{
  "name": "11ty",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npm run css-build && eleventy",
    "start": "concurrently \"npm run css-watch\" \"eleventy --serve\"",
    "format": "prettier --write .",
    "css-build": "sass --load-path=node_modules \"src/assets/_sass/main.scss\" \"src/assets/css/main.css\"",
    "css-watch": "sass --load-path=node_modules \"src/assets/_sass/main.scss\" \"src/assets/css/main.css\" --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "bulma": "^1.0.4",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.3",
    "prettier-plugin-jinja-template": "^2.2.0",
    "sass": "^1.99.0"
  }
}
