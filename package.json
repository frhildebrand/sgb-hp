{
  "name": "11ty",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npm run css-build && eleventy",
    "start": "npm run css-build && concurrently \"npm run css-watch\" \"eleventy --serve\"",
    "format": "prettier --write .",
    "check": "node scripts/check-public-site.cjs",
    "css-build": "sass --no-source-map --load-path=node_modules \"src/assets/_sass/main.scss\" \"src/assets/css/main.css\"",
    "css-watch": "sass --no-source-map --load-path=node_modules \"src/assets/_sass/main.scss\" \"src/assets/css/main.css\" --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@11ty/eleventy": "3.1.6",
    "@fortawesome/fontawesome-free": "7.3.1",
    "bulma": "1.0.4",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "concurrently": "10.0.3",
    "prettier": "3.9.0",
    "prettier-plugin-jinja-template": "2.2.0",
    "sass": "1.101.0"
  }
}
