---
title: Schwimmgemeinschaft Barnstorf e.V.
---

<!DOCTYPE html>
<html>
  <head>
    {% if heading %}
      <title>{{ heading }} - {{ title }}</title>
    {% else %}
      <title>{{ title }}</title>
    {% endif %}
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, user-scalable=no"
    />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="icon" type="image/svg+xml" href="/images/sgb-hai.svg" />
  </head>
  <body>
    {% set activeHeroImage = heroImage or "/images/header-bg.jpg" %}
    <section
      class="hero is-medium"
      style="background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)), url('{{ activeHeroImage }}') no-repeat center center; background-size: cover;"
    >
      <div class="hero-head">
        <nav
          class="navbar is-white is-fixed-top"
          style="background-color: rgba(247, 247, 247, 0.8);"
          role="navigation"
          aria-label="main navigation"
        >
          <div class="container">
            <div class="navbar-brand">
              <a class="navbar-item" href="/">
                <img
                  src="{{ metadata.logo }}"
                  alt="{{ metadata.title }}"
                  style="max-height: 3rem;"
                />
              </a>

              <a
                role="button"
                class="navbar-burger"
                aria-label="menu"
                aria-expanded="false"
                data-target="navbarMain"
              >
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
              </a>
            </div>

            <div id="navbarMain" class="navbar-menu">
              <div class="navbar-start">
                <a class="navbar-item" href="/">Home</a>
                <a class="navbar-item" href="/news">News</a>

                <div class="navbar-item has-dropdown is-hoverable">
                  <a class="navbar-link" href="/training">Training</a>
                  <div class="navbar-dropdown">
                    <a
                      class="navbar-item"
                      href="https://sgbarnstorf.webclub.app"
                      target="_blank"
                    >
                      Direkt zu WebClub
                    </a>
                  </div>
                </div>

                <div class="navbar-item has-dropdown is-hoverable">
                  <a class="navbar-link" href="/verein">Verein</a>
                  <div class="navbar-dropdown">
                    <a class="navbar-item" href="/verein/mitgliedschaft"
                      >Mitgliedschaft</a
                    >
                    <a class="navbar-item" href="/verein/downloads"
                      >Downloads</a
                    >
                  </div>
                </div>

                <a class="navbar-item" href="/hunte-schwimmmeeting"
                  >Hunte-Schwimmmeeting</a
                >
              </div>
            </div>
          </div>
        </nav>
      </div>
      <div class="hero-body">
        <div class="container">
          <p
            class="title is-1 has-text-white"
            style="text-shadow: 0 4px 15px rgba(0,0,0,0.8);"
          >
            {{ heading or title }}
          </p>
          {% if heroSubtitle %}
            <p
              class="subtitle is-4 has-text-white"
              style="text-shadow: 0 2px 10px rgba(0,0,0,0.8);"
            >
              {{ heroSubtitle }}
            </p>
          {% endif %}
        </div>
      </div>
    </section>

    <div class="mt-6">
      <!-- Main -->
      <div class="container">{{ content | safe }}</div>

      <!-- Footer -->
      <footer class="footer mt-6">
        <div class="container">
          <div class="columns is-multiline is-variable is-8">
            <div class="column is-3-desktop is-6-tablet">
              <p class="menu-label has-text-weight-bold">Most wanted</p>
              <ul class="is-size-6">
                <li class="mb-2"><a href="/verein/downloads">Downloads</a></li>
                <li class="mb-2">
                  <a href="/training#probetraining">Probetraining</a>
                </li>
                <li class="mb-2">
                  <a href="/verein/mitgliedschaft">Mitgliedschaft</a>
                </li>
              </ul>
            </div>

            <div class="column is-3-desktop is-6-tablet">
              <p class="menu-label has-text-weight-bold">Verbände</p>
              <ul class="is-size-6">
                <li class="mb-2">
                  <a
                    href="https://kreisschwimmverband-diepholz-nienburg.de/"
                    target="_blank"
                    >Kreisschwimmverband</a
                  >
                </li>
                <li class="mb-2">
                  <a href="https://www.ksb-diepholz.de/" target="_blank"
                    >Kreissportbund</a
                  >
                </li>
                <li class="mb-2">
                  <a href="https://lsn-info.de/" target="_blank"
                    >Landesschwimmverband Nds</a
                  >
                </li>
                <li class="mb-2">
                  <a href="https://www.dsv.de/" target="_blank">DSV</a>
                </li>
              </ul>
            </div>

            <div class="column is-3-desktop is-6-tablet">
              <p class="menu-label has-text-weight-bold">Extern</p>
              <ul class="is-size-6">
                <li class="mb-2">
                  <a href="https://sgbarnstorf.webclub.app" target="_blank"
                    >WebClub</a
                  >
                </li>
                <li class="mb-2">
                  <a
                    href="https://teamfreaks.de/Vereinsshops/SG-Barnstorf/"
                    target="_blank"
                    >Vereinsshop</a
                  >
                </li>
                <li class="mb-2">
                  <a href="https://live.sgbarnstorf.de/" target="_blank"
                    >Live-Ergebnisse</a
                  >
                </li>
              </ul>
            </div>

            <div class="column is-3-desktop is-6-tablet">
              <p class="menu-label has-text-weight-bold">Folge uns</p>
              <div class="buttons">
                <a
                  href="https://www.facebook.com/sgbarnstorf"
                  class="button is-link is-light is-medium"
                  target="_blank"
                  aria-label="Facebook"
                >
                  <span class="icon"><i class="fab fa-facebook-f"></i></span>
                </a>
                <a
                  href="https://www.instagram.com/sgbarnstorf"
                  class="button is-danger is-light is-medium"
                  target="_blank"
                  aria-label="Instagram"
                >
                  <span class="icon"><i class="fab fa-instagram"></i></span>
                </a>
                <a
                  href="mailto:info@sgbarnstorf.de"
                  class="button is-dark is-light is-medium"
                  aria-label="Email"
                >
                  <span class="icon"><i class="fas fa-envelope"></i></span>
                </a>
              </div>
            </div>
          </div>

          <hr class="has-background-grey-lighter" />

          <div class="level is-mobile">
            <div class="level-left">
              <div class="level-item">
                <p class="is-size-7 has-text-grey">
                  &copy; Schwimmgemeinschaft Barnstorf e.V.
                </p>
              </div>
            </div>
            <div class="level-right">
              <div class="level-item">
                <a href="/impressum" class="is-size-7 has-text-grey mr-4"
                  >Impressum & Datenschutz</a
                >
              </div>
              <div class="level-item">
                <a href="https://bulma.io">
                  <img
                    src="https://bulma.io/assets/images/made-with-bulma.png"
                    alt="Made with Bulma"
                    width="128"
                    height="24"
                  />
                </a>
              </div>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <!-- Scripts -->

    <script src="/assets/js/jquery.min.js"></script>
    <script src="/assets/js/jquery.dropotron.min.js"></script>
    <script src="/assets/js/browser.min.js"></script>
    <script src="/assets/js/breakpoints.min.js"></script>
    <script src="/assets/js/util.js"></script>
    <script src="/assets/js/main.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const $navbarBurgers = Array.prototype.slice.call(
          document.querySelectorAll(".navbar-burger"),
          0,
        );
        $navbarBurgers.forEach((el) => {
          el.addEventListener("click", () => {
            const target = el.dataset.target;
            const $target = document.getElementById(target);
            el.classList.toggle("is-active");
            $target.classList.toggle("is-active");
          });
        });
      });
    </script>
    <script
      defer
      src="https://use.fontawesome.com/releases/v5.3.1/js/all.js"
    ></script>
  </body>
</html>
