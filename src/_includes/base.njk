---
title: SG Barnstorf e.V.
---

<!DOCTYPE html>
<html>
  <head>
    {% if heading %}
      <title>{{ heading }} - {{ title }}</title>
    {% else %}
      <title>{{ title }}</title>
    {% endif %}
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, user-scalable=no"
    />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="icon" type="image/svg+xml" href="/images/sgb-hai.svg" />
  </head>
  <body>
    <section class="hero">
      <div class="hero-body">
        <p class="title">SG Barnstorf e.V.</p>
        <p class="subtitle">Seit 1972 mit euch im Wasser</p>
      </div>
    </section>
    <div>
      <div id="header-wrapper">
        <header id="header" class="hero">
          <!-- Logo -->
          <div id="logo">
            <h1>
              <a href="/">
                <img
                  src="{{ metadata.logo }}"
                  alt="{{ metadata.title }}"
                  class="logo-black"
                />
              </a>
            </h1>
          </div>

          <!-- Nav -->
          <nav id="nav">
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/news">News</a></li>
              <li>
                <a href="/training">Training</a>
                <ul>
                  <li>
                    <a href="https://sgbarnstorf.webclub.app" target="_blank"
                      >Direkt zu WebClub</a
                    >
                  </li>
                </ul>
              </li>
              <li>
                <a href="/verein">Verein</a>
                <ul>
                  <li><a href="/mitgliedschaft">Mitgliedschaft</a></li>
                  <li><a href="/downloads">Downloads</a></li>
                </ul>
              </li>
              <li><a href="/hunte-schwimmmeeting">Hunte-Schwimmmeeting</a></li>
            </ul>
          </nav>
        </header>
      </div>

      <!-- Home page without sidenav-->
      {% if page.url == "/" %}
        <div id="banner-wrapper">
          <div id="banner" class="box container">
            <div class="row">
              <div class="col-7 col-12-medium">
                <h2>Schwimmgemeinschaft Barnstorf</h2>
                <p>Seit 1972 mit euch im Wasser</p>
              </div>
              <div class="col-5 col-12-medium">
                <ul>
                  <li>
                    <a href="/training" class="button large icon solid fa-clock"
                      >Training</a
                    >
                  </li>
                  <li>
                    <a
                      href="/news/"
                      class="button alt large icon solid fa-newspaper"
                      >News</a
                    >
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <div id="features-wrapper">
          <div class="container">
            <div class="row">
              {% for item in collections.news | reverse %}
                {% if loop.index0 < 3 %}
                  <div class="col-4 col-12-medium">
                    <section class="box feature news-card">
                      <a
                        href="{{ item.url }}"
                        class="image featured aspect-ratio-3x2"
                        ><img
                          src="{{ item.data.image | default('/images/news/placeholder.png') }}"
                          alt="{{ item.data.heading }}"
                      /></a>
                      <div class="inner">
                        <header>
                          <h2>{{ item.data.heading }}</h2>
                          <small>{{ item.data.date | dateFilter }}</small>
                        </header>
                        <p>
                          {{ item.data.excerpt }}
                          <a
                            href="{{ item.url }}"
                            class="icon solid fa-arrow-circle-right"
                            >Mehr</a
                          >
                        </p>
                      </div>
                    </section>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      {% endif %}
      <!-- Main -->
      <div id="main-wrapper">
        <div class="container">{{ content | safe }}</div>
      </div>

      <!-- Footer -->
      <div id="footer-wrapper">
        <footer id="footer" class="container">
          <div class="row">
            <div class="col-3 col-6-medium col-12-small">
              <!-- Links -->
              <section class="widget links">
                <h3>Most wanted</h3>
                <ul class="style2">
                  <li><a href="/downloads">Downloads</a></li>
                  <li><a href="/training#probetraining">Probetraining</a></li>
                  <li><a href="/mitgliedschaft">Mitgliedschaft</a></li>
                </ul>
              </section>
            </div>
            <div class="col-3 col-6-medium col-12-small">
              <!-- Links -->
              <section class="widget links">
                <h3>Verbände</h3>
                <ul class="style2">
                  <li>
                    <a
                      href="https://kreisschwimmverband-diepholz-nienburg.de/"
                      target="_blank"
                      >Kreisschwimmverband</a
                    >
                  </li>
                  <li>
                    <a href="https://www.ksb-diepholz.de/" target="_blank"
                      >Kreissportbund</a
                    >
                  </li>
                  <li>
                    <a href="https://lsn-info.de/" target="_blank"
                      >Landesschwimmverband Nds</a
                    >
                  </li>
                  <li><a href="https://www.dsv.de/" target="_blank">dsv</a></li>
                </ul>
              </section>
            </div>
            <div class="col-3 col-6-medium col-12-small">
              <!-- Links -->
              <section class="widget links">
                <h3>Extern</h3>
                <ul class="style2">
                  <li>
                    <a href="https://sgbarnstorf.webclub.app" target="_blank"
                      >WebClub</a
                    >
                  </li>
                  <li>
                    <a
                      href="https://teamfreaks.de/Vereinsshops/SG-Barnstorf/"
                      target="_blank"
                      >Vereinsshop</a
                    >
                  </li>
                  <li>
                    <a href="https://live.sgbarnstorf.de/" target="_blank"
                      >Live-Ergebnisse</a
                    >
                  </li>
                </ul>
              </section>
            </div>
            <div class="col-3 col-6-medium col-12-small">
              <!-- Contact -->
              <section class="widget contact last">
                <h3>Folge uns</h3>
                <ul>
                  <li>
                    <a
                      href="https://www.facebook.com/sgbarnstorf"
                      class="icon brands fa-facebook-f"
                      target="_blank"
                      ><span class="label">Facebook</span></a
                    >
                  </li>
                  <li>
                    <a
                      href="https://www.instagram.com/sgbarnstorf"
                      class="icon brands fa-instagram"
                      target="_blank"
                      ><span class="label">Instagram</span></a
                    >
                  </li>
                  <li>
                    <a
                      href="mailto:info@sgbarnstorf.de"
                      class="icon solid style2 fa-envelope"
                      ><span class="label">Email</span></a
                    >
                  </li>
                </ul>
              </section>
            </div>
          </div>
          <div class="row">
            <div class="col-12">
              <div id="copyright">
                <ul class="menu">
                  <li>
                    &copy; Schwimmgemeinschaft Barnstorf e.V. All rights
                    reserved
                  </li>
                  <li>Design: <a href="http://html5up.net">HTML5 UP</a></li>
                  <li><a href="/impressum">Impressum & Datenschutz</a></li>
                </ul>
              </div>
            </div>
          </div>
        </footer>
      </div>
    </div>

    <!-- Scripts -->

    <script src="/assets/js/jquery.min.js"></script>
    <script src="/assets/js/jquery.dropotron.min.js"></script>
    <script src="/assets/js/browser.min.js"></script>
    <script src="/assets/js/breakpoints.min.js"></script>
    <script src="/assets/js/util.js"></script>
    <script src="/assets/js/main.js"></script>
  </body>
</html>
