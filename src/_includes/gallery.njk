<div class="columns is-multiline is-mobile news-gallery">
  {% for image in galleryImages %}
    <div class="column is-3-desktop is-4-tablet is-6-mobile">
      <a
        href="{{ image.src }}"
        data-caption="{{ image.alt or image.description }}"
      >
        <figure class="image is-1by1">
          <img
            src="{{ image.src }}"
            alt="{{ image.alt or image.description }}"
            style="object-fit: cover; border-radius: 6px; width: 100%; height: 100%;"
          />
        </figure>
      </a>
    </div>
  {% endfor %}
</div>
