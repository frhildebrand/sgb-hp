---
layout: base.njk
---

<div class="row gtr-150">
  <div class="col-8 col-12-medium">
    <article class="news-detail">
      <header>
        <h1>{{ heading }}</h1>
        <p class="news-meta">
          {% if date %}
            <span class="icon solid fa-calendar"> {{ date | dateFilter }}</span>
          {% endif %}

          <span class="tag-container">
            {% for tag in tags %}
              <span class="tag-badge">{{ tag }}</span>
            {% endfor %}
          </span>
        </p>
      </header>

      <a
        href="{{ image | default('/images/news/placeholder.png') }}"
        class="image featured aspect-ratio-3x2"
      >
        <img
          src="{{ image | default('/images/news/placeholder.png') }}"
          alt="{{ heading }}"
        />
      </a>

      {{ content | safe }}

      {% if links %}
        <section class="related-links">
          <h3>Links zum Thema</h3>
          <ul class="style2">
            {% for item in links %}
              <li>
                <a href="{{ item.url }}" target="_blank" rel="noopener"
                  >{{ item.text }}</a
                >
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    </article>
  </div>
  <div class="col-4 col-12-medium">
    <div id="sidebar">
      <section class="box">
        <h3>Weitere News</h3>
        <ul class="style2">
          {% set count = 0 %}
          {% for post in collections.news | reverse %}
            {% if post.url != page.url and count < 5 %}
              <li><a href="{{ post.url }}">{{ post.data.heading }}</a></li>
              {% set count = count + 1 %}
            {% endif %}
          {% endfor %}
        </ul>
      </section>
    </div>
    <a
      href="/news"
      class="button alt icon solid fa-arrow-left"
      style="margin:1em 0 1em 0;"
      >Alle News</a
    >
  </div>
</div>
