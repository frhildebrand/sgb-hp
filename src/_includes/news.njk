---
layout: base.njk
---

<div class="columns is-multiline">
  <div class="column is-8-desktop is-12-tablet">
    <article class="box p-5">
      <header class="mb-5">
        <h1 class="title is-1">{{ heading }}</h1>

        <div class="level is-mobile mb-4">
          <div class="level-left">
            {% if date %}
              <div class="level-item">
                <span class="icon-text has-text-grey">
                  <span class="icon"><i class="fas fa-calendar-alt"></i></span>
                  <span>{{ date | dateFilter }}</span>
                </span>
              </div>
            {% endif %}
          </div>
          <div class="level-right">
            <div class="tags">
              {% for tag in tags %}
                <span class="tag is-primary is-light">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>
        </div>
      </header>

      <figure class="image is-3by2 mb-5">
        <img
          src="{{ image | default('/images/news/placeholder.png') }}"
          alt="{{ heading }}"
          style="object-fit: cover; border-radius: 6px;"
        />
      </figure>

      <div class="content">{{ content | safe }}</div>

      {% if links %}
        <section class="mt-6 pt-5" style="border-top: 1px solid #eee;">
          <h3 class="title is-4">Links zum Thema</h3>
          <div class="buttons">
            {% for item in links %}
              <a
                href="{{ item.url }}"
                class="button is-link is-outlined is-small"
                target="_blank"
                rel="noopener"
              >
                <span class="icon"
                  ><i class="fas fa-external-link-alt"></i
                ></span>
                <span>{{ item.text }}</span>
              </a>
            {% endfor %}
          </div>
        </section>
      {% endif %}
    </article>
  </div>

  <div class="column is-4-desktop is-12-tablet">
    <div id="sidebar">
      <aside class="menu box">
        <p class="menu-label title is-5 mb-3">Weitere News</p>
        <ul class="menu-list">
          {% set count = 0 %}
          {% for post in collections.news | reverse %}
            {% if post.url != page.url and count < 5 %}
              <li><a href="{{ post.url }}">{{ post.data.heading }}</a></li>
              {% set count = count + 1 %}
            {% endif %}
          {% endfor %}
        </ul>
      </aside>
    </div>
    <a href="/news" class="button is-light is-fullwidth mt-4">
      <span class="icon"><i class="fas fa-arrow-left"></i></span>
      <span>Alle News</span>
    </a>
  </div>
</div>
