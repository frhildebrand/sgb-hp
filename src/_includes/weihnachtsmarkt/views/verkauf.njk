<div id="viewVerkauf" class="hidden space-y-5 max-w-4xl mx-auto">

  <!-- Kopf: Titel, Live-Anzeige, Statistik (nur wer sie sehen darf) -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-3 flex-wrap">
      <h2 class="font-black text-xl text-amber-600 dark:text-amber-400">🪙 Kasse</h2>
      <span id="kasseSyncBadge" class="text-xs px-3 py-1 rounded-full font-bold border flex items-center gap-1.5 bg-slate-500/10 text-slate-500 dark:text-slate-300 border-slate-500/30">
        <span class="w-2.5 h-2.5 rounded-full bg-slate-400 animate-pulse"></span> Verbinde...
      </span>
    </div>
    <button id="kasseStatistikBtn" type="button" onclick="switchView('statistik')" class="hidden px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-xs rounded-xl shadow transition">📊 Statistik</button>
  </div>

  <!-- Tag wählen -->
  <div class="grid grid-cols-2 gap-2 bg-slate-200/60 dark:bg-slate-900 p-1.5 rounded-2xl">
    <button id="kasseDayTabSamstag" type="button" onclick="setKasseDay('samstag')" class="py-3 rounded-xl text-sm font-black bg-amber-500 text-slate-950 shadow transition">📅 Samstag</button>
    <button id="kasseDayTabSonntag" type="button" onclick="setKasseDay('sonntag')" class="py-3 rounded-xl text-sm font-bold text-slate-600 dark:text-slate-300 transition">📅 Sonntag</button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

    <!-- WAFFELN -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="text-4xl">🧇</span>
          <div>
            <h3 class="font-black text-lg text-slate-900 dark:text-slate-100">Belgische Waffeln</h3>
            <div id="displayWaffelPrice" class="text-sm font-bold text-amber-600 dark:text-amber-400">2,00 € / Stück</div>
          </div>
        </div>
        <div class="text-right">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Verkauft</div>
          <div id="countWaffelPaid" class="text-5xl font-black text-emerald-600 dark:text-emerald-400 leading-none">0</div>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-2">
        <button type="button" onclick="changeKasseCount('waffel', 'paid', -1)" class="h-16 bg-slate-100 dark:bg-slate-800 hover:bg-rose-100 dark:hover:bg-rose-900/60 text-slate-700 dark:text-slate-200 rounded-xl font-black text-2xl transition active:scale-95 border border-slate-200 dark:border-slate-700">−1</button>
        <button type="button" onclick="changeKasseCount('waffel', 'paid', 1)" class="col-span-2 h-16 bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-xl font-black text-2xl transition active:scale-95 shadow">+1</button>
      </div>
      <div class="flex items-center justify-between gap-3 bg-indigo-500/10 border border-indigo-500/30 rounded-xl px-3 py-2">
        <div class="text-xs font-bold text-indigo-600 dark:text-indigo-300">🎁 Helfer: <span id="countWaffelFree" class="font-black text-base">0</span></div>
        <div class="flex gap-1.5">
          <button type="button" onclick="changeKasseCount('waffel', 'free', -1)" class="w-9 h-9 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 rounded-lg font-black transition active:scale-95">−</button>
          <button type="button" onclick="changeKasseCount('waffel', 'free', 1)" class="w-9 h-9 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-black transition active:scale-95">+</button>
        </div>
      </div>
    </div>

    <!-- KINDERPUNSCH -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="text-4xl">☕</span>
          <div>
            <h3 class="font-black text-lg text-slate-900 dark:text-slate-100">Kinderpunsch</h3>
            <div id="displayKinderpunschPrice" class="text-sm font-bold text-amber-600 dark:text-amber-400">2,00 € / Becher</div>
          </div>
        </div>
        <div class="text-right">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Verkauft</div>
          <div id="countKinderpunschPaid" class="text-5xl font-black text-emerald-600 dark:text-emerald-400 leading-none">0</div>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-2">
        <button type="button" onclick="changeKasseCount('kinderpunsch', 'paid', -1)" class="h-16 bg-slate-100 dark:bg-slate-800 hover:bg-rose-100 dark:hover:bg-rose-900/60 text-slate-700 dark:text-slate-200 rounded-xl font-black text-2xl transition active:scale-95 border border-slate-200 dark:border-slate-700">−1</button>
        <button type="button" onclick="changeKasseCount('kinderpunsch', 'paid', 1)" class="col-span-2 h-16 bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-xl font-black text-2xl transition active:scale-95 shadow">+1</button>
      </div>
      <div class="flex items-center justify-between gap-3 bg-indigo-500/10 border border-indigo-500/30 rounded-xl px-3 py-2">
        <div class="text-xs font-bold text-indigo-600 dark:text-indigo-300">🎁 Helfer: <span id="countKinderpunschFree" class="font-black text-base">0</span></div>
        <div class="flex gap-1.5">
          <button type="button" onclick="changeKasseCount('kinderpunsch', 'free', -1)" class="w-9 h-9 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 rounded-lg font-black transition active:scale-95">−</button>
          <button type="button" onclick="changeKasseCount('kinderpunsch', 'free', 1)" class="w-9 h-9 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-black transition active:scale-95">+</button>
        </div>
      </div>
    </div>

  </div>
</div>
