<div id="viewInventar" class="hidden space-y-6">
<!-- Header / Navigations-Button -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-slate-900/90 p-5 rounded-2xl border border-slate-800/80 shadow-md gap-4">
<div>
<h2 class="font-black text-xl text-amber-400 flex items-center gap-2">
📋 Inventar & Checkliste
</h2>
<p class="text-xs text-slate-400 mt-0.5">Übersicht aller Gegenstände, Status und Packfortschritt</p>
</div>
<button onclick="switchView('aushang')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold rounded-xl transition border border-slate-700 flex items-center gap-2">
⬅️ Zurück zu Aushänge
</button>
</div>
<!-- Suchleiste, Filter-Pills & Fortschritts-Anzeige -->
<div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-800/80 shadow-md space-y-4">
<div class="flex flex-col md:flex-row justify-between items-stretch md:items-center gap-4">
<!-- Suchfeld -->
<div class="relative flex-1">
<span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 text-sm">🔍</span>
<input 
type="text" 
placeholder="Suche nach Name, Ort, Kiste..." 
oninput="window.handleInventarSearch(this.value)"
class="w-full pl-10 pr-4 py-2 bg-slate-950/80 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-500/80 transition"
/>
</div>
<!-- Live-Fortschritt Text (z.B. 0% erledigt (0/74)) -->
<div class="text-right text-xs font-bold text-amber-400 whitespace-nowrap self-end md:self-center" id="inventarProgressText">
0% erledigt (0/0)
</div>
</div>
<!-- Filter Buttons -->
<div class="flex flex-wrap gap-2 pt-1 border-t border-slate-800/60">
<button data-filter-btn="alle" onclick="window.setInventarFilter('alle')" class="px-3 py-1.5 rounded-lg text-xs font-bold transition bg-amber-500 text-slate-950 shadow-md">
Alle
</button>
<button data-filter-btn="offen" onclick="window.setInventarFilter('Offen')" class="px-3 py-1.5 rounded-lg text-xs font-medium transition bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700">
Offen
</button>
<button data-filter-btn="vorbereitet" onclick="window.setInventarFilter('Vorbereitet')" class="px-3 py-1.5 rounded-lg text-xs font-medium transition bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700">
Vorbereitet
</button>
<button data-filter-btn="verteilt" onclick="window.setInventarFilter('Verteilt')" class="px-3 py-1.5 rounded-lg text-xs font-medium transition bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700">
Verteilt
</button>
<button data-filter-btn="erledigt" onclick="window.setInventarFilter('Erledigt')" class="px-3 py-1.5 rounded-lg text-xs font-medium transition bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700">
Erledigt
</button>
<button data-filter-btn="packed" onclick="window.togglePackedFilter()" class="px-3 py-1.5 rounded-lg text-xs font-medium transition bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700">
📦 Nur Gepackt
</button>
</div>
</div>
<!-- Container für die dynamischen Tabellen -->
<div id="inventarTablesContainer" class="space-y-6">
<div class="p-8 text-center text-slate-400 text-xs">Lade Inventardaten...</div>
</div>
</div>
