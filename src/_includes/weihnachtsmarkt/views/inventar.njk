<div id="viewInventar" class="space-y-6 hidden">

  <!-- Header -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="space-y-1">
      <h2 class="font-black text-xl text-slate-800 dark:text-slate-100 flex items-center gap-2">
        <span>📋</span> Inventar & Checkliste
      </h2>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Übersicht aller Gegenstände und Status
      </p>
    </div>
    
    <div class="flex items-center gap-2">
      <button id="adminInventarEditBtn" onclick="window.toggleInventarEditMode()" class="px-3 py-2 bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 hover:bg-purple-500/20 text-xs font-bold rounded-xl transition-colors hidden cursor-pointer">
        ✏️ Gegenstände verwalten
      </button>
      
      <button onclick="window.switchView('aushang')" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl transition-colors flex items-center gap-2 cursor-pointer">
        <span>⬅️</span> Zurück
      </button>
    </div>
  </div>

  <!-- Suche & Filter -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-sm space-y-4">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="relative w-full sm:w-80">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-xs">🔍</span>
        <input type="text" id="inventarSearchInput" onkeyup="window.filterInventarTable()" placeholder="Suche nach Name, Ort, Kiste..." class="w-full pl-8 pr-3 py-2 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500">
      </div>
      <div id="inventarProgressText" class="text-xs font-bold text-amber-500 dark:text-amber-400">
        Bereit
      </div>
    </div>

    <!-- Filter Pills -->
    <div class="flex flex-wrap items-center gap-2 pt-1 border-t border-slate-100 dark:border-slate-800/80 text-xs">
      <button onclick="window.filterInventarStatus('alle')" class="px-3 py-1.5 bg-amber-500 text-slate-950 font-bold rounded-xl text-xs cursor-pointer">Alle</button>
      <button onclick="window.filterInventarStatus('Offen')" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium rounded-xl text-xs hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer">🔴 Offen</button>
      <button onclick="window.filterInventarStatus('Vorbereitet')" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium rounded-xl text-xs hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer">🟡 Vorbereitet</button>
      <button onclick="window.filterInventarStatus('Verteilt')" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium rounded-xl text-xs hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer">🟣 Verteilt</button>
      <button onclick="window.filterInventarStatus('Erledigt')" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium rounded-xl text-xs hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer">🟢 Erledigt</button>
    </div>
  </div>

  <!-- Neuer Gegenstand Hinzufügen -->
  <div id="addItemPanel" class="hidden bg-purple-500/10 border border-purple-500/30 rounded-2xl p-4 space-y-3">
    <h3 class="font-bold text-xs text-purple-600 dark:text-purple-400 flex items-center gap-2">
      <span>➕</span> Neuen Gegenstand hinzufügen
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
      <input type="text" id="newItemName" placeholder="Gegenstandsname..." class="px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs">
      <select id="newItemCategory" class="px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs">
      </select>
      <input type="number" id="newItemBedarf" placeholder="Bedarf" value="1" class="px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs">
      <button onclick="window.createNewItem()" class="py-2 bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs rounded-xl transition-colors cursor-pointer">
        Hinzufügen
      </button>
    </div>
  </div>

  <!-- Tabellen Container (Direkt mit Nunjucks gerendert) -->
  <div id="inventarTablesContainer" class="space-y-6">
    {% for kiste, items in inventarData | groupby("kategorie") %}
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm mb-6">
      
      <!-- Kategorie Header -->
      <div class="bg-slate-50 dark:bg-slate-800/60 px-5 py-3.5 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
        <h3 class="font-bold text-sm text-amber-600 dark:text-amber-400 flex items-center gap-2">
          📦 {{ kiste }}
        </h3>
      </div>

      <!-- Tabelle -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-slate-200 dark:border-slate-800 text-[10px] font-bold uppercase text-slate-400 dark:text-slate-500 bg-slate-50/30 dark:bg-slate-900/30">
              <th class="py-3 px-4">GEGENSTAND</th>
              <th class="py-3 px-2 text-center w-20">BENÖTIGT</th>
              <th class="py-3 px-2 text-center w-20">AUF LAGER</th>
              <th class="py-3 px-2 text-center w-32">STATUS</th>
              <th class="py-3 px-2 w-36">VERANTWORTLICH</th>
              <th class="py-3 px-2 text-center w-14">GEPACKT?</th>
              <th class="py-3 px-2 text-center w-20">BOX</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
            {% for item in items %}
            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/30 transition-colors">
              <!-- Gegenstand & Beschreibung -->
              <td class="py-2.5 px-4 font-bold text-slate-800 dark:text-slate-200">
                <div>{{ item.gegenstand or item.Gegenstand }}</div>
                {% if item.beschreibung or item.Beschreibung %}
                  <div class="text-[10px] font-normal text-slate-400">{{ item.beschreibung or item.Beschreibung }}</div>
                {% endif %}
              </td>

              <!-- Benötigt -->
              <td class="py-2.5 px-2 text-center">
                <input type="number" value="{{ item.bedarf or item.Bedarf or '' }}" placeholder="-" 
                  class="w-16 text-center py-1 px-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 font-bold focus:ring-2 focus:ring-amber-500 outline-none" />
              </td>

              <!-- Auf Lager -->
              <td class="py-2.5 px-2 text-center">
                <input type="number" value="{{ item.lager or item.Lager or 0 }}" 
                  class="w-16 text-center py-1 px-1.5 rounded-lg border border-amber-200 dark:border-amber-900/40 bg-amber-50/30 dark:bg-amber-950/20 font-bold text-amber-700 dark:text-amber-400 focus:ring-2 focus:ring-amber-500 outline-none" />
              </td>

              <!-- Status -->
              <td class="py-2.5 px-2 text-center">
                <select class="w-full text-center py-1 px-2 rounded-lg border border-red-200 dark:border-red-900/40 bg-red-50/40 dark:bg-red-950/20 font-bold text-red-600 dark:text-red-400 text-[11px] focus:ring-2 focus:ring-amber-500 outline-none cursor-pointer">
                  <option value="Offen" {% if (item.status or item.Status) == 'Offen' %}selected{% endif %}>Offen</option>
                  <option value="Vorbereitet" {% if (item.status or item.Status) == 'Vorbereitet' %}selected{% endif %}>Vorbereitet</option>
                  <option value="Verteilt" {% if (item.status or item.Status) == 'Verteilt' %}selected{% endif %}>Verteilt</option>
                  <option value="Erledigt" {% if (item.status or item.Status) == 'Erledigt' %}selected{% endif %}>Erledigt</option>
                </select>
              </td>

              <!-- Verantwortlich -->
              <td class="py-2.5 px-2">
                <input type="text" value="{{ item.wer or item.Wer or '' }}" placeholder="Name..." 
                  class="w-full py-1 px-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 focus:ring-2 focus:ring-amber-500 outline-none" />
              </td>

              <!-- Gepackt? -->
              <td class="py-2.5 px-2 text-center">
                <input type="checkbox" {% if item.pack or item.Pack %}checked{% endif %} 
                  class="w-4 h-4 rounded border-slate-300 text-amber-500 focus:ring-amber-500 cursor-pointer" />
              </td>

              <!-- Box -->
              <td class="py-2.5 px-2 text-center">
                <input type="text" value="{{ item.box or item.Box or '' }}" placeholder="-" 
                  class="w-16 text-center py-1 px-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 focus:ring-2 focus:ring-amber-500 outline-none" />
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endfor %}
  </div>

</div>
