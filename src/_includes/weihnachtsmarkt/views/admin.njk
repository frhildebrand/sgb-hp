<div id="viewAdminpanel" class="hidden space-y-6">
  <div class="flex justify-between items-center bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
    <h2 class="font-extrabold text-lg text-amber-500 flex items-center gap-2">👑 Admin Control Center</h2>
    <button onclick="switchView('aushang')" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl transition">⬅️ Zurück</button>
  </div>

  <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
    <div class="bg-amber-50/50 dark:bg-amber-950/20 p-4 rounded-xl border border-amber-200 dark:border-amber-800/50 space-y-3">
      <h4 class="font-extrabold text-xs text-amber-600 dark:text-amber-400 uppercase tracking-wider">🏷️ Verkaufspreise festlegen</h4>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-bold">
        <div>
          <label class="block text-slate-600 dark:text-slate-400 mb-1">Waffel Preis (€):</label>
          <input type="number" step="0.10" id="adminPriceWaffel" onchange="updatePricesFromAdmin()" class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-2 font-bold" />
        </div>
        <div>
          <label class="block text-slate-600 dark:text-slate-400 mb-1">Punsch Preis (€):</label>
          <input type="number" step="0.10" id="adminPricePunsch" onchange="updatePricesFromAdmin()" class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-2 font-bold" />
        </div>
      </div>
    </div>

    <div class="bg-slate-50 dark:bg-slate-950 p-4 rounded-xl border border-slate-200 dark:border-slate-800 space-y-3">
      <h4 class="font-extrabold text-xs text-amber-600 dark:text-amber-400 uppercase tracking-wider">📤 ROSHOP Listen Hochladen</h4>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="space-y-1">
          <label class="font-bold block">📅 Samstag Liste Upload:</label>
          <input type="file" accept="image/*" onchange="uploadRoshopImage('samstag', this)" class="text-xs text-slate-500 block w-full cursor-pointer" />
        </div>
        <div class="space-y-1">
          <label class="font-bold block">📅 Sonntag Liste Upload:</label>
          <input type="file" accept="image/*" onchange="uploadRoshopImage('sonntag', this)" class="text-xs text-slate-500 block w-full cursor-pointer" />
        </div>
      </div>
    </div>
    
    <div id="adminPermissionsGrid" class="space-y-4"></div>

    <div class="pt-4 border-t border-slate-200 dark:border-slate-800 flex flex-wrap gap-2 text-xs font-bold">
      <button onclick="addNewItemPrompt()" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl shadow transition">⚙️ Item Hinzufügen</button>
      <button onclick="downloadBackup()" class="px-4 py-2.5 bg-slate-700 hover:bg-slate-600 text-white rounded-xl shadow transition">💾 Backup Download</button>
      <button onclick="resetSeasonPrompt()" class="px-4 py-2.5 bg-rose-600 hover:bg-rose-500 text-white rounded-xl shadow transition">🔄 Saison-Reset</button>
    </div>
  </div>
</div>
