<div id="viewStatistik" class="hidden space-y-6">
<!-- Header -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm gap-4">
<div>
<h2 class="font-black text-xl text-amber-600 dark:text-amber-400 flex items-center gap-2">
📊 Verkaufs- & Schicht-Statistik
</h2>
<p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Übersicht über Ausgaben, Einnahmen und Gratis-Kontingente</p>
</div>
<div class="flex items-center gap-2">
<button onclick="window.resetKasseData()" class="px-3.5 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-500/30 text-xs font-bold rounded-xl transition">
🔄 Zähler zurücksetzen
</button>
<button onclick="window.switchView('verkauf')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl transition border border-slate-300 dark:border-slate-700">
⬅️ Zum Verkauf
</button>
</div>
</div>
<!-- KPI Cards Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
<div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
<div class="text-[11px] font-bold uppercase text-slate-500 dark:text-slate-400">Gesamteinnahmen</div>
<div id="statTotalRevenue" class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">0,00 €</div>
<div class="text-[10px] text-slate-400 mt-0.5">Nur bezahlte Artikel</div>
</div>
<div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
<div class="text-[11px] font-bold uppercase text-slate-500 dark:text-slate-400">Verkaufte Artikel</div>
<div id="statTotalPaidItems" class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">0 Stk.</div>
<div class="text-[10px] text-slate-400 mt-0.5">Kinderpunsch & Waffeln</div>
</div>
<div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
<div class="text-[11px] font-bold uppercase text-indigo-600 dark:text-indigo-400">🎁 Gratis / Helfer</div>
<div id="statTotalFreeItems" class="text-2xl font-black text-indigo-600 dark:text-indigo-400 mt-1">0 Stk.</div>
<div class="text-[10px] text-slate-400 mt-0.5">Ausgegebene Helfer-Rationen</div>
</div>
<div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
<div class="text-[11px] font-bold uppercase text-slate-500 dark:text-slate-400">Gesamtausgabe</div>
<div id="statTotalAllItems" class="text-2xl font-black text-slate-900 dark:text-slate-100 mt-1">0 Stk.</div>
<div class="text-[10px] text-slate-400 mt-0.5">Bezahlt + Gratis zusammen</div>
</div>
</div>
<!-- Detail-Aufschlüsselung -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<!-- KINDERPUNSCH DETAILS -->
<div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
<h3 class="font-black text-sm text-slate-900 dark:text-slate-100 flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-2">
☕ Kinderpunsch Statistik
</h3>
<div class="space-y-2 text-xs">
<div class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-800/60">
<span class="text-slate-600 dark:text-slate-400">Bezahlt (2,00 €):</span>
<span id="statKinderpunschPaid" class="font-bold text-slate-900 dark:text-slate-100">0 Stk. (0,00 €)</span>
</div>
<div class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-800/60">
<span class="text-indigo-600 dark:text-indigo-400 font-medium">🎁 Helfer (Gratis):</span>
<span id="statKinderpunschFree" class="font-bold text-indigo-600 dark:text-indigo-400">0 Stk.</span>
</div>
<div class="flex justify-between py-1 font-bold pt-1">
<span class="text-slate-800 dark:text-slate-200">Gesamt Tassen:</span>
<span id="statKinderpunschTotal" class="text-amber-600 dark:text-amber-400">0 Stk.</span>
</div>
</div>
</div>
<!-- WAFFELN DETAILS -->
<div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
<h3 class="font-black text-sm text-slate-900 dark:text-slate-100 flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-2">
🧇 Waffeln Statistik
</h3>
<div class="space-y-2 text-xs">
<div class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-800/60">
<span class="text-slate-600 dark:text-slate-400">Bezahlt (2,00 €):</span>
<span id="statWaffelPaid" class="font-bold text-slate-900 dark:text-slate-100">0 Stk. (0,00 €)</span>
</div>
<div class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-800/60">
<span class="text-indigo-600 dark:text-indigo-400 font-medium">🎁 Helfer (Gratis):</span>
<span id="statWaffelFree" class="font-bold text-indigo-600 dark:text-indigo-400">0 Stk.</span>
</div>
<div class="flex justify-between py-1 font-bold pt-1">
<span class="text-slate-800 dark:text-slate-200">Gesamt Waffeln:</span>
<span id="statWaffelTotal" class="text-amber-600 dark:text-amber-400">0 Stk.</span>
</div>
</div>
</div>
</div>
</div>
