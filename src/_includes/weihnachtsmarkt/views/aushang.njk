        <div class="bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl p-4 text-center cursor-pointer hover:opacity-90 transition-opacity" onclick="openLightbox('/images/logo.png', 'Sonntag - Teigspenden')">
