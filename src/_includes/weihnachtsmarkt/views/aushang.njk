      <!-- Samstag: Teigspenden -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">🧇 Teigspenden</h4>
        <div class="bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl p-4 text-center cursor-pointer hover:opacity-90 transition-opacity" onclick="openLightbox('/images/logo.png', 'Samstag - Teigspenden')">
          <img src="/images/logo.png" alt="Samstag Teigspenden Scan" class="max-h-48 mx-auto object-contain rounded-lg mb-2">
