<header class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md sticky top-0 z-40 border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    
    <!-- Logo & Titel (Klick bringt zurück zum Aushang / Startseite) -->
    <div onclick="switchView('aushang')" class="flex items-center gap-3 cursor-pointer select-none">
      <span class="text-2xl">🎄</span>
      <div>
        <h1 class="font-black text-base leading-none text-slate-900 dark:text-slate-100">SG Barnstorf</h1>
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Weihnachtsmarkt Portal</p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <!-- Rolle / Status Badge -->
      <button onclick="switchView('login')" id="roleBadge" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5 cursor-pointer">
        <span id="roleIcon">👁️</span>
        <span id="roleLabel">GAST</span>
      </button>

      <!-- Smart Theme Toggle Button -->
      <button id="themeToggleBtn" onclick="toggleTheme()" class="p-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-xl transition-colors text-sm cursor-pointer" title="Design wechseln">
        <span id="themeToggleIcon">🌙</span>
      </button>

      <!-- Burger Button -->
      <button id="burgerMenuBtn" onclick="toggleBurgerMenu()" class="p-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-xl transition-colors hidden cursor-pointer">
        <span class="text-lg">☰</span>
      </button>
    </div>

  </div>
</header>
