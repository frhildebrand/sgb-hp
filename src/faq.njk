---
layout: base.njk
heading: Häufig gestellte Fragen (FAQ)
---

<div class="container">
  <section class="section">
    <div class="columns is-centered">
      <div class="column is-8">
        <h1 class="title is-1 has-text-centered mb-6">FAQ</h1>

        <!-- Suchfeld: Nur auf dieser Seite vorhanden -->
        <div class="field mb-6">
          <div class="control has-icons-left is-large">
            <input
              class="input is-large"
              type="text"
              id="faqSearchInput"
              aria-label="Fragen und Antworten durchsuchen"
              placeholder="Suchen Sie nach einer Antwort..."
            />
            <span class="icon is-medium is-left">
              <i class="fas fa-search"></i>
            </span>
          </div>
        </div>

        <div id="faqList">
          {% for item in faq %}
            {% include "faq-item.njk" %}
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("faqSearchInput");
    const items = document.querySelectorAll(".faq-item");

    searchInput.addEventListener("input", (e) => {
      const term = e.target.value.toLowerCase();

      items.forEach((item) => {
        const question = item
          .querySelector("summary")
          .textContent.toLowerCase();
        const answer = item.querySelector(".content").textContent.toLowerCase();

        if (question.includes(term) || answer.includes(term)) {
          item.style.display = "block";
        } else {
          item.style.display = "none";
        }
      });
    });
  });
</script>

{% include "lightbox.njk" %}
