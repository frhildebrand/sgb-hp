  function resetSeason() {
    if (confirm("⚠️ Bist du sicher? Das setzt alle Haken (Gepackt), Erledigt-Statusse und Helfer-Namen für das nächste Jahr zurück! Die Gegenstände und Boxen bleiben erhalten.")) {
      itemsData.forEach(item => {
        if (appState[item.id]) {
          appState[item.id].status = 'Offen';
          appState[item.id].assignedTo = '';
