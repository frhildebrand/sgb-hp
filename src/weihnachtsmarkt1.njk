<!-- Tailwind CSS Fallback CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-6xl mx-auto px-2 sm:px-4 py-6 font-sans text-slate-800 print:p-0 print:max-w-none">
  
  <!-- Header -->
  <div class="bg-gradient-to-r from-emerald-50 via-green-100 to-emerald-50 text-slate-900 border border-emerald-200 rounded-2xl p-6 text-center shadow-md mb-6 relative print:hidden">
    
    <!-- Admin & Sync Status -->
    <div class="absolute top-4 right-4 flex items-center gap-2">
      <span id="syncStatus" class="hidden sm:inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-1 rounded-xl bg-white/80 border border-emerald-300 text-emerald-800 shadow-sm">
        🟢 Sync bereit
      </span>
      <button id="adminToggleBtn" onclick="toggleAdminMode()" class="px-3 py-1.5 rounded-xl text-xs font-bold border transition shadow-sm flex items-center gap-1.5 bg-slate-100 text-slate-700 border-slate-300 hover:bg-slate-200">
        🔒 Admin-Modus
      </button>
    </div>

    <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-2 text-emerald-900">🎄 SG Barnstorf – Stand-Planung</h1>
    <p class="text-slate-600 text-sm sm:text-base mb-4 max-w-xl mx-auto">Vorbereitungsliste für Kinderpunsch & Waffelstand am 1. Advent</p>
    
    <!-- Progress Bar -->
    <div class="max-w-xl mx-auto bg-slate-200 rounded-full h-6 border border-slate-300 overflow-hidden relative shadow-inner mb-5">
      <div id="progressBar" class="bg-gradient-to-r from-emerald-500 to-green-600 h-full w-0 transition-all duration-300"></div>
      <div id="progressText" class="absolute inset-0 flex items-center justify-center text-xs sm:text-sm font-bold text-slate-900">0% erledigt</div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap justify-center gap-3">
      <button onclick="openShoppingModal()" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-amber-600 text-white hover:bg-amber-700 transition shadow-sm flex items-center gap-2">
        🛒 Einkaufsliste & Preise
      </button>
      <button onclick="openWiringModal()" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-sky-700 text-white hover:bg-sky-800 transition shadow-sm flex items-center gap-2">
        ⚡ Strom & Kabel-Planer
      </button>
      <button onclick="openStockModal()" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-indigo-700 text-white hover:bg-indigo-800 transition shadow-sm flex items-center gap-2">
        📊 Lagerbestand
      </button>
      <button onclick="openBoxOverview()" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-emerald-700 text-white hover:bg-emerald-800 transition shadow-sm flex items-center gap-2">
        📦 Boxen-Übersicht
      </button>
      <button onclick="window.print()" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-slate-700 text-white hover:bg-slate-800 transition shadow-sm flex items-center gap-2">
        🖨️ Liste drucken
      </button>
    </div>
  </div>

  <!-- Admin Panel Bar (Nur sichtbar im Admin-Modus) -->
  <div id="adminPanel" class="hidden bg-amber-50 border-2 border-amber-300 rounded-2xl p-4 shadow-sm mb-6 print:hidden">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-amber-200 pb-3 mb-3">
      <span class="font-extrabold text-amber-900 text-sm sm:text-base flex items-center gap-2">⚙️ Admin Control-Center</span>
      <div class="flex flex-wrap gap-2">
        <button onclick="openCreateItemModal()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-700 text-white hover:bg-emerald-800 transition">➕ Neuer Gegenstand / Kategorie</button>
        <button onclick="syncIngredientsToShoppingList()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-700 text-white hover:bg-amber-800 transition">🛒 Punsch-Zutaten in Einkaufsliste übernehmen</button>
        <button onclick="exportDataJSON()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-700 text-white hover:bg-slate-800 transition">💾 Backup Herunterladen</button>
        <button onclick="importDataJSON()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-700 text-white hover:bg-slate-800 transition">📂 Backup Einspielen</button>
        <button onclick="changeAdminPassword()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-sky-700 text-white hover:bg-sky-800 transition">🔑 Passwort Ändern</button>
        <button onclick="resetSeason()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-red-600 text-white hover:bg-red-700 transition">🔄 Saison-Reset</button>
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-between text-xs text-amber-800 gap-2">
      <span>Verwaltung aller Artikel, Skalierungen und Systemeinstellungen.</span>
      <a id="sheetLink" href="https://script.google.com/macros/s/AKfycbzm4pz4LD6vwqwkDQXqIypYRVx9m49oliAevZPGolZYm_JKFmWN526TLE-2Z3fGP8tJ/exec" target="_blank" class="font-bold underline text-amber-900 hover:text-amber-700">🔗 Google Sheet Backend öffnen</a>
    </div>
  </div>

  <!-- Helfer- & Teigspenden Aushang Vorschau (ROSHOP) -->
  <div class="bg-amber-50/90 border border-amber-200 rounded-2xl p-4 sm:p-5 shadow-sm mb-6 print:hidden">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-2xl">📌</span>
      <div>
        <h3 class="font-bold text-slate-900 text-sm sm:text-base">Aktueller Aushang bei ROSHOP (Helfer & Teigspenden)</h3>
        <p class="text-xs sm:text-sm text-slate-600">Fotos/Scans der ausgehängten Listen für Samstag und Sonntag:</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-white border border-amber-200 rounded-xl p-3 text-center">
        <span class="font-bold text-xs sm:text-sm text-amber-900 block mb-2">📅 Samstag (1. Adventswochenende)</span>
        <div class="bg-slate-50 border border-slate-100 rounded-lg p-2 flex justify-center items-center overflow-hidden min-h-[220px]">
          <img src="/images/roshop_samstag.jpg" alt="Aushang Samstag" class="max-h-[500px] w-auto object-contain rounded shadow-sm" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'py-12 text-amber-700/70 text-xs italic\'>📷 Noch kein Foto für <b>Samstag</b> hochgeladen.</div>';" />
        </div>
      </div>
      <div class="bg-white border border-amber-200 rounded-xl p-3 text-center">
        <span class="font-bold text-xs sm:text-sm text-amber-900 block mb-2">📅 Sonntag (1. Adventswochenende)</span>
        <div class="bg-slate-50 border border-slate-100 rounded-lg p-2 flex justify-center items-center overflow-hidden min-h-[220px]">
          <img src="/images/roshop_sonntag.jpg" alt="Aushang Sonntag" class="max-h-[500px] w-auto object-contain rounded shadow-sm" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'py-12 text-amber-700/70 text-xs italic\'>📷 Noch kein Foto für <b>Sonntag</b> hochgeladen.</div>';" />
        </div>
      </div>
    </div>
  </div>

  <!-- Rezepte & Punsch-Skalierer -->
  <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm mb-6 print:break-inside-avoid">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3 mb-4">
      <h2 class="text-lg font-bold text-emerald-900 flex items-center gap-2">📜 Stand-Rezepte</h2>
      <div class="flex items-center gap-2 text-xs bg-slate-50 p-2 rounded-xl border border-slate-200">
        <span class="font-bold text-slate-700">Punsch-Mengenrechner:</span>
        <label class="flex items-center gap-1 font-semibold text-red-900">
          Ziel-Menge (Liter):
          <input type="number" id="punschLiters" value="8" min="1" max="200" step="1" onchange="updateRecipeScaling()" class="w-16 border border-slate-300 rounded text-center py-0.5 text-xs font-bold bg-white" />
        </label>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Belgische Waffeln (Fixes Rezept da Spenden) -->
      <div class="bg-emerald-50/50 border border-emerald-100 rounded-xl p-4 text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-bold text-emerald-900 text-sm sm:text-base mb-2"><span>🧇</span> Belgische Waffeln (Rezept pro Spende)</div>
        <p class="text-slate-600 mb-2 text-xs italic">Bitte eine ausreichend große Schüssel benutzen (2l reichen nicht)!</p>
        <ul class="list-disc list-inside space-y-1 text-slate-700 mb-3 font-medium">
          <li><b>5</b> Eier</li>
          <li><b>300 g</b> Zucker</li>
          <li><b>2 Pck.</b> Vanillezucker</li>
          <li><b>2 Prisen</b> Salz</li>
          <li><b>400 g</b> Butter (weich)</li>
          <li><b>500 g</b> Mehl</li>
          <li><b>½ Pck.</b> Backpulver</li>
          <li><b>200 ml</b> Milch</li>
        </ul>
        <div class="border-t border-emerald-200/60 pt-2 text-slate-600 space-y-1 text-[11px]">
          <p><b>Zubereitung:</b></p>
          <p>1. Eier, Zucker, Vanillezucker, Salz verrühren, bis der Zucker aufgelöst & schaumig ist.</p>
          <p>2. Weiche Butter dazu und kurz unterrühren.</p>
          <p>3. Mehl mit Backpulver vermischen und mit Milch zur Masse geben und gut unterrühren.</p>
        </div>
      </div>

      <!-- Winter-Kinderpunsch (Skalierbar) -->
      <div class="bg-red-50/50 border border-red-100 rounded-xl p-4 text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-bold text-red-900 text-sm sm:text-base mb-2"><span>☕</span> Winter-Kinderpunsch (<span id="punschLitersLabel">8 Liter</span>)</div>
        <p class="text-slate-600 mb-2 text-xs italic">Im Einkochautomaten erhitzen – nicht kochen lassen!</p>
        <ul id="punschRecipeList" class="list-disc list-inside space-y-1 text-slate-700 mb-3 font-medium"></ul>
        <div class="border-t border-red-200/60 pt-2 text-slate-600 space-y-1 text-[11px]">
          <p><b>Zubereitung:</b></p>
          <p>1. Tee kochen – ziehen lassen, Beutel raus.</p>
          <p>2. Rest nach und nach zugeben.</p>
          <p>3. Ziehen lassen.</p>
        </div>
      </div>

    </div>
  </div>

  <!-- Verkaufsstatistik, Standgebühr & Live-Gewinn-Rechner -->
  <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm mb-6 print:hidden">
    <h2 class="text-lg font-bold text-slate-900 mb-3 flex items-center gap-2 border-b border-slate-100 pb-2">📈 Verkaufsstatistik & Stand-Kasse</h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-xs sm:text-sm mb-4">
      <div class="bg-slate-50 border border-slate-200 p-3 rounded-xl">
        <label class="block font-bold text-slate-700 mb-1">Verkaufte Tassen Punsch:</label>
        <div class="flex items-center gap-1.5">
          <input type="number" id="soldPunsch" value="0" min="0" onchange="calculateSalesStats()" class="w-16 border border-slate-300 rounded-lg p-1.5 text-center font-bold text-slate-900" />
          <span>x </span>
          <input type="number" step="0.50" id="pricePunsch" value="2.50" onchange="calculateSalesStats()" class="w-16 border border-slate-300 rounded-lg p-1.5 text-right font-bold text-slate-900" /> €
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200 p-3 rounded-xl">
        <label class="block font-bold text-slate-700 mb-1">Verkaufte Waffeln:</label>
        <div class="flex items-center gap-1.5">
          <input type="number" id="soldWaffles" value="0" min="0" onchange="calculateSalesStats()" class="w-16 border border-slate-300 rounded-lg p-1.5 text-center font-bold text-slate-900" />
          <span>x </span>
          <input type="number" step="0.50" id="priceWaffles" value="2.00" onchange="calculateSalesStats()" class="w-16 border border-slate-300 rounded-lg p-1.5 text-right font-bold text-slate-900" /> €
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200 p-3 rounded-xl">
        <label class="block font-bold text-slate-700 mb-1">Standgebühr (Fixkosten):</label>
        <div class="flex items-center gap-1">
          <input type="number" step="1.00" id="standFee" value="0.00" min="0" onchange="calculateSalesStats()" class="w-20 border border-slate-300 rounded-lg p-1.5 text-right font-bold text-slate-900" /> €
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200 p-3 rounded-xl">
        <label class="block font-bold text-slate-700 mb-1">Sonstige Einnahmen/Spenden:</label>
        <div class="flex items-center gap-1">
          <input type="number" step="1.00" id="otherRevenue" value="0.00" onchange="calculateSalesStats()" class="w-20 border border-slate-300 rounded-lg p-1.5 text-right font-bold text-slate-900" /> €
        </div>
      </div>
    </div>

    <!-- Live Kassen-Ergebnis -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center border-t border-slate-100 pt-3">
      <div class="bg-blue-50 border border-blue-200 p-2.5 rounded-xl">
        <span class="block text-xs font-semibold text-blue-800">Gesamteinnahmen (Brutto):</span>
        <span id="statRevenue" class="text-base font-black text-blue-900">0,00 €</span>
      </div>
      <div class="bg-amber-50 border border-amber-200 p-2.5 rounded-xl">
        <span class="block text-xs font-semibold text-amber-800">Gesamtkosten (Einkauf + Standgebühr):</span>
        <span id="statExpenses" class="text-base font-black text-amber-900">0,00 €</span>
      </div>
      <div class="bg-emerald-50 border border-emerald-200 p-2.5 rounded-xl">
        <span class="block text-xs font-semibold text-emerald-800">Reingewinn (SG Jugend):</span>
        <span id="statProfit" class="text-base font-black text-emerald-900">0,00 €</span>
      </div>
    </div>
  </div>

  <!-- Suche & Status-Filter -->
  <div class="space-y-4 mb-8 print:hidden">
    <input type="text" id="searchInput" placeholder="🔍 Gegenstand, Person, Menge oder Box suchen..." 
      class="w-full bg-white border border-slate-300 text-slate-900 placeholder-slate-400 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-emerald-500 transition shadow-sm" />
    
    <div class="flex flex-wrap justify-center gap-2" id="filterContainer">
      <button onclick="setFilter('all', this)" class="filter-btn active px-3.5 py-2 rounded-xl border border-emerald-600 bg-emerald-600 text-white font-bold text-xs sm:text-sm shadow-sm">Alle</button>
      <button onclick="setFilter('Offen', this)" class="filter-btn px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-red-600 font-medium text-xs sm:text-sm hover:border-red-400">Offen</button>
      <button onclick="setFilter('Vorbereitet', this)" class="filter-btn px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-amber-600 font-medium text-xs sm:text-sm hover:border-amber-400">Vorbereitet</button>
      <button onclick="setFilter('Verteilt', this)" class="filter-btn px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-sky-600 font-medium text-xs sm:text-sm hover:border-sky-400">Verteilt</button>
      <button onclick="setFilter('Eingekauft', this)" class="filter-btn px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-emerald-600 font-medium text-xs sm:text-sm hover:border-emerald-400">Eingekauft</button>
      <button onclick="setFilter('Erledigt', this)" class="filter-btn px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-emerald-600 font-medium text-xs sm:text-sm hover:border-emerald-400">Erledigt</button>
    </div>
  </div>

  <!-- Checklist Container -->
  <div id="checklist" class="space-y-8"></div>

</div>

<!-- Modal: Admin Item Erstellen/Bearbeiten -->
<div id="itemModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 print:hidden">
  <div class="bg-white border border-slate-200 rounded-2xl max-w-md w-full p-6 shadow-2xl">
    <h3 id="itemModalTitle" class="text-lg font-bold text-slate-900 mb-4">Gegenstand bearbeiten</h3>
    
    <div class="space-y-4 text-xs sm:text-sm">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Name des Gegenstands:</label>
        <input type="text" id="modalItemTitle" class="w-full border border-slate-300 rounded-xl p-2.5 focus:border-emerald-500 focus:outline-none" />
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Kategorie:</label>
        <select id="modalItemCat" onchange="handleCatSelectChange(this)" class="w-full border border-slate-300 rounded-xl p-2.5 bg-white focus:border-emerald-500 focus:outline-none">
        </select>
        <input type="text" id="modalCustomCat" placeholder="Neue Kategorie eingeben..." class="w-full border border-slate-300 rounded-xl p-2.5 mt-2 hidden focus:border-emerald-500 focus:outline-none" />
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Zusatzdetails / Hinweistext (optional):</label>
        <input type="text" id="modalItemDetails" placeholder="z. B. Verpackungs-Tipp..." class="w-full border border-slate-300 rounded-xl p-2.5 focus:border-emerald-500 focus:outline-none" />
      </div>
    </div>

    <div class="flex justify-end gap-2 mt-6">
      <button onclick="closeItemModal()" class="px-4 py-2 bg-slate-100 text-slate-600 font-bold rounded-xl hover:bg-slate-200 text-xs sm:text-sm">Abbrechen</button>
      <button onclick="saveItemFromModal()" class="px-4 py-2 bg-emerald-700 text-white font-bold rounded-xl hover:bg-emerald-800 text-xs sm:text-sm">Speichern</button>
    </div>
  </div>
</div>

<!-- Modal: Einkaufsliste -->
<div id="shoppingModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 print:hidden">
  <div class="bg-white border border-slate-200 rounded-2xl max-w-5xl w-full max-h-[90vh] flex flex-col shadow-2xl">
    <div class="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between bg-amber-50 rounded-t-2xl">
      <div>
        <h2 class="text-lg font-bold text-amber-900 flex items-center gap-2">🛒 Interaktive Einkaufsliste & Preise</h2>
        <p class="text-xs text-amber-800/80 mt-0.5">Gib Packungsgrößen & Einzelpreise ein. Die Gesamtmenge und Kosten berechnen sich automatisch!</p>
      </div>
      <button onclick="closeShoppingModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">✕</button>
    </div>
    
    <div class="p-4 sm:p-6 overflow-y-auto space-y-4">
      <div class="table-container">
        <table class="w-full text-left text-xs sm:text-sm text-slate-800 border-collapse min-w-[750px]">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500 text-xs uppercase bg-slate-50">
              <th class="py-2.5 px-3 w-[5%] text-center">Gekauft</th>
              <th class="py-2.5 px-3 w-[22%]">Artikel</th>
              <th class="py-2.5 px-2 w-[10%] text-center">Bedarf</th>
              <th class="py-2.5 px-2 w-[12%] text-center">Packungsgröße</th>
              <th class="py-2.5 px-2 w-[12%] text-center font-bold text-amber-900">Anz. Packungen</th>
              <th class="py-2.5 px-2 w-[15%]">Laden / Geschäft</th>
              <th class="py-2.5 px-2 w-[12%] text-right">Preis / Packung</th>
              <th class="py-2.5 px-2 w-[12%] text-right font-bold">Gesamtpreis</th>
            </tr>
          </thead>
          <tbody id="shoppingTableBody" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>

      <div class="flex justify-between items-center gap-4 pt-4 border-t border-slate-200">
        <button onclick="window.print()" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-slate-200 text-slate-700 hover:bg-slate-300">🖨️ Einkaufsliste drucken</button>
        <div class="flex items-center gap-2">
          <span class="text-sm font-bold text-slate-700">Gesamtsumme Einkauf:</span>
          <span id="shoppingTotal" class="text-lg font-black text-emerald-800 bg-emerald-50 px-3 py-1 rounded-lg border border-emerald-200">0,00 €</span>
        </div>
      </div>
    </div>

    <div class="p-4 border-t border-slate-100 text-right bg-slate-50 rounded-b-2xl">
      <button onclick="closeShoppingModal()" class="px-5 py-2 bg-amber-600 text-white font-bold rounded-xl text-xs sm:text-sm hover:bg-amber-700 transition">Schließen</button>
    </div>
  </div>
</div>

<!-- Modal: Strom & Modularer Verkabelungs-Planer -->
<div id="wiringModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 print:hidden">
  <div class="bg-white border border-slate-200 rounded-2xl max-w-6xl w-full max-h-[92vh] flex flex-col shadow-2xl">
    <div class="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between bg-sky-50 rounded-t-2xl">
      <div>
        <h2 class="text-lg font-bold text-sky-900 flex items-center gap-2">⚡ Modularer Strom- & Kabel-Planer (3 Stromeingänge)</h2>
        <p class="text-xs text-sky-700 mt-0.5">Wattzahlen für jedes einzelne Gerät direkt anpassen und per Drag & Drop Verteilen!</p>
      </div>
      <button onclick="closeWiringModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">✕</button>
    </div>

    <div class="p-4 sm:p-6 overflow-y-auto space-y-6 text-xs sm:text-sm">
      
      <!-- Unassigned Pool -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="font-bold text-slate-900 text-sm mb-2 flex items-center gap-2">🔌 Nicht zugewiesene Geräte & Kabel (Hier herausziehen):</h3>
        <div id="unassignedPool" ondragover="allowDrop(event)" ondrop="drop(event, 'unassigned')" class="flex flex-wrap gap-2 min-h-[50px] p-2 bg-white rounded-lg border border-dashed border-slate-300"></div>
      </div>

      <!-- Modular 3 Outlets / Sockets Grid -->
