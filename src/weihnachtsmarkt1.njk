  async function loadStateFromSheet() {
    try {
      const res = await fetch(SCRIPT_URL + '?t=' + new Date().getTime());
      const cloudData = await res.json();
      if (cloudData && Object.keys(cloudData).length > 0) {
        appState = cloudData;
        if (appState.customItemsList && Array.isArray(appState.customItemsList)) {
          itemsData = appState.customItemsList;
        }
        if (appState.adminPassword) adminPassword = appState.adminPassword;
        localStorage.setItem('sg_wm_state_v19', JSON.stringify(appState));
        setSyncStatus(true);
      } else {
        loadFromLocal();
      }
    } catch(e) {
      console.error("Fehler beim Laden:", e);
      loadFromLocal();
      setSyncStatus(false);
    }
    itemsData.forEach(item => initItemState(item));
    renderChecklist();
    updateProgress();
    updateRecipeScaling();
    
