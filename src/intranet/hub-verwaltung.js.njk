      '<span class="ha-ptotal"></span></div>';
    var first = true, lastCat = '';
    var secs = sectionsFor().map(function (sec) {
      var flat = sec.groups.length === 1 && sec.groups[0].title === String(sec.title).replace(/^\S+\s/, '');
      var cards = sec.groups.map(function (g) {
        if (flat) return '<div class="ha-accbody ha-flat">' + g.perms.map(function (q) {
          var on = !!sel[q.key]; var mine = isAdmin || has(q.key); var dis = locked || forcedSet[q.key] || (!mine && !on);
          return '<label class="ha-perm' + (!mine && !locked ? ' nomine' : '') + '"' + (!mine && !locked ? ' title="Dieses Recht hast du selbst nicht und kannst es daher nicht vergeben."' : '') + '><input type="checkbox" class="ha-sw" data-pk="' + esc(q.key) + '"' + (on ? ' checked' : '') + (dis ? ' disabled' : '') + '><span>' + esc(q.label) + '</span></label>';
        }).join('') + '</div>';
        return '<details class="ha-acc"' + (sec.id === 'weihnachtsmarkt' ? '' : ' open') + '><summary><span class="ha-gt">' + esc(g.title) + '</span><span class="ha-cnt"></span>' +
          (locked ? '' : '<span class="ha-gbtn"><button type="button" class="wm-btn" data-pall="on">alle</button><button type="button" class="wm-btn" data-pall="off">keine</button></span>') + '</summary><div class="ha-accbody">' + g.perms.map(function (q) {
          var on = !!sel[q.key]; var mine = isAdmin || has(q.key);
          var dis = locked || forcedSet[q.key] || (!mine && !on);
          return '<label class="ha-perm' + (!mine && !locked ? ' nomine' : '') + '"' + (!mine && !locked ? ' title="Dieses Recht hast du selbst nicht und kannst es daher nicht vergeben."' : '') + '><input type="checkbox" class="ha-sw" data-pk="' + esc(q.key) + '"' + (on ? ' checked' : '') + (dis ? ' disabled' : '') + '><span>' + esc(q.label) + '</span></label>';
        }).join('') + '</div></details>';
      }).join('');
      var o = false; first = false; var ch = sec.cat !== lastCat ? '<div class="ha-cat ha-cat-' + esc(sec.cat.replace(/\s+/g, '')) + '">' + esc(sec.cat) + '</div>' : ''; lastCat = sec.cat;
      return ch + '<details class="ha-sysacc ha-c-' + esc(String(sec.cat).replace(/\s+/g, '')) + '"' + (o ? ' open' : '') + ' data-sys="' + sec.id + '"><summary><span class="ha-st">' + esc(sec.title) + '</span><span class="ha-ptc"></span>' +
        (locked || !sec.groups.length ? '' : '<span class="ha-gbtn"><button type="button" class="wm-btn" data-pall="on">alle</button><button type="button" class="wm-btn" data-pall="off">keine</button></span>') + '</summary><div class="ha-sysbody">' +
        (sec.hint ? '<p class="ha-hint">' + esc(sec.hint) + '</p>' : '') + (cards ? (flat ? cards : '<div class="ha-grid">' + cards + '</div>') : '<p class="ha-hint">' + esc(sec.empty || 'Keine Rechte.') + '</p>') + '</div></details>';
    }).join('');
    return bar + secs;
  }
  function permCount(scope) {
    var all = scope.querySelectorAll('input[data-pk]'); var n = 0;
    Array.prototype.forEach.call(all, function (i) { if (i.checked) n++; });
    return [n, all.length];
  }
  function permRefresh() {
    Array.prototype.forEach.call(root.querySelectorAll('details.ha-acc'), function (det) { var c = permCount(det); var e = det.querySelector('.ha-cnt'); if (e) e.textContent = c[0] + ' von ' + c[1]; });
    Array.prototype.forEach.call(root.querySelectorAll('details.ha-sysacc'), function (det) { var c = permCount(det); var e = det.querySelector('.ha-ptc'); if (e) e.textContent = c[1] ? c[0] + ' von ' + c[1] : ''; });
    var dlg = root.querySelector('.ha-dialog'); var t = root.querySelector('.ha-ptotal');
    if (dlg && t) { var c2 = permCount(dlg); t.textContent = 'Gesamt ' + c2[0] + ' von ' + c2[1]; }
  }
