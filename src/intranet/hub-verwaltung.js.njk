    var TIT = { training: '🦈 Gruppen (Wettkampfgruppe)', auswertung: '📈 Jahresauswertung', hub: '🌐 Menü: wer welchen Bereich sieht' };
    var ORD = [['Startseite', ['brett']], ['Wettkampf', ['wettkaempfe', 'auswertung']], ['Training', ['training', 'trainer', 'anwesenheit']], ['Verein', ['mitglieder', 'jugend', 'vorstand', 'dokumente']], ['Organisation', ['aufgaben', 'abrechnung', 'material']], ['Aktionen', ['veranstaltungen', 'weihnachtsmarkt']], ['Verwaltung', ['hub']]];
    var res = [], used = {};
    ORD.forEach(function (c) { c[1].forEach(function (id) { var x = byId[id]; if (!x) return; used[id] = 1; if (TIT[id]) x.title = TIT[id]; x.cat = c[0]; res.push(x); }); });
    out.forEach(function (x) { if (byId[x.id] && !used[x.id]) { x.cat = 'Weitere'; res.push(x); } });
    return res;
  }
  function permGrid(d, key, value, locked, forced) {
    var sel = {}; (value || []).forEach(function (k) { sel[k] = true; }); (forced || []).forEach(function (k) { sel[k] = true; });
    var forcedSet = {}; (forced || []).forEach(function (k) { forcedSet[k] = true; });
    var isAdmin = !!(S.me && S.me.roles && S.me.roles.some(function (r) { return r.id === 'admin'; }));
    var presets = S.roles.map(function (r) { return '<option value="' + esc(r.id) + '">' + esc(r.name) + '</option>'; }).join('');
    var bar = '<div class="ha-ptool"><input type="search" class="ha-psearch" placeholder="🔎 Recht suchen …" data-psearch="1" autocomplete="off">' +
