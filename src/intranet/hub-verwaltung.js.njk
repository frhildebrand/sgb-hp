        }).join('') + '</div>';
        return '<details class="ha-acc" open><summary><span class="ha-gt">' + esc(g.title) + '</span><span class="ha-cnt"></span>' +
          (locked ? '' : '<span class="ha-gbtn"><button type="button" class="wm-btn" data-pall="on">alle</button><button type="button" class="wm-btn" data-pall="off">keine</button></span>') + '</summary><div class="ha-accbody">' + g.perms.map(function (q) {
          var on = !!sel[q.key]; var mine = isAdmin || has(q.key);
          var dis = locked || forcedSet[q.key] || (!mine && !on);
          return '<label class="ha-perm' + (!mine && !locked ? ' nomine' : '') + '"' + (!mine && !locked ? ' title="Dieses Recht hast du selbst nicht und kannst es daher nicht vergeben."' : '') + '><input type="checkbox" class="ha-sw" data-pk="' + esc(q.key) + '"' + (on ? ' checked' : '') + (dis ? ' disabled' : '') + '><span>' + esc(q.label) + '</span></label>';
        }).join('') + '</div></details>';
      }).join('');
      var o = false; first = false; var ch = sec.cat !== lastCat ? '<div class="ha-cat ha-cat-' + esc(sec.cat.replace(/\s+/g, '')) + '">' + esc(sec.cat) + '</div>' : ''; lastCat = sec.cat;
      return ch + '<details class="ha-sysacc ha-c-' + esc(String(sec.cat).replace(/\s+/g, '')) + '"' + (o ? ' open' : '') + ' data-sys="' + sec.id + '"><summary><span class="ha-st">' + esc(sec.title) + '</span><span class="ha-ptc"></span>' +
        (locked || !sec.groups.length ? '' : '<span class="ha-gbtn"><button type="button" class="wm-btn" data-pall="on">alle</button><button type="button" class="wm-btn" data-pall="off">keine</button></span>') + '</summary><div class="ha-sysbody">' +
        (sec.hint ? '<p class="ha-hint">' + esc(sec.hint) + '</p>' : '') + (cards ? (flat ? cards : '<div class="ha-grid">' + cards + '</div>') : '<p class="ha-hint">' + esc(sec.empty || 'Keine Rechte.') + '</p>') + '</div></details>';
    }).join('');
