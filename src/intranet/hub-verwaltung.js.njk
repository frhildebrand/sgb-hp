    var out = defs.map(function (d) { return { id: d.id, title: d.title, hint: d.hint, groups: [], empty: 'Für diesen Bereich gibt es keine eigenen Rechte.' }; });
    var verw = { title: 'Verwaltung', perms: [] };
    S.catalog.groups.forEach(function (g) {
      var sec = out.filter(function (x) { return x.id === g.system; })[0]; if (!sec) return;
      if (g.system === 'hub') { sec.groups.push({ title: 'Seiten im Hub', perms: g.perms }); return; }
      var keep = [];
      g.perms.forEach(function (q) { if (HUB_KEYS.indexOf(q.key) >= 0) verw.perms.push(q); else keep.push(q); });
      if (keep.length) { var single = g.title === sec.title.replace(/^\S+\s/, '') || out.filter(function (x) { return x.id === g.system; }).length && S.catalog.groups.filter(function (z) { return z.system === g.system; }).length === 1; splitCats(g.system, g.title, keep, single).forEach(function (x) { sec.groups.push(x); }); }
