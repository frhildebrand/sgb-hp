  function splitCats(sysId, title, perms, single) {
    var defs = SUBCATS[sysId]; if (!defs || perms.length < 3) return [{ title: title, perms: perms }];
    var by = {}, order = [], rest = [];
    perms.forEach(function (q) {
      var hit = defs.filter(function (d) { return d[1].test(q.key); })[0];
      if (!hit) { rest.push(q); return; } if (!by[hit[0]]) { by[hit[0]] = []; order.push(hit[0]); } by[hit[0]].push(q);
    });
    var out = defs.map(function (d) { return d[0]; }).filter(function (n) { return by[n]; }).map(function (n) { return { title: (single ? '' : title + ' · ') + n, perms: by[n] }; });
    if (rest.length) out.push({ title: (single ? '' : title + ' · ') + 'Weitere', perms: rest });
    return out.length > 1 ? out : [{ title: title, perms: perms }];
  }
  function sectionsFor() {
