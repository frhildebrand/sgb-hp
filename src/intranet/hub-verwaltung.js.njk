    jugend: [['Übersicht', /^jugend\.kasse\.(view|print)$/], ['Buchungen', /^jugend\.kasse\.(buchen|bestaetigen)$/], ['Verwaltung', /^jugend\.kasse\.verwalten$/]],
    abrechnung: [['Eigene Abrechnungen', /^abrechnung\.eigene$/], ['Alle Abrechnungen', /^abrechnung\.(alle|ansehen|bezahlen)$/], ['Einstellungen', /^abrechnung\.saetze$/]],
