  var HUB_KEYS = ['system.users', 'system.roles', 'system.rechte', 'system.passwords', 'account.password'];
  // Rechte eines Systems in Kategorien aufteilen (Übersicht, Training, Mitglieder …); Unbekanntes landet unter „Weitere“
  var SUBCATS = {
    aufgaben: [['Übersicht', /^aufgaben\.(view|own)$/], ['Anlegen und bearbeiten', /^aufgaben\.(edit|anlegen|loeschen)$/]],
    wettkaempfe: [['Übersicht', /^wettkaempfe\.(view|print|artikel)$/], ['Anlegen und verwalten', /^wettkaempfe\.(import|anlegen|loeschen)$/], ['Vorbereitung und Meldung', /^wettkaempfe\.(check|teilnahme|krzahl|meldegeld|kampfgericht)$/], ['Wettkampftag', /^wettkaempfe\.(zeiten|vorort)$/]],
