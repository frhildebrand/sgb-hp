        return Promise.all([get('roles'), get('catalog'), get('users')]).then(function (res) {
          if (!res[0] || !res[1]) { SH.DIAG.push('Verwaltung: ' + (!res[0] ? 'roles' : 'catalog') + ' ohne Antwort'); S.offline = true; S.loaded = true; render(); return; }
          applyAll({ me: S.me, systems: SH.S.systems, roles: res[0].roles, catalog: res[1], users: res[2] && res[2].users, extras: res[2] && res[2].extras });
