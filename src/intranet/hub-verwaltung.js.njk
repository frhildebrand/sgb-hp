/* Verwaltung im Hub: Benutzer, Rollen und Sonderrechte für alle Systeme.
   Oben stehen die Schalter für die Systeme, darunter die Rechte je System. */
(function () {
  'use strict';
  var root = document.getElementById('hubRoot');
  if (!root) return;
  var SH = window.HubShell;
  if (!SH) { root.textContent = 'Der Grundbaustein hub-common.js fehlt.'; return; }
  var HUB_URL = '/intranet/';
  var S = { me: null, roles: [], users: [], extras: [], catalog: null, tab: 'benutzer', loaded: false, offline: false, dialog: null, msg: '' };
  var esc = SH.esc;
  function token() { return SH.token(); }
  function get(a, p) { return SH.get(a, p); }
  function post(o) { return SH.post(o); }
  function has(p) { return !!(S.me && S.me.perms && S.me.perms.indexOf(p) >= 0); }
  function canAny(list) { return list.some(has); }
  var CAN_ENTER = ['system.users', 'system.roles', 'system.rechte', 'system.passwords'];

  function sortRoles(r) { return (r || []).slice(); }
  function roleName(id) { var r = S.roles.filter(function (x) { return x.id === id; })[0]; return r ? r.name : id; }
  function allPermKeys() { return S.catalog ? S.catalog.groups.reduce(function (a, g) { return a.concat(g.perms.map(function (q) { return q.key; })); }, []) : []; }

  // Alles in EINER Abfrage (Konto, Rollen, Katalog, Benutzer). Der letzte Stand liegt im Browser und erscheint sofort.
  function applyAll(r) {
    S.me = r.me; SH.S.me = r.me; SH.S.systems = r.systems || []; SH.S.offline = false;
    S.offline = false; S.roles = sortRoles(r.roles); S.catalog = r.catalog;
    S.users = Array.isArray(r.users) ? r.users : []; S.extras = Array.isArray(r.extras) ? r.extras : [];
  }
  function saveCache() { SH.lsSet('verwcache', { token: token(), data: { me: S.me, systems: SH.S.systems, roles: S.roles, catalog: S.catalog, users: S.users, extras: S.extras } }); }
  function load() {
    var c = SH.lsGet('verwcache', null);
    var fast = !!(token() && c && c.token === token() && c.data && c.data.me && c.data.catalog);
    if (fast) applyAll(c.data);
    S.loaded = fast; render();
    var legacy = function () {
      return SH.loadAccount().then(function () {
        S.me = SH.S.me;
        if (SH.S.offline) { S.offline = true; S.loaded = true; render(); return null; }
        if (!S.me) { S.loaded = true; render(); return null; }
        return Promise.all([get('roles'), get('catalog'), get('users')]).then(function (res) {
          if (!res[0] || !res[1]) { SH.DIAG.push('Verwaltung: ' + (!res[0] ? 'roles' : 'catalog') + ' ohne Antwort'); S.offline = true; S.loaded = true; render(); return; }
          applyAll({ me: S.me, systems: SH.S.systems, roles: res[0].roles, catalog: res[1], users: res[2] && res[2].users, extras: res[2] && res[2].extras });
          S.loaded = true; saveCache(); render();
        });
      });
    };
    if (!token()) return legacy();
    SH.DIAG.length = 0;
    return get('verwaltung').then(function (r) {
      if (r && r.status === 'success' && r.catalog) { applyAll(r); S.loaded = true; saveCache(); render(); return; }
      if (fast && !(r && r.code === 'auth')) { S.loaded = true; render(); return; }   // alter Stand bleibt sichtbar
      return legacy();
    });
  }
  function access(ops) {
    return post({ action: 'accessOps', token: token(), ops: ops }).then(function (r) {
      if (!r) { S.msg = 'Keine Verbindung. Änderungen brauchen Internet.'; render(); return null; }
      if (r.code === 'auth') { S.msg = 'Die Anmeldung ist abgelaufen. Bitte im Hub neu anmelden.'; render(); return null; }
      if (Array.isArray(r.roles)) S.roles = sortRoles(r.roles);
      if (Array.isArray(r.users)) S.users = r.users;
      if (Array.isArray(r.extras)) S.extras = r.extras;
      S.msg = r.errors && r.errors.length ? r.errors.join(' ') : '';
      saveCache(); render(); return r;
    });
  }

  // ---------- Dialoge ----------
  // Rechte: oben Werkzeugleiste (Suche, Vorlage, alle an/aus), darunter je System ein ausklappbarer Bereich
  // (Intranet, Weihnachtsmarkt, Jugend) mit den Rechte-Gruppen. Nur Rechte, die man selbst hat, lassen sich vergeben.
  var HUB_KEYS = ['system.users', 'system.roles', 'system.rechte', 'system.passwords', 'account.password'];
  function sectionsFor() {
    var defs = S.catalog.sections && S.catalog.sections.length ? S.catalog.sections : [{ id: 'hub', title: '🌐 Intranet', hint: 'Welche Seiten im Hub erscheinen und wer Benutzer, Rollen und Rechte verwalten darf.' }, { id: 'weihnachtsmarkt', title: '🎄 Weihnachtsmarkt' }, { id: 'jugend', title: '🏊 Jugend' }];
    var out = defs.map(function (d) { return { id: d.id, title: d.title, hint: d.hint, groups: [], empty: 'Für diesen Bereich gibt es keine eigenen Rechte.' }; });
    var verw = { title: 'Verwaltung', perms: [] };
    S.catalog.groups.forEach(function (g) {
      var sec = out.filter(function (x) { return x.id === g.system; })[0]; if (!sec) return;
      if (g.system === 'hub') { sec.groups.push({ title: 'Seiten im Hub', perms: g.perms }); return; }
      var keep = [];
      g.perms.forEach(function (q) { if (HUB_KEYS.indexOf(q.key) >= 0) verw.perms.push(q); else keep.push(q); });
      if (keep.length) sec.groups.push({ title: g.title, perms: keep });
    });
    if (verw.perms.length) out[0].groups.push(verw);
    return out;
  }
  function permGrid(d, key, value, locked, forced) {
    var sel = {}; (value || []).forEach(function (k) { sel[k] = true; }); (forced || []).forEach(function (k) { sel[k] = true; });
    var forcedSet = {}; (forced || []).forEach(function (k) { forcedSet[k] = true; });
    var isAdmin = !!(S.me && S.me.roles && S.me.roles.some(function (r) { return r.id === 'admin'; }));
    var presets = S.roles.map(function (r) { return '<option value="' + esc(r.id) + '">' + esc(r.name) + '</option>'; }).join('');
    var bar = '<div class="ha-ptool"><input type="search" class="ha-psearch" placeholder="🔎 Recht suchen …" data-psearch="1" autocomplete="off">' +
      (locked ? '' : '<select class="ha-ppreset" data-ppreset="1"><option value="">Vorlage übernehmen …</option>' + presets + '</select><button type="button" class="wm-btn" data-pgall="on">✓ Alle an</button><button type="button" class="wm-btn" data-pgall="off">✗ Alle aus</button>') +
      '<span class="ha-ptotal"></span></div>';
    var first = true;
    var secs = sectionsFor().map(function (sec) {
      var cards = sec.groups.map(function (g) {
        return '<details class="ha-acc" open><summary><span class="ha-gt">' + esc(g.title) + '</span><span class="ha-cnt"></span>' +
          (locked ? '' : '<span class="ha-gbtn"><button type="button" class="wm-btn" data-pall="on">alle</button><button type="button" class="wm-btn" data-pall="off">keine</button></span>') + '</summary><div class="ha-accbody">' + g.perms.map(function (q) {
          var on = !!sel[q.key]; var mine = isAdmin || has(q.key);
          var dis = locked || forcedSet[q.key] || (!mine && !on);
          return '<label class="ha-perm' + (!mine && !locked ? ' nomine' : '') + '"' + (!mine && !locked ? ' title="Dieses Recht hast du selbst nicht und kannst es daher nicht vergeben."' : '') + '><input type="checkbox" class="ha-sw" data-pk="' + esc(q.key) + '"' + (on ? ' checked' : '') + (dis ? ' disabled' : '') + '><span>' + esc(q.label) + '</span></label>';
        }).join('') + '</div></details>';
      }).join('');
      var o = first; first = false;
      return '<details class="ha-sysacc"' + (o ? ' open' : '') + ' data-sys="' + sec.id + '"><summary><span class="ha-st">' + esc(sec.title) + '</span><span class="ha-ptc"></span>' +
        (locked || !sec.groups.length ? '' : '<span class="ha-gbtn"><button type="button" class="wm-btn" data-pall="on">alle</button><button type="button" class="wm-btn" data-pall="off">keine</button></span>') + '</summary><div class="ha-sysbody">' +
        (sec.hint ? '<p class="ha-hint">' + esc(sec.hint) + '</p>' : '') + (cards ? '<div class="ha-grid">' + cards + '</div>' : '<p class="ha-hint">' + esc(sec.empty || 'Keine Rechte.') + '</p>') + '</div></details>';
    }).join('');
    return bar + secs;
  }
  function permCount(scope) {
    var all = scope.querySelectorAll('input[data-pk]'); var n = 0;
    Array.prototype.forEach.call(all, function (i) { if (i.checked) n++; });
    return [n, all.length];
  }
  function permRefresh() {
    Array.prototype.forEach.call(root.querySelectorAll('details.ha-acc'), function (det) { var c = permCount(det); var e = det.querySelector('.ha-cnt'); if (e) e.textContent = c[0] + ' von ' + c[1]; });
    Array.prototype.forEach.call(root.querySelectorAll('details.ha-sysacc'), function (det) { var c = permCount(det); var e = det.querySelector('.ha-ptc'); if (e) e.textContent = c[1] ? c[0] + ' von ' + c[1] : ''; });
    var dlg = root.querySelector('.ha-dialog'); var t = root.querySelector('.ha-ptotal');
    if (dlg && t) { var c2 = permCount(dlg); t.textContent = 'Gesamt ' + c2[0] + ' von ' + c2[1]; }
  }
  function permSet(scope, on) {
    Array.prototype.forEach.call(scope.querySelectorAll('input[data-pk]'), function (i) { if (!i.disabled) i.checked = on; });
    permRefresh();
  }
  function openDialog(cfg) { S.dialog = cfg; render(); }
  function closeDialog() { S.dialog = null; render(); }
  function dialogHtml() {
    var d = S.dialog; if (!d) return '';
    var body = d.fields.map(function (f) {
      if (f.type === 'text' || f.type === 'password') return '<label class="ha-f"><span>' + esc(f.label) + '</span><input name="' + esc(f.key) + '" type="text" value="' + esc(f.value || '') + '"' + (f.maxlength ? ' maxlength="' + f.maxlength + '"' : '') + (f.placeholder ? ' placeholder="' + esc(f.placeholder) + '"' : '') + ' autocomplete="off">' + (f.hint ? '<small>' + esc(f.hint) + '</small>' : '') + '</label>';
      if (f.type === 'checkbox') return '<label class="ha-f ha-row"><input name="' + esc(f.key) + '" type="checkbox"' + (f.value ? ' checked' : '') + '> <span>' + esc(f.label) + '</span></label>';
      if (f.type === 'checklist') return '<div class="ha-f"><span>' + esc(f.label) + '</span><div class="ha-checks">' + (f.options.length ? f.options.map(function (o) { return '<label class="ha-perm"><input type="checkbox" data-cl="' + esc(f.key) + '" value="' + esc(o.value) + '"' + ((f.value || []).indexOf(o.value) >= 0 ? ' checked' : '') + '> <span>' + esc(o.label) + (o.hint ? ' <small>' + esc(o.hint) + '</small>' : '') + '</span></label>'; }).join('') : '<small>' + esc(f.empty || 'Nichts vorhanden.') + '</small>') + '</div></div>';
      if (f.type === 'permissions') return '<div class="ha-f"><span>' + esc(f.label) + '</span>' + (f.note ? '<small>' + esc(f.note) + '</small>' : '') + permGrid(d, f.key, f.value, f.locked, f.forced) + '</div>';
      return '';
    }).join('');
    var extra = (d.extra || []).map(function (e) { return '<button type="button" class="hub-btn ' + (e.danger ? 'ha-danger' : 'hub-ghost') + '" data-dx="' + esc(e.value) + '">' + esc(e.text) + '</button>'; }).join('');
    return '<div class="ha-overlay"><form class="ha-dialog" data-dlg="1"><h3>' + esc(d.title) + '</h3>' + (d.error ? '<div class="hub-err">' + esc(d.error) + '</div>' : '') + '<div class="ha-body">' + body + '</div><div class="ha-actions"><span class="ha-extra">' + extra + '</span><button type="button" class="hub-btn hub-ghost" data-dx="cancel">Abbrechen</button><button type="submit" class="hub-btn hub-gold">Speichern</button></div></form></div>';
  }
  function readDialog() {
    var f = root.querySelector('form[data-dlg]'); var out = {};
    S.dialog.fields.forEach(function (fld) {
      if (fld.type === 'text' || fld.type === 'password') out[fld.key] = f.elements[fld.key].value;
      else if (fld.type === 'checkbox') out[fld.key] = f.elements[fld.key].checked;
      else if (fld.type === 'checklist') out[fld.key] = Array.prototype.slice.call(f.querySelectorAll('input[data-cl="' + fld.key + '"]:checked')).map(function (i) { return i.value; });
      else if (fld.type === 'permissions') out[fld.key] = Array.prototype.slice.call(f.querySelectorAll('input[data-pk]')).filter(function (i) { return i.checked || i.disabled && i.checked; }).map(function (i) { return i.getAttribute('data-pk'); });
    });
    return out;
  }
  function confirmBox(title, message, okText) {
    return new Promise(function (res) { S.dialog = { confirm: true, title: title, message: message, ok: okText || 'OK', done: res }; render(); });
  }

  function roleDialog(id, copyFrom) {
    var role = id ? S.roles.filter(function (r) { return r.id === id; })[0] : null;
    var src = role || (copyFrom ? S.roles.filter(function (r) { return r.id === copyFrom; })[0] : null);
    var isAdmin = !!role && role.id === 'admin';
    var locked = !has('system.rechte');
    var fields = [
      { key: 'name', label: 'Name', type: 'text', value: role ? role.name : (src ? 'Kopie von ' + src.name : ''), maxlength: 40 },
      { key: 'desc', label: 'Beschreibung', type: 'text', value: src ? src.desc : '', maxlength: 120 }
    ];
    if (!role || role.id !== 'gast') fields.push({ key: 'password', label: role ? 'Neues Passwort (leer lassen = unverändert)' : 'Passwort', type: 'text', value: '', hint: role ? 'Mindestens 4 Zeichen.' : 'Mindestens 4 Zeichen. Ohne Passwort ist keine Anmeldung mit dieser Rolle möglich.' });
    fields.push({ key: 'perms', label: 'Rechte', type: 'permissions', value: src ? src.perms : [], locked: locked, forced: isAdmin ? S.catalog.core : [], note: isAdmin ? 'Die Rechte zur Verwaltung von Rollen, Benutzern und Passwörtern bleiben beim Administrator immer an.' : '' });
    var extra = [];
    if (role && !role.builtin && has('system.roles')) extra.push({ text: 'Rolle löschen', value: 'delete', danger: true });
    if (role && role.id !== 'gast' && has('system.roles')) extra.push({ text: 'Überall abmelden', value: 'logoutAll' });
    if (role && role.id !== 'gast' && role.id !== 'admin' && role.hasPw && has('system.passwords')) extra.push({ text: 'Rollen-Anmeldung abschalten', value: 'clearPw' });
    openDialog({ title: role ? 'Rolle bearbeiten: ' + role.name : (src ? 'Rolle kopieren: ' + src.name : 'Neue Rolle'), fields: fields, extra: extra, wide: true, submit: function (v) {
      var name = String(v.name || '').trim(); if (!name) return 'Bitte einen Namen eingeben.';
      var pw = String(v.password || '').trim(); if (pw && pw.length < 4) return 'Das Passwort braucht mindestens 4 Zeichen.';
      var op = { op: 'saveRole', role: { id: role ? role.id : undefined, name: has('system.roles') ? name : role.name, desc: has('system.roles') ? String(v.desc || '').trim() : role.desc, perms: locked ? role.perms : v.perms } };
      if (pw) op.password = pw;
      return access([op]);
    }, action: function (a) {
      if (a === 'delete') { var n = S.users.filter(function (u) { return (u.roles || []).indexOf(role.id) >= 0; }).length; return confirmBox('Rolle löschen?', role.name + ' wird gelöscht.' + (n ? ' ' + n + ' Benutzer verlieren diese Rolle.' : ''), 'Löschen').then(function (ok) { return ok ? access([{ op: 'delRole', id: role.id }]) : null; }); }
      if (a === 'logoutAll') return confirmBox('Überall abmelden?', 'Alle, die sich mit dem Passwort der Rolle ' + role.name + ' angemeldet haben, werden abgemeldet.', 'Abmelden').then(function (ok) { return ok ? access([{ op: 'logoutRole', id: role.id }]) : null; });
      if (a === 'clearPw') return confirmBox('Rollen-Anmeldung abschalten?', 'Mit ' + role.name + ' kann sich danach niemand mehr mit einem Rollen-Passwort anmelden.', 'Abschalten').then(function (ok) { return ok ? access([{ op: 'saveRole', role: { id: role.id, name: role.name, desc: role.desc, perms: role.perms }, clearPassword: true }]) : null; });
    } });
  }
  function userDialog(id) {
    var u = id ? S.users.filter(function (x) { return x.id === id; })[0] : null;
    var fields = [
      { key: 'name', label: 'Benutzername', type: 'text', value: u ? u.name : '', maxlength: 40 },
      { key: 'roles', label: 'Rollen (eine oder mehrere)', type: 'checklist', options: S.roles.map(function (r) { return { value: r.id, label: r.name, hint: r.desc || '' }; }), value: u ? u.roles : (S.roles.some(function (r) { return r.id === 'helfer'; }) ? ['helfer'] : []) },
      { key: 'extras', label: 'Sonderrechte (zusätzlich zu den Rollen)', type: 'checklist', options: S.extras.map(function (x) { return { value: x.id, label: x.name, hint: x.desc || '' }; }), value: u ? u.extras : [], empty: 'Noch keine Sonderrechte angelegt.' }
    ];
    if (!u || has('system.passwords')) fields.push({ key: 'password', label: u ? 'Neues Passwort (leer lassen = unverändert)' : 'Passwort', type: 'text', value: '', hint: 'Mindestens 4 Zeichen.' });
    if (u) fields.push({ key: 'disabled', label: 'Konto sperren (Anmeldung nicht mehr möglich, der Benutzer bleibt erhalten)', type: 'checkbox', value: !!u.disabled });
    var extra = u ? [{ text: 'Benutzer löschen', value: 'delete', danger: true }, { text: 'Überall abmelden', value: 'logoutAll' }] : [];
    openDialog({ title: u ? 'Benutzer bearbeiten' : 'Neuer Benutzer', fields: fields, extra: extra, submit: function (v) {
      var name = String(v.name || '').trim(); if (!name) return 'Bitte einen Benutzernamen eingeben.';
      if (!v.roles.length) return 'Bitte mindestens eine Rolle wählen.';
      var pw = String(v.password || '').trim(); if ((!u && pw.length < 4) || (pw && pw.length < 4)) return 'Das Passwort braucht mindestens 4 Zeichen.';
      var op = { op: 'saveUser', user: { id: u ? u.id : undefined, name: name, roles: v.roles, extras: v.extras } };
      if (u) op.user.disabled = !!v.disabled; if (pw) op.password = pw;
      return access([op]);
    }, action: function (a) {
      if (a === 'delete') return confirmBox('Benutzer löschen?', u.name + ' wird gelöscht und überall abgemeldet.', 'Löschen').then(function (ok) { return ok ? access([{ op: 'delUser', id: u.id }]) : null; });
      if (a === 'logoutAll') return confirmBox('Überall abmelden?', u.name + ' wird auf allen Geräten abgemeldet und muss sich neu anmelden.', 'Abmelden').then(function (ok) { return ok ? access([{ op: 'logoutUser', id: u.id }]) : null; });
    } });
  }
  function extraDialog(id) {
    var x = id ? S.extras.filter(function (e) { return e.id === id; })[0] : null;
    openDialog({ title: x ? 'Sonderrecht bearbeiten: ' + x.name : 'Neues Sonderrecht', wide: true, fields: [
      { key: 'name', label: 'Name des Sonderrechts', type: 'text', value: x ? x.name : '', maxlength: 40, placeholder: 'z. B. Statistik bearbeiten' },
      { key: 'desc', label: 'Beschreibung', type: 'text', value: x ? x.desc : '', maxlength: 120 },
      { key: 'perms', label: 'Rechte, die dieses Sonderrecht zusätzlich gibt', type: 'permissions', value: x ? x.perms : [] }
    ], extra: x ? [{ text: 'Sonderrecht löschen', value: 'delete', danger: true }] : [], submit: function (v) {
      var name = String(v.name || '').trim(); if (!name) return 'Bitte einen Namen eingeben.';
      return access([{ op: 'saveExtra', extra: { id: x ? x.id : undefined, name: name, desc: String(v.desc || '').trim(), perms: v.perms } }]);
    }, action: function (a) {
      if (a === 'delete') { var n = S.users.filter(function (u) { return (u.extras || []).indexOf(x.id) >= 0; }).length; return confirmBox('Sonderrecht löschen?', x.name + ' wird gelöscht.' + (n ? ' ' + n + ' Benutzer verlieren dieses Recht.' : ''), 'Löschen').then(function (ok) { return ok ? access([{ op: 'delExtra', id: x.id }]) : null; }); }
    } });
  }

  // ---------- Anzeige ----------
  function sysBadges(perms) {
    var secs = S.catalog && S.catalog.sections ? S.catalog.sections : [{ id: 'weihnachtsmarkt', title: '🎄 Weihnachtsmarkt' }, { id: 'jugend', title: '🏊 Jugend' }];
    return secs.filter(function (x) { return x.id !== 'hub' && (perms || []).indexOf('hub.' + x.id) >= 0; }).map(function (x) { return '<span class="ha-badge">' + esc(x.title) + '</span>'; }).join('');
  }
  function when(t) { if (!t) return 'noch nie angemeldet'; var m = Math.round((Date.now() - Number(t)) / 60000); return m < 2 ? 'zuletzt angemeldet gerade eben' : m < 120 ? 'zuletzt angemeldet vor ' + m + ' Min.' : m < 2880 ? 'zuletzt angemeldet vor ' + Math.round(m / 60) + ' Std.' : 'zuletzt angemeldet vor ' + Math.round(m / 1440) + ' Tagen'; }
  function roleIcon(id) { return { admin: '👑', orga: '🧭', helfer: '🙋', gast: '👁️' }[id] || '🛡️'; }
  function usersHtml() {
    if (!S.users.length) return '<p class="wm-note">Noch keine Benutzer. Ohne Benutzer meldet man sich mit dem Passwort der Rolle an.</p>';
    return S.users.map(function (u) {
      var ex = (u.extras || []).map(function (id) { var x = S.extras.filter(function (e) { return e.id === id; })[0]; return x ? x.name : null; }).filter(Boolean);
      return '<div class="wm-row' + (u.disabled ? ' off' : '') + '"><span class="wm-ic">' + (u.disabled ? '🚫' : '👤') + '</span><div class="wm-main"><div class="wm-name">' + esc(u.name) + (u.disabled ? ' <span class="wm-lock">gesperrt</span>' : '') + '</div><div class="wm-sub">' + esc((u.roles || []).map(roleName).join(' + ') || 'keine Rolle') + (ex.length ? ' · ✨ ' + esc(ex.join(', ')) : '') + ' · ' + esc(when(u.last)) + '</div></div>' +
        (has('system.users') ? '<button type="button" class="wm-btn" data-ed="user" data-id="' + esc(u.id) + '">✏️ Bearbeiten</button>' : '') + '</div>';
    }).join('');
  }
  function rolesHtml() {
    var total = allPermKeys().length;
    return S.roles.map(function (r, i, all) {
      var n = (r.perms || []).filter(function (k) { return allPermKeys().indexOf(k) >= 0; }).length;
      var mv = has('system.roles') ? '<span class="wm-nowrap"><button type="button" class="wm-btn" data-mv="-1" data-id="' + esc(r.id) + '" title="Höher einstufen"' + (i === 0 ? ' disabled' : '') + '>▲</button> <button type="button" class="wm-btn" data-mv="1" data-id="' + esc(r.id) + '" title="Niedriger einstufen"' + (i === all.length - 1 ? ' disabled' : '') + '>▼</button></span>' : '';
      return '<div class="wm-row"><span class="wm-num">' + (i + 1) + '</span><span class="wm-ic">' + roleIcon(r.id) + '</span><div class="wm-main"><div class="wm-name">' + esc(r.name) + (r.builtin ? ' <span class="wm-fest">(fest)</span>' : '') + '</div><div class="wm-sub">' + esc(r.desc || 'ohne Beschreibung') + (r.last ? ' · ' + esc(when(r.last)) : '') + '</div></div>' +
        '<span class="wm-meta">Rechte ' + n + ' von ' + total + '</span><span class="wm-meta ' + (r.hasPw ? 'ok' : 'dim') + '">' + (r.id === 'gast' ? 'ohne Passwort' : (r.hasPw ? '🔑 Passwort' : 'Rollen-Anmeldung aus')) + '</span>' + mv +
        (has('system.roles') && has('system.rechte') ? '<button type="button" class="wm-btn" data-ed="copy" data-id="' + esc(r.id) + '" title="Als Vorlage für eine neue Rolle kopieren">⧉ Kopieren</button>' : '') +
        (canAny(['system.roles', 'system.rechte', 'system.passwords']) ? '<button type="button" class="wm-btn" data-ed="role" data-id="' + esc(r.id) + '">✏️ Bearbeiten</button>' : '') + '</div>';
    }).join('');
  }
  function extrasHtml() {
    if (!S.extras.length) return '<p class="wm-note">Noch keine Sonderrechte angelegt.</p>';
    return S.extras.map(function (x) {
      var n = S.users.filter(function (u) { return (u.extras || []).indexOf(x.id) >= 0; }).length;
      return '<div class="wm-row"><span class="wm-ic">✨</span><div class="wm-main"><div class="wm-name">' + esc(x.name) + '</div><div class="wm-sub">' + esc(x.desc || 'ohne Beschreibung') + '</div></div><span class="wm-meta">' + (x.perms || []).length + ((x.perms || []).length === 1 ? ' Recht' : ' Rechte') + ' · ' + n + ' Benutzer</span>' +
        (has('system.rechte') ? '<button type="button" class="wm-btn" data-ed="extra" data-id="' + esc(x.id) + '">✏️ Bearbeiten</button>' : '') + '</div>';
    }).join('');
  }
  function matrixHtml() {
    var cols = S.roles.map(function (r) { return { name: r.name, perms: r.perms || [] }; }).concat(S.extras.map(function (x) { return { name: '✨ ' + x.name, perms: x.perms || [] }; }));
    var h = '<table class="wm-matrix"><thead><tr><th class="left">Recht</th>' + cols.map(function (c) { return '<th>' + esc(c.name) + '</th>'; }).join('') + '</tr></thead><tbody>';
    S.catalog.groups.forEach(function (g) {
      h += '<tr><td colspan="' + (cols.length + 1) + '" class="grp">' + esc(g.title) + '</td></tr>';
      g.perms.forEach(function (q) { h += '<tr><td class="left">' + esc(q.label) + '</td>' + cols.map(function (c) { var on = c.perms.indexOf(q.key) >= 0; return '<td class="' + (on ? 'yes' : 'no') + '">' + (on ? '✓' : '–') + '</td>'; }).join('') + '</tr>'; });
    });
    return h + '</tbody></table>';
  }
  function head() {
    var ok = !!S.me && canAny(CAN_ENTER);
    SH.S.menuExtra = ok ? [['benutzer', '👤', 'Benutzerverwaltung'], ['zugang', '🛡️', 'Zugangsverwaltung']].map(function (t) { return { key: t[0], icon: t[1], label: t[2], on: S.tab === t[0] }; }) : [];
    return SH.header('Verwaltung');
  }
  function body() {
    if (!S.loaded) return '<section class="hub-grid"><div class="hub-skel"></div><div class="hub-skel"></div></section>';
    if (!S.me) return '<section class="hub-card hub-offline"><h2>Bitte anmelden</h2><p class="hub-sub">Die Verwaltung ist nur mit Anmeldung erreichbar.</p><button type="button" class="hub-btn hub-gold" data-sh="login">Anmelden</button></section>';
    if (!canAny(CAN_ENTER)) return '<section class="hub-card hub-offline"><h2>Kein Zugriff</h2><p class="hub-sub">Für dein Konto ist die Verwaltung nicht freigeschaltet.</p><a class="hub-btn hub-ghost" href="' + HUB_URL + '">← Hub</a></section>';
    if (S.offline) return '<section class="hub-card hub-offline"><h2>Keine Verbindung</h2><p class="hub-sub">Das Konto-System ist gerade nicht erreichbar.</p><button type="button" class="hub-btn hub-gold" data-act="retry">Nochmal versuchen</button><details class="hub-diag"><summary>Technische Details</summary><pre>' + esc(SH.DIAG.length ? SH.DIAG.join('\n') : 'Keine Angaben.') + '</pre></details></section>';
    if (S.tab !== 'benutzer' && S.tab !== 'zugang') S.tab = 'benutzer';
    var tabs = [['benutzer', '👤 Benutzerverwaltung'], ['zugang', '🛡️ Zugangsverwaltung']].map(function (t) { return '<button type="button" data-tab="' + t[0] + '" class="wm-tab' + (S.tab === t[0] ? ' on' : '') + '">' + t[1] + '</button>'; }).join('');
    var top = '<div class="wm-card wm-top"><h2>👑 Verwaltung</h2><a class="wm-btn" href="' + HUB_URL + '">⬅️ Zurück zum Hub</a></div>';
    var inner = '';
    if (S.tab === 'benutzer') {
      inner = '<div class="wm-card"><div class="wm-bar"><h3>👤 Benutzer</h3>' + (has('system.users') ? '<button type="button" class="wm-amber" data-ed="newuser">➕ Neuer Benutzer</button>' : '') + '</div><p class="wm-note">Benutzer haben einen eigenen Namen und ein eigenes Passwort, eine oder mehrere Rollen und auf Wunsch Sonderrechte. Die Rechte aus allen Rollen und Sonderrechten zählen zusammen.</p>' + (canAny(['system.users', 'system.rechte', 'system.roles']) ? usersHtml() : '<p class="wm-note">Du darfst Benutzer nicht ansehen.</p>') + '</div>';
    } else {
      inner = '<div class="wm-card"><div class="wm-bar"><h3>🛡️ Rollen</h3>' + (has('system.roles') ? '<button type="button" class="wm-amber" data-ed="newrole">➕ Neue Rolle</button>' : '') + '</div><p class="wm-note">Pro Rolle lassen sich Name, Beschreibung, Passwort und alle einzelnen Rechte einstellen. Die Rechte gelten sofort auf allen Geräten.</p>' + rolesHtml() + '</div>' +
        '<div class="wm-card"><div class="wm-bar"><h3>✨ Sonderrechte</h3>' + (has('system.rechte') ? '<button type="button" class="wm-amber" data-ed="newextra">➕ Neues Sonderrecht</button>' : '') + '</div><p class="wm-note">Ein Sonderrecht ist ein eigenes Rechte-Paket, das man einzelnen Benutzern zusätzlich zu ihren Rollen gibt, zum Beispiel „Statistik bearbeiten“ für einen Helfer. Es gilt nur bei persönlicher Anmeldung mit Benutzername, nicht bei der Anmeldung mit dem Passwort der Rolle.</p>' + extrasHtml() + '</div>' +
        '<details class="wm-card wm-det"><summary>📊 Rechte-Übersicht (wer darf was)</summary><p class="wm-note">Nur zum Ansehen. Geändert wird bei den einzelnen Rollen und Sonderrechten.</p><div class="wm-scroll">' + matrixHtml() + '</div></details>';
    }
    return top + (S.msg ? '<div class="hub-err" style="margin-bottom:14px">' + esc(S.msg) + '</div>' : '') + '<div class="wm-tabs">' + tabs + '</div>' + inner;
  }
  function dialogOrConfirm() {
    var d = S.dialog; if (!d) return '';
    if (d.confirm) return '<div class="ha-overlay"><div class="ha-dialog small"><h3>' + esc(d.title) + '</h3><p class="hub-sub">' + esc(d.message) + '</p><div class="ha-actions"><span class="ha-extra"></span><button type="button" class="hub-btn hub-ghost" data-cf="no">Abbrechen</button><button type="button" class="hub-btn ha-danger" data-cf="yes">' + esc(d.ok) + '</button></div></div></div>';
    return dialogHtml().replace('class="ha-dialog"', 'class="ha-dialog' + (d.wide ? ' wide' : '') + '"');
  }
  SH.S.onMenu = function (k) { S.tab = k === 'zugang' ? 'zugang' : 'benutzer'; S.msg = ''; };
  function render() {
    var keep = root.querySelector('.ha-body') ? root.querySelector('.ha-body').scrollTop : 0;
    root.innerHTML = head() + '<main class="hub-main">' + body() + '</main>' + SH.overlay() + dialogOrConfirm();
    var b = root.querySelector('.ha-body'); if (b && keep) b.scrollTop = keep;
    permRefresh();
  }

  root.addEventListener('click', function (ev) {
    var ct = ev.target.closest ? ev.target.closest('[data-pall],[data-pgall]') : null;
    if (ct) {
      ev.preventDefault();
      if (ct.getAttribute('data-pall')) { permSet(ct.closest('details.ha-acc') || ct.closest('details.ha-sysacc'), ct.getAttribute('data-pall') === 'on'); }
      else { permSet(root.querySelector('.ha-dialog'), ct.getAttribute('data-pgall') === 'on'); }
      return;
    }
    if (SH.click(ev, render, load)) return;
    var t = ev.target.closest ? ev.target.closest('[data-tab],[data-ed],[data-mv],[data-dx],[data-cf],[data-act]') : null; if (!t) return;
    if (t.getAttribute('data-tab')) { S.tab = t.getAttribute('data-tab'); S.msg = ''; render(); return; }
    if (t.getAttribute('data-act') === 'retry') { load(); return; }
    if (t.getAttribute('data-act') === 'theme') { if (window.HubTheme) window.HubTheme.cycle(); render(); return; }
    if (t.getAttribute('data-cf')) { var d = S.dialog; S.dialog = null; render(); if (d && d.done) d.done(t.getAttribute('data-cf') === 'yes'); return; }
    if (t.getAttribute('data-dx')) {
      var dx = t.getAttribute('data-dx'); if (dx === 'cancel') { closeDialog(); return; }
      var cur = S.dialog; if (cur && cur.action) { S.dialog = null; var p = cur.action(dx); if (!S.dialog) render(); return p; } return;
    }
    if (t.getAttribute('data-mv')) { access([{ op: 'moveRole', id: t.getAttribute('data-id'), dir: Number(t.getAttribute('data-mv')) }]); return; }
    var ed = t.getAttribute('data-ed'), id = t.getAttribute('data-id');
    if (ed === 'user') userDialog(id); else if (ed === 'newuser') userDialog(); else if (ed === 'role') roleDialog(id); else if (ed === 'copy') roleDialog(null, id);
    else if (ed === 'newrole') roleDialog(); else if (ed === 'extra') extraDialog(id); else if (ed === 'newextra') extraDialog();
  });
  root.addEventListener('change', function (ev) {
    var t = ev.target; if (!t || !t.getAttribute) return;
    if (t.getAttribute('data-pk')) { permRefresh(); return; }
    if (t.getAttribute('data-ppreset')) {
      var r = S.roles.filter(function (x) { return x.id === t.value; })[0]; if (!r) return;
      Array.prototype.forEach.call(root.querySelectorAll('input[data-pk]'), function (i) { if (!i.disabled) i.checked = (r.perms || []).indexOf(i.getAttribute('data-pk')) >= 0; });
      t.value = ''; permRefresh();
    }
  });
  root.addEventListener('input', function (ev) {
    var t = ev.target; if (!t || !t.getAttribute || !t.getAttribute('data-psearch')) return;
    var q = String(t.value || '').trim().toLowerCase();
    Array.prototype.forEach.call(root.querySelectorAll('details.ha-acc'), function (det) {
      var any = false;
      Array.prototype.forEach.call(det.querySelectorAll('.ha-perm'), function (l) { var m = !q || l.textContent.toLowerCase().indexOf(q) >= 0; l.style.display = m ? '' : 'none'; if (m) any = true; });
      det.style.display = any ? '' : 'none'; if (q && any) det.open = true;
    });
    Array.prototype.forEach.call(root.querySelectorAll('details.ha-sysacc'), function (sec) {
      var vis = Array.prototype.some.call(sec.querySelectorAll('details.ha-acc'), function (x) { return x.style.display !== 'none'; });
      sec.style.display = !q || vis ? '' : 'none'; if (q && vis) sec.open = true;
    });
  });
  root.addEventListener('submit', function (ev) {
    if (SH.submit(ev, render, load)) return;
    if (!ev.target.getAttribute || !ev.target.getAttribute('data-dlg')) return;
    ev.preventDefault();
    var d = S.dialog; if (!d || !d.submit) return;
    var v = readDialog(); var res = d.submit(v);
    if (typeof res === 'string') { d.error = res; var keep = {}; d.fields.forEach(function (f) { if (v[f.key] !== undefined) f.value = v[f.key]; }); render(); return; }
    S.dialog = null; render();
  });
  load();
})();
