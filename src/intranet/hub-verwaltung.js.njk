    }).join('');
    return '<style>.rn-row{display:grid;grid-template-columns:minmax(120px,1fr) 2fr 2fr;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid rgba(148,163,184,.25)}.rn-row input{min-height:38px;padding:0 10px;border-radius:10px;border:1px solid rgba(148,163,184,.45);background:rgba(148,163,184,.10);color:inherit;font-size:14px;width:100%;box-sizing:border-box}.rn-old small{display:block;color:#b45309;font-size:11px}@media(max-width:700px){.rn-row{grid-template-columns:1fr}}</style><div class="wm-card"><div class="wm-bar"><h3>🪪 Namen angleichen</h3><span><button type="button" class="wm-btn" data-act="rnclose">Schließen</button> <button type="button" class="wm-amber" data-act="rnsave"' + (RN.busy || RN.loading ? ' disabled' : '') + '>' + (RN.busy ? 'Speichere …' : 'Übernehmen') + '</button></span></div><p class="wm-note">Links steht der bisherige Kurzname, daneben der vorgeschlagene volle Name und der Anmeldename. Bitte prüfen und bei Bedarf ändern. Leer gelassene Zeilen bleiben unverändert. Passwörter bleiben, die Daten der Person werden mit umbenannt.</p>' + (RN.err ? '<div class="hub-err">' + esc(RN.err) + '</div>' : '') + body + '</div>';
