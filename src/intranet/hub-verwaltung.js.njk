      var mem = r && r.status === 'success' && r.data ? (r.data.wgMitglieder || []) : [];
      if (!r || r.status !== 'success') { RN.err = 'Die Mitgliederliste konnte nicht geladen werden. Namen lassen sich trotzdem von Hand eintragen.'; (RN.rows || []).forEach(function (x) { x.hint = ''; }); render(); return; }
      RN.names = mem.map(function (m) { return String(m.name || '').trim(); }).filter(Boolean);
