    permRefresh();
  }

  // ---------- Namen angleichen: Konten auf Vor- und Nachname + Anmeldename vorname.nachname ----------
  var RN = { open: false, loading: false, rows: null, err: '', busy: false };
  function slug(t) { return String(t || '').toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, ''); }
  function loginOf(full) { var w = String(full || '').trim().split(/\s+/).filter(Boolean); if (w.length < 2) return ''; return slug(w[0]) + '.' + slug(w[w.length - 1]); }
  // Sofort anzeigen (Liste der Konten), Vorschläge aus der Mitgliederliste kommen danach dazu und überschreiben nur Zeilen, die noch nicht bearbeitet wurden.
  function rnSuggest(names) {
    var used = {}; S.users.forEach(function (u) { if (u.login) used[String(u.login).toLowerCase()] = u.id; });
    (RN.rows || []).forEach(function (r) {
      if (r.touched) return;
      var key = slug(r.old), hit = [];
      names.forEach(function (n) { var w = n.split(/\s+/); if (slug(n) === key || (w.length > 1 && (slug(w[0]) === key || slug(w[w.length - 1]) === key || slug(w[0] + w[w.length - 1]) === key))) hit.push(n); });
      hit = hit.filter(function (x, i) { return hit.indexOf(x) === i; });
      var full = hit.length === 1 ? hit[0] : (/\s/.test(r.old) ? r.old : '');
      r.name = full; r.login = full ? loginOf(full) : (r.login || '');
      r.hint = hit.length > 1 ? 'Mehrere Treffer: ' + hit.join(', ') : (hit.length ? '' : 'Kein Treffer in der Mitgliederliste');
      if (r.login) { var base = r.login, n = 1; while (used[r.login] && used[r.login] !== r.id) { n++; r.login = base + n; r.hint = (r.hint ? r.hint + ' · ' : '') + 'Anmeldename war schon vergeben, Ziffer angehängt'; } used[r.login] = r.id; }
    });
  }
  function rnLoad() {
    RN.open = true; RN.err = ''; RN.loading = false;
    RN.rows = S.users.map(function (u) { return { id: u.id, old: u.name, name: /\s/.test(u.name) ? u.name : '', login: u.login || '', hint: RN.names ? '' : 'Vorschläge werden geladen …', touched: false }; });
    if (RN.names) { rnSuggest(RN.names); render(); return; }
    render();
