      inner = '<div class="wm-card"><div class="wm-bar"><h3>🛡️ Rollen</h3>' + (has('system.roles') ? '<button type="button" class="wm-amber" data-ed="newrole">➕ Neue Rolle</button>' : '') + '</div><p class="wm-note">Die Reihenfolge (▲▼) bestimmt auch die Benutzerliste: oben steht die höchste Rolle. Pro Rolle lassen sich Name, Beschreibung, Passwort und alle einzelnen Rechte einstellen. Die Rechte gelten sofort auf allen Geräten.</p>' + rolesHtml() + '</div>' +
        '<div class="wm-card"><div class="wm-bar"><h3>✨ Sonderrechte</h3>' + (has('system.rechte') ? '<button type="button" class="wm-amber" data-ed="newextra">➕ Neues Sonderrecht</button>' : '') + '</div><p class="wm-note">Ein Sonderrecht ist ein eigenes Rechte-Paket, das man einzelnen Benutzern zusätzlich zu ihren Rollen gibt, zum Beispiel „Statistik bearbeiten“ für einen Helfer. Es gilt nur bei persönlicher Anmeldung mit Benutzername, nicht bei der Anmeldung mit dem Passwort der Rolle.</p>' + extrasHtml() + '</div>' +
        '<details class="wm-card wm-det"><summary>📊 Rechte-Übersicht (wer darf was)</summary><p class="wm-note">Nur zum Ansehen. Geändert wird bei den einzelnen Rollen und Sonderrechten.</p><div class="wm-scroll">' + matrixHtml() + '</div></details>';
    }
    return top + (S.msg ? '<div class="hub-err" style="margin-bottom:14px">' + esc(S.msg) + '</div>' : '') + inner;
  }
  function dialogOrConfirm() {
    var d = S.dialog; if (!d) return '';
    if (d.confirm) return '<div class="ha-overlay"><div class="ha-dialog small"><h3>' + esc(d.title) + '</h3><p class="hub-sub">' + esc(d.message) + '</p><div class="ha-actions"><span class="ha-extra"></span><button type="button" class="hub-btn hub-ghost" data-cf="no">Abbrechen</button><button type="button" class="hub-btn ha-danger" data-cf="yes">' + esc(d.ok) + '</button></div></div></div>';
    return dialogHtml().replace('class="ha-dialog"', 'class="ha-dialog' + (d.wide ? ' wide' : '') + '"');
  }
  SH.S.onMenu = function (k) { S.tab = ['zugang', 'status', 'protokoll', 'backups'].indexOf(k) >= 0 ? k : 'benutzer'; S.msg = ''; };
  function render() {
    var keep = root.querySelector('.ha-body') ? root.querySelector('.ha-body').scrollTop : 0;
    root.innerHTML = head() + '<main class="hub-main">' + body() + '</main>' + SH.overlay() + dialogOrConfirm();
    var b = root.querySelector('.ha-body'); if (b && keep) b.scrollTop = keep;
    permRefresh();
  }

  root.addEventListener('click', function (ev) {
    var ct = ev.target.closest ? ev.target.closest('[data-pall],[data-pgall]') : null;
    if (ct) {
      ev.preventDefault();
      if (ct.getAttribute('data-pall')) { permSet(ct.closest('details.ha-acc') || ct.closest('details.ha-sysacc'), ct.getAttribute('data-pall') === 'on'); }
      else { permSet(root.querySelector('.ha-dialog'), ct.getAttribute('data-pgall') === 'on'); }
      return;
    }
    if (SH.click(ev, render, load)) return;
    var t = ev.target.closest ? ev.target.closest('[data-tab],[data-ed],[data-mv],[data-dx],[data-cf],[data-act]') : null; if (!t) return;
    if (t.getAttribute('data-tab')) { S.tab = t.getAttribute('data-tab'); S.msg = ''; render(); return; }
    if (t.getAttribute('data-act') === 'retry') { load(); return; }
    if (t.getAttribute('data-act') === 'stload') { ST.d = null; loadStatus(); return; }
    if (t.getAttribute('data-act') === 'bknow') { BK.msg = ''; post({ action: 'backupNow', token: token() }).then(function (r) { BK.msg = r && r.status === 'success' ? '' : (r && r.message) || 'Sicherung fehlgeschlagen.'; BK.list = null; loadBackups(); }); return; }
    if (t.getAttribute('data-act') === 'bktrig') { BK.msg = ''; post({ action: 'installTriggers', token: token() }).then(function (r) { BK.msg = r && r.status === 'success' ? '' : (r && r.message) || 'Einrichten fehlgeschlagen.'; BK.list = null; loadBackups(); }); return; }
    if (t.getAttribute('data-act') === 'bkrestore') { var bid = t.getAttribute('data-id'); confirmBox('Sicherung wiederherstellen?', 'Der aktuelle Stand wird vorher automatisch gesichert. Danach gilt der Stand dieser Sicherung für alle Daten.', 'Wiederherstellen').then(function (ok) { if (!ok) return; post({ action: 'restoreBackup', token: token(), id: bid }).then(function (r) { BK.msg = r && r.status === 'success' ? 'Wiederhergestellt.' : (r && r.message) || 'Fehlgeschlagen.'; BK.list = null; loadBackups(); }); }); return; }
    if (t.getAttribute('data-act') === 'logmore') { loadLog(false); return; }
    if (t.getAttribute('data-act') === 'theme') { if (window.HubTheme) window.HubTheme.cycle(); render(); return; }
    if (t.getAttribute('data-cf')) { var d = S.dialog; S.dialog = null; render(); if (d && d.done) d.done(t.getAttribute('data-cf') === 'yes'); return; }
    if (t.getAttribute('data-dx')) {
      var dx = t.getAttribute('data-dx'); if (dx === 'cancel') { closeDialog(); return; }
      var cur = S.dialog; if (cur && cur.action) { S.dialog = null; var p = cur.action(dx); if (!S.dialog) render(); return p; } return;
    }
    if (t.getAttribute('data-mv')) { access([{ op: 'moveRole', id: t.getAttribute('data-id'), dir: Number(t.getAttribute('data-mv')) }]); return; }
    var ed = t.getAttribute('data-ed'), id = t.getAttribute('data-id');
    if (ed === 'user') userDialog(id); else if (ed === 'newuser') userDialog(); else if (ed === 'role') roleDialog(id); else if (ed === 'copy') roleDialog(null, id);
    else if (ed === 'newrole') roleDialog(); else if (ed === 'extra') extraDialog(id); else if (ed === 'newextra') extraDialog();
  });
  root.addEventListener('change', function (ev) {
    var t = ev.target; if (!t || !t.getAttribute) return;
    if (t.getAttribute('data-pk')) { permRefresh(); return; }
    if (t.getAttribute('data-ppreset')) {
      var r = S.roles.filter(function (x) { return x.id === t.value; })[0]; if (!r) return;
      Array.prototype.forEach.call(root.querySelectorAll('input[data-pk]'), function (i) { if (!i.disabled) i.checked = (r.perms || []).indexOf(i.getAttribute('data-pk')) >= 0; });
      t.value = ''; permRefresh();
    }
  });
  root.addEventListener('input', function (ev) {
    var t = ev.target; if (!t || !t.getAttribute || !t.getAttribute('data-psearch')) return;
    var q = String(t.value || '').trim().toLowerCase();
    Array.prototype.forEach.call(root.querySelectorAll('details.ha-acc'), function (det) {
      var any = false;
      Array.prototype.forEach.call(det.querySelectorAll('.ha-perm'), function (l) { var m = !q || l.textContent.toLowerCase().indexOf(q) >= 0; l.style.display = m ? '' : 'none'; if (m) any = true; });
      det.style.display = any ? '' : 'none'; if (q && any) det.open = true;
    });
    Array.prototype.forEach.call(root.querySelectorAll('details.ha-sysacc'), function (sec) {
      var vis = Array.prototype.some.call(sec.querySelectorAll('details.ha-acc'), function (x) { return x.style.display !== 'none'; });
      sec.style.display = !q || vis ? '' : 'none'; if (q && vis) sec.open = true;
    });
  });
  root.addEventListener('submit', function (ev) {
    if (ev.target.getAttribute && ev.target.getAttribute('data-lgform') !== null) { ev.preventDefault(); Array.prototype.forEach.call(ev.target.querySelectorAll('[data-lg]'), function (i) { L[i.getAttribute('data-lg')] = String(i.value || '').trim(); }); L.entries = []; L.done = false; loadLog(true); return; }
    if (ev.target.getAttribute && ev.target.getAttribute('data-bkform') !== null) { ev.preventDefault(); var bf = ev.target; post({ action: 'setMailcfg', token: token(), to: bf.querySelector('[data-bk=to]').value, aus: bf.querySelector('[data-bk=aus]').checked }).then(function (r) { BK.msg = r && r.status === 'success' ? '' : (r && r.message) || 'Speichern fehlgeschlagen.'; BK.list = null; loadBackups(); }); return; }
    if (SH.submit(ev, render, load)) return;
    if (!ev.target.getAttribute || !ev.target.getAttribute('data-dlg')) return;
    ev.preventDefault();
    var d = S.dialog; if (!d || !d.submit) return;
    var v = readDialog(); var res = d.submit(v);
    if (typeof res === 'string') { d.error = res; d.fields.forEach(function (f) { if (v[f.key] !== undefined) f.value = v[f.key]; }); render(); return; }
    S.dialog = null; render();
  });
  load();
})();
