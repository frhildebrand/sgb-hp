    var res = [], used = {};
    ORD.forEach(function (c) { c[1].forEach(function (id) { var x = byId[id]; if (!x) return; used[id] = 1; if (TIT[id]) x.title = TIT[id]; x.cat = c[0]; res.push(x); }); });
    out.forEach(function (x) { if (byId[x.id] && !used[x.id]) { x.cat = 'Weitere'; res.push(x); } });
    return res;
  }
  function permGrid(d, key, value, locked, forced) {
    var sel = {}; (value || []).forEach(function (k) { sel[k] = true; }); (forced || []).forEach(function (k) { sel[k] = true; });
    var forcedSet = {}; (forced || []).forEach(function (k) { forcedSet[k] = true; });
