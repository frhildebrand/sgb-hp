/* Anwesenheit: WebClub-Anwesenheitslisten je Gruppe hochladen, Übersicht und Status. */
(function () {
  'use strict';
  var M = window.HubMod; if (!M) return;
  var P = window.WKParse; var esc = M.esc;
  var GR = ['Wettkampfgruppe', 'Gruppe 1', 'Gruppe 2', 'Gruppe 3', 'Gruppe 4', 'Masters'];
  var MON = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
  function slug(n) { return String(n || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); }
  function fd(i) { return i ? M.fmtDate(i) : ''; }
  function ym(i) { return String(i || '').slice(0, 7); }
  function sub() { var s = M.S.sub; if (!s.ag) s.ag = GR[0]; if (!s.am) s.am = ym(M.today()); return s; }
  function shift(m, n) { var p = m.split('-'); var d = new Date(+p[0], +p[1] - 1 + n, 1); return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2); }
  function lists(g) { return M.items('anwesenheit').filter(function (x) { return x.gruppe === g; }); }
  var CODE = { a: ['a', '✓'], e: ['e', 'e'], f: ['o', 'x'], k: ['k', 'k'] };
  function cell(c) { if (!c || c === '.') return '<span class="st n" style="display:inline-block;width:22px;text-align:center;color:#94a3b8">·</span>'; var x = CODE[c] || ['n', c]; var col = { a: '#d1fae5;color:#047857', e: '#fef3c7;color:#92400e', o: '#fee2e2;color:#b91c1c', k: '#dbeafe;color:#1d4ed8', n: '#eef1f6;color:#94a3b8' }[x[0]]; return '<span style="display:inline-block;width:22px;border-radius:7px;text-align:center;font-weight:800;font-size:12px;background:' + col + '">' + x[1] + '</span>'; }
  // Alle Termine und Personen einer Gruppe aus allen hochgeladenen Listen zusammenführen
  function merged(g, onlyLists) {
    var sess = {}, ppl = {};
    lists(g).forEach(function (l) {
      (l.sessions || []).forEach(function (s, i) {
        var k = s.date + '|' + (s.time || ''); sess[k] = { date: s.date, time: s.time || '' };
        (l.people || []).forEach(function (p) { var pk = (p.trainer ? 't:' : 's:') + lowr(swapN(p.name)); var o = ppl[pk] || (ppl[pk] = { name: p.name, trainer: !!p.trainer, st: {} }); var c = (p.st || '').charAt(i); if (c && c !== '.') o.st[k] = c; });
      });
    });
    // Trainingstage aus der Gruppenseite: dort eingetragene Anwesenheit (✓, e, ✗) erscheint hier ebenfalls; ohne Eintrag gilt an einem vergangenen Termin mit Eintragungen als „fehlt“
    if (!onlyLists) M.items('trainingTage').forEach(function (t) {
      var gs = Array.isArray(t.gruppen) && t.gruppen.length ? t.gruppen : [t.gruppe || 'Wettkampfgruppe']; if (gs.indexOf(g) < 0) return;
      var k = t.date + '|' + (t.time || ''); var an = t.anw || {}; var taken = Object.keys(an).length > 0; if (!taken && !sess[k]) return;
      var trn = (t.trainer || []).map(lowr); sess[k] = sess[k] || { date: t.date, time: t.time || '' };
      M.items('wgMitglieder').forEach(function (m) {
        var mg = Array.isArray(m.gruppen) ? m.gruppen : ['Wettkampfgruppe']; if (mg.indexOf(g) < 0 && !an[m.id]) return;
        if (m.status === 'ausgetreten' && !an[m.id]) return;
        var sw = (t.schw || []).indexOf(m.id) >= 0; if (!sw && ((m.trainerIn || []).indexOf(g) >= 0 || trn.indexOf(lowr(m.name)) >= 0)) return;
        var pk = 's:' + lowr(m.name); var o = ppl[pk] || (ppl[pk] = { name: m.name, trainer: false, st: {} });
        if (o.st[k]) return;
        var c = an[m.id]; if (!c && taken && t.date <= M.today()) c = 'f'; if (c) o.st[k] = c;
      });
    });
    var keys = Object.keys(sess).sort(); return { keys: keys, sess: sess, ppl: Object.keys(ppl).map(function (k) { return ppl[k]; }).sort(function (a, b) { return (a.trainer === b.trainer ? 0 : a.trainer ? -1 : 1) || a.name.localeCompare(b.name, 'de'); }) };
  }
  function uebersicht() {
    var s = sub(); var g = s.ag; var mg = merged(g); var keys = mg.keys.filter(function (k) { return ym(k) === s.am; });
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Anwesenheit</h3></div><div class="m-chips">' + GR.map(function (x) { return '<button type="button" class="m-chip' + (x === g ? ' on' : '') + '" data-ma="awg" data-v="' + esc(x) + '">' + esc(x) + '</button>'; }).join('') + '</div>' +
      '<div class="m-chips" style="align-items:center"><button type="button" class="m-chip" data-ma="awm" data-d="-1">‹</button><b>' + esc(M.monthLabel(s.am)) + '</b><button type="button" class="m-chip" data-ma="awm" data-d="1">›</button><span class="wm-sub">' + keys.length + ' Termine</span></div>';
    if (!keys.length) out += '<p class="wm-note">Für ' + esc(g) + ' gibt es in diesem Monat noch keine Liste. Lade sie im Reiter „Hochladen“ hoch.</p>';
    else {
      out += '<div class="m-twrap"><table><tr><th>Name</th>' + keys.map(function (k) { return '<th class="nowrap">' + esc(M.fmtDate(mg.sess[k].date, true)) + '<br>' + esc(mg.sess[k].time) + '</th>'; }).join('') + '<th>Quote</th></tr>';
      mg.ppl.forEach(function (p) {
        var a = 0, t = 0; keys.forEach(function (k) { var c = p.st[k]; if (c && c !== '.') { t++; if (c === 'a') a++; } });
        out += '<tr><td class="nowrap"><b>' + esc(p.name) + '</b>' + (p.trainer ? ' <span class="wm-sub">Trainer</span>' : '') + '</td>' + keys.map(function (k) { return '<td style="text-align:center">' + cell(p.st[k]) + '</td>'; }).join('') + '<td>' + (t ? Math.round(a * 100 / t) + ' %' : '–') + '</td></tr>';
      });
      out += '</table></div><p class="wm-sub" style="margin-top:8px">' + cell('a') + ' anwesend &nbsp; ' + cell('e') + ' entschuldigt &nbsp; ' + cell('f') + ' fehlt (zählt in die Quote)</p>';
    }
    out += '</section>';
    // Status: welche Gruppe hat in welchem Monat eine Liste
    var y = s.am.slice(0, 4);
    out += '<section class="wm-card"><div class="wm-bar"><h3>Listen-Status ' + esc(y) + '</h3></div><div class="m-twrap"><table><tr><th>Gruppe</th>' + MON.map(function (m) { return '<th>' + m + '</th>'; }).join('') + '</tr>' + GR.map(function (x) {
      var mm = merged(x, true); var have = {}; mm.keys.forEach(function (k) { have[ym(k)] = 1; });
      return '<tr><td><b>' + esc(x) + '</b></td>' + MON.map(function (m, i) { var key = y + '-' + ('0' + (i + 1)).slice(-2); var future = key > ym(M.today()); return '<td style="text-align:center">' + (have[key] ? cell('a') : future ? '<span class="wm-sub">·</span>' : cell('f')) + '</td>'; }).join('') + '</tr>';
    }).join('') + '</table></div><p class="wm-sub" style="margin-top:8px">✓ Liste vorhanden · – fehlt</p></section>';
    return out;
  }
  var UP = null;
  function hochladen() {
    if (!M.anyCan(['anwesenheit.upload'])) return '<section class="wm-card"><p class="wm-note">Zum Hochladen fehlt dir die Berechtigung.</p></section>';
    return '<section class="wm-card"><div class="wm-bar"><h3>Liste hochladen</h3></div><p class="wm-note">Wähle die Gruppe und die „Anwesenheitsliste“ (PDF) aus WebClub. Die Liste wird gelesen, in der Übersicht angezeigt und die PDF zusätzlich im Drive abgelegt.</p>' +
      '<div class="m-fgrid"><label class="m-f"><span>Gruppe</span><select id="aw_g">' + GR.map(function (g) { return '<option' + (g === sub().ag ? ' selected' : '') + '>' + esc(g) + '</option>'; }).join('') + '</select></label><label class="m-f wide"><span>PDF-Datei</span><input type="file" id="aw_f" accept="application/pdf,.pdf"></label></div><div class="m-btns"><button type="button" class="wm-amber" data-ma="awread">Vorschau erstellen</button></div><div id="aw_msg" class="wm-sub" style="margin-top:8px"></div></section>';
  }
  function read() {
    var f = document.getElementById('aw_f').files[0]; var g = document.getElementById('aw_g').value; var msg = document.getElementById('aw_msg');
    if (!f) { msg.textContent = 'Bitte zuerst eine PDF-Datei auswählen.'; return; }
    if (!window.HubPdf) { msg.textContent = 'Der PDF-Leser fehlt auf dieser Seite.'; return; }
    msg.textContent = 'Wird gelesen … (beim ersten Mal wird der PDF-Leser geladen)';
    HubPdf.read(f).then(function (r) {
      var p = P.parseAnwesenheit(r.pages); UP = { g: g, p: p, f: f };
      if (!p.sessions.length) { msg.innerHTML = '<span class="m-over">' + esc(p.warnings.join(' ') || 'Keine Termine gefunden.') + '</span>'; return; }
      var tr = p.people.filter(function (x) { return x.trainer; }).length; var sw = p.people.length - tr;
      var hint = p.title && p.title.toLowerCase().indexOf(g.toLowerCase().replace('wettkampfgruppe', 'wettkampf')) < 0 ? '<p class="wm-note">Hinweis: In der Datei steht „' + esc(p.title) + '“, gewählt ist „' + esc(g) + '“.</p>' : '';
      var have = lists(g).some(function (l) { return l.id === idFor(g, p); });
      M.openDlg('<div class="hub-dhead"><h3>Das wurde gefunden</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div>' + (p.warnings.length ? '<div class="hub-err">' + p.warnings.map(esc).join('<br>') + '</div>' : '') + hint +
        '<p class="wm-note"><b>' + p.sessions.length + '</b> Termine (' + fd(p.sessions[0].date) + ' – ' + fd(p.sessions[p.sessions.length - 1].date) + ') · <b>' + sw + '</b> Schwimmer · <b>' + tr + '</b> Trainer · Gruppe <b>' + esc(g) + '</b></p>' + (have ? '<p class="wm-note">Für diesen Zeitraum gibt es schon eine Liste. Sie wird ersetzt.</p>' : '') +
        (M.anyCan(['anwesenheit.tage']) ? fahrerBlock(p) : '') +
        '<div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="awsave">Übernehmen</button></div>');
    }, function (e) { msg.innerHTML = '<span class="m-over">' + esc(e.message || String(e)) + '</span>'; });
  }
  function idFor(g, p) { return 'aw-' + slug(g) + '-' + String((p.sessions[0] && p.sessions[0].date) || '').replace(/-/g, ''); }
  // Aus der Liste entstehen zugleich die Trainingstage (Trainer, Anwesenheit der Schwimmer, Gruppe). So wird die Liste nur einmal eingelesen.
  function lowr(x) { return String(x || '').toLowerCase().replace(/\s+/g, ' ').trim(); }
  function swapN(n) { n = String(n || '').trim(); var i = n.indexOf(','); return i > 0 ? (n.slice(i + 1).trim() + ' ' + n.slice(0, i).trim()).trim() : n; }
  // Fahrer je Termin gleich beim Einlesen wählen (für das Fahrtenformular / die Erstattung)
  function fahrerNames(p) {
    var o = []; ((M.find('saetze', 'main') || {}).fahrer || []).forEach(function (n) { n = String(n || '').trim(); if (n && o.indexOf(n) < 0) o.push(n); });
    return o;
  }
  function fahrerBlock(p) {
    var names = fahrerNames(p); if (!names.length) return '<p class="wm-note">Fahrer: In den Sätzen (Abrechnung → Sätze) sind noch keine Fahrer eingetragen. Dort kannst du sie hinterlegen, dann stehen sie hier zur Auswahl.</p>';
    return '<div class="m-sec">Wer ist gefahren? (optional, für das Fahrtenformular)</div><div style="max-height:24vh;overflow:auto">' + p.sessions.map(function (s, i) {
      return '<div class="m-chips" style="align-items:center;margin:3px 0"><span class="wm-sub" style="min-width:110px">' + esc(M.fmtDate(s.date, true)) + (s.time ? ' ' + esc(s.time) : '') + '</span>' + names.map(function (n) { return '<label class="m-chip"><input type="checkbox" data-awf="' + i + '" value="' + esc(n) + '" style="margin-right:4px">' + esc(n) + '</label>'; }).join('') + '</div>';
    }).join('') + '</div>';
  }
  function fahrerPick() { var f = {}; [].slice.call(document.querySelectorAll('input[data-awf]:checked')).forEach(function (x) { var i = x.getAttribute('data-awf'); (f[i] = f[i] || []).push(x.value); }); return f; }
  function tageOps(p, g, fa) {
    if (!M.anyCan(['anwesenheit.tage'])) return [];
    var mem = M.items('wgMitglieder').filter(function (m) { return Array.isArray(m.gruppen) ? m.gruppen.indexOf(g) >= 0 : g === 'Wettkampfgruppe'; }); var byN = {};
    mem.forEach(function (m) { byN[lowr(m.name)] = m; });
    var sat = M.find('saetze', 'main'); var dauer = sat && sat.dauer ? M.num(sat.dauer) : 60; var ops = [];
    var ex = M.items('trainingTage');
    p.sessions.forEach(function (s, i) {
      var anw = {}; p.people.forEach(function (x) { if (x.trainer) return; var m = byN[lowr(x.name)] || byN[lowr(swapN(x.name))]; var c = (x.st || [])[i]; if (m && (c === 'a' || c === 'e' || c === 'f')) anw[m.id] = c; });
      var tr = p.people.filter(function (x) { return x.trainer && (x.st || [])[i] === 'a'; }).map(function (x) { return swapN(x.name); }); var fh = (fa && fa[i]) || [];
      var old = ex.filter(function (t) { return t.date === s.date && String(t.time || '') === String(s.time || '') && (Array.isArray(t.gruppen) ? t.gruppen.indexOf(g) >= 0 : (t.gruppe || 'Wettkampfgruppe') === g); })[0];
      if (old) { var f = { anw: Object.assign({}, old.anw || {}, anw) }; if (tr.length) f.trainer = tr; if (fh.length) f.fahrer = fh; if (!old.dauer) f.dauer = dauer; ops.push({ op: 'patch', coll: 'trainingTage', id: old.id, merge: true, fields: f }); }
      else ops.push({ op: 'set', coll: 'trainingTage', item: { id: 'tt-' + s.date.replace(/-/g, '') + '-' + String(s.time || '0000').replace(':', '') + (g === 'Wettkampfgruppe' ? '' : '-' + slug(g)), gruppe: g, gruppen: [g], date: s.date, time: s.time || '', dauer: dauer, trainer: tr, anw: anw, ort: '', fahrer: fh } });
    });
    return ops;
  }
  function save() {
    if (!UP) return; UP.fa = fahrerPick(); var p = UP.p, g = UP.g;
    var item = { id: idFor(g, p), gruppe: g, title: g + ' ' + fd(p.sessions[0].date) + ' – ' + fd(p.sessions[p.sessions.length - 1].date), von: p.sessions[0].date, bis: p.sessions[p.sessions.length - 1].date, sessions: p.sessions, people: p.people.map(function (x) { return { name: x.name, trainer: !!x.trainer, st: x.st.map(function (c) { return c || '.'; }).join('') }; }), datei: UP.f.name };
    var f = UP.f; M.closeDlg(); M.op({ op: 'set', coll: 'anwesenheit', item: item }); var tops = tageOps(p, g, UP.fa); if (tops.length) M.ops(tops); sub().ag = g; sub().am = ym(p.sessions[0].date); M.toast(M.anyCan(['anwesenheit.tage']) ? 'Liste übernommen. Trainingstage und Trainerstunden sind angelegt.' : 'Liste übernommen.');
    if (f.size < 6000000) {
      var fr = new FileReader();
      fr.onload = function () { window.HubShell.post({ action: 'fileSave', token: window.HubShell.token(), area: 'anwesenheit', sub: g, name: (item.von || M.today()) + ' ' + g + '.pdf', data: String(fr.result).split(',')[1] || '' }).then(function (r) { if (r && r.status === 'success') { M.op({ op: 'patch', coll: 'anwesenheit', id: item.id, fields: { pdfUrl: r.url } }); M.toast('PDF im Drive abgelegt.'); } else M.toast((r && r.message) || 'PDF konnte nicht im Drive abgelegt werden.'); }); };
      fr.readAsDataURL(f);
    }
    UP = null;
  }
  function verwalten() {
    var l = M.items('anwesenheit').sort(function (a, b) { return String(b.von || '') < String(a.von || '') ? -1 : 1; });
    return '<section class="wm-card"><div class="wm-bar"><h3>Hochgeladene Listen</h3></div>' + (l.length ? l.map(function (x) { return '<div class="m-chk" data-id="' + esc(x.id) + '"><span style="flex:1"><b>' + esc(x.gruppe) + '</b> · ' + fd(x.von) + ' – ' + fd(x.bis) + ' <span class="wm-sub">' + (x.people || []).length + ' Personen</span></span>' + (x.pdfUrl && /^https:\/\//.test(x.pdfUrl) ? '<a class="wm-btn" href="' + esc(x.pdfUrl) + '" target="_blank" rel="noopener">📎 PDF</a>' : '') + (M.anyCan(['anwesenheit.edit', 'anwesenheit.loeschen']) ? ' <button type="button" class="wm-btn m-danger" data-ma="awdel">🗑️</button>' : '') + '</div>'; }).join('') : '<p class="wm-note">Noch keine Liste hochgeladen.</p>') + '</section>';
  }
  M.register('anwesenheit', {
    title: 'Anwesenheit', icon: '📋', colls: ['anwesenheit', 'trainingTage', 'wgMitglieder', 'saetze'],
    tabs: [{ id: 'uebersicht', label: 'Übersicht', view: ['anwesenheit.view'], render: uebersicht }, { id: 'hochladen', label: 'Hochladen', view: ['anwesenheit.upload'], render: function () { return hochladen() + verwalten(); } }],
    actions: {
      awg: function (it, el) { sub().ag = el.getAttribute('data-v'); M.render(true); },
      awm: function (it, el) { var s = sub(); s.am = shift(s.am, +el.getAttribute('data-d')); M.render(true); },
      awread: function () { read(); }, awsave: function () { save(); },
      awdel: function (it, el, ev, c) { var id = c.id || el.closest('[data-id]').getAttribute('data-id'); M.confirm('Diese Liste löschen?', 'Löschen', function () { M.op({ op: 'del', coll: 'anwesenheit', id: id }); }); }
    }
  });
  function applyHash() { var h = String(location.hash || '').replace('#', ''); if (h === 'hochladen' || h === 'uebersicht') { M.S.tab = h; if (M.render) M.render(true); } }
  window.addEventListener('hashchange', applyHash); setTimeout(applyHash, 900); setTimeout(applyHash, 2500);
})();
