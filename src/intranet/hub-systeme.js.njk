      arbeit: function (it) { if (!it) return; M.op({ op: 'patch', coll: 'aufgaben', id: it.id, fields: { status: it.status === 'arbeit' ? 'offen' : 'arbeit' } }); },
      comment: function (it) { if (!it) return; M.openForm({ title: 'Kommentar', fields: [{ k: 'text', t: 'text', label: 'Kurz und knapp', req: true, ph: 'z. B. Halle angefragt' }], item: {}, saveLabel: 'Speichern', onSave: function (v) { var c = M.clone(it.com || []); c.push({ n: me(), t: v.text, at: Date.now() }); M.op({ op: 'patch', coll: 'aufgaben', id: it.id, fields: { com: c } }); } }); },
