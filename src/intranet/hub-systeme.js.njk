      var cToday = open.filter(function (x) { return x.due === t; }).length;
      var cWeek = open.filter(function (x) { return x.due && x.due > t && x.due <= we; }).length;
      var doneAll = all.filter(function (x) { return x.status === 'erledigt'; });
      var cDone = doneAll.filter(function (x) { return x.doneAt && Date.now() - x.doneAt < 14 * 86400000; }).length;
      var q = lower(S.q);
      var list = all.filter(function (it) {
        if (q && lower(it.title + ' ' + (it.text || '') + ' ' + (it.who || []).join(' ')).indexOf(q) < 0) return false;
        var isOpen = it.status !== 'erledigt';
        if (f === 'offen') return isOpen && !oldWk(it);
        if (f === 'meine') return isOpen && isMine(it);
        if (f === 'over') return isOpen && it.due && it.due < t && !oldWk(it);
        if (f === 'today') return isOpen && it.due === t;
        if (f === 'week') return isOpen && it.due && it.due >= t && it.due <= we;
        if (f === 'erledigt') return !isOpen;
        return true;
      });
      if (f === 'erledigt') list.sort(function (a, b) { return (b.doneAt || 0) - (a.doneAt || 0); });
      var chips = [['offen', 'Offen', open.length], ['meine', 'Meine', all.filter(function (x) { return x.status !== 'erledigt' && isMine(x); }).length], ['erledigt', 'Erledigt', doneAll.length], ['alle', 'Alle', all.length]].filter(function (c) { return M.can('aufgaben.view') || c[0] === 'meine' || c[0] === 'erledigt'; });
      var out = '<section class="wm-card"><div class="m-stats">' + M.stat(cOver, 'überfällig', cOver ? 'bad' : '', 'data-ma="filt" data-f="over"') + M.stat(cToday, 'heute fällig', cToday ? 'warn' : '', 'data-ma="filt" data-f="today"') + M.stat(cWeek, 'diese Woche', 'info', 'data-ma="filt" data-f="week"') + M.stat(cDone, 'erledigt (14 Tage)', 'ok', 'data-ma="filt" data-f="erledigt"') + '</div>' +
        '<div class="wm-bar"><span class="m-actions">' + M.seg([['liste', '☰ Liste'], ['spalten', '▥ Spalten']], S.sub.lay || 'liste', 'lay') + (canEdit ? M.seg([['liste', 'Aufgaben'], ['pakete', 'Pakete']], 'liste', 'av') : '') + '</span><span class="m-actions"><button type="button" class="wm-btn" data-ma="printtasks">🖨️ Drucken</button>' + (canEdit ? '<button type="button" class="wm-amber" data-ma="addtask">+ Neue Aufgabe</button>' : '') + '</span></div>' +
        '<div class="m-chips">' + chips.map(function (c) { return '<button type="button" class="m-chip' + (c[0] === f ? ' on' : '') + '" data-ma="filt" data-f="' + c[0] + '">' + c[1] + ' (' + c[2] + ')</button>'; }).join('') + (['over', 'today', 'week'].indexOf(f) >= 0 ? '<button type="button" class="m-chip on" data-ma="filt" data-f="offen">Filter: ' + ({ over: 'überfällig', today: 'heute', week: 'Woche' }[f]) + ' ✕</button>' : '') + '</div>' +
        '<input type="search" class="m-search" data-mq="1" placeholder="🔎 Aufgabe oder Person suchen …" value="' + esc(S.q) + '" autocomplete="off">';
      if (!list.length) out += '<p class="wm-note">' + (all.length ? 'Hier ist nichts offen. 🎉' : 'Noch keine Aufgaben.') + '</p>';
      else if ((S.sub.lay || 'liste') === 'spalten') {
        var src = f === 'erledigt' || f === 'alle' ? list : list;
        var cols = [['offen', 'Offen'], ['arbeit', 'In Arbeit'], ['erledigt', 'Erledigt']];
        out += '<div class="m-kan">' + cols.map(function (c) {
          var l = src.filter(function (x) { return x.status === c[0] || (c[0] === 'offen' && x.status !== 'arbeit' && x.status !== 'erledigt'); });
          if (c[0] === 'erledigt') l = l.filter(function (x) { return x.doneAt && Date.now() - x.doneAt < 14 * 86400000; });
