  function pre(t) { return t ? '<pre>' + esc(t) + '</pre>' : ''; }
  function printHead(title, sub) { return '<h1>' + esc(title) + '</h1>' + (sub ? '<div class="sub">' + sub + '</div>' : ''); }
  function lower(s) { return String(s || '').toLowerCase(); }
  function me() { return M.userName(); }
  function isMe(n) { return !!me() && lower(n) === lower(me()); }
  function avatars(list) { return (list || []).slice(0, 3).map(function (n) { return M.avatar(n); }).join('') + ((list || []).length > 3 ? '<span class="wm-sub" style="margin-left:10px">+' + (list.length - 3) + '</span>' : ''); }
  function addMonths(iso, n) { var d = new Date(iso + 'T12:00:00'); d.setMonth(d.getMonth() + n); return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
  function weekEnd() { var d = new Date(M.today() + 'T12:00:00'); var wd = (d.getDay() + 6) % 7; return M.addDays(M.today(), 6 - wd); }
  // Vorlagen: Zeilen "Text | Tage" (Aufgaben) bzw. "Text | Phase | Tage" (Veranstaltungen) <-> Liste
  var PH = { v: 'vor', t: 'tag', n: 'danach' };
  var PHN = { vor: 'Vorher', tag: 'Am Tag', danach: 'Danach' };
  function parsePunkte(txt, withPhase) {
    return String(txt || '').split('\n').map(function (l) { return l.trim(); }).filter(Boolean).map(function (l) {
      var p = l.split('|').map(function (x) { return x.trim(); });
      var o = { t: p[0] };
      if (withPhase) { var ph = lower(p[1] || ''); o.ph = ph.charAt(0) === 'n' || ph === 'danach' ? 'danach' : (ph.charAt(0) === 't' || ph === 'am tag') ? 'tag' : 'vor'; o.off = parseInt(p[2], 10); if (!isFinite(o.off)) o.off = o.ph === 'vor' ? -7 : o.ph === 'tag' ? 0 : 1; }
      else { o.off = parseInt(p[1], 10); if (!isFinite(o.off)) o.off = 0; }
      return o;
    });
  }
  function punkteText(list, withPhase) {
    return (list || []).map(function (p) { return withPhase ? p.t + ' | ' + ({ vor: 'vorher', tag: 'am Tag', danach: 'danach' }[p.ph] || 'vorher') + ' | ' + p.off : p.t + ' | ' + p.off; }).join('\n');
  }
  function vorlagen(typ) { return M.items('vorlagen').filter(function (v) { return v.typ === typ; }); }

  /* ================= AUFGABEN ================= */
  var TASK_FIELDS = [
    { k: 'title', t: 'text', label: 'Aufgabe', req: true, ph: 'Was ist zu tun?' },
    { k: 'text', t: 'area', label: 'Beschreibung', rows: 3 },
    { k: 'who', t: 'tags', label: 'Zuständig' },
    { k: 'due', t: 'date', label: 'Bis' },
    { k: 'status', t: 'sel', label: 'Status', opts: [['offen', 'Offen'], ['arbeit', 'In Arbeit'], ['erledigt', 'Erledigt']] },
    { k: 'prio', t: 'sel', label: 'Wichtigkeit', opts: [['normal', 'Normal'], ['hoch', 'Hoch']] },
    { k: 'rep', t: 'sel', label: 'Wiederholen', opts: [['', 'Nie'], ['woechentlich', 'Jede Woche'], ['14tage', 'Alle 2 Wochen'], ['monatlich', 'Jeden Monat'], ['jaehrlich', 'Jedes Jahr']] },
    { k: 'sub', t: 'checks', label: 'Unteraufgaben', rows: 4, hint: 'Pro Zeile eine Unteraufgabe.' }
  ];
  function isMine(it) { var n = lower(me()); if (!n) return false; var w = Array.isArray(it.who) ? it.who : []; return w.some(function (x) { return lower(x) === n; }) || lower(it.by) === n; }
  function oldWk(it) {
    if (!it.ref || it.ref.indexOf('wk:') !== 0) return false;
    var w = M.find('wettkaempfe', it.ref.slice(3)); return !!(w && w.date && w.date < M.today());
  }
  function nextDue(it) {
    var d = it.due || M.today();
    if (it.rep === 'woechentlich') return M.addDays(d, 7);
    if (it.rep === '14tage') return M.addDays(d, 14);
    if (it.rep === 'monatlich') return addMonths(d, 1);
    if (it.rep === 'jaehrlich') return addMonths(d, 12);
    return '';
  }
  function taskSort(a, b) {
    var da = a.due || '9999', db = b.due || '9999'; if (da !== db) return da < db ? -1 : 1;
    var pa = a.prio === 'hoch' ? 0 : 1, pb = b.prio === 'hoch' ? 0 : 1; if (pa !== pb) return pa - pb;
    return (a.ts || 0) - (b.ts || 0);
  }
  function taskRow(it, canEdit, compact) {
    var done = it.status === 'erledigt'; var dd = M.daysTo(it.due);
    var over = !done && dd !== null && dd < 0;
    var due = it.due ? '<span class="' + (over || (!done && dd === 0) ? 'm-over' : '') + '">' + (over ? '⚠️ ' : '') + 'bis ' + fmtShort(it.due) + (!done ? (dd < 0 ? ' (' + (-dd) + ' Tg. überfällig)' : dd === 0 ? ' (heute)' : dd === 1 ? ' (morgen)' : '') : '') + '</span>' : '';
    var sub = it.sub || []; var sdone = sub.filter(function (s) { return s.d; }).length;
    var ref = it.ref ? '🔗 ' + esc(it.refLabel || it.ref) : '';
    var doneTxt = done && it.doneBy ? '✓ Erledigt (' + esc(it.doneBy) + ')' + (it.doneAt ? ', ' + fmtShort(new Date(it.doneAt).toISOString().slice(0, 10)) : '') : '';
    var open = !!M.S.open[it.id] && !compact;
    var canTick = canEdit || (M.can('aufgaben.own') && isMine(it));
    var canCom = canTick;
    var metaBits = [due, sub.length ? '☑ ' + sdone + '/' + sub.length : '', it.rep ? '🔁' : '', ref, doneTxt].filter(Boolean).join(' · ');
    var out = '<article class="m-card' + (done ? ' dim' : '') + '" data-id="' + esc(it.id) + '"><div class="m-head" data-ma="' + (compact ? 'edit' : 'toggle') + '"><button type="button" class="m-box' + (done ? ' on' : '') + '" data-ma="tick"' + (canTick ? '' : ' disabled') + ' aria-label="Erledigt">' + (done ? '✓' : '') + '</button><div class="m-main"><div class="m-title">' + esc(it.title) + (it.prio === 'hoch' ? M.badge('wichtig', 'red') : '') + (it.status === 'arbeit' ? M.badge('in Arbeit', 'blue') : '') + '</div><div class="wm-sub">' + metaBits + '</div></div>' + ((it.who || []).length ? '<span class="m-avs">' + avatars(it.who) + '</span>' : '') + (compact ? '' : '<span class="m-chev">' + (open ? '▾' : '▸') + '</span>') + '</div>';
    if (open) {
      out += '<div class="m-body">' + (it.text ? '<pre>' + esc(it.text) + '</pre>' : '') + (it.note ? '<div class="wm-sub">Notiz: ' + lines(it.note) + '</div>' : '');
      if (sub.length) out += '<h4 class="wm-sub" style="margin:10px 0 4px">Unteraufgaben</h4>' + sub.map(function (s, i) { return '<div class="m-chk"><button type="button" class="m-box' + (s.d ? ' on' : '') + '" data-ma="subtick" data-i="' + i + '"' + (canTick ? '' : ' disabled') + '>' + (s.d ? '✓' : '') + '</button><span' + (s.d ? ' style="text-decoration:line-through;opacity:.6"' : '') + '>' + esc(s.t) + '</span></div>'; }).join('');
      var com = it.com || [];
      if (com.length) out += '<h4 class="wm-sub" style="margin:10px 0 4px">Kommentare</h4>' + com.map(function (c) { return '<div class="wm-sub" style="margin:2px 0"><b style="color:inherit">' + esc(c.t) + '</b> (' + esc(c.n) + (c.at ? ', ' + fmtShort(new Date(c.at).toISOString().slice(0, 10)) : '') + ')</div>'; }).join('');
      out += '<div class="m-btns">' + (canTick && !done ? '<button type="button" class="wm-btn" data-ma="arbeit">' + (it.status === 'arbeit' ? '↩︎ Wieder offen' : '▶︎ In Arbeit') + '</button>' : '') + (canCom ? '<button type="button" class="wm-btn" data-ma="comment">💬 Kommentar</button>' : '') + (canEdit ? '<button type="button" class="wm-btn" data-ma="edit">✏️ Bearbeiten</button><button type="button" class="wm-btn m-danger" data-ma="del">🗑️ Löschen</button>' : '') + '</div></div>';
    }
    return out + '</article>';
  }
  function taskSections(list, canEdit) {
    var t = M.today(), we = weekEnd();
    var groups = [['over', 'Überfällig', 'bad'], ['today', 'Heute', ''], ['week', 'Diese Woche', ''], ['later', 'Später', ''], ['none', 'Ohne Datum', '']];
    var by = { over: [], today: [], week: [], later: [], none: [] };
    list.forEach(function (x) { by[!x.due ? 'none' : x.due < t ? 'over' : x.due === t ? 'today' : x.due <= we ? 'week' : 'later'].push(x); });
    return groups.filter(function (g) { return by[g[0]].length; }).map(function (g) { return '<h4 class="m-sec ' + g[2] + '">' + g[1] + ' (' + by[g[0]].length + ')</h4>' + by[g[0]].map(function (x) { return taskRow(x, canEdit); }).join(''); }).join('');
  }
  function saveTaskItem(v, base, done) {
    var n = Object.assign({}, base, v);
    if (v.status === 'erledigt' && base.status !== 'erledigt') { n.doneAt = Date.now(); n.doneBy = me(); }
    if (v.status !== 'erledigt') { n.doneAt = 0; n.doneBy = ''; }
    return n;
  }
  M.register('aufgaben', {
    title: 'Aufgaben', icon: '✅', colls: ['aufgaben', 'vorlagen', 'wettkaempfe'], custom: true, access: ['aufgaben.view', 'aufgaben.own'],
    render: function () {
      var S = M.S; var view = S.sub.av || 'liste';
      var canEdit = M.can('aufgaben.edit');
      if (view === 'pakete') return paketeHtml(canEdit, view);
