    var sub = it.sub || []; var sdone = sub.filter(function (s) { return s.d; }).length;
    var ref = it.ref ? '🔗 ' + esc(it.refLabel || it.ref) : '';
    var doneTxt = done && it.doneBy ? '✓ Erledigt (' + esc(it.doneBy) + ')' + (it.doneAt ? ', ' + fmtShort(new Date(it.doneAt).toISOString().slice(0, 10)) : '') : '';
    var open = !!M.S.open[it.id] && !compact;
    var canTick = canEdit || (M.can('aufgaben.own') && isMine(it));
    var canCom = canTick;
    var metaBits = [due, sub.length ? '☑ ' + sdone + '/' + sub.length : '', it.rep ? '🔁' : '', ref, doneTxt].filter(Boolean).join(' · ');
    var out = '<article class="m-card' + (done ? ' dim' : '') + '" data-id="' + esc(it.id) + '"><div class="m-head" data-ma="' + (compact ? 'edit' : 'toggle') + '"><button type="button" class="m-box' + (done ? ' on' : '') + '" data-ma="tick"' + (canTick ? '' : ' disabled') + ' aria-label="Erledigt">' + (done ? '✓' : '') + '</button><div class="m-main"><div class="m-title">' + esc(it.title) + (it.prio === 'hoch' ? M.badge('wichtig', 'red') : '') + (it.status === 'arbeit' ? M.badge('in Arbeit', 'blue') : '') + '</div><div class="wm-sub">' + metaBits + '</div></div>' + ((it.who || []).length ? '<span class="m-avs">' + avatars(it.who) + '</span>' : '') + (compact ? '' : '<span class="m-chev">' + (open ? '▾' : '▸') + '</span>') + '</div>';
    if (open) {
      out += '<div class="m-body">' + (it.text ? '<pre>' + esc(it.text) + '</pre>' : '') + (it.note ? '<div class="wm-sub">Notiz: ' + lines(it.note) + '</div>' : '');
      if (sub.length) out += '<h4 class="wm-sub" style="margin:10px 0 4px">Unteraufgaben</h4>' + sub.map(function (s, i) { return '<div class="m-chk"><button type="button" class="m-box' + (s.d ? ' on' : '') + '" data-ma="subtick" data-i="' + i + '"' + (canTick ? '' : ' disabled') + '>' + (s.d ? '✓' : '') + '</button><span' + (s.d ? ' style="text-decoration:line-through;opacity:.6"' : '') + '>' + esc(s.t) + '</span></div>'; }).join('');
      var com = it.com || [];
      if (com.length) out += '<h4 class="wm-sub" style="margin:10px 0 4px">Kommentare</h4>' + com.map(function (c) { return '<div class="wm-sub" style="margin:2px 0"><b style="color:inherit">' + esc(c.t) + '</b> (' + esc(c.n) + (c.at ? ', ' + fmtShort(new Date(c.at).toISOString().slice(0, 10)) : '') + ')</div>'; }).join('');
      out += '<div class="m-btns">' + (canTick && !done ? '<button type="button" class="wm-btn" data-ma="arbeit">' + (it.status === 'arbeit' ? '↩︎ Wieder offen' : '▶︎ In Arbeit') + '</button>' : '') + (canCom ? '<button type="button" class="wm-btn" data-ma="comment">💬 Kommentar</button>' : '') + (canEdit ? '<button type="button" class="wm-btn" data-ma="edit">✏️ Bearbeiten</button>' : '') + (M.anyCan(['aufgaben.edit', 'aufgaben.loeschen']) ? '<button type="button" class="wm-btn m-danger" data-ma="del">🗑️ Löschen</button>' : '') + '</div></div>';
    }
    return out + '</article>';
  }
  function taskSections(list, canEdit) {
    var t = M.today(), we = weekEnd();
    var groups = [['over', 'Überfällig', 'bad'], ['today', 'Heute', ''], ['week', 'Diese Woche', ''], ['later', 'Später', ''], ['none', 'Ohne Datum', '']];
    var by = { over: [], today: [], week: [], later: [], none: [] };
    list.forEach(function (x) { by[!x.due ? 'none' : x.due < t ? 'over' : x.due === t ? 'today' : x.due <= we ? 'week' : 'later'].push(x); });
    return groups.filter(function (g) { return by[g[0]].length; }).map(function (g) { return '<h4 class="m-sec ' + g[2] + '">' + g[1] + ' (' + by[g[0]].length + ')</h4>' + by[g[0]].map(function (x) { return taskRow(x, canEdit); }).join(''); }).join('');
  }
  function saveTaskItem(v, base, done) {
