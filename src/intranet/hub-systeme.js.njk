          M.ops((it.punkte || []).map(function (p) { return { op: 'set', coll: 'aufgaben', item: { id: M.uid(), title: p.t, who: v.who, due: M.addDays(v.start, p.off || 0), status: 'offen', prio: 'normal', rep: '', sub: [], ref: 'pk:' + it.id, refLabel: it.title, by: me() } }; }));
