          var md = tb.map(function (c, k) { var a = c.slice(), one = c.length === 1; while (a.length < nc) { if (k === 0 || one) a.unshift(''); else a.push(''); } return '| ' + a.join(' | ') + ' |'; });
          md.splice(1, 0, '| ' + new Array(nc + 1).join('--- | ').trim());
