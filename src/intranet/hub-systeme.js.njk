      });
      var res = [], i = 0;
      while (i < rows.length) {
        var r0 = rows[i];
        if (r0.cells.length >= 2 && rows[i + 1] && rows[i + 1].cells.length >= 2) {
          var tb = [r0.cells.map(function (c) { return c.str.trim(); })], fx = r0.cells[0].x, j = i + 1, lastY = r0.y;
          while (j < rows.length) {
            var rj = rows[j];
            if (rj.cells.length >= 2) { tb.push(rj.cells.map(function (c) { return c.str.trim(); })); fx = Math.min(fx, rj.cells[0].x); }
            else if (rj.cells.length === 1 && Math.abs(rj.cells[0].x - fx) <= 4 && lastY - rj.y < 22) { var lr = tb[tb.length - 1]; lr[0] = (lr[0] + ' ' + rj.cells[0].str.trim()).trim(); }
            else if (rj.cells.length === 1 && rj.cells[0].x > fx + 100 && lastY - rj.y < 40) { tb.push([rj.cells[0].str.trim()]); j++; lastY = rj.y; break; }
