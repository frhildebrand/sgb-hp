      edit: function (it) { if (!it) return; M.openForm({ title: 'Aufgabe bearbeiten', fields: TASK_FIELDS, item: it, onSave: function (v) { M.op({ op: 'set', coll: 'aufgaben', item: saveTaskItem(v, it) }); } }); },
