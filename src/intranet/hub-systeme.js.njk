/* Die Fach-Systeme Aufgaben, Veranstaltungen, Vorstand und Material. Baut auf hub-modul.js auf. */
(function () {
  'use strict';
  var M = window.HubMod; if (!M) return;
  var esc = M.esc;
  function lines(t) { return esc(t || '').replace(/\n/g, '<br>'); }
