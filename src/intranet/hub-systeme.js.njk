          printwer: function () { var rows = []; M.items('material').forEach(function (it) { openLoans(it).forEach(function (l) { rows.push([l.who, loanText(it, l), l.at, l.bis]); }); }); rows.sort(function (a, b) { return a[0].localeCompare(b[0], 'de'); }); M.print('Wer hat was', printHead('Wer hat was', 'Stand ' + fmtShort(M.today())) + '<table><tr><th>Wer</th><th>Was</th><th>Seit</th><th>Zurück bis</th></tr>' + rows.map(function (r) { return '<tr><td>' + esc(r[0]) + '</td><td>' + r[1] + '</td><td class="nowrap">' + fmtShort(r[2]) + '</td><td class="nowrap">' + fmtShort(r[3]) + '</td></tr>'; }).join('') + '</table>'); }
        } },
      { id: 'kauf', label: 'Einkaufsliste', coll: 'material', view: ['material.view'], edit: ['material.edit'], print: ['material.print'],
        render: function () {
          var l = needList(M.items('material'));
          var out = '<section class="wm-card"><div class="wm-bar"><h3>Nachkaufen (' + l.length + ')</h3><span class="m-actions"><button type="button" class="wm-btn" data-ma="printkauf">🖨️ Drucken</button></span></div><p class="wm-note">Hier stehen alle Gegenstände, die unter dem Mindestbestand sind oder manuell auf die Liste gesetzt wurden.</p>';
          if (!l.length) return out + '<p class="wm-note">Nichts nachzukaufen. 🎉</p></section>';
          out += '<table class="m-table"><tr><th>Gegenstand</th><th>Verfügbar</th><th>Fehlt</th><th></th></tr>' + l.map(function (it) { var miss = low(it) ? Number(it.min) - avail(it) : 0; return '<tr data-id="' + esc(it.id) + '"><td><b>' + esc(it.title) + '</b><div class="wm-sub">' + esc(it.ort || '') + '</div></td><td>' + avail(it) + '</td><td>' + (miss ? miss + ' ' + esc(it.einheit || '') : '–') + '</td><td>' + (M.can('material.edit') ? '<button type="button" class="wm-btn" data-ma="gekauft">✓ gekauft</button>' : '') + '</td></tr>'; }).join('') + '</table></section>';
          return out;
        },
        actions: {
          gekauft: function (it, el) { var id = el.closest('[data-id]').getAttribute('data-id'); var x = M.find('material', id); if (!x) return; var need = low(x) ? Number(x.min) - avail(x) : 0; M.confirm('Wie viele „' + x.title + '“ wurden gekauft? Der Bestand wird um ' + (need || 'die gekaufte Menge') + ' erhöht.', 'Gekauft', function () { M.op({ op: 'patch', coll: 'material', id: id, fields: { kaufen: false, bestand: (Number(x.bestand) || 0) + need } }); }); },
          printkauf: function () { var l = needList(M.items('material')); M.print('Einkaufsliste', printHead('Einkaufsliste Material', 'Stand ' + fmtShort(M.today())) + '<table><tr><th>✓</th><th>Gegenstand</th><th>Menge</th><th>Ort</th></tr>' + l.map(function (it) { var miss = low(it) ? Number(it.min) - avail(it) : ''; return '<tr><td>☐</td><td>' + esc(it.title) + '</td><td>' + esc(miss) + ' ' + esc(it.einheit || '') + '</td><td>' + esc(it.ort || '') + '</td></tr>'; }).join('') + '</table>'); }
        } }
    ]
  });
  // Eingabevorschlaege fuer Gruppen
  if (!document.getElementById('mGruppen')) { var dl = document.createElement('datalist'); dl.id = 'mGruppen'; dl.innerHTML = ['Wettkampfgruppe', 'Frösche', 'Seepferdchen', 'Anfänger', 'Fortgeschrittene', 'Erwachsene'].map(function (g) { return '<option value="' + g + '">'; }).join(''); document.body.appendChild(dl); }
})();
