      },
      subtick: function (it, el, ev) { ev.stopPropagation(); if (!it) return; var i = +el.getAttribute('data-i'); var s = M.clone(it.sub || []); s[i].d = !s[i].d; M.op({ op: 'patch', coll: 'aufgaben', id: it.id, fields: { sub: s } }); },
      arbeit: function (it) { if (!it) return; M.op({ op: 'patch', coll: 'aufgaben', id: it.id, fields: { status: it.status === 'arbeit' ? 'offen' : 'arbeit' } }); },
