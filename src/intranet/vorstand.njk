  /* ===== Ruhiges Design (gilt für alle Hub-Seiten) ===== */
  #hubRoot { --navy: #12395c; --navy2: #1c4f7c; --gold: #d6a23a; --line: #e2e8f0; --soft: #64748b; --bg: #f1f5f9; background: var(--bg); }
