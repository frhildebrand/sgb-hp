  /* ===== Design 3: Kategorie-Farben, Konto-Knopf, Menü, Startseite, mehr Tiefe ===== */
  #hubRoot { --bg: #eef2f7; --card: #ffffff; --line: #dfe6ef; --soft: #5f6b7d; --ink: #0f172a; --ring: rgba(214,162,58,.35); background: radial-gradient(1200px 500px at 85% -10%, rgba(18,57,92,.07), transparent 60%), var(--bg); }
