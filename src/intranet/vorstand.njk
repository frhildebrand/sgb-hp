  #hubRoot .hub-t2 { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 22px 20px 18px; min-height: 168px; border-radius: 22px; background: #fff; border: 1px solid var(--line); box-shadow: 0 1px 3px rgba(60,50,30,.06); color: inherit; text-decoration: none; overflow: hidden; transition: transform .12s, box-shadow .12s; }
