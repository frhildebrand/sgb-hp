    return '<span class="hub-t2h ' + esc(h.c || '') + '">' + esc(h.t) + '</span>';
  }
  function tile(s, color) {
    return '<a class="hub-t2" href="' + esc(s.url) + '" style="--acc:' + esc(color || s.color || '#94a3b8') + '"><span class="hub-t2ic">' + esc(s.icon || '•') + '</span><span class="hub-t2n">' + esc(s.name) + '</span><span class="hub-t2d">' + esc(s.desc || '') + '</span>' + hintOf(s) + '</a>';
  }
  function groupsHtml(systems) {
    var by = {}; systems.forEach(function (s) { var g = SH.catOf(s); (by[g] = by[g] || []).push(s); });
    var names = SH.CATS.map(function (c) { return c.name; }).filter(function (g) { return by[g]; }).concat(Object.keys(by).filter(function (g) { return !SH.CATS.some(function (c) { return c.name === g; }); }));
    return names.map(function (g) { var ci = SH.catInfo(g); return '<section class="hub-sec" style="--cat:' + esc(ci.color) + '"><h3 class="hub-sech"><span class="hub-sechi">' + ci.icon + '</span>' + esc(g) + '</h3><div class="hub-tiles">' + by[g].map(function (x) { return tile(x, ci.color); }).join('') + '</div></section>'; }).join('');
  }
  var WD = ['Sonntag', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag'], MO = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
  function longDate() { var d = new Date(); return WD[d.getDay()] + ', ' + d.getDate() + '. ' + MO[d.getMonth()] + ' ' + d.getFullYear(); }
  function greet() { var h = new Date().getHours(); return h < 5 ? 'Gute Nacht' : h < 11 ? 'Guten Morgen' : h < 17 ? 'Hallo' : 'Guten Abend'; }
  function cdBadge(n) { if (n === null || n === undefined) return ''; if (n <= 0) return '<span class="hub-hcd hub-hcd0"><b>' + (n === 0 ? 'Heute' : 'Jetzt') + '</b></span>'; return '<span class="hub-hcd"><b>' + n + '</b><i>' + (n === 1 ? 'Tag' : 'Tage') + '</i></span>'; }
  function hero() {
    var S = SH.S; var nm = S.me ? String(S.me.user || (S.me.role && S.me.role.name) || '') : '';
    var first = nm.split(/\s+/)[0];
    var n = state.next && state.next.token === SH.token() ? state.next : null;
    var items = [];
    if (n) {
      (n.wk || []).forEach(function (w) { items.push({ date: w.date, ic: '🏁', t: w.title, s: [fmtD(w.date), w.ort || ''].filter(Boolean).join(' · '), href: '/intranet/wettkaempfe/' }); });
      (n.ev || []).forEach(function (e) { items.push({ date: e.date, ic: '🎪', t: e.title, s: [fmtD(e.date), e.prog || ''].filter(Boolean).join(' · '), href: '/intranet/veranstaltungen/' }); });
    }
    var wm = state.wm; if (wm && wm.at) { var wiso = String(wm.at).slice(0, 10); var wend = String(wm.endAt || wm.at).slice(0, 10); if (daysTo(wiso) !== null && daysTo(wend) !== null && daysTo(wend) >= 0) { var wdt = new Date(wiso + 'T12:00:00'); var wtime = /T(\d{2}:\d{2})/.exec(wm.at); items.push({ date: wiso, ic: '🎄', t: wm.label || 'Weihnachtsmarkt', s: [WD[wdt.getDay()].slice(0, 2) + ', ' + String(wdt.getDate()).padStart(2, '0') + '.' + String(wdt.getMonth() + 1).padStart(2, '0') + '.', wtime ? wtime[1] + ' Uhr' : ''].filter(Boolean).join(' · '), href: '/intranet/weihnachtsmarkt/' }); } }
    items.sort(function (a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
    var line = items.length ? '<div class="hub-hline">' + items.slice(0, 3).map(function (x) { return '<a class="hub-hnext" href="' + x.href + '"><span class="hub-hic">' + x.ic + '</span><span class="hub-htx"><b>' + esc(x.t) + '</b><i>' + esc(x.s) + '</i></span>' + cdBadge(daysTo(x.date)) + '</a>'; }).join('') + '</div>' : '';
    return '<section class="hub-hero"><div class="hub-hero-t"><div class="hub-hdate">' + esc(longDate()) + '</div><h2 class="hub-hello">' + (S.me ? greet() + ', ' + esc(first) + ' 👋' : 'Willkommen') + '</h2></div>' + line + '</section>';
  }
  function fristHtml() {
