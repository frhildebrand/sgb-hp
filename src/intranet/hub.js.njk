      '<td class="a"><label class="hub-wch"><input type="checkbox" name="wichtig" form="bform"' + (ex.wichtig ? ' checked' : '') + '><span>📣 Wichtig</span></label><div><button type="submit" form="bform" class="hub-bx" aria-label="Speichern" title="Speichern">💾</button><button type="button" class="hub-bx" data-act="bcancel" aria-label="Abbrechen" title="Abbrechen">✕</button></div></td></tr>';
  }
  function brettHtml() {
    var can = SH.has('startseite.brett'), del = SH.has('brett.loeschen') || can; if (!SH.has('brett.view') && !can) return '';
    var l = brettSort(state.brett), shown = l.slice(0, 6);
    var head = '<tr><th>Von</th><th>Datum</th><th>Mitteilung</th>' + (can ? '<th></th>' : '') + '</tr>';
    var rows = (state.bform && !state.bedit ? brettEditRow(null) : '') + shown.map(function (b, i) {
      if (state.bform && state.bedit === b.id) return brettEditRow(b);
      var up = i > 0 && !!shown[i - 1].wichtig === !!b.wichtig, dn = i < shown.length - 1 && !!shown[i + 1].wichtig === !!b.wichtig;
      return '<tr' + (b.wichtig ? ' class="imp"' : '') + '><td>' + esc(b.by || '') + '</td><td>' + esc(fmtDMY(b.date)) + '</td><td class="m"' + (window.HubRich.okBg(b.bg) ? ' style="background:' + window.HubRich.okBg(b.bg) + '"' : '') + '><b>' + (b.wichtig ? '📣 ' : '') + esc(b.title) + '</b>' + window.HubRich.show(b) + '</td>' +
        (can ? '<td class="a"><div><button type="button" class="hub-bx" data-act="bmove" data-dir="-1" data-id="' + esc(b.id) + '" aria-label="Nach oben"' + (up ? '' : ' disabled') + '>▲</button><button type="button" class="hub-bx" data-act="bmove" data-dir="1" data-id="' + esc(b.id) + '" aria-label="Nach unten"' + (dn ? '' : ' disabled') + '>▼</button><button type="button" class="hub-bx" data-act="bedit" data-id="' + esc(b.id) + '" aria-label="Bearbeiten">✏️</button>' + (del ? '<button type="button" class="hub-bx" data-act="bdel" data-id="' + esc(b.id) + '" aria-label="Löschen">🗑️</button>' : '') + '</div></td>' : '') + '</tr>'; }).join('');
    return '<section class="hub-card2" id="brett"><div class="hub-c2h"><h3>📌 Schwarzes Brett</h3><span class="hub-c2b">' + (can && !state.bform ? '<button type="button" class="hub-btn hub-gold" data-act="bnew">+ Neue Mitteilung</button>' : '') + '<a class="hub-btn hub-ghost" href="/intranet/brett/">' + (can ? 'Verwalten →' : 'Alle ansehen →') + '</a></span></div>' +
      '<form id="bform" data-bf="1" data-id="' + esc(state.bedit || '') + '"></form>' +
      (rows ? '<div class="hub-bwrap"><table class="hub-bt">' + head + rows + '</table></div>' + (l.length > shown.length ? '<p class="hub-sub" style="margin:8px 0 0">Weitere ' + (l.length - shown.length) + ' Mitteilungen unter „' + (can ? 'Verwalten' : 'Alle ansehen') + '“.</p>' : '') : '<p class="hub-sub" style="margin:6px 0 0">Zurzeit gibt es keine Mitteilungen.</p>') + '</section>';
  }
  function termineHtml() {
    var n = state.next && state.next.token === SH.token() ? state.next : null; var items = [];
    if (n) {
      (n.wk || []).forEach(function (w) { var sub = 'Wettkampf ' + fmtDMY(w.date).slice(0, 5); items.push({ date: w.date, t: w.title, s: w.ort || '', href: '/intranet/wettkaempfe/' }); });
      (n.ev || []).forEach(function (e) { items.push({ date: e.date, t: e.title, s: e.prog || '', href: '/intranet/veranstaltungen/' }); });
    }
    var wm = state.wm; if (wm && wm.at) { var wiso = String(wm.at).slice(0, 10); if (daysTo(wiso) !== null && daysTo(wiso) >= 0) items.push({ date: wiso, t: wm.label || 'Weihnachtsmarkt', s: '', href: '/intranet/weihnachtsmarkt/' }); }
    items.sort(function (a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
