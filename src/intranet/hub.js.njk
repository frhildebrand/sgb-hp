  }
  function pidOf(n) { return 'p-' + String(n || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 36); }
  function saveProf(f) {
    var u = SH.S.me && SH.S.me.user; if (!u) return; var id = pidOf(u);
    var o = state.hasProfile ? { op: 'patch', coll: 'profile', id: id, fields: f } : { op: 'set', coll: 'profile', item: Object.assign({ id: id, owner: u }, f) };
    SH.post({ action: 'dataOps', token: SH.token(), ops: [o] }).then(function (r) { if (r && r.status === 'success') state.hasProfile = true; });
  }
  // Welche Gruppen auf der Startseite stehen: eigene Auswahl, sonst die Gruppen, in denen man Trainer ist, sonst die Wettkampfgruppe
  function groupSel(n) { return Array.isArray(state.pgrp) ? state.pgrp : (n.grp && n.grp.mine && n.grp.mine.length ? n.grp.mine : ['Wettkampfgruppe']); }
  function wgCard() {
