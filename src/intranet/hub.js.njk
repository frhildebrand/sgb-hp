    if (state.gedit) return '<section class="hub-card2"><div class="hub-c2h"><h3>🏊 Gruppen auswählen</h3><button type="button" class="hub-btn hub-gold" data-act="gdone" style="padding:4px 12px;font-size:13px">Fertig</button></div><p class="hub-sub" style="margin:0 0 8px">Diese Gruppen erscheinen auf deiner Startseite.</p><div class="hub-gl">' + n.grp.all.map(function (g) { return '<label class="hub-gk"><input type="checkbox" data-act="gtog" data-g="' + esc(g.name) + '"' + (sel.indexOf(g.name) >= 0 ? ' checked' : '') + '><span>' + esc(g.name) + ' <i>(' + g.n + ')</i></span></label>'; }).join('') + '</div><button type="button" class="hub-btn hub-ghost" data-act="greset" style="margin-top:10px;padding:4px 12px;font-size:13px">Zurücksetzen (Gruppen, in denen ich Trainer bin)</button></section>';
    var rows = sel.filter(function (g) { return cnt[g] !== undefined; }).map(function (g) { return '<div class="hub-gr"><span>' + esc(g) + '</span><b>' + cnt[g] + '</b></div>'; }).join('');
