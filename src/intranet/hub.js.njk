  function dayBox(iso) { var d = new Date(iso + 'T12:00:00'); return '<span class="hub-dbx"><b>' + ('0' + d.getDate()).slice(-2) + '</b><i>' + ['JAN', 'FEB', 'MÄR', 'APR', 'MAI', 'JUN', 'JUL', 'AUG', 'SEP', 'OKT', 'NOV', 'DEZ'][d.getMonth()] + '</i></span>'; }
  function brettSort(l) {
    return (l || []).slice().sort(function (a, b) {
      var w = (b.wichtig ? 1 : 0) - (a.wichtig ? 1 : 0); if (w) return w;
      var oa = typeof a.ord === 'number' ? a.ord : -1, ob = typeof b.ord === 'number' ? b.ord : -1; if (oa !== ob) return oa - ob;
