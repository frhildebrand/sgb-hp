    return '<section class="hub-card2 hub-big"><div class="hub-c2h"><h3>✅ ' + (n.mine ? 'Meine Aufgaben' : 'Offene Aufgaben') + '</h3><a href="/intranet/aufgaben/" class="hub-sub">' + tot + ' offen →</a></div>' + (l.length ? l.map(function (x) { var d = x.due ? daysTo(x.due) : null; var bc = d === null ? '' : d < 0 ? 'bad' : d === 0 ? 'bad' : d <= 7 ? 'warn' : 'info'; return '<a class="hub-ai" href="/intranet/aufgaben/"><span>' + (x.prio === 'hoch' ? '❗ ' : '') + esc(x.title || x.t || '') + '</span>' + (x.due ? '<em class="hub-ab ' + bc + '">' + (d === 0 ? 'heute' : d < 0 ? 'überfällig' : 'bis ' + esc(fmtDMY(x.due).slice(0, 6))) + '</em>' : '') + '</a>'; }).join('') + (tot > l.length ? '<p class="hub-sub" style="margin:8px 0 0">und ' + (tot - l.length) + ' weitere</p>' : '') : '<p class="hub-sub" style="margin:6px 0 0">Alles erledigt.</p>') + '</section>';
  }
  function blickHtml() {
    var n = state.next && state.next.token === SH.token() ? state.next : null; if (!n || !n.cnt) return '';
