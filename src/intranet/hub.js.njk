    return out;
  }
  // Kompakte Aufgabenübersicht direkt unter dem Kopfbereich
  function tasksHtml() {
    var n = state.next; if (!n || n.token !== SH.token() || !(n.tasks || []).length) return '';
    var t0 = todayIso();
    return '<section class="hub-tk"><div class="hub-tkh"><h3>✅ ' + (n.mine ? 'Meine Aufgaben' : 'Offene Aufgaben') + '</h3><a href="/intranet/aufgaben/">Alle ansehen →</a></div><div class="hub-tkl">' + n.tasks.map(function (t) { var over = t.due && t.due < t0; return '<a class="hub-tki' + (over ? ' hub-over' : '') + (t.prio === 'hoch' ? ' hub-hi' : '') + '" href="/intranet/aufgaben/"><span>' + esc(t.title) + '</span>' + (t.due ? '<em>' + (over ? '⚠️ ' : '') + esc(fmtD(t.due)) + '</em>' : '') + '</a>'; }).join('') + '</div></section>';
  }
  function wkProgress(w) {
    var KEYS = ['webclub', 'krabfrage', 'bekWA', 'lizenzen', 'geprueft', 'versendet', 'bestaetigung', 'waGruppe', 'meWA', 'urkGedruckt', 'urkVerteilt', 'artikel'];
    var chk = w.chk || {}; var done = KEYS.filter(function (k) { return chk[k]; }).length;
    if (w.meldegeldStatus === 'bezahlt') done++; return done + '/' + (KEYS.length + 1) + ' erledigt';
  }
  function loadNext() {
    var want = [];
    if (SH.has('wettkaempfe.view')) want.push('wettkaempfe');
    if (SH.has('aufgaben.view') || SH.has('aufgaben.own')) want.push('aufgaben');
    if (SH.has('material.view')) want.push('material');
    if (SH.has('veranstaltungen.view')) want.push('veranstaltungen');
    if (SH.has('vorstand.view') || SH.has('vorstand.antrag')) want.push('vorstandAntraege');
    if (['abrechnung.eigene', 'abrechnung.alle', 'abrechnung.ansehen', 'abrechnung.bezahlen'].some(function (k) { return SH.has(k); })) want.push('abrechnungen');
    if (['fahrten.eigene', 'fahrten.alle', 'fahrten.ansehen', 'fahrten.abrechnen'].some(function (k) { return SH.has(k); })) want.push('fahrten');
    if (SH.has('training.tage.view')) want.push('trainingTage');
