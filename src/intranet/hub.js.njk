    SH.get('data', { colls: want.join(',') }).then(function (r) {
      if (!r || r.status !== 'success') return;
      var t = todayIso(); var d = r.data || {}; var me = (SH.S.me && (SH.S.me.user || '')).toLowerCase();
      var comps = d.wettkaempfe || [];
      var pastIds = {}; comps.forEach(function (w) { if ((w.date || '9999') < t) pastIds[w.id] = 1; });
      var up = comps.filter(function (w) { return (w.date || '') >= t; }).sort(function (a, b) { return a.date < b.date ? -1 : 1; });
      var wk = up.slice(0, 3).map(function (w) { return { date: w.date, title: w.title, ort: w.ort, prog: wkProgress(w), ims: (w.intMs && w.intMs >= t) ? w.intMs : '', ms: (w.meldeschluss && w.meldeschluss >= t) ? w.meldeschluss : '' }; });
      var mine = !SH.has('aufgaben.view');
      var tasks = (d.aufgaben || []).filter(function (x) { return x.status !== 'erledigt' && !(x.ref && x.ref.indexOf('wk:') === 0 && pastIds[x.ref.slice(3)]); });
      if (!mine && me) { var m2 = tasks.filter(function (x) { return (x.who || []).some(function (w) { return String(w).toLowerCase() === me; }); }); if (m2.length) { tasks = m2; mine = true; } }
      var overdue = tasks.filter(function (x) { return x.due && x.due < t; }).length;
      var open = tasks.length;
      tasks = tasks.sort(function (a, b) { var pa = a.prio === 'hoch' ? 0 : 1, pb = b.prio === 'hoch' ? 0 : 1; if (pa !== pb) return pa - pb; return (a.due || '9999') < (b.due || '9999') ? -1 : 1; }).slice(0, 6).map(function (x) { return { title: x.title, due: x.due, prio: x.prio }; });
      var evs = (d.veranstaltungen || []).filter(function (e) { return (e.date || '') >= t && e.status !== 'Abgeschlossen'; }).sort(function (a, b) { return a.date < b.date ? -1 : 1; });
      var ev = evs.slice(0, 3).map(function (e) { var c = e.check || []; var dn = c.filter(function (x) { return x.d; }).length; return { date: e.date, title: e.title, prog: c.length ? dn + '/' + c.length + ' erledigt' : '' }; });
      var hints = {};
      if (d.aufgaben) hints.aufgaben = open ? { t: open + ' offen' + (overdue ? ', ' + overdue + ' überfällig' : ''), c: overdue ? 'bad' : 'warn' } : { t: 'Alles erledigt', c: '' };
      if (d.wettkaempfe) hints.wettkaempfe = up.length ? (function () { var dd = daysTo(up[0].date); return { t: 'Nächster ' + inDays(dd), c: dd <= 7 ? 'warn' : 'info' }; })() : { t: 'Kein Termin', c: 'none' };
