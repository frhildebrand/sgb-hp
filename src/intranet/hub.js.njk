/* Hub der SG Barnstorf: Auswahl der Systeme in Gruppen, mit kleinen Hinweisen. Anmeldung und Menü stecken in der Kopfzeile (hub-common.js). */
(function () {
  'use strict';
  var root = document.getElementById('hubRoot');
  if (!root) return;
  var SH = window.HubShell;
  if (!SH) { root.textContent = 'Der Grundbaustein hub-common.js fehlt.'; return; }
  var HUB_URL = '/intranet/';
  var state = { loaded: false, next: SH.lsGet('hubnext', null), brett: SH.lsGet('hubbrett', []) };
  var esc = SH.esc;

  function todayIso() { var d = new Date(); return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
  function daysTo(iso) { if (!iso) return null; return Math.round((new Date(iso + 'T12:00:00') - new Date(todayIso() + 'T12:00:00')) / 86400000); }
  function fmtD(iso) { if (!iso) return ''; var d = new Date(iso + 'T12:00:00'); return ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'][d.getDay()] + ', ' + ('0' + d.getDate()).slice(-2) + '.' + ('0' + (d.getMonth() + 1)).slice(-2) + '.'; }
  function fmtDMY(iso) { var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso || '')); return m ? m[3] + '.' + m[2] + '.' + m[1] : String(iso || ''); }
  function inDays(n) { return n === 0 ? 'heute' : n === 1 ? 'morgen' : 'in ' + n + ' Tagen'; }

  function hintOf(s) {
    var h = state.next && state.next.token === SH.token() ? (state.next.hints || {})[s.id] : null;
    if (!h) return '';
    return '<span class="hub-t2h ' + esc(h.c || '') + '">' + esc(h.t) + '</span>';
  }
  function tile(s, color) {
    return '<a class="hub-t2" href="' + esc(s.url) + '" style="--acc:' + esc(color || s.color || '#94a3b8') + '"><span class="hub-t2ic">' + esc(s.icon || '•') + '</span><span class="hub-t2n">' + esc(s.name) + '</span><span class="hub-t2d">' + esc(s.desc || '') + '</span>' + hintOf(s) + '</a>';
  }
  function groupsHtml(systems) {
    var by = {}; systems.forEach(function (s) { var g = SH.catName(s.group); (by[g] = by[g] || []).push(s); });
    var names = SH.CATS.map(function (c) { return c.name; }).filter(function (g) { return by[g]; }).concat(Object.keys(by).filter(function (g) { return !SH.CATS.some(function (c) { return c.name === g; }); }));
    return names.map(function (g) { var ci = SH.catInfo(g); return '<section class="hub-sec" style="--cat:' + esc(ci.color) + '"><h3 class="hub-sech"><span class="hub-sechi">' + ci.icon + '</span>' + esc(g) + '</h3><div class="hub-tiles">' + by[g].map(function (x) { return tile(x, ci.color); }).join('') + '</div></section>'; }).join('');
  }
  var WD = ['Sonntag', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag'], MO = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
  function longDate() { var d = new Date(); return WD[d.getDay()] + ', ' + d.getDate() + '. ' + MO[d.getMonth()] + ' ' + d.getFullYear(); }
  function greet() { var h = new Date().getHours(); return h < 5 ? 'Gute Nacht' : h < 11 ? 'Guten Morgen' : h < 17 ? 'Hallo' : 'Guten Abend'; }
  function cdBadge(n) { if (n === null || n === undefined) return ''; if (n <= 0) return '<span class="hub-hcd hub-hcd0"><b>' + (n === 0 ? 'Heute' : 'Jetzt') + '</b></span>'; return '<span class="hub-hcd"><b>' + n + '</b><i>' + (n === 1 ? 'Tag' : 'Tage') + '</i></span>'; }
  function hero() {
    var S = SH.S; var nm = S.me ? String(S.me.user || (S.me.role && S.me.role.name) || '') : '';
    var first = nm.split(/\s+/)[0];
    var n = state.next && state.next.token === SH.token() ? state.next : null;
    var items = [];
    if (n) {
      (n.wk || []).forEach(function (w) { items.push({ date: w.date, ic: '🏁', t: w.title, s: [fmtD(w.date), w.ort || ''].filter(Boolean).join(' · '), href: '/intranet/wettkaempfe/' }); });
      (n.ev || []).forEach(function (e) { items.push({ date: e.date, ic: '🎪', t: e.title, s: [fmtD(e.date), e.prog || ''].filter(Boolean).join(' · '), href: '/intranet/veranstaltungen/' }); });
    }
    var wm = state.wm; if (wm && wm.at) { var wiso = String(wm.at).slice(0, 10); var wend = String(wm.endAt || wm.at).slice(0, 10); if (daysTo(wiso) !== null && daysTo(wend) !== null && daysTo(wend) >= 0) { var wdt = new Date(wiso + 'T12:00:00'); var wtime = /T(\d{2}:\d{2})/.exec(wm.at); items.push({ date: wiso, ic: '🎄', t: wm.label || 'Weihnachtsmarkt', s: [WD[wdt.getDay()].slice(0, 2) + ', ' + String(wdt.getDate()).padStart(2, '0') + '.' + String(wdt.getMonth() + 1).padStart(2, '0') + '.', wtime ? wtime[1] + ' Uhr' : ''].filter(Boolean).join(' · '), href: '/intranet/weihnachtsmarkt/' }); } }
    items.sort(function (a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
    var line = items.length ? '<div class="hub-hline">' + items.slice(0, 3).map(function (x) { return '<a class="hub-hnext" href="' + x.href + '"><span class="hub-hic">' + x.ic + '</span><span class="hub-htx"><b>' + esc(x.t) + '</b><i>' + esc(x.s) + '</i></span>' + cdBadge(daysTo(x.date)) + '</a>'; }).join('') + '</div>' : '';
    return '<section class="hub-hero"><div class="hub-hero-t"><div class="hub-hdate">' + esc(longDate()) + '</div><h2 class="hub-hello">' + (S.me ? greet() + ', ' + esc(first) + ' 👋' : 'Willkommen') + '</h2></div>' + line + '</section>';
  }
  function fristHtml() {
    var n = state.next; if (!n || n.token !== SH.token() || !(n.fr || []).length) return '';
    return '<section class="hub-fr"><h3 class="hub-frh">⏰ Fristen &amp; Hinweise</h3><div class="hub-frl">' + n.fr.map(function (f) { return '<a class="hub-fchip ' + esc(f.c || '') + '" href="' + esc(f.href || '/intranet/') + '"><b>' + esc(f.t) + '</b><span>' + esc(f.s || '') + '</span></a>'; }).join('') + '</div></section>';
  }
  // Schnellzugriff: jeder wählt seine Lieblingsbereiche selbst (bleibt in diesem Browser gespeichert).
  // Speichert den Schnellzugriff im eigenen Profil, damit er auf jedem Gerät gleich ist.
  function pidOf(n) { return 'p-' + String(n || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 36); }
  function saveQuick(l) {
    var u = SH.S.me && SH.S.me.user; if (!u) return; var id = pidOf(u);
    var o = state.hasProfile ? { op: 'patch', coll: 'profile', id: id, fields: { quick: l } } : { op: 'set', coll: 'profile', item: { id: id, owner: u, quick: l } };
    SH.post({ action: 'dataOps', token: SH.token(), ops: [o] }).then(function (r) { if (r && r.status === 'success') state.hasProfile = true; });
  }
  function quickList() {
    var sys = SH.S.systems || []; var sel = Array.isArray(state.quick) ? state.quick : SH.lsGet('hubquick_' + (SH.S.me && SH.S.me.user || ''), null);
    if (!Array.isArray(sel)) sel = sys.slice(0, 4).map(function (x) { return x.url; });
    return sel.map(function (u) { return sys.filter(function (x) { return x.url === u; })[0]; }).filter(Boolean);
  }
  function quickHtml() {
    var sys = SH.S.systems || []; if (!sys.length) return '';
    var sel = quickList().map(function (x) { return x.url; });
    if (state.qedit) return '<section class="hub-fr"><div class="hub-tkh"><h3>⚡ Schnellzugriff bearbeiten</h3><button type="button" class="hub-btn hub-gold" data-act="qdone">Fertig</button></div><p class="hub-sub" style="margin:2px 0 10px">Tippe die Bereiche an, die du oben haben willst. Das gilt nur für dieses Gerät.</p><div class="hub-frl">' + sys.map(function (x) { var on = sel.indexOf(x.url) >= 0; return '<button type="button" class="hub-fchip' + (on ? ' ok' : '') + '" data-act="qtog" data-u="' + esc(x.url) + '" style="cursor:pointer">' + (on ? '✓ ' : '') + esc(x.icon || '') + ' ' + esc(x.name) + '</button>'; }).join('') + '</div></section>';
    return '<section class="hub-sec" style="--cat:#d6a23a"><h3 class="hub-sech"><span class="hub-sechi">⚡</span>Schnellzugriff <button type="button" class="hub-btn hub-ghost" data-act="qedit" style="margin-left:auto;padding:4px 10px;font-size:12px">✏️ Ändern</button></h3><div class="hub-tiles">' + (quickList().map(function (x) { return tile(x, '#d6a23a'); }).join('') || '<p class="hub-sub">Noch nichts ausgewählt. Mit „Ändern“ legst du deine Lieblingsbereiche fest.</p>') + '</div></section>';
  }
  // ---------- Startseite: zwei Spalten ----------
  function dayBox(iso) { var d = new Date(iso + 'T12:00:00'); return '<span class="hub-dbx"><b>' + ('0' + d.getDate()).slice(-2) + '</b><i>' + ['JAN', 'FEB', 'MÄR', 'APR', 'MAI', 'JUN', 'JUL', 'AUG', 'SEP', 'OKT', 'NOV', 'DEZ'][d.getMonth()] + '</i></span>'; }
  function banner() {
    var l = (state.brett || []).filter(function (b) { return b.wichtig; }).sort(function (a, b) { return String(b.date || '') < String(a.date || '') ? -1 : 1; });
    return l.length ? '<div class="hub-wichtig"><b>Wichtig:</b> ' + esc(l[0].title) + (l[0].text ? ' – ' + esc(l[0].text) : '') + '</div>' : '';
  }
  function brettHtml() {
    var can = SH.has('startseite.brett'); if (!SH.has('brett.view') && !can) return ''; var l = (state.brett || []).slice().sort(function (a, b) { return String(b.date || '') < String(a.date || '') ? -1 : String(b.date || '') > String(a.date || '') ? 1 : 0; });
    var cut = function (t) { t = String(t || ''); return t.length > 110 ? t.slice(0, 108) + ' …' : t; };
    return '<section class="hub-card2" id="brett"><div class="hub-c2h"><h3>📌 Schwarzes Brett</h3><a class="hub-btn hub-ghost" href="/intranet/brett/" style="padding:4px 10px;font-size:12px">' + (can ? 'Verwalten →' : 'Alle ansehen →') + '</a></div>' +
      (l.length ? l.slice(0, 4).map(function (b) { return '<a class="hub-bi" href="/intranet/brett/" style="text-decoration:none;color:inherit"><span class="hub-bic">' + (b.wichtig ? '📣' : '📌') + '</span><div class="hub-bit"><b>' + esc(b.title) + '</b>' + (b.text ? '<p>' + esc(cut(b.text)) + '</p>' : '') + '<i>' + esc(b.by || '') + (b.date ? ' · ' + esc(fmtDMY(b.date).slice(0, 5)) : '') + '</i></div></a>'; }).join('') : '<p class="hub-sub" style="margin:6px 0 0">Zurzeit gibt es keine Mitteilungen.</p>') + '</section>';
  }
  function termineHtml() {
    var n = state.next && state.next.token === SH.token() ? state.next : null; var items = [];
    if (n) {
      (n.wk || []).forEach(function (w) { var sub = 'Wettkampf ' + fmtDMY(w.date).slice(0, 5); items.push({ date: w.date, t: w.title, s: w.ort || '', href: '/intranet/wettkaempfe/' }); });
      (n.ev || []).forEach(function (e) { items.push({ date: e.date, t: e.title, s: e.prog || '', href: '/intranet/veranstaltungen/' }); });
    }
    var wm = state.wm; if (wm && wm.at) { var wiso = String(wm.at).slice(0, 10); if (daysTo(wiso) !== null && daysTo(wiso) >= 0) items.push({ date: wiso, t: wm.label || 'Weihnachtsmarkt', s: '', href: '/intranet/weihnachtsmarkt/' }); }
    items.sort(function (a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
    return '<section class="hub-card2"><div class="hub-c2h"><h3>📅 Nächste Termine</h3></div>' + (items.length ? items.slice(0, 5).map(function (x) { return '<a class="hub-ti" href="' + x.href + '">' + dayBox(x.date) + '<span class="hub-tit"><b>' + esc(x.t) + '</b>' + (x.s ? '<i>' + esc(x.s) + '</i>' : '') + '</span></a>'; }).join('') : '<p class="hub-sub" style="margin:6px 0 0">Keine Termine in Sicht.</p>') + '</section>';
  }
  function quickCompact() {
    var sys = SH.S.systems || []; if (!sys.length) return '';
    var sel = quickList().map(function (x) { return x.url; });
    if (state.qedit) return '<section class="hub-card2"><div class="hub-c2h"><h3>⚡ Schnellzugriffe</h3><button type="button" class="hub-btn hub-gold" data-act="qdone" style="padding:4px 12px;font-size:13px">Fertig</button></div><p class="hub-sub" style="margin:0 0 8px">Tippe an, was du hier haben willst. Das gilt für dein Konto auf allen Geräten.</p><div class="hub-qg">' + sys.map(function (x) { var on = sel.indexOf(x.url) >= 0; return '<button type="button" class="hub-q' + (on ? ' on' : '') + '" data-act="qtog" data-u="' + esc(x.url) + '">' + (on ? '✓ ' : '') + esc(x.icon || '') + ' ' + esc(x.name) + '</button>'; }).join('') + '</div></section>';
    return '<section class="hub-card2"><div class="hub-c2h"><h3>⚡ Meine Schnellzugriffe</h3><button type="button" class="hub-btn hub-ghost" data-act="qedit" style="padding:4px 10px;font-size:12px">✏️ Bearbeiten</button></div><div class="hub-qg">' + (quickList().map(function (x) { return '<a class="hub-q" href="' + esc(x.url) + '">' + esc(x.icon || '') + ' ' + esc(x.name) + '</a>'; }).join('') || '<p class="hub-sub">Noch nichts ausgewählt.</p>') + '</div></section>';
  }
  function aufgabenCard() {
    var n = state.next && state.next.token === SH.token() ? state.next : null; if (!n) return '';
    var l = (n.tasks || []).slice(0, 5); var t = todayIso();
    return '<section class="hub-card2"><div class="hub-c2h"><h3>✅ ' + (n.mine ? 'Meine Aufgaben' : 'Offene Aufgaben') + '</h3><a href="/intranet/aufgaben/" class="hub-sub">' + (n.tasks || []).length + ' offen →</a></div>' + (l.length ? l.map(function (x) { var d = x.due ? daysTo(x.due) : null; var bc = d === null ? '' : d < 0 ? 'bad' : d === 0 ? 'bad' : d <= 7 ? 'warn' : 'info'; return '<a class="hub-ai" href="/intranet/aufgaben/"><span>' + esc(x.title || x.t || '') + '</span>' + (x.due ? '<em class="hub-ab ' + bc + '">' + (d === 0 ? 'heute' : d < 0 ? 'überfällig' : 'bis ' + esc(fmtDMY(x.due).slice(0, 6))) + '</em>' : '') + '</a>'; }).join('') : '<p class="hub-sub" style="margin:6px 0 0">Alles erledigt.</p>') + '</section>';
  }
  function blickHtml() {
    var n = state.next && state.next.token === SH.token() ? state.next : null; if (!n || !n.cnt) return '';
    return '<section class="hub-card2"><div class="hub-c2h"><h3>📊 Verein auf einen Blick</h3></div><div class="hub-bl"><div><i>Mitglieder</i><b>' + n.cnt.mem + '</b></div><div><i>Wettkampfgruppe</i><b>' + n.cnt.wg + '</b></div>' + (n.nstarts ? '<div><i>Nächste Starts</i><b>' + n.nstarts + '</b></div>' : '') + '</div></section>';
  }
  function greetRow() { var nm = SH.S.me ? String(SH.S.me.user || '').split(/\s+/)[0] : ''; return '<div class="hub-greet"><h2>' + (nm ? 'Hallo ' + esc(nm) + ' 👋' : 'Willkommen') + '</h2><span>' + esc(longDate()) + '</span></div>'; }
  function body() {
    var S = SH.S;
    if (!state.loaded) return '<section class="hub-tiles"><div class="hub-skel"></div><div class="hub-skel"></div><div class="hub-skel"></div></section>';
    if (S.offline) return '<section class="hub-card hub-offline"><h2>Keine Verbindung</h2><p class="hub-sub">Das Konto-System ist gerade nicht erreichbar. Bitte prüfe das Internet und versuche es nochmal.</p><button type="button" class="hub-btn hub-gold" data-act="retry">Nochmal versuchen</button><details class="hub-diag"><summary>Technische Details</summary><pre>' + esc(SH.DIAG.length ? SH.DIAG.join('\n') : 'Keine Angaben.') + '</pre></details></section>';
