  function ensurePdfJs() {
    if (window.pdfjsLib) return Promise.resolve(window.pdfjsLib);
    var i = 0;
    function tryNext() {
      if (i >= PDFJS.length) return Promise.reject(new Error('Der PDF-Leser konnte nicht geladen werden. Bitte Internetverbindung prüfen.'));
      var k = i++;
      return M.loadScript(PDFJS[k]).then(function () {
        var lib = window.pdfjsLib; if (!lib) throw new Error('pdf.js fehlt');
        return fetch(WORKER[k]).then(function (r) { return r.text(); }).then(function (t) { lib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(new Blob([t], { type: 'text/javascript' })); }, function () { lib.GlobalWorkerOptions.workerSrc = WORKER[k]; }).then(function () { return lib; });
      }, tryNext);
    }
    return tryNext();
  }
  function readPdf(file) {
    return Promise.all([ensurePdfJs(), new Promise(function (res, rej) { var r = new FileReader(); r.onload = function () { res(new Uint8Array(r.result)); }; r.onerror = function () { rej(new Error('Datei konnte nicht gelesen werden.')); }; r.readAsArrayBuffer(file); })]).then(function (a) {
      return a[0].getDocument({ data: a[1] }).promise.then(function (doc) {
        var pages = []; var chain = Promise.resolve();
        for (var n = 1; n <= doc.numPages; n++) (function (n) { chain = chain.then(function () { return doc.getPage(n).then(function (pg) { return pg.getTextContent().then(function (tc) { pages.push(tc.items.map(function (i) { return { str: i.str, x: i.transform[4], y: i.transform[5], w: i.width }; })); }); }); }); })(n);
        return chain.then(function () { return P.linesFromItems(pages); });
      });
    });
  }
