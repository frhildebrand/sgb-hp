      (canPrint ? '<button type="button" class="wm-btn" data-ma="wkprint">🖨️ Drucken</button>' : '') +
      (M.can('wettkaempfe.import') ? '<button type="button" class="wm-btn" data-ma="wkupdate">📄 Meldeergebnis aktualisieren</button><button type="button" class="wm-btn" data-ma="wkedit">✏️</button><button type="button" class="wm-btn m-danger" data-ma="wkdel">🗑️</button>' : '') + '</span></div>' +
      '<h3 class="m-h2" style="margin:6px 0 2px">' + esc(wk.title) + '</h3><div class="wm-sub">' + [fd(wk.date), esc(wk.ort || ''), esc(wk.veranstalter ? 'Veranstalter: ' + wk.veranstalter : ''), esc(wk.becken || ''), esc(wk.temp ? 'Wasser ' + wk.temp : '')].filter(Boolean).join(' · ') + '</div>' +
      (wk.stand ? '<div class="wm-sub">Stand des Meldeergebnisses: ' + esc(wk.stand.replace(/^(\d{4})-(\d{2})-(\d{2})/, '$3.$2.$1')) + '</div>' : '') + '</section>';
    out += '<div class="wm-tabs">' + views.map(function (v) { return '<button type="button" class="wm-tab' + (s.v === v[0] ? ' on' : '') + '" data-ma="wkview" data-v="' + v[0] + '">' + v[1] + '</button>'; }).join('') + '</div>';
    if (!(wk.starts || []).length && s.v !== 'gericht') return out + '<section class="wm-card"><p class="wm-note">Für diesen Termin gibt es noch kein Meldeergebnis.' + (M.can('wettkaempfe.import') ? ' Tippe oben auf „Meldeergebnis aktualisieren“.' : '') + '</p></section>';
    if (s.v === 'uebersicht') return out + viewUebersicht(wk);
    if (s.v === 'ablauf') return out + viewAblauf(wk);
