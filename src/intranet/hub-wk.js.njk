    var out = '<section class="wm-card"><div class="wm-bar"><h3>Zeiten eintragen</h3></div><p class="wm-note">Zeit z. B. <b>31,20</b> oder <b>1:05,85</b>. Zwischenzeiten mit Leerzeichen oder Semikolon trennen. Es wird automatisch gespeichert.</p>' +
      '<div class="m-chips"><select class="m-search" style="width:auto;margin:0" data-wkswf="1"><option value="">Alle Schwimmer</option>' + sw.map(function (x) { var k = swimmerKey(x.starts[0]); return '<option value="' + esc(k) + '"' + (s.swf === k ? ' selected' : '') + '>' + esc(x.n) + '</option>'; }).join('') + '</select><button type="button" class="m-chip' + (s.onlyOpen ? ' on' : '') + '" data-ma="onlyopen">Nur ohne Zeit</button></div>';
    var st = sortStarts(wk).filter(function (x) { return (!s.swf || swimmerKey(x) === s.swf) && (!s.onlyOpen || !(resOf(wk, x) && (resOf(wk, x).t || resOf(wk, x).st))); });
    if (!st.length) return out + '<p class="wm-note">Nichts zu zeigen.</p></section>';
    out += '<div class="wk-zrows">';
    st.forEach(function (x) {
      var r = resOf(wk, x) || {}; var e = ev(wk, x.e);
      out += '<div class="wk-z" data-k="' + esc(key(x)) + '"><div class="wk-zh"><b>' + esc(x.n) + '</b> <span class="wm-sub">(' + esc(x.j) + ')</span><div class="wm-sub">WK ' + x.e + ' · ' + esc(e.name) + ' · Lauf ' + x.l + ' · Bahn ' + x.b + ' · ca. ' + esc(x.t) + (x.m ? ' · Meldezeit ' + esc(x.m) : '') + '</div></div>' +
        '<div class="wk-zi"><input class="m-time" data-wkt="t" inputmode="decimal" placeholder="Endzeit" value="' + esc(r.t || '') + '"' + (can ? '' : ' disabled') + ' autocomplete="off">' +
        '<input class="m-split" data-wkt="sp" placeholder="Zwischenzeiten" value="' + esc((r.sp || []).join('; ')) + '"' + (can ? '' : ' disabled') + ' autocomplete="off">' +
        '<select data-wkt="st" class="m-time" style="width:auto"' + (can ? '' : ' disabled') + '><option value="">–</option>' + ['DQ', 'nicht angetreten', 'abgemeldet'].map(function (o) { return '<option' + (r.st === o ? ' selected' : '') + '>' + o + '</option>'; }).join('') + '</select><span class="wk-diff">' + diffHtml(wk, x) + '</span></div></div>';
    });
    return out + '</div></section>';
  }
  function viewGericht(wk) {
    var g = wk.gericht || []; var canE = M.can('wettkaempfe.import');
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Kampfgericht – Einsatz für ' + esc(club()) + '</h3><span class="wm-sub">' + g.length + ' Plätze · ' + openDuties(wk) + ' offen</span></div>';
    if (!g.length) return out + '<p class="wm-note">Im Meldeergebnis sind keine Plätze für deinen Verein eingetragen.</p></section>';
    out += '<table class="m-table"><tr><th>Abschnitt</th><th>Position</th><th>Name</th>' + (canE ? '<th></th>' : '') + '</tr>' + g.map(function (x, i) { var open = !x.name || /^N\s?N$/i.test(x.name); return '<tr data-gi="' + i + '"><td>' + x.a + '</td><td>' + esc(x.pos) + '<div class="wm-sub">' + esc(x.g || '') + '</div></td><td>' + (open ? '<span class="m-over">offen</span>' : esc(x.name)) + '</td>' + (canE ? '<td><button type="button" class="wm-btn" data-ma="gedit">✏️</button></td>' : '') + '</tr>'; }).join('') + '</table>';
