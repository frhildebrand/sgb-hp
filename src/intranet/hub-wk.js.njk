  }
  function startLine(wk, st, withName) {
    var e = ev(wk, st.e);
    return '<tr><td class="nowrap"><b>' + esc(st.t) + '</b></td><td>' + (withName ? '<b>' + esc(st.n) + '</b> (' + esc(st.j) + ')<br>' : '') + 'WK ' + st.e + ' · ' + esc(e.name) + '</td><td class="nowrap">Lauf ' + st.l + '/' + st.lt + '<br>Bahn ' + st.b + '</td><td class="nowrap">' + (st.m ? esc(st.m) : '<span class="wm-sub">ohne</span>') + '</td></tr>';
  }
  function viewUebersicht(wk) {
