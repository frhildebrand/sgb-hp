  var P = WKParse; var esc = M.esc;
  var PDFJS = ['https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js', 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js'];
  var WORKER = ['https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js', 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js'];
  var CLUB_KEY = 'wkclub';
  var imp = null;        // laufender Import { parsed, fileName, club }
  function club() { return M.lsGet(CLUB_KEY, 'SG Barnstorf') || 'SG Barnstorf'; }
  function sub() { var s = M.S.sub; if (!s.v) s.v = 'uebersicht'; return s; }
  function fd(iso) { return iso ? M.fmtDate(iso) : ''; }
  function fs(iso) { return iso ? M.fmtDate(iso, true) : ''; }
  function ev(wk, no) { var l = wk.events || []; for (var i = 0; i < l.length; i++) if (l[i].no === no) return l[i]; return { no: no, name: 'Wettkampf ' + no }; }
  function key(s) { return s.e + '-' + s.l + '-' + s.b; }
  function swimmerKey(s) { return s.n + '|' + s.j; }
  function sortStarts(wk) {
    return (wk.starts || []).slice().sort(function (a, b) {
      var ea = ev(wk, a.e), eb = ev(wk, b.e);
      if ((ea.ab || 1) !== (eb.ab || 1)) return (ea.ab || 1) - (eb.ab || 1);
      return a.e - b.e || a.l - b.l || a.b - b.b;
    });
  }
  function swimmers(wk) {
    var m = {}; (wk.starts || []).forEach(function (s) { var k = swimmerKey(s); (m[k] = m[k] || { n: s.n, j: s.j, s: s.s, starts: [] }).starts.push(s); });
    return Object.keys(m).map(function (k) { return m[k]; }).sort(function (a, b) { return a.n.localeCompare(b.n, 'de'); });
  }
  function resOf(wk, s) { return (wk.res || {})[key(s)] || null; }
  function todosOf(id) { return M.items('aufgaben').filter(function (t) { return t.ref === 'wk:' + id; }).sort(function (a, b) { return (a.due || '9999') < (b.due || '9999') ? -1 : 1; }); }
  function openDuties(wk) { return (wk.gericht || []).filter(function (g) { return /^N\s?N$/i.test(g.name || '') || !g.name; }).length; }
  function timeRange(wk) {
    var st = sortStarts(wk); if (!st.length) return '';
    var a = st[0].t, b = st[st.length - 1].t; return a === b ? 'ca. ' + a + ' Uhr' : 'ca. ' + a + ' – ' + b + ' Uhr';
  }
  function diffHtml(wk, s) {
    var r = resOf(wk, s); if (!r) return '';
    if (r.st) return '<span class="m-over">' + esc(r.st) + '</span>';
    if (!r.t) return '';
    var a = P.timeMs(r.t), m = P.timeMs(s.m); if (a === null || m === null) return '';
    var d = a - m; return '<span class="' + (d < 0 ? 'm-ok' : '') + '">' + P.diffStr(d) + (d < 0 ? ' 🎉 Bestzeit' : '') + '</span>';
  }

  /* ---------- Übersicht aller Wettkämpfe ---------- */
  function listPage() {
    var all = M.items('wettkaempfe').sort(function (a, b) { return String(a.date || '') < String(b.date || '') ? -1 : 1; });
    var t = M.today();
    var up = all.filter(function (w) { return (w.date || '9999') >= t; });
    var past = all.filter(function (w) { return (w.date || '9999') < t; }).reverse();
    var canImp = M.can('wettkaempfe.import');
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Nächste Wettkämpfe</h3><span class="m-actions">' + (canImp ? '<button type="button" class="wm-btn" data-ma="wkneu">➕ Termin ohne PDF</button><button type="button" class="wm-amber" data-ma="wkimport">📄 Meldeergebnis hochladen</button>' : '') + '</span></div>';
    if (!up.length) out += '<p class="wm-note">Keine anstehenden Wettkämpfe. ' + (canImp ? 'Lade ein Meldeergebnis (PDF) hoch, dann erscheint es hier.' : '') + '</p>';
    up.forEach(function (w) { out += wkCard(w, false); });
    out += '</section>';
    if (past.length) {
      var open = M.S.sub.pastOpen;
      out += '<section class="wm-card"><div class="wm-bar"><h3>Vergangene Wettkämpfe (' + past.length + ')</h3><button type="button" class="wm-btn" data-ma="pasttoggle">' + (open ? 'Ausblenden' : 'Anzeigen') + '</button></div>' + (open ? past.map(function (w) { return wkCard(w, true); }).join('') : '') + '</section>';
    }
    return out;
  }
  function wkCard(w, isPast) {
    var dd = M.daysTo(w.date); var todos = isPast ? [] : todosOf(w.id);
    var openT = todos.filter(function (x) { return x.status !== 'erledigt'; });
    var sw = swimmers(w).length;
    var when = dd === null ? '' : dd === 0 ? 'heute' : dd === 1 ? 'morgen' : dd > 0 ? 'in ' + dd + ' Tagen' : 'vor ' + (-dd) + ' Tagen';
    var d = w.date ? new Date(w.date + 'T12:00:00') : null;
    var dbox = d ? '<div class="wk-date"><b>' + ('0' + d.getDate()).slice(-2) + '</b><span>' + ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'][d.getMonth()] + '</span></div>' : '<div class="wk-date"><b>?</b></div>';
    var nOpen = openDuties(w);
    var out = '<article class="m-card wk-card" data-id="' + esc(w.id) + '"><div class="m-head" data-ma="wkopen">' + dbox + '<div class="m-main"><div class="m-title">' + esc(w.title) + '</div><div class="wm-sub">' + [fd(w.date), when, esc(w.ort || '')].filter(Boolean).join(' · ') + '</div><div class="wm-sub">' + [(w.starts || []).length ? sw + ' Schwimmer · ' + w.starts.length + ' Starts' : 'Noch kein Meldeergebnis', timeRange(w), nOpen ? '⚠️ ' + nOpen + ' Kampfgericht-Plätze offen' : ''].filter(Boolean).join(' · ') + '</div></div><span class="m-chev">›</span></div>';
    if (!isPast && (todos.length || M.can('aufgaben.edit'))) {
      out += '<div class="wk-todos"><div class="wm-sub" style="font-weight:800;text-transform:uppercase;letter-spacing:.04em">To-dos' + (openT.length ? ' (' + openT.length + ' offen)' : '') + '</div>' +
        todos.map(function (t) { var done = t.status === 'erledigt'; var o = M.daysTo(t.due); var canTick = M.can('aufgaben.edit') || (M.can('aufgaben.own')); return '<div class="m-chk" data-tid="' + esc(t.id) + '"><button type="button" class="m-box' + (done ? ' on' : '') + '" data-ma="wktick"' + (canTick ? '' : ' disabled') + '>' + (done ? '✓' : '') + '</button><span style="flex:1' + (done ? ';text-decoration:line-through;opacity:.6' : '') + '">' + esc(t.title) + (t.who && t.who.length ? ' <span class="wm-sub">· ' + esc(t.who.join(', ')) + '</span>' : '') + '</span>' + (t.due ? '<span class="wm-sub ' + (!done && o < 0 ? 'm-over' : '') + '">' + fs(t.due) + '</span>' : '') + '</div>'; }).join('') +
        (M.can('aufgaben.edit') ? '<button type="button" class="wm-btn" data-ma="wktodo" style="margin-top:6px">+ To-do</button>' : '') + '</div>';
    }
    return out + '</article>';
  }

  /* ---------- Detailansicht ---------- */
  function detail(wk) {
    var s = sub();
    var views = [['uebersicht', 'Übersicht'], ['ablauf', 'Ablauf'], ['zeiten', 'Zeiten'], ['gericht', 'Kampfgericht']];
    var canPrint = M.can('wettkaempfe.print');
