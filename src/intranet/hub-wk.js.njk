/* Wettkämpfe: Checkliste pro Wettkampf, Tabellenansicht, Unterlagen (Ausschreibung → Meldedatei → Meldeergebnis → Protokoll), Zeiten, Drucken. */
(function () {
  'use strict';
  var M = window.HubMod; if (!M) return;
  var P = WKParse; var esc = M.esc;
  var CLUB_KEY = 'wkclub';
  var imp = null;        // laufender Import { parsed, fileName, club }
  function club() { return M.lsGet(CLUB_KEY, 'SG Barnstorf') || 'SG Barnstorf'; }
  function sub() { var s = M.S.sub; if (!s.v) s.v = 'uebersicht'; return s; }
  var fd = M.fd, fs = M.fs;
  function ev(wk, no) { var l = wk.events || []; for (var i = 0; i < l.length; i++) if (l[i].no === no) return l[i]; return { no: no, name: 'Wettkampf ' + no }; }
  function key(s) { return s.e + '-' + s.l + '-' + s.b; }
  function swimmerKey(s) { return s.n + '|' + s.j; }
  function sortStarts(wk) {
    return (wk.starts || []).slice().sort(function (a, b) {
      var ea = ev(wk, a.e), eb = ev(wk, b.e);
      if ((ea.ab || 1) !== (eb.ab || 1)) return (ea.ab || 1) - (eb.ab || 1);
      return a.e - b.e || a.l - b.l || a.b - b.b;
    });
  }
  function swimmers(wk) {
    var m = {}; (wk.starts || []).forEach(function (s) { var k = swimmerKey(s); (m[k] = m[k] || { n: s.n, j: s.j, s: s.s, starts: [] }).starts.push(s); });
    return Object.keys(m).map(function (k) { return m[k]; }).sort(function (a, b) { return a.n.localeCompare(b.n, 'de'); });
  }
  function resOf(wk, s) { return (wk.res || {})[key(s)] || null; }
  function openDuties(wk) { return (wk.gericht || []).filter(function (g) { return /^N\s?N$/i.test(g.name || '') || !g.name; }).length; }
  function diffHtml(wk, s) {
    var r = resOf(wk, s); if (!r) return '';
    if (r.st) return '<span class="m-over">' + esc(r.st) + '</span>';
    if (!r.t) return '';
    var a = P.timeMs(r.t), m = P.timeMs(s.m); if (a === null || m === null) return '';
    var d = a - m; return '<span class="' + (d < 0 ? 'm-ok' : '') + '">' + P.diffStr(d) + (d < 0 ? ' 🎉 Bestzeit' : '') + '</span>';
  }

  var PHASES = [
    { id: 'plan', label: 'Planung', items: [['webclub', 'WebClub angelegt'], ['krabfrage', 'Kampfrichter abgefragt'], ['bekWA', 'Bekanntgabe WhatsApp']] },
    { id: 'meld', label: 'Meldung', items: [['lizenzen', 'DSV-Lizenzen geprüft'], ['@intMs', 'Interner Meldeschluss'], ['geprueft', 'Meldungen geprüft'], ['versendet', 'Meldungen versendet'], ['@meldegeld', 'Meldegeld'], ['bestaetigung', 'Meldebestätigung erhalten']] },
    { id: 'erg', label: 'Nach Meldeergebnis', items: [['waGruppe', 'WhatsApp-Gruppe'], ['meWA', 'Meldeergebnis in WhatsApp']] },
    { id: 'wk', label: 'Wettkampf', items: [['@teilnahme', 'Teilnahme'], ['@kr1', 'Kampfrichter Abschnitt 1'], ['@kr2', 'Kampfrichter Abschnitt 2']] },
    { id: 'nach', label: 'Nachbereitung', items: [['urkGedruckt', 'Urkunden gedruckt'], ['urkVerteilt', 'Urkunden verteilt'], ['artikel', 'Artikel für die Homepage']] }
  ];
  var BOXES = []; PHASES.forEach(function (p) { p.items.forEach(function (i) { if (i[0].charAt(0) !== '@') BOXES.push(i); }); });
  var STEPS = BOXES.length + 1;
  function canCheck() { return M.can('wettkaempfe.check'); }
  function isOn(wk, k) { return !!(wk.chk && wk.chk[k]); }
  function done(wk) { var n = 0; BOXES.forEach(function (b) { if (isOn(wk, b[0])) n++; }); if (wk.meldegeldStatus === 'bezahlt') n++; return n; }
  function clock(wk) { return wk.meldeschlussUhr ? ' ' + esc(wk.meldeschlussUhr) + ' Uhr' : ''; }
  function tg(n) { return n + (n === 1 ? ' Tag' : ' Tagen'); }
  function warnings(wk) {
    var out = []; var past = wk.date && wk.date < M.today();
    if (past) return out;
    var sent = isOn(wk, 'versendet');
    if (wk.meldeschluss && !sent) {
      var d = M.daysTo(wk.meldeschluss);
      if (d < 0) out.push({ c: 'bad', t: 'Meldeschluss vorbei (' + fs(wk.meldeschluss) + ')' });
      else if (d <= 7) out.push({ c: d <= 2 ? 'bad' : 'warn', t: 'Meldeschluss ' + (d === 0 ? 'heute' : d === 1 ? 'morgen' : 'in ' + tg(d)) + (d <= 1 ? clock(wk) : '') });
    }
    if (wk.intMs && !sent && !isOn(wk, 'geprueft')) {
      var di = M.daysTo(wk.intMs);
      if (di < 0) out.push({ c: 'bad', t: 'Interner Meldeschluss überschritten (' + fs(wk.intMs) + ')' });
      else if (di <= 3) out.push({ c: 'warn', t: 'Interner Meldeschluss ' + (di === 0 ? 'heute' : 'in ' + tg(di)) });
    }
    var no = openDuties(wk); if (no && (wk.gericht || []).length) out.push({ c: 'warn', t: no + ' Kampfgericht-Platz' + (no > 1 ? 'e' : '') + ' offen' });
    return out;
  }
  function warnHtml(wk) { return warnings(wk).map(function (w) { return '<span class="wk-w ' + w.c + '">' + esc(w.t) + '</span>'; }).join(''); }
  function teilTxt(v) { return v === 'pos' ? 'Teilnahme: ja' : v === 'neg' ? 'Teilnahme: nein' : ''; }

  /* ---------- Kampfrichter-Vorschlag ---------- */
  function abList(wk) { var l = (wk.abschnitte || []).map(function (a) { return a.no; }); return l.length ? l : [1]; }
  function krSuggest(wk, ab) {
    var g = (wk.gericht || []).filter(function (x) { return x.a === ab; }).length;
    if (g) return { n: g, src: g + ' Plätze im Meldeergebnis' };
    var src = (wk.starts || []).length ? wk.starts : ((wk.meld && wk.meld.starts) || []);
    if (!src.length || !(wk.kr || []).length) return null;
    var cnt = src.filter(function (s) { return (ev(wk, s.e).ab || 1) === ab; }).length;
    var n = P.krFor(wk.kr, cnt);
    return n === null ? null : { n: n, src: cnt + ' Meldungen laut Ausschreibung' };
  }

  /* ---------- Übersicht aller Wettkämpfe ---------- */
  function sortedAll() { return M.items('wettkaempfe').sort(function (a, b) { var x = String(a.date || '9999'), y = String(b.date || '9999'); return x < y ? -1 : x > y ? 1 : 0; }); }
  function viewSwitch(v) { return M.seg([['karten', 'Karten'], ['tabelle', 'Tabelle']], v, 'wklist'); }
  function listPage() {
    var all = sortedAll(); var t = M.today(); var lv = M.S.sub.lv || 'karten';
    var up = all.filter(function (w) { return (w.date || '9999') >= t; });
    var past = all.filter(function (w) { return (w.date || '9999') < t; }).reverse();
    var canImp = M.anyCan(['wettkaempfe.import', 'wettkaempfe.anlegen']);
    var out = '<section class="wm-card"><div class="wm-bar"><span class="m-actions" style="margin-right:auto;align-items:center"><h3 style="margin:0 10px 0 0">Wettkämpfe</h3>' + viewSwitch(lv) + '</span><span class="m-actions" style="margin-left:auto">' + (canImp ? '<button type="button" class="wm-btn" data-ma="wkneu">➕ Termin</button><button type="button" class="wm-amber" data-ma="wkaus">📄 Neu aus Ausschreibung</button><button type="button" class="wm-btn" data-ma="wkbulk">📦 Mehrere CSV</button><button type="button" class="wm-btn" data-ma="wkneumeld">📋 Neu aus Meldedatei</button>' : '') + '</span></div>';
    if (lv === 'tabelle') {
      var rows = M.S.sub.allRows ? all : up.concat(past.filter(function (w) { return M.daysTo(w.date) >= -45; }));
      out += tableHtml(rows) + '<p class="wm-note"><button type="button" class="m-chip' + (M.S.sub.allRows ? ' on' : '') + '" data-ma="allrows">Auch ältere zeigen</button> Tippe auf ein Feld, um es abzuhaken.</p></section>';
      return out;
    }
    if (!up.length) out += '<p class="wm-note">Keine anstehenden Wettkämpfe. ' + (canImp ? 'Lege einen Termin an oder erstelle einen Wettkampf aus Ausschreibung, Meldedatei.' : '') + '</p>';
    up.forEach(function (w) { out += wkCard(w, false); });
    out += '</section>';
    if (past.length) {
      var open = M.S.sub.pastOpen;
      out += '<section class="wm-card"><div class="wm-bar"><h3>Vergangene Wettkämpfe (' + past.length + ')</h3><button type="button" class="wm-btn" data-ma="pasttoggle">' + (open ? 'Ausblenden' : 'Anzeigen') + '</button></div>' + (open ? past.map(function (w) { return wkCard(w, true); }).join('') : '') + '</section>';
    }
    return out;
  }
  function wkCard(w, isPast) {
    var dd = M.daysTo(w.date);
    var sw = swimmers(w).length;
    var when = dd === null ? '' : dd === 0 ? 'heute' : dd === 1 ? 'morgen' : dd > 0 ? 'in ' + dd + ' Tagen' : 'vor ' + (-dd) + ' Tagen';
    var d = w.date ? new Date(w.date + 'T12:00:00') : null;
    var dbox = d ? '<div class="wk-date"><b>' + ('0' + d.getDate()).slice(-2) + '</b><span>' + ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'][d.getMonth()] + '</span></div>' : '<div class="wk-date"><b>?</b></div>';
    var nd = done(w);
    var info = [(w.starts || []).length ? sw + ' Schwimmer · ' + w.starts.length + ' Starts' : ((w.meld && w.meld.starts || []).length ? 'Gemeldet: ' + (w.meld.n || '') + ' Schwimmer' : 'Noch keine Meldung'), isPast ? teilTxt(w.teilnahme) : ''].filter(Boolean).join(' · ');
    return '<article class="m-card wk-card" data-id="' + esc(w.id) + '"><div class="m-head" data-ma="wkopen">' + dbox + '<div class="m-main"><div class="m-title">' + esc(w.title) + '</div><div class="wm-sub">' + [fd(w.date), when, esc(w.ort || '')].filter(Boolean).join(' · ') + '</div><div class="wm-sub">' + info + '</div>' +
      (isPast ? '' : '<div class="wk-prog">' + M.prog(nd, STEPS) + ' <span class="wm-sub">erledigt</span></div>' + warnHtml(w)) + '</div><span class="m-chev">›</span></div></article>';
  }

  /* ---------- Tabelle wie im Sheet ---------- */
  function tableHtml(rows) {
    if (!rows.length) return '<p class="wm-note">Keine Wettkämpfe.</p>';
    var can = canCheck(); var canT = canCheck() || M.can('wettkaempfe.teilnahme'); var canK = canCheck() || M.can('wettkaempfe.krzahl');
    var h1 = '<tr class="ph"><th></th>' + PHASES.map(function (p) { return '<th colspan="' + p.items.length + '">' + esc(p.label) + '</th>'; }).join('') + '<th></th></tr>';
    var h2 = '<tr><th>Wettkampf</th>' + PHASES.map(function (p) { return p.items.map(function (i) { return '<th title="' + esc(i[1]) + '">' + esc(shortLabel(i)) + '</th>'; }).join(''); }).join('') + '<th>Fertig</th></tr>';
    var body = rows.map(function (w) {
      var tds = PHASES.map(function (p) {
        return p.items.map(function (i) {
          var k = i[0];
          if (k === '@intMs') return '<td><button type="button" class="m-chip wk-tc" data-ma="wkcell" data-w="' + esc(w.id) + '" data-k="intMs"' + (can ? '' : ' disabled') + '>' + (w.intMs ? esc(fs(w.intMs).replace(/^\S+\s/, '')) : '–') + '</button></td>';
          if (k === '@meldegeld') return '<td><button type="button" class="m-chip wk-tc" data-ma="wkcell" data-w="' + esc(w.id) + '" data-k="meldegeld"' + (can ? '' : ' disabled') + '>' + (w.meldegeldStatus === 'bezahlt' ? '✓ bezahlt' : w.meldegeldStatus === 'mail' ? '✉ Mail' : '–') + '</button></td>';
          if (k === '@teilnahme') return '<td><button type="button" class="m-chip wk-tc" data-ma="wkcell" data-w="' + esc(w.id) + '" data-k="teilnahme"' + (canT ? '' : ' disabled') + '>' + (w.teilnahme === 'pos' ? '✓ ja' : w.teilnahme === 'neg' ? '✗ nein' : '–') + '</button></td>';
          if (k === '@kr1' || k === '@kr2') { var f = k.slice(1); return '<td><button type="button" class="m-chip wk-tc" data-ma="wkcell" data-w="' + esc(w.id) + '" data-k="' + f + '"' + (canK ? '' : ' disabled') + '>' + (w[f] === undefined || w[f] === '' || w[f] === null ? '–' : esc(w[f])) + '</button></td>'; }
          var on = isOn(w, k);
          return '<td><button type="button" class="m-cell' + (on ? ' on' : '') + '" data-ma="wkcell" data-w="' + esc(w.id) + '" data-k="' + k + '"' + (can ? '' : ' disabled') + '>' + (on ? '✓' : '') + '</button></td>';
        }).join('');
      }).join('');
      return '<tr><td><button type="button" class="wk-tl" data-ma="wkopen" data-id="' + esc(w.id) + '"><b>' + esc(w.title) + '</b></button><div class="wm-sub">' + fs(w.date) + '</div></td>' + tds + '<td><b>' + done(w) + '/' + STEPS + '</b></td></tr>';
    }).join('');
    return '<div class="m-twrap"><table>' + h1 + h2 + body + '</table></div>';
  }
  function shortLabel(i) {
    var m = { webclub: 'WebClub', krabfrage: 'KR-Abfr.', bekWA: 'WA', '@meldegeld': 'Meldegeld', artikel: 'Artikel', lizenzen: 'Lizenzen', '@intMs': 'Int. MS', geprueft: 'Geprüft', versendet: 'Versandt', bestaetigung: 'Bestät.', waGruppe: 'WA-Gr.', meWA: 'ME WA', '@teilnahme': 'Teiln.', '@kr1': 'KR 1', '@kr2': 'KR 2', urkGedruckt: 'Urk. dr.', urkVerteilt: 'Urk. vert.' };
    return m[i[0]] || i[1];
  }
  function toggleChk(wk, k) {
    var on = isOn(wk, k); var f = {}; f[k] = on ? null : { by: M.userName(), at: M.today() };
    M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, merge: true, fields: { chk: f } });
  }
  function cellEdit(wk, k) {
    var fields, item = {}, save;
    if (k === 'intMs') { fields = [{ k: 'v', t: 'date', label: 'Interner Meldeschluss' }]; item.v = wk.intMs || ''; save = function (v) { M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, fields: { intMs: v.v } }); }; }
    else if (k === 'teilnahme') { fields = [{ k: 'v', t: 'sel', label: 'Teilnahme', opts: [['', 'Offen'], ['pos', 'Positiv (nehmen teil)'], ['neg', 'Negativ (nehmen nicht teil)']] }]; item.v = wk.teilnahme || ''; save = function (v) { M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, fields: { teilnahme: v.v } }); }; }
    else { var ab = k === 'kr1' ? 1 : 2; var sg = krSuggest(wk, ab); fields = [{ k: 'v', t: 'num', label: 'Kampfrichter Abschnitt ' + ab, hint: sg ? 'Vorschlag: ' + sg.n + ' (' + sg.src + ')' : '' }]; item.v = wk[k] === undefined ? (sg ? sg.n : '') : wk[k]; save = function (v) { var f = {}; f[k] = v.v; M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, fields: f }); }; }
    M.openForm({ title: wk.title, fields: fields, item: item, onSave: save });
  }

  /* ---------- Detail ---------- */
  function detail(wk) {
    var s = sub();
    if (s.v === 'ablauf' || s.v === 'zeiten') s.v = 'uebersicht';
    var views = [['check', 'Checkliste'], ['uebersicht', 'Starts'], ['gericht', 'Kampfgericht'], ['docs', 'Unterlagen']]; if (M.anyCan(['wettkaempfe.zeiten', 'wettkaempfe.vorort'])) views.splice(2, 0, ['vorort', 'Vor Ort']); if (Object.keys(wk.res || {}).length && M.anyCan(['wettkaempfe.artikel', 'wettkaempfe.import', 'wettkaempfe.zeiten'])) views.push(['artikel', 'Artikel']);
    var canPrint = M.can('wettkaempfe.print'); var canImp = M.anyCan(['wettkaempfe.import', 'wettkaempfe.anlegen']);
    var out = '<section class="wm-card"><div class="wm-bar"><button type="button" class="wm-btn" data-ma="wkback">← Alle Wettkämpfe</button><span class="m-actions">' +
      (canPrint ? '<button type="button" class="wm-btn" data-ma="wkprint">🖨️ Drucken</button>' : '') +
      (canImp ? '<button type="button" class="wm-btn" data-ma="wkedit">✏️</button>' : '') + (M.anyCan(['wettkaempfe.import', 'wettkaempfe.loeschen']) ? '<button type="button" class="wm-btn m-danger" data-ma="wkdel">🗑️</button>' : '') + '</span></div>' +
      '<h3 class="m-h2" style="margin:6px 0 2px">' + esc(wk.title) + '</h3><div class="wm-sub">' + [fd(wk.date), esc(wk.ort || ''), esc(wk.veranstalter ? 'Veranstalter: ' + wk.veranstalter : ''), esc(wk.becken || ''), esc(wk.temp ? 'Wasser ' + wk.temp : '')].filter(Boolean).join(' · ') + '</div>' +
      (wk.stand ? '<div class="wm-sub">Stand des Meldeergebnisses: ' + esc(wk.stand.replace(/^(\d{4})-(\d{2})-(\d{2})/, '$3.$2.$1')) + '</div>' : '') + '<div class="wk-prog" style="margin-top:8px">' + M.prog(done(wk), STEPS) + ' <span class="wm-sub">erledigt</span></div>' + warnHtml(wk) + '</section>';
    out += '<div class="wm-tabs">' + views.map(function (v) { return '<button type="button" class="wm-tab' + (s.v === v[0] ? ' on' : '') + '" data-ma="wkview" data-v="' + v[0] + '">' + v[1] + '</button>'; }).join('') + '</div>';
    if (s.v === 'check') return out + viewCheck(wk);
    if (s.v === 'docs') return out + viewDocs(wk);
    if (s.v === 'gericht') return out + viewGericht(wk);
    if (s.v === 'artikel') return out + viewArtikel(wk);
    if (s.v === 'vorort') return out + ((wk.starts || []).length ? viewVorort(wk) : '<section class="wm-card"><p class="wm-note">Die Vor-Ort-Seite braucht das Meldeergebnis (Läufe und Bahnen). Bitte unter „Unterlagen“ hochladen.</p></section>');
    if (!(wk.starts || []).length) {
      if (s.v === 'uebersicht' && wk.meld && (wk.meld.starts || []).length) return out + viewGemeldet(wk);
      return out + '<section class="wm-card"><p class="wm-note">Für diesen Termin gibt es noch kein Meldeergebnis.' + (canImp ? ' Unter „Unterlagen“ kannst du es hochladen.' : '') + '</p></section>';
    }
    return out + viewUebersicht(wk) + '<div class="m-sec">Ablauf</div>' + viewAblauf(wk);
  }
  function whoAt(c) { return c ? '<span class="wm-sub"> · ' + esc(c.by || '') + (c.at ? ', ' + fs(c.at) : '') + '</span>' : ''; }
  function viewCheck(wk) {
    var can = canCheck(); var canT = canCheck() || M.can('wettkaempfe.teilnahme'); var canK = canCheck() || M.can('wettkaempfe.krzahl');
    var out = '';
    if (wk.meldeschluss || wk.meldegeld || wk.meldeanschrift) {
      out += '<section class="wm-card"><div class="wm-sub" style="font-weight:800;text-transform:uppercase">Aus der Ausschreibung</div>' +
        (wk.meldeschluss ? '<div><b>Meldeschluss:</b> ' + fd(wk.meldeschluss) + clock(wk) + '</div>' : '') + (wk.meldegeld ? '<div><b>Meldegeld:</b> ' + esc(P.cleanGeld(wk.meldegeld)) + '</div>' : '') + (wk.meldeanschrift ? '<div><b>Meldeanschrift:</b> ' + esc(wk.meldeanschrift) + '</div>' : '') + '</section>';
    }
    PHASES.forEach(function (p) {
      out += '<section class="wm-card"><div class="m-sec" style="margin-top:0">' + esc(p.label) + '</div>';
      p.items.forEach(function (i) {
        var k = i[0];
        if (k === '@intMs') {
          out += '<div class="m-chk"><span style="flex:1">' + esc(i[1]) + '</span><input type="date" class="m-time" style="width:auto" data-wkims="1" value="' + esc(wk.intMs || '') + '"' + (can ? '' : ' disabled') + '></div>'; return;
        }
        if (k === '@meldegeld') { out += '<div class="m-chk" style="flex-wrap:wrap"><span style="flex:1;min-width:6em">Meldegeld' + (wk.meldegeld ? '<div class="wm-sub">' + esc(P.cleanGeld(wk.meldegeld)) + '</div>' : '') + '</span>' + M.seg([['', 'Offen'], ['mail', 'Mail versendet'], ['bezahlt', 'Bezahlt']], wk.meldegeldStatus || '', can || M.can('wettkaempfe.meldegeld') ? 'wkgeld' : 'wknop') + '</div>'; return; }
        if (k === '@teilnahme') {
          out += '<div class="m-chk"><span style="flex:1">Teilnahme</span>' + M.seg([['', 'Offen'], ['pos', 'Positiv'], ['neg', 'Negativ']], wk.teilnahme || '', canT ? 'wkteil' : 'wknop') + '</div>'; return;
        }
        if (k === '@kr1' || k === '@kr2') {
          var f = k.slice(1); var ab = f === 'kr1' ? 1 : 2;
          if (ab === 2 && abList(wk).length < 2 && (wk[f] === undefined || wk[f] === '')) return;
          var sg = krSuggest(wk, ab); var gm = ((wk.meld && wk.meld.kari) || []).filter(function (x) { return (x.ab || []).indexOf(ab) >= 0; }).map(function (x) { return x.name; });
          out += '<div class="m-chk"><span style="flex:1">' + esc(i[1]) + (gm.length ? '<div class="wm-sub">Gemeldet: ' + esc(gm.join(', ')) + '</div>' : '') + (sg ? '<div class="wm-sub">Vorschlag ' + sg.n + ' · ' + esc(sg.src) + '</div>' : '') + '</span><input type="number" inputmode="numeric" min="0" class="m-time" style="width:5em" data-wkkr="' + f + '" value="' + esc(wk[f] === undefined || wk[f] === null ? '' : wk[f]) + '" placeholder="' + (sg ? sg.n : '') + '"' + (canK ? '' : ' disabled') + '>' + (sg && canK && (wk[f] === undefined || wk[f] === '') ? '<button type="button" class="wm-btn" data-ma="wkkrtake" data-k="' + f + '" data-n="' + sg.n + '">übernehmen</button>' : '') + '</div>'; return;
        }
        var c = wk.chk && wk.chk[k]; var on = !!c;
        out += '<div class="m-chk"><button type="button" class="m-box' + (on ? ' on' : '') + '" data-ma="wkchk" data-k="' + k + '"' + (can ? '' : ' disabled') + '>' + (on ? '✓' : '') + '</button><span style="flex:1' + (on ? ';opacity:.7' : '') + '">' + esc(i[1]) + whoAt(c) + '</span></div>';
      });
      out += '</section>';
    });
    return out;
