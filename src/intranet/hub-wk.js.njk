  /* ---------- Drucken ---------- */
  var PCSS = '';
  function printMenu(wk) {
    M.openDlg('<div class="hub-dhead"><h3>Drucken</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div><div class="m-btns" style="flex-direction:column;align-items:stretch">' +
      '<button type="button" class="wm-btn" data-ma="pr" data-w="start">📋 Startliste (nach Uhrzeit)</button>' +
      '<button type="button" class="wm-btn" data-ma="pr" data-w="slips">🧾 Laufzettel pro Schwimmer (zum Eintragen)</button>' +
      '<button type="button" class="wm-btn" data-ma="pr" data-w="eltern">👪 Übersicht je Schwimmer (kompakt)</button>' +
      '<button type="button" class="wm-btn" data-ma="pr" data-w="res">🏅 Ergebnisse</button></div>');
  }
  function head(wk, what) { return '<h1>' + esc(what) + '</h1><div class="sub"><b>' + esc(wk.title) + '</b> · ' + fd(wk.date) + (wk.ort ? ' · ' + esc(wk.ort) : '') + '</div>'; }
  function printWhat(wk, what) {
    var body = '';
    if (what === 'start') {
      body = head(wk, 'Startliste ' + club()) + '<table><tr><th>Uhr</th><th>Schwimmer / Strecke</th><th>Lauf / Bahn</th><th>Meldezeit</th></tr>' + sortStarts(wk).map(function (s) { return startLine(wk, s, true); }).join('') + '</table>';
      (wk.abschnitte || []).forEach(function (a) { body += '<div class="sub">Abschnitt ' + a.no + ': ' + [a.einlass && 'Einlass ' + a.einlass, a.einschwimmen && 'Einschwimmen ' + a.einschwimmen, a.kr && 'Kampfrichtersitzung ' + a.kr, a.beginn && 'Beginn ' + a.beginn].filter(Boolean).map(esc).join(' · ') + '</div>'; });
    } else if (what === 'slips') {
      body = head(wk, 'Laufzettel');
      swimmers(wk).forEach(function (x) {
        body += '<div class="slip"><div class="big"><b>' + esc(x.n) + '</b> (' + esc(x.j) + ')</div><table><tr><th>Uhr</th><th>Strecke</th><th>Lauf/Bahn</th><th>Meldezeit</th><th>Endzeit</th><th>Zwischenzeiten</th></tr>' + x.starts.slice().sort(function (a, b) { return a.t < b.t ? -1 : 1; }).map(function (s) { return '<tr><td class="nowrap">' + esc(s.t) + '</td><td>WK ' + s.e + ' ' + esc(ev(wk, s.e).name) + '</td><td class="nowrap">' + s.l + '/' + s.lt + ' · B ' + s.b + '</td><td class="nowrap">' + esc(s.m || '–') + '</td><td><span class="blank"></span></td><td><span class="blank" style="min-width:120px"></span></td></tr>'; }).join('') + '</table></div>';
      });
    } else if (what === 'eltern') {
      body = head(wk, 'Meine Starts');
      swimmers(wk).forEach(function (x) { body += '<div class="slip"><b>' + esc(x.n) + '</b> (' + esc(x.j) + ')<br>' + x.starts.slice().sort(function (a, b) { return a.t < b.t ? -1 : 1; }).map(function (s) { return esc(s.t) + ' Uhr · ' + esc(ev(wk, s.e).name) + ' · Lauf ' + s.l + '/' + s.lt + ' · Bahn ' + s.b; }).join('<br>') + '</div>'; });
    } else {
      body = head(wk, 'Ergebnisse');
      swimmers(wk).forEach(function (x) { body += '<h3>' + esc(x.n) + ' (' + esc(x.j) + ')</h3><table><tr><th>Strecke</th><th>Meldezeit</th><th>Zeit</th><th>Zwischenzeiten</th><th>Differenz</th></tr>' + x.starts.slice().sort(function (a, b) { return a.t < b.t ? -1 : 1; }).map(function (s) { var r = resOf(wk, s) || {}; var d = ''; var a = P.timeMs(r.t), m = P.timeMs(s.m); if (r.st) d = esc(r.st); else if (a !== null && m !== null) d = P.diffStr(a - m); return '<tr><td>' + esc(ev(wk, s.e).name) + '</td><td class="nowrap">' + esc(s.m || '–') + '</td><td class="nowrap"><b>' + esc(r.t || '') + '</b></td><td>' + esc((r.sp || []).join(' · ')) + '</td><td class="nowrap">' + d + '</td></tr>'; }).join('') + '</table>'; });
    }
    if (what === 'start' || what === 'slips') { var g = wk.gericht || []; if (g.length && what === 'start') body += '<h2>Kampfgericht ' + esc(club()) + '</h2><table><tr><th>Abschn.</th><th>Position</th><th>Name</th></tr>' + g.map(function (x) { return '<tr><td>' + x.a + '</td><td>' + esc(x.pos) + '</td><td>' + (/^N\s?N$/i.test(x.name) ? '<i>noch offen</i>' : esc(x.name)) + '</td></tr>'; }).join('') + '</table>'; }
    M.print(wk.title, body);
  }

  /* ---------- Modul ---------- */
  function curWk() { return M.S.sub.wk ? M.find('wettkaempfe', M.S.sub.wk) : null; }
  M.register('wettkaempfe', {
    title: 'Wettkämpfe', icon: '🏁', colls: ['wettkaempfe'], custom: true, access: ['wettkaempfe.view'],
    render: function () { var s = sub(); var wk = s.wk ? M.find('wettkaempfe', s.wk) : null; if (wk) { if (!s.vSet) { s.v = 'check'; s.vSet = true; } return detail(wk); } s.wk = ''; return listPage(); },
    onChange: function (ev) {
      var t = ev.target; if (!t || !t.getAttribute) return;
      var wk = curWk(); if (!wk) return;
      if (t.getAttribute('data-wkswf')) { M.S.sub.swf = t.value; M.render(true); return; }
      if (t.getAttribute('data-wknote')) { M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, fields: { note: t.value } }, true); return; }
      if (t.getAttribute('data-wkims')) { M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, fields: { intMs: t.value } }, true); M.S.dirty = true; return; }
      if (t.getAttribute('data-wkkr')) { var f = {}; f[t.getAttribute('data-wkkr')] = t.value === '' ? '' : Number(t.value); M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, fields: f }, true); M.S.dirty = true; return; }
      if (t.getAttribute('data-wkt')) {
        var row = t.closest('.wk-z'); if (!row) return; var k = row.getAttribute('data-k');
        var tin = row.querySelector('[data-wkt=t]'), spin = row.querySelector('[data-wkt=sp]'), stin = row.querySelector('[data-wkt=st]');
        var tv = P.fmtTime(tin.value); var bad = tv === null;
        var sp = spin.value.split(/[;\s]+/).filter(Boolean).map(P.fmtTime); var badSp = sp.some(function (x) { return x === null; });
        tin.classList.toggle('bad', bad); spin.classList.toggle('bad', badSp);
        if (bad || badSp) { M.toast('Zeit nicht lesbar. Beispiel: 31,20 oder 1:05,85'); return; }
        tin.value = tv; spin.value = sp.join('; ');
        var r = { t: tv, sp: sp, st: stin.value };
        var empty = !r.t && !r.sp.length && !r.st;
        M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, merge: true, fields: { res: (function () { var o = {}; o[k] = empty ? null : r; return o; })() } }, true);
        var st = (wk.starts || []).filter(function (x) { return key(x) === k; })[0];
        var upd = M.find('wettkaempfe', wk.id); var dh = row.querySelector('.wk-diff'); if (dh && st && upd) dh.innerHTML = diffHtml(upd, st);
      }
    },
    actions: {
      wklist: function (it, el) { M.S.sub.lv = el.getAttribute('data-v'); M.lsSet('wklv', M.S.sub.lv); M.render(true); },
      allrows: function () { M.S.sub.allRows = !M.S.sub.allRows; M.render(true); },
      wkcell: function (it, el) {
        var wk = M.find('wettkaempfe', el.getAttribute('data-w')); if (!wk || !canCheck()) return; var k = el.getAttribute('data-k');
        if (k === 'intMs' || k === 'teilnahme' || k === 'kr1' || k === 'kr2') cellEdit(wk, k); else toggleChk(wk, k);
      },
      wkchk: function (it, el) { var wk = curWk(); if (wk && canCheck()) toggleChk(wk, el.getAttribute('data-k')); },
      wkteil: function (it, el) { var wk = curWk(); if (wk) M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, fields: { teilnahme: el.getAttribute('data-v') } }); },
      wknop: function () { },
      wkkrtake: function (it, el) { var wk = curWk(); if (!wk) return; var f = {}; f[el.getAttribute('data-k')] = Number(el.getAttribute('data-n')); M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, fields: f }); },
      wkaus: function () { docDialog('aus', ''); },
      wkdoc: function (it, el) { docDialog(el.getAttribute('data-kind'), M.S.sub.wk); },
      wkneu: function () { M.openForm({ title: 'Wettkampf-Termin anlegen', fields: NEW_FIELDS, item: {}, onSave: function (v) { var wk = { id: M.uid(), title: v.title, date: v.date, ort: v.ort, meldeschluss: v.meldeschluss, intMs: v.intMs, club: club(), abschnitte: [], events: [], starts: [], gericht: [], res: {}, chk: {} }; M.op({ op: 'set', coll: 'wettkaempfe', item: wk }); M.S.sub.wk = wk.id; M.S.sub.v = 'check'; M.S.sub.vSet = true; M.render(true); } }); },
      wkread: function (it, el) { doRead(el.getAttribute('data-kind') || 'erg', el.getAttribute('data-target') || ''); },
      wksave: function () { doSave(); },
      wksaveaus: function () { saveAus(); },
      wksavemeld: function () { saveMeld(); },
      wksaveprot: function () { saveProt(); },
      pasttoggle: function () { M.S.sub.pastOpen = !M.S.sub.pastOpen; M.render(true); },
      wkopen: function (it, el, ev, c) { M.S.sub.wk = c.id; M.S.sub.v = 'check'; M.S.sub.vSet = true; M.S.q = ''; window.scrollTo(0, 0); M.render(true); },
      wkback: function () { M.S.sub.wk = ''; M.S.sub.vSet = false; M.S.q = ''; M.render(true); },
      wkview: function (it, el) { M.S.sub.v = el.getAttribute('data-v'); M.S.q = ''; M.render(true); },
      wkprint: function () { var wk = curWk(); if (wk) printMenu(wk); },
      pr: function (it, el) { var wk = curWk(); M.closeDlg(); if (wk) printWhat(wk, el.getAttribute('data-w')); },
      wkedit: function () { var wk = curWk(); if (!wk) return; M.openForm({ title: 'Wettkampf bearbeiten', fields: NEW_FIELDS, item: wk, onSave: function (v) { M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, fields: { title: v.title, date: v.date, ort: v.ort, meldeschluss: v.meldeschluss, intMs: v.intMs } }); } }); },
      wkdel: function () { var wk = curWk(); if (!wk) return; M.confirm('„' + wk.title + '“ samt aller Zeiten löschen?', 'Löschen', function () { M.S.sub.wk = ''; M.op({ op: 'del', coll: 'wettkaempfe', id: wk.id }); }); },
      onlyopen: function () { M.S.sub.onlyOpen = !M.S.sub.onlyOpen; M.render(true); },
      gedit: function (it, el) { var wk = curWk(); var i = +el.closest('[data-gi]').getAttribute('data-gi'); if (!wk || !wk.gericht[i]) return; var g = wk.gericht[i]; M.openForm({ title: g.pos + ' (Abschnitt ' + g.a + ')', fields: [{ k: 'name', t: 'text', label: 'Name (leer = offen)' }], item: { name: /^N\s?N$/i.test(g.name) ? '' : g.name }, onSave: function (v) { var l = M.clone(wk.gericht); l[i].name = v.name || 'NN'; M.op({ op: 'patch', coll: 'wettkaempfe', id: wk.id, fields: { gericht: l } }); } }); },
      sw: function () { }
    }
  });
  (function () { var lv = M.lsGet('wklv', ''); if (lv) M.S.sub.lv = lv; })();
  var st = document.createElement('style'); st.textContent = '#hubRoot .wk-date{flex:0 0 auto;width:54px;text-align:center;border-radius:12px;background:var(--navy);color:#fff;padding:6px 0;line-height:1.1}#hubRoot .wk-date b{display:block;font-size:22px;font-weight:900}#hubRoot .wk-date span{font-size:11px;font-weight:800;text-transform:uppercase;color:var(--gold)}#hubRoot .wk-z{padding:10px 0;border-bottom:1px solid rgba(148,163,184,.25)}#hubRoot .wk-zi{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:6px}#hubRoot .wk-diff{font-size:13px;font-weight:700}' +
