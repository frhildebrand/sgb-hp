/* ---------- Meldeergebnis (EasyWk-PDF) auslesen ---------- */
var WKParse = (function () {
  function normTime(t) { return t; }
  function isoDate(d) { var m = /(\d{2})\.(\d{2})\.(\d{4})/.exec(d || ''); return m ? m[3] + '-' + m[2] + '-' + m[1] : ''; }
  function toMin(hhmm) { var m = /(\d{1,2}):(\d{2})/.exec(hhmm || ''); return m ? (+m[1]) * 60 + (+m[2]) : null; }
  function sexOf(name, evName) {
    var m = /\((M|W|X)\)\s*$/.exec(name);
    if (m) return m[1];
    if (/männlich/i.test(evName || '')) return 'M';
    if (/weiblich/i.test(evName || '')) return 'W';
    return '';
  }
  // lines: Array von Textzeilen (Spalten durch mindestens zwei Leerzeichen getrennt)
  function parse(lines, club) {
    var clubL = String(club || '').toLowerCase();
    var out = { title: '', date: '', veranstalter: '', ausrichter: '', becken: '', temp: '', stand: '', ort: '', abschnitte: [], events: {}, starts: [], gericht: [], vereine: {}, warnings: [] };
    var i, line, m;
    // Kopf
    var head = [];
    for (i = 0; i < lines.length && i < 40; i++) { if (lines[i].trim()) head.push(lines[i].trim()); }
    var mi = head.indexOf('Meldeergebnis');
    if (mi >= 0) {
      var t = [];
      for (i = mi + 1; i < head.length; i++) { if (/^am\s+\d{2}\.\d{2}\.\d{4}/.test(head[i])) { out.date = isoDate(head[i]); break; } if (/^Veranstalter:/.test(head[i])) break; t.push(head[i]); }
      out.title = t.join(' ');
    }
    var addrN = 0, addr = [];
    var abNo = 0, abIdx = null, curEv = null, curLauf = null, inGericht = false, gGroup = '', gAb = 0;
    for (i = 0; i < lines.length; i++) {
      line = lines[i].replace(/\s+$/, '');
      var tl = line.trim();
      if (!tl) continue;
      if ((m = /^Veranstalter:\s*(.+)$/.exec(tl))) { out.veranstalter = m[1].trim(); continue; }
      if ((m = /^Ausrichter:\s*(.+)$/.exec(tl))) { out.ausrichter = m[1].trim(); continue; }
      if ((m = /(\d+)\s*Bahnen\s*(?:á|a|à)\s*(\d+)\s*m/i.exec(tl)) && !out.becken) { out.becken = m[1] + ' Bahnen à ' + m[2] + ' m'; }
      if ((m = /Wassertemperatur ca\.\s*(\d+)/i.exec(tl)) && !out.temp) { out.temp = m[1] + ' °C'; }
      if ((m = /Stand:\s*(\d{2}\.\d{2}\.\d{4}),\s*(\d{2}:\d{2})/.exec(tl)) && !out.stand) { out.stand = isoDate(m[1]) + ' ' + m[2]; }
      if (/Schwimmbad-Adresse/.test(tl)) { addrN = 5; continue; }
      if (addrN > 0) {
        addrN--;
        var ac = line.trim().split(/\s{3,}/);
        if (ac.length > 1) addr.push(ac[ac.length - 1]); else if (/^\s{20,}\S/.test(line)) addr.push(tl);
        out.ort = addr.join(', ');
      }
      // Kampfgericht
      if ((m = /^Kampfgericht Abschnitt\s+(\d+)/.exec(tl))) { inGericht = true; gAb = +m[1]; gGroup = 'Kampfgericht'; continue; }
      if ((m = /^Abschnitt\s+(\d+)\s*-\s*(\S+)\s+(\d{2}\.\d{2}\.\d{4})/.exec(tl))) {
        inGericht = false; curEv = null; curLauf = null;
        abNo = +m[1];
        abIdx = { no: abNo, tag: m[2], date: isoDate(m[3]), einlass: '', einschwimmen: '', kr: '', beginn: '' };
        out.abschnitte.push(abIdx); continue;
      }
      if (abIdx && !abIdx.beginn) {
        if ((m = /Einlass:\s*([^|]+?)\s*(?:\||$)/.exec(tl))) abIdx.einlass = m[1].trim();
        if ((m = /Einschwimmen:\s*([^|]+?)\s*(?:\||$)/.exec(tl))) abIdx.einschwimmen = m[1].trim();
        if ((m = /Kampfrichtersitzung:\s*([^|]+?)\s*(?:\||$)/.exec(tl))) abIdx.kr = m[1].trim();
        if ((m = /^Beginn:\s*(.+)$/.exec(tl))) { abIdx.beginn = m[1].trim(); continue; }
        if (/Einlass:/.test(tl)) continue;
      }
      if (/^Wettkampffolge für Abschnitt/.test(tl)) { inGericht = false; continue; }
      if (inGericht) {
        if (/^Position\s+Name\s+Verein/.test(tl)) continue;
        var cols = line.trim().split(/\s{2,}/);
        if (cols.length === 1 && !/\s{2,}/.test(line.trim()) && cols[0].length < 40 && !/^(Schiedsrichter|Starter|Sprecher|Auswerter|Protokollf|Computer|Zeitnehmer|Reservezeit|Wenderichter|Zielrichter|Schwimmrichter)/.test(cols[0])) { gGroup = cols[0]; continue; }
        if (cols.length >= 3) {
          var g = { a: gAb, g: gGroup, pos: cols[0], name: cols[1], v: cols.slice(2).join(' ') };
          if (clubL && g.v.toLowerCase().indexOf(clubL) >= 0) out.gericht.push(g);
          continue;
        }
        if (/^(Zielgericht|Zeitgericht|Wendegericht|Kampfgericht)/.test(tl)) { gGroup = tl; continue; }
        continue;
      }
      // Wettkampf-Zeile (Liste oder Kopf)
      if ((m = /^Wettkampf\s+(\d+)\s*-\s*(.+?)\s*$/.exec(tl))) {
        var no = +m[1]; var rest = m[2]; var laeufe = null; var ca = '';
        var mc = /\s*\(ca\.\s*(\d{1,2}:\d{2})\s*Uhr\)\s*$/.exec(rest); if (mc) { ca = mc[1]; rest = rest.slice(0, mc.index); }
        var ml = /\s*\((\d+)\s*Läufe?\)\s*$/.exec(rest); if (ml) { laeufe = +ml[1]; rest = rest.slice(0, ml.index); }
        var ev = out.events[no] || (out.events[no] = { no: no, name: '', ab: abNo, laeufe: null, ca: '' });
        ev.name = rest.trim(); if (laeufe) ev.laeufe = laeufe; if (ca) ev.ca = ca; if (abNo) ev.ab = abNo;
        curEv = ev; curLauf = null; continue;
      }
      if ((m = /^Lauf\s+(\d+)\s*\/\s*(\d+)\s*-\s*ca\.\s*(\d{1,2}:\d{2})\s*Uhr/.exec(tl))) { curLauf = { l: +m[1], lt: +m[2], t: m[3] }; if (curEv && !curEv.laeufe) curEv.laeufe = +m[2]; if (curEv && !curEv.ca) curEv.ca = m[3]; continue; }
      if (/^Bahn\s+Schwimmer/.test(tl)) continue;
      if (curEv && curLauf && (m = /^Bahn\s+(\d+)\s+(.+?)\s+(\d{4}|Offen)\s+(\S.*?)\s+(\d{1,2}:\d{2},\d{2})\s*$/.exec(tl))) {
        var st = { e: curEv.no, l: curLauf.l, lt: curLauf.lt, t: curLauf.t, b: +m[1], n: m[2].replace(/\s+\((M|W|X)\)\s*$/, '').trim(), s: sexOf(m[2], curEv.name), j: m[3] === 'Offen' ? 'Staffel' : m[3], v: m[4].trim(), m: m[5] === '00:00,00' ? '' : m[5] };
        if (/Mannschaft/i.test(st.n) && !st.s) st.s = 'X';
        out.vereine[st.v] = (out.vereine[st.v] || 0) + 1;
        if (!clubL || st.v.toLowerCase().indexOf(clubL) >= 0) out.starts.push(st);
        continue;
      }
    }
    var evs = Object.keys(out.events).map(function (k) { return out.events[k]; }).sort(function (a, b) { return a.no - b.no; });
    out.events = evs;
    var names = {}; out.starts.forEach(function (s) { names[s.n + '|' + s.j] = 1; });
    out.swimmers = Object.keys(names).length;
    if (!out.title) out.warnings.push('Titel nicht gefunden.');
    if (!out.date) out.warnings.push('Datum nicht gefunden.');
    if (!evs.length) out.warnings.push('Keine Wettkämpfe gefunden. Ist das ein Meldeergebnis aus EasyWk?');
    if (!out.starts.length) out.warnings.push('Für „' + club + '“ wurden keine Starts gefunden. Vereinsname prüfen. Im PDF kommen vor: ' + Object.keys(out.vereine).slice(0, 8).join(', ') + '.');
    return out;
  }
  // PDF-Text (pdf.js) in Zeilen wandeln: Elemente einer Zeile nach x sortieren, grosse Luecken als mehrere Leerzeichen
  function linesFromItems(pages) {
    var all = [];
    pages.forEach(function (items) {
      var rows = []; var byY = {};
      items.forEach(function (it) {
        if (!it.str) return;
        var ky = Math.round(it.y); var r = null;
        [0, -1, 1, -2, 2].forEach(function (d) { if (!r && byY[ky + d]) r = byY[ky + d]; });
        if (!r) { r = { y: it.y, its: [] }; rows.push(r); byY[ky] = r; }
        r.its.push(it);
      });
      rows.sort(function (a, b) { return b.y - a.y; });
      rows.forEach(function (r) {
        r.its.sort(function (a, b) { return a.x - b.x; });
        var s = ''; var endX = null;
        r.its.forEach(function (it) {
          if (endX !== null) {
            var gap = it.x - endX;
            var cw = it.w && it.str.length ? it.w / it.str.length : 4;
            if (gap > cw * 2.2) s += '   ';
            else if (gap > cw * 0.25 && !/^\s/.test(it.str) && !/\s$/.test(s)) s += ' ';
          }
          s += it.str; endX = it.x + (it.w || 0);
        });
        all.push(s);
      });
    });
    return all;
  }
  // Zeitformat: "31,2" -> "00:31,20"; "1:05,85" -> "01:05,85"; "65,85" -> "01:05,85"
  function fmtTime(v) {
    v = String(v || '').trim().replace('.', ',').replace(/\s+/g, '');
    if (!v) return '';
    var m = /^(?:(\d{1,2}):)?(\d{1,3})(?:,(\d{1,2}))?$/.exec(v);
    if (!m) return null;
    var min = m[1] ? +m[1] : 0; var sec = +m[2]; var h = m[3] === undefined ? 0 : +(m[3].length === 1 ? m[3] + '0' : m[3]);
    if (!m[1] && sec >= 60) { min = Math.floor(sec / 60); sec = sec % 60; }
    if (sec >= 60 || min > 59) return null;
    return ('0' + min).slice(-2) + ':' + ('0' + sec).slice(-2) + ',' + ('0' + h).slice(-2);
  }
  function timeMs(t) { var m = /^(\d{2}):(\d{2}),(\d{2})$/.exec(t || ''); return m ? (+m[1]) * 60000 + (+m[2]) * 1000 + (+m[3]) * 10 : null; }
  function diffStr(ms) { var a = Math.abs(ms); var s = Math.floor(a / 1000), h = Math.round((a % 1000) / 10); return (ms < 0 ? '−' : '+') + s + ',' + ('0' + h).slice(-2) + ' s'; }
  return { parse: parse, linesFromItems: linesFromItems, fmtTime: fmtTime, timeMs: timeMs, diffStr: diffStr, isoDate: isoDate, toMin: toMin };
})();

/* Wettkämpfe: Meldeergebnis (PDF aus EasyWk) hochladen, Übersicht wer wann wo schwimmt, Zeiten eintragen, Drucken. */
(function () {
