/* Gemeinsame Bausteine der Fach-Systeme im Hub (Aufgaben, Wettkämpfe, Training, Veranstaltungen, Vorstand, Material, Jugend).
   Alles wird zuerst lokal angezeigt und im Hintergrund gespeichert. Es wird nie neu gezeichnet, während du tippst. */
(function () {
  'use strict';
  var SH = window.HubShell;
  var esc = SH ? SH.esc : function (s) { return String(s); };
  var MODULES = {};
  var S = { tab: '', q: '', open: {}, filter: {}, loaded: false, error: '', sub: {} };
  var D = { base: {}, denied: {}, people: [] };
  var Q = [];                // offene Änderungen (werden nach und nach an das Script geschickt)
  var def = null, root = null, flushTimer = null, flushing = false, reloading = false, dlgOpen = false, dlgOnClose = null;
  var COLORS = { green: '#10b981', amber: '#f59e0b', red: '#ef4444', blue: '#3b82f6', gray: '#94a3b8' };

  /* ---------- Hilfen ---------- */
  function uid() { return 'x' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
  function clone(o) { return JSON.parse(JSON.stringify(o)); }
  function today() { var d = new Date(); return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
  function addDays(iso, n) { var d = new Date(iso + 'T12:00:00'); d.setDate(d.getDate() + n); return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
  function daysTo(iso) { if (!iso) return null; return Math.round((new Date(iso + 'T12:00:00') - new Date(today() + 'T12:00:00')) / 86400000); }
  var WT = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
  function fmtDate(iso, short) {
    if (!iso) return '';
    var d = new Date(iso + 'T12:00:00'); if (isNaN(d)) return esc(iso);
    return WT[d.getDay()] + ', ' + ('0' + d.getDate()).slice(-2) + '.' + ('0' + (d.getMonth() + 1)).slice(-2) + (short ? '.' : '.' + d.getFullYear());
  }
  function userName() { var m = SH.S.me; return m ? (m.user || (m.role && m.role.name) || '') : ''; }
  function can(p) { return SH.has(p); }
  function anyCan(list) { return !list || !list.length || list.some(function (p) { return SH.has(p); }); }
  function typing() { var a = document.activeElement; return !!(a && ['INPUT', 'TEXTAREA', 'SELECT'].indexOf(a.tagName) >= 0 && a.type !== 'checkbox' && a.type !== 'radio' && a.type !== 'button' && root && root.contains(a)); }
  function lsGet(k, d) { return SH.lsGet(k, d); }
  function lsSet(k, v) { SH.lsSet(k, v); }
  function toast(msg) {
    var t = document.getElementById('mToast');
    if (!t) { t = document.createElement('div'); t.id = 'mToast'; t.className = 'm-toast'; document.body.appendChild(t); }
    t.textContent = msg; t.classList.add('on');
    clearTimeout(t._h); t._h = setTimeout(function () { t.classList.remove('on'); }, 3200);
  }
  function badge(text, color) { return '<span class="m-badge" style="--c:' + (COLORS[color] || color || COLORS.gray) + '">' + esc(text) + '</span>'; }


  function euro(n) { var v = Number(n); if (!isFinite(v)) v = 0; return v.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ' €'; }
  function num(v) { var x = Number(String(v === undefined || v === null ? '' : v).replace(',', '.')); return isFinite(x) ? x : 0; }
  function initials(n) { return SH && SH.initials ? SH.initials(n) : String(n || '?').charAt(0).toUpperCase(); }
  function avatar(n, cls) { return '<span class="m-av ' + (cls || '') + '" title="' + esc(n) + '">' + esc(initials(n)) + '</span>'; }
  function prog(done, total, label) { var p = total ? Math.round(done * 100 / total) : 0; return '<div class="m-prog" title="' + p + ' %"><i style="width:' + p + '%"' + (total && done === total ? ' class="full"' : '') + '></i></div>' + (label === false ? '' : '<span class="m-progt">' + done + '/' + total + '</span>'); }
  function stat(n, label, cls, attrs) { return '<button type="button" class="m-stat ' + (cls || '') + '" ' + (attrs || '') + '><b>' + esc(n) + '</b><span>' + esc(label) + '</span></button>'; }
  function seg(items, cur, act) { return '<div class="m-seg">' + items.map(function (x) { return '<button type="button" class="' + (x[0] === cur ? 'on' : '') + '" data-ma="' + act + '" data-v="' + esc(x[0]) + '">' + esc(x[1]) + '</button>'; }).join('') + '</div>'; }
  var MON = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
  function monthLabel(ym) { var p = String(ym || '').split('-'); return p.length > 1 ? MON[(+p[1]) - 1] + ' ' + p[0] : String(ym || ''); }
  function slug(s) { return String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 30); }

  /* ---------- Daten: lokal sofort, im Hintergrund speichern ---------- */
  function applyOp(list, op) {
    var i;
    if (op.op === 'order') {
      var pos = {}; (op.ids || []).forEach(function (id, n) { pos[id] = n; });
      list.forEach(function (it) { if (pos[it.id] !== undefined) it.ord = pos[it.id]; });
      list.sort(cmpOrd); return list;
    }
    var id = op.id || (op.item && op.item.id);
    for (i = 0; i < list.length; i++) if (list[i].id === id) break;
    if (op.op === 'del') { if (i < list.length) list.splice(i, 1); return list; }
    if (op.op === 'set') {
      var it = clone(op.item);
      if (i < list.length) { if (typeof list[i].ord === 'number' && typeof it.ord !== 'number') it.ord = list[i].ord; it.ts = it.ts || list[i].ts; list[i] = it; }
      else { it.ts = it.ts || Date.now(); if (typeof it.ord !== 'number') it.ord = list.reduce(function (m, x) { return Math.max(m, typeof x.ord === 'number' ? x.ord : -1); }, -1) + 1; list.push(it); }
      return list;
    }
    if (op.op === 'patch' && i < list.length) {
      Object.keys(op.fields || {}).forEach(function (k) {
        var v = op.fields[k];
        if (op.merge && v && typeof v === 'object' && !Array.isArray(v)) { var b = list[i][k] && typeof list[i][k] === 'object' ? list[i][k] : {}; Object.keys(v).forEach(function (sk) { if (v[sk] === null) delete b[sk]; else b[sk] = v[sk]; }); list[i][k] = b; }
        else list[i][k] = v;
      });
    }
    return list;
  }
  function cmpOrd(a, b) { return ((typeof a.ord === 'number' ? a.ord : 1e12) - (typeof b.ord === 'number' ? b.ord : 1e12)) || ((a.ts || 0) - (b.ts || 0)); }
  function items(coll) {
    var l = clone(D.base[coll] || []);
    Q.forEach(function (op) { if (op.coll === coll) l = applyOp(l, op); });
    return l;
  }
  function find(coll, id) { var l = items(coll); for (var i = 0; i < l.length; i++) if (l[i].id === id) return l[i]; return null; }
  function persistQ() { lsSet('modq', Q); }
  function persistBase() { lsSet('modbase_' + def.id, { token: SH.token(), base: D.base, people: D.people, dir: D.dir, pick: D.pick, pr: D.pr }); }
  function op(o, quiet) { Q.push(o); persistQ(); if (!quiet) renderMain(true); scheduleFlush(); }
  function ops(list) { list.forEach(function (o) { Q.push(o); }); persistQ(); renderMain(true); scheduleFlush(); }
  function scheduleFlush() { clearTimeout(flushTimer); flushTimer = setTimeout(flush, 500); }
  function flush() {
    if (flushing) { scheduleFlush(); return Promise.resolve(); }
    if (!Q.length) return Promise.resolve();
    flushing = true;
    var sent = Q.slice();
    return SH.post({ action: 'dataOps', token: SH.token(), ops: sent }).then(function (r) {
      flushing = false;
      if (!r) { setTimeout(flush, 8000); return; }                        // offline: spaeter nochmal
      if (r.status !== 'success' && !(r.deniedIdx && r.deniedIdx.length)) { toast(r.message || 'Speichern hat nicht geklappt.'); }
      var denied = {}; (r.deniedIdx || []).forEach(function (i) { denied[i] = 1; });
      // gesendete Aenderungen in den Grundstand uebernehmen (sonst springt die Anzeige kurz zurueck)
      sent.forEach(function (o, i) { if (!denied[i]) { var l = D.base[o.coll] || []; D.base[o.coll] = applyOp(l, o); } });
      Q = Q.slice(sent.length); persistQ(); persistBase();
      if (r.deniedIdx && r.deniedIdx.length) toast('Für ' + r.deniedIdx.length + ' Änderung(en) fehlt die Berechtigung. Sie wurden verworfen.');
      renderMain(true);
      if (Q.length) scheduleFlush(); else reload();
    });
  }
  function colls() { return (def.colls || []).join(','); }
  function reload() {
    if (reloading || !colls()) return Promise.resolve();
    reloading = true;
    return SH.get('data', { colls: colls() }).then(function (r) {
      reloading = false;
      if (!r) { S.error = S.loaded ? '' : 'Keine Verbindung.'; renderMain(); return; }
      if (r.status !== 'success') { S.error = r.message || 'Fehler.'; renderMain(); return; }
      S.error = '';
      var before = JSON.stringify([D.base, D.denied, D.people, D.dir, D.pick]);
      Object.keys(r.data || {}).forEach(function (c) { D.base[c] = r.data[c]; });
      D.denied = {}; (r.denied || []).forEach(function (c) { D.denied[c] = 1; });
      if (r.people) D.people = r.people;
      if (r.dir) D.dir = r.dir;
      if (r.pick) D.pick = r.pick;
      if (r.pr) D.pr = r.pr;
      S.loaded = true; persistBase();
      if (before !== JSON.stringify([D.base, D.denied, D.people, D.dir, D.pick]) || !S.drawn) renderMain();
      S.drawn = true;
    });
  }

  /* ---------- Zeichnen ---------- */
  function tabsOf() { return (def.tabs || []).filter(function (t) { return anyCan(t.view); }); }
  function curTab() { var t = tabsOf(); for (var i = 0; i < t.length; i++) if (t[i].id === S.tab) return t[i]; return t[0] || null; }
  // Reiter der Seite auch im linken Menü anbieten (dort als Unterpunkte der Seite)
  function wide() { try { return window.matchMedia('(min-width: 1100px)').matches; } catch (e) { return false; } }
  function syncTabs() { var tl = def.custom ? [] : tabsOf(); var c = tl.length > 1 ? curTab() : null; SH.S.pageTabs = tl.length > 1 ? tl.map(function (x) { return { id: x.id, label: x.label }; }) : null; SH.S.pageTab = c ? c.id : ''; }
  function setTab(id) { S.tab = id; S.q = ''; S.filter = {}; lsSet('modtab_' + def.id, S.tab); renderMain(true); renderChrome(); window.scrollTo(0, 0); }
  function renderChrome() {
    syncTabs();
    var h = document.getElementById('mHead'); var o = document.getElementById('mOv');
    if (h) h.innerHTML = SH.header(def.title);
    if (o) o.innerHTML = SH.overlay();
  }
  function noAccess() {
    var me = SH.S.me;
    return '<section class="wm-card"><h2 class="m-h2">Kein Zugriff</h2><p class="wm-note">Für dein Konto ist dieser Bereich nicht freigeschaltet.' + (me ? '' : ' Melde dich an, um ihn zu öffnen.') + '</p>' + (me ? '' : '<button type="button" class="wm-amber" data-sh="login">Anmelden</button> ') + '<a class="wm-btn" href="/intranet/">← Alle Systeme</a></section>';
  }
  function mainHtml() {
    if (!SH.S.restoredDone) return '<section class="wm-card"><div class="hub-skel"></div></section>';
    if (SH.S.offline && !S.loaded) return '<section class="wm-card"><h2 class="m-h2">Keine Verbindung</h2><p class="wm-note">Das Konto-System ist gerade nicht erreichbar.</p><button type="button" class="wm-amber" data-ma="retry">Nochmal versuchen</button></section>';
    var tabs = tabsOf();
    if (!def.custom && !tabs.length) return noAccess();
    if (def.custom && def.access && !anyCan(def.access)) return noAccess();
    var out = Q.length ? '<div class="m-pagehead"><span class="m-sync">⏳ speichert …</span></div>' : '';
    if (S.error) out += '<div class="hub-err">' + esc(S.error) + '</div>';
    if (def.custom) return out + def.render(api);
    var t = curTab();
    if (tabs.length > 1 && !wide()) out += '<div class="wm-tabs">' + tabs.map(function (x) { return '<button type="button" class="wm-tab' + (x === t ? ' on' : '') + '" data-ma="tab" data-tab="' + esc(x.id) + '">' + esc(x.label) + '</button>'; }).join('') + '</div>';
    return out + (t.render ? t.render(api, t) : listHtml(t));
  }
  var lastHtml = '';
  function renderMain(force) {
    var m = document.getElementById('mMain'); if (!m) return;
    if (def.hold && def.hold()) { S.dirty = true; return; }
    if (!force && typing()) { S.dirty = true; return; }
    if (force && typing() && !S.forceTyping) { S.dirty = true; return; }
    var h = mainHtml();
    if (h === lastHtml) return;
    var sy = window.scrollY;
    lastHtml = h; m.innerHTML = h; S.dirty = false;
    if (Math.abs(window.scrollY - sy) > 2) window.scrollTo(0, sy);
  }
  document.addEventListener('focusout', function () { setTimeout(function () { if (S.dirty && !typing()) renderMain(); }, 300); });

  /* ---------- Listenansicht (Karten) ---------- */
  function matchQ(it, t) {
    var q = (S.q || '').toLowerCase().trim(); if (!q) return true;
    var hay = (t.search || ['title', 'name']).map(function (k) { var v = it[k]; return Array.isArray(v) ? v.join(' ') : (v === undefined ? '' : v); }).join(' ').toLowerCase();
    return hay.indexOf(q) >= 0;
  }
  function listHtml(t) {
    var all = items(t.coll);
    if (t.sortBy) { var k = t.sortBy.k, dir = t.sortBy.dir || 1; all.sort(function (a, b) { return String(a[k] || '') < String(b[k] || '') ? -dir : String(a[k] || '') > String(b[k] || '') ? dir : 0; }); }
    var list = all.filter(function (it) { return matchQ(it, t) && (!t.filter || t.filter(it, S.filter)); });
    var canEdit = anyCan(t.edit); var canAdd = anyCan(t.add || t.edit); var canDel = anyCan(t.del || t.edit); var canPrint = anyCan(t.print);
    var out = '<section class="wm-card"><div class="wm-bar"><h3>' + esc(t.label) + ' <span class="wm-sub">(' + list.length + (list.length !== all.length ? ' von ' + all.length : '') + ')</span></h3><span class="m-actions">' +
      (canPrint && (t.printAll || t.xlsxAll) ? '<button type="button" class="wm-btn" data-ma="printall">' + (t.xlsxAll ? '📊 Excel' : '🖨️ Drucken') + '</button>' : '') +
      (canAdd ? '<button type="button" class="wm-amber" data-ma="add">+ ' + esc(t.addLabel || 'Neu') + '</button>' : '') + '</span></div>' +
      (t.hint ? '<p class="wm-note">' + t.hint + '</p>' : '') +
      '<input type="search" class="m-search" data-mq="1" placeholder="🔎 Suchen …" value="' + esc(S.q) + '" autocomplete="off">' +
      (t.summary ? t.summary(all, api) : '');
    if (!list.length) out += '<p class="wm-note">' + esc(all.length ? 'Nichts gefunden. Ändere die Suche oder die Filter.' : (t.empty || ('Noch nichts eingetragen.' + (canAdd ? ' Mit „+ ' + (t.addLabel || 'Neu') + '“ oben legst du den ersten Eintrag an.' : '')))) + '</p>';
    list.forEach(function (it, i) {
      var c = t.card(it, api); var open = !!S.open[it.id] || !!t.alwaysOpen;
      out += '<article class="m-card' + (c.dim ? ' dim' : '') + '" data-id="' + esc(it.id) + '"><div class="m-head" data-ma="toggle"><div class="m-main"><div class="m-title">' + esc(c.title) + (c.badges || '') + '</div>' + (c.sub ? '<div class="wm-sub">' + c.sub + '</div>' : '') + '</div>' + (c.row ? '<span class="m-rowbtns">' + c.row + '</span>' : '') + '<span class="m-chev">' + (open ? '▾' : '▸') + '</span></div>' +
        (open ? '<div class="m-body">' + (c.body || '') + '<div class="m-btns">' +
          (t.manual && canEdit ? '<button type="button" class="wm-btn" data-ma="up"' + (i === 0 || S.q ? ' disabled' : '') + '>⬆️</button><button type="button" class="wm-btn" data-ma="down"' + (i === list.length - 1 || S.q ? ' disabled' : '') + '>⬇️</button>' : '') +
          (canPrint && (t.printItem || t.xlsxItem) ? '<button type="button" class="wm-btn" data-ma="' + (t.xlsxItem ? 'xlsxitem' : 'print') + '">' + (t.xlsxItem ? '📊 Excel' : '🖨️ Drucken') + '</button>' : '') +
          (c.buttons || '') +
          (canEdit ? '<button type="button" class="wm-btn" data-ma="edit">✏️ Bearbeiten</button>' : '') + (canDel ? '<button type="button" class="wm-btn m-danger" data-ma="del">🗑️ Löschen</button>' : '') + '</div></div>' : '') + '</article>';
    });
    return out + '</section>';
  }

  /* ---------- Formulare ---------- */
  function lstRow(x) { return '<div class="m-lr"><input type="text" data-lr="1" value="' + esc(x) + '" autocomplete="off"><button type="button" class="wm-btn m-lx" data-lstdel="1" aria-label="Entfernen">✕</button></div>'; }
  function lstSync(box) { var ta = box.querySelector('textarea'); if (ta) ta.value = [].map.call(box.querySelectorAll('input[data-lr]'), function (i) { return i.value.trim(); }).filter(Boolean).join('\n'); }
  function lstAdd(box, after) { var h = document.createElement('div'); h.innerHTML = lstRow(''); var row = h.firstChild, rows = box.querySelector('.m-lrows'); if (after && after.parentNode === rows) rows.insertBefore(row, after.nextSibling); else rows.appendChild(row); row.querySelector('input').focus(); }
  document.addEventListener('input', function (ev) { var i = ev.target; if (i && i.getAttribute && i.getAttribute('data-lr')) lstSync(i.closest('.m-lst')); });
  document.addEventListener('keydown', function (ev) { var i = ev.target; if (ev.key === 'Enter' && i && i.getAttribute && i.getAttribute('data-lr')) { ev.preventDefault(); lstAdd(i.closest('.m-lst'), i.closest('.m-lr')); } });
  document.addEventListener('click', function (ev) {
    var e = ev.target.closest ? ev.target.closest('[data-lstadd],[data-lstdel]') : null; if (!e) return; var box = e.closest('.m-lst'); if (!box) return;
    if (e.getAttribute('data-lstadd')) { lstAdd(box); return; }
    var row = e.closest('.m-lr'), rows = box.querySelector('.m-lrows'); if (rows.children.length > 1) row.parentNode.removeChild(row); else row.querySelector('input').value = ''; lstSync(box);
  });
  function fieldHtml(f, v) {
    var id = 'mf_' + f.k; var val = v === undefined || v === null ? '' : v; var lab = '<span>' + esc(f.label) + (f.req ? ' *' : '') + '</span>';
    var attr = ' name="' + esc(f.k) + '" id="' + id + '"' + (f.req ? ' required' : '') + (f.ph ? ' placeholder="' + esc(f.ph) + '"' : '');
    if (f.t === 'sec') return '<div class="m-f wide m-fsec">' + esc(f.label) + '</div>';
    if (f.t === 'chk') return '<label class="m-f m-fchk"><input type="checkbox"' + attr + (val ? ' checked' : '') + '>' + lab + '</label>';
    if (f.t === 'area') return '<label class="m-f' + (f.wide === false ? '' : ' wide') + '">' + lab + '<textarea' + attr + ' rows="' + (f.rows || 4) + '">' + esc(val) + '</textarea>' + (f.hint ? '<small>' + f.hint + '</small>' : '') + '</label>';
    if (f.t === 'lines' || f.t === 'checks') {
      var arr = Array.isArray(val) ? val : []; if (f.t === 'checks') arr = arr.map(function (c) { return c.t; });
      var rows = arr.length ? arr : [''];
      return '<div class="m-f wide m-lst">' + lab + '<textarea hidden' + attr + '>' + esc(arr.join('\n')) + '</textarea><div class="m-lrows">' + rows.map(lstRow).join('') + '</div><button type="button" class="wm-btn m-ladd" data-lstadd="1">➕ Eintrag hinzufügen</button>' + (f.hint ? '<small>' + f.hint + '</small>' : '') + '</div>';
    }
    if (f.t === 'pick') {
      var cur = Array.isArray(val) ? val : []; var opts = (typeof f.opts === 'function' ? f.opts() : (f.opts || D.people || [])).slice(); cur.forEach(function (n) { if (opts.indexOf(n) < 0) opts.push(n); });
      return '<div class="m-f wide">' + lab + '<div class="m-pick">' + opts.map(function (n) { var on = cur.indexOf(n) >= 0; return '<label class="m-pk' + (on ? ' on' : '') + '"><input type="checkbox" data-pick="' + esc(f.k) + '" value="' + esc(n) + '"' + (on ? ' checked' : '') + '><span>' + esc(n) + '</span></label>'; }).join('') + '</div>' + (f.extra ? '<input class="m-pkx" type="text" data-pickx="' + esc(f.k) + '" placeholder="' + esc(f.extra) + '" autocomplete="off">' : '') + (f.hint ? '<small>' + f.hint + '</small>' : '') + '</div>';
    }
    if (f.t === 'sel') return '<label class="m-f">' + lab + '<select' + attr + '>' + (f.opts || []).map(function (o) { var ov = typeof o === 'string' ? o : o[0], ol = typeof o === 'string' ? o : o[1]; return '<option value="' + esc(ov) + '"' + (String(val) === String(ov) ? ' selected' : '') + '>' + esc(ol) + '</option>'; }).join('') + '</select></label>';
    if (f.t === 'tags') return '<label class="m-f wide">' + lab + '<input type="text" data-person="multi"' + attr + ' value="' + esc((Array.isArray(val) ? val : []).join(', ')) + '" autocomplete="off" autocapitalize="words"><small>' + (f.hint || 'Mehrere Namen mit Komma trennen.') + '</small></label>';
    var type = f.t === 'date' ? 'date' : f.t === 'time' ? 'time' : f.t === 'num' ? 'number' : 'text';
    return '<label class="m-f' + (f.half ? '' : '') + '">' + lab + '<input type="' + type + '"' + attr + ' value="' + esc(val) + '"' + (f.t === 'num' ? ' inputmode="decimal" step="any"' : ' autocomplete="off"') + (f.list ? ' list="' + f.list + '"' : '') + (f.person ? ' data-person="one"' : '') + '></label>';
  }
  function collect(form, fields, old) {
    var out = {};
    fields.forEach(function (f) {
      if (f.k.charAt(0) === '_') return;
      if (f.t === 'pick') { out[f.k] = [].slice.call(form.querySelectorAll('input[data-pick="' + f.k + '"]:checked')).map(function (x) { return x.value; }); var px = form.querySelector('input[data-pickx="' + f.k + '"]'); if (px && px.value) px.value.split(/[,;\n]/).forEach(function (n) { n = n.trim(); if (n && out[f.k].indexOf(n) < 0) out[f.k].push(n); }); return; }
      var el = form.elements[f.k]; if (!el) return; var v;
