    if (f.t === 'tags') return '<label class="m-f wide">' + lab + '<input type="text" list="mPeople"' + attr + ' value="' + esc((Array.isArray(val) ? val : []).join(', ')) + '" autocomplete="off" autocapitalize="words"><small>' + (f.hint || 'Mehrere Namen mit Komma trennen.') + '</small></label>';
    var type = f.t === 'date' ? 'date' : f.t === 'time' ? 'time' : f.t === 'num' ? 'number' : 'text';
    return '<label class="m-f' + (f.half ? '' : '') + '">' + lab + '<input type="' + type + '"' + attr + ' value="' + esc(val) + '"' + (f.t === 'num' ? ' inputmode="decimal" step="any"' : ' autocomplete="off"') + (f.list ? ' list="' + f.list + '"' : '') + '></label>';
  }
  function collect(form, fields, old) {
    var out = {};
    fields.forEach(function (f) {
      if (f.k.charAt(0) === '_') return;
      if (f.t === 'pick') { out[f.k] = [].slice.call(form.querySelectorAll('input[data-pick="' + f.k + '"]:checked')).map(function (x) { return x.value; }); var px = form.querySelector('input[data-pickx="' + f.k + '"]'); if (px && px.value) px.value.split(/[,;\n]/).forEach(function (n) { n = n.trim(); if (n && out[f.k].indexOf(n) < 0) out[f.k].push(n); }); return; }
      var el = form.elements[f.k]; if (!el) return; var v;
      if (f.t === 'chk') v = !!el.checked;
      else if (f.t === 'num') v = el.value === '' ? '' : Number(String(el.value).replace(',', '.'));
