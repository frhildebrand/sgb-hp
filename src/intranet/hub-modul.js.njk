  }
  function openDlg(html, onClose) { dlgOpen = true; dlgOnClose = onClose || null; document.getElementById('mDlg').innerHTML = '<div class="ha-overlay m-ov"><div class="ha-dialog m-dlg">' + html + '</div></div>'; var f = document.querySelector('#mDlg input[type=text],#mDlg textarea'); if (f && !/iPad|iPhone/.test(navigator.userAgent)) try { f.focus(); } catch (e) { /* egal */ } }
  function closeDlg() { dlgOpen = false; var d = document.getElementById('mDlg'); if (d) d.innerHTML = ''; if (dlgOnClose) { var f = dlgOnClose; dlgOnClose = null; f(); } if (S.dirty) renderMain(); }
  function openForm(o) {
    var item = o.item || {}; var fields = o.fields;
    var peopleList = '<datalist id="mPeople">' + (D.people || []).map(function (p) { return '<option value="' + esc(p) + '">'; }).join('') + '</datalist>';
    var tabbed = !!o.tabs && fields.some(function (f) { return f.t === 'sec'; });
    var body;
    if (tabbed) {
      var panes = [], cur = null;
      fields.forEach(function (f) { if (f.t === 'sec') { cur = { f: f, h: '' }; panes.push(cur); } else { if (!cur) { cur = { f: { label: 'Allgemein' }, h: '' }; panes.push(cur); } cur.h += fieldHtml(f, item[f.k]); } });
      body = '<div class="m-tabs" role="tablist">' + panes.map(function (pn, i) { return '<button type="button" class="m-tab' + (i === 0 ? ' on' : '') + '" data-tab="' + i + '"' + (pn.f.role ? ' data-role="' + esc(pn.f.role) + '"' : '') + '>' + esc(pn.f.label) + '</button>'; }).join('') + '</div>' +
        '<div class="m-panes">' + panes.map(function (pn, i) { return '<div class="m-pane' + (i === 0 ? ' on' : '') + '" data-pane="' + i + '"><div class="m-fgrid">' + pn.h + '</div></div>'; }).join('') + '</div>';
    } else body = '<div class="m-fgrid">' + fields.map(function (f) { return fieldHtml(f, item[f.k]); }).join('') + '</div>';
