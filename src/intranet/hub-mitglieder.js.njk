/* Mitglieder: alle Vereinsmitglieder, Gruppenübersicht (Wettkampfgruppe, Gruppe 1–4, Masters) und WebClub-Import der Gruppenlisten. */
(function () {
  'use strict';
  var M = window.HubMod; if (!M) return;
  var esc = M.esc;
  var GR = ['Wettkampfgruppe', 'Gruppe 1', 'Gruppe 2', 'Gruppe 3', 'Gruppe 4', 'Masters'];
  var ROLLEN = ['Schwimmer', 'Kampfrichter', 'Funktionär', 'Sonstige'];
  function lower(s) { return String(s || '').toLowerCase().trim(); }
  function members() { return M.items('wgMitglieder').sort(function (a, b) { return String(a.name || '').localeCompare(String(b.name || ''), 'de'); }); }
  // Ältere Einträge ohne Gruppenfeld gehören zur Wettkampfgruppe
  function rOf(m) { return Array.isArray(m.rollen) && m.rollen.length ? m.rollen : [m.rolle || 'Schwimmer']; }
  function hasR(m, r) { return rOf(m).indexOf(r) >= 0; }
  function gOf(m) { return Array.isArray(m.gruppen) ? m.gruppen : ['Wettkampfgruppe']; }
  function isActive(m) { return m.status !== 'ausgetreten' && m.status !== 'pausiert' && (!m.austritt || m.austritt >= M.today()); }
  function age(m) { return m.jg ? new Date().getFullYear() - Number(m.jg) : ''; }
  function trainers() { try { return M.items('trainer'); } catch (e) { return []; } }
  function flt() { var f = M.S.filter || (M.S.filter = {}); return f; }
  function slug(n) { return lower(n).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); }
  function swapName(n) { n = String(n || '').trim(); var i = n.indexOf(','); return i > 0 ? (n.slice(i + 1).trim() + ' ' + n.slice(0, i).trim()).trim() : n; }
  function match(name, ms) {
    var n = lower(name); var rev = lower(swapName(name));
    return ms.filter(function (m) { var mn = lower(m.name); return mn === n || mn === rev; })[0] || null;
  }

  /* ---------- Liste ---------- */
  var FIELDS = [
    { k: 'name', t: 'text', label: 'Name', req: true, ph: 'Vorname Nachname' },
    { k: 'jg', t: 'num', label: 'Jahrgang' },
    { k: 'sex', t: 'sel', label: 'Geschlecht', opts: [['', '–'], ['w', 'weiblich'], ['m', 'männlich'], ['d', 'divers']] },
    { k: 'gruppen', t: 'pick', label: 'Gruppen', opts: GR, hint: 'Mehrere sind möglich.' },
    { k: 'rollen', t: 'pick', label: 'Rollen', opts: ROLLEN, hint: 'Mehrere sind möglich, z. B. Schwimmer und Kampfrichter.' },
    { k: 'trainerIn', t: 'pick', label: 'Trainer in Gruppen', opts: GR, hint: 'Wo diese Person Trainer ist. Sie erscheint dann auch im Bereich Trainer.' },
    { k: 'status', t: 'sel', label: 'Status', opts: [['', 'aktiv'], ['pausiert', 'pausiert'], ['ausgetreten', 'ausgetreten']] },
    { k: 'dsv', t: 'text', label: 'DSV-ID' },
    { k: 'notiz', t: 'area', label: 'Notiz', rows: 3 }
  ];
  function chipRow(label, key, opts, cur) {
    return '<div class="m-chips" style="margin:2px 0 6px"><span class="wm-sub" style="align-self:center">' + label + '</span>' + [['', 'Alle']].concat(opts.map(function (o) { return [o, o]; })).map(function (o) { return '<button type="button" class="m-chip' + (cur === o[0] ? ' on' : '') + '" data-ma="mgf" data-k="' + key + '" data-v="' + esc(o[0]) + '">' + esc(o[1]) + '</button>'; }).join('') + '</div>';
  }
  var listTab = {
    id: 'alle', label: 'Alle Mitglieder', coll: 'wgMitglieder', view: ['mitglieder.view'], edit: ['mitglieder.edit'], add: ['mitglieder.edit', 'mitglieder.anlegen'], del: ['mitglieder.edit', 'mitglieder.loeschen'], addLabel: 'Neues Mitglied', search: ['name', 'dsv'], get fields() { return M.anyCan(['mitglieder.trainer']) ? FIELDS : FIELDS.filter(function (f) { return f.k !== 'trainerIn'; }); },
    newItem: function () { var f = flt(); return { gruppen: f.g ? [f.g] : [], rollen: ['Schwimmer'] }; },
    prep: function (m) { var t = match(m.name, trainers().map(function (x) { return { name: x.name, g: x.gruppen }; })); if (!Array.isArray(m.trainerIn)) { var tr = trainers().filter(function (x) { return lower(x.name) === lower(m.name) || lower(x.name) === lower(swapName(m.name)); })[0]; m.trainerIn = tr ? (tr.gruppen || []).slice() : []; } return m; },
    beforeSave: function (it) {
      it.title = it.name; if (!M.anyCan(['mitglieder.trainer'])) { delete it.trainerIn; return; } var tin = Array.isArray(it.trainerIn) ? it.trainerIn : [];
      var tr = trainers().filter(function (x) { return lower(x.name) === lower(it.name) || lower(x.name) === lower(swapName(it.name)); })[0];
      if (tr) { if (JSON.stringify(tr.gruppen || []) !== JSON.stringify(tin)) M.op({ op: 'patch', coll: 'trainer', id: tr.id, fields: { gruppen: tin } }); }
      else if (tin.length) M.op({ op: 'set', coll: 'trainer', item: { id: 't-' + slug(it.name), name: it.name, title: it.name, owner: it.name, gruppen: tin } });
    },
    filter: function (m, f) { f = f || {}; if (f.g && gOf(m).indexOf(f.g) < 0) return false; if (f.r && !hasR(m, f.r)) return false; if (!f.alle && !isActive(m)) return false; return true; },
    summary: function (all) {
      var f = flt(); var act = all.filter(isActive);
      return '<div class="m-stats">' + M.stat(act.length, 'Aktive Mitglieder', '') + M.stat(all.length - act.length, 'Pausiert / ausgetreten', '') + M.stat(act.filter(function (m) { return hasR(m, 'Kampfrichter'); }).length, 'Kampfrichter', '') + M.stat(act.filter(function (m) { return !gOf(m).length; }).length, 'Ohne Gruppe', act.filter(function (m) { return !gOf(m).length; }).length ? 'warn' : '') + '</div>' +
        chipRow('Gruppe', 'g', GR, f.g || '') + chipRow('Rolle', 'r', ROLLEN, f.r || '') + '<div class="m-chips" style="margin:2px 0 8px"><button type="button" class="m-chip' + (f.alle ? ' on' : '') + '" data-ma="mgall">Auch pausierte und ausgetretene zeigen</button></div>';
    },
    card: function (m) {
      return { title: m.name, badges: (m.status ? M.badge(m.status, 'amber') : '') + rOf(m).filter(function (r) { return r !== 'Schwimmer'; }).map(function (r) { return ' ' + M.badge(r, 'blue'); }).join(''),
        sub: [m.jg ? 'Jg. ' + m.jg + ' (' + age(m) + ')' : '', gOf(m).join(', ') || 'keine Gruppe', (function () { var tr = trainers().filter(function (x) { return lower(x.name) === lower(m.name); })[0]; return tr && (tr.gruppen || []).length ? 'Trainer: ' + tr.gruppen.join(', ') : ''; })()].filter(Boolean).join(' · '),
        body: [m.dsv && m.dsv !== '0' ? '<div><b>DSV-ID:</b> ' + esc(m.dsv) + '</div>' : '', m.notiz ? '<div><pre>' + esc(m.notiz) + '</pre></div>' : ''].join('') };
    },
    printAll: function (all) {
      var f = flt(); var l = all.filter(function (m) { return listTab.filter(m, f); });
      return { title: 'Mitglieder' + (f.g ? ' ' + f.g : ''), body: '<h1>Mitglieder' + (f.g ? ': ' + esc(f.g) : '') + '</h1><div class="sub">Stand ' + M.fmtDate(M.today()) + ' · ' + l.length + ' Personen</div><table><tr><th>Name</th><th>Jg.</th><th>Gruppen</th><th>Rolle</th></tr>' + l.map(function (m) { return '<tr><td>' + esc(m.name) + '</td><td>' + esc(m.jg || '') + '</td><td>' + esc(gOf(m).join(', ')) + '</td><td>' + esc(rOf(m).join(', ')) + '</td></tr>'; }).join('') + '</table>' };
    }
  };

  /* ---------- Gruppenübersicht ---------- */
  function gruppenTab() {
    var ms = members().filter(isActive); var tr = trainers();
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Gruppen</h3></div><p class="wm-note">Tippe auf eine Gruppe, um ihre Mitglieder zu sehen. Gruppen kommen aus dem WebClub-Import (Gruppenliste).</p></section><div class="m-stats" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">';
    GR.forEach(function (g) {
      var inG = ms.filter(function (m) { return gOf(m).indexOf(g) >= 0; });
      var sw = inG.filter(function (m) { return hasR(m, 'Schwimmer'); }).length; var kr = inG.filter(function (m) { return hasR(m, 'Kampfrichter'); }).length; var fu = inG.filter(function (m) { return hasR(m, 'Funktionär'); }).length;
      var tn = tr.filter(function (t) { return (t.gruppen || []).indexOf(g) >= 0; }).length;
      out += '<button type="button" class="m-stat" data-ma="mggo" data-v="' + esc(g) + '"><b>' + sw + '</b><span>' + esc(g) + '</span><small class="wm-sub">Schwimmer · ' + tn + ' Trainer · ' + kr + ' Kampfrichter · ' + fu + ' Funktionäre</small></button>';
    });
    var none = ms.filter(function (m) { return !gOf(m).length; }).length;
    return out + '</div>' + (none ? '<p class="wm-note">' + none + ' aktive Mitglieder haben noch keine Gruppe.</p>' : '');
  }

  /* ---------- WebClub-Import ---------- */
  function parseGruppenliste(lines) {
    var out = { kind: '', rows: [] };
    lines.forEach(function (ln) {
      var s = String(ln).replace(/\s+/g, ' ').trim();
      if (/^Trainer in der Gruppe/i.test(s)) { out.kind = 'trainer'; return; }
      if (/^Schwimmer in der Gruppe/i.test(s)) { out.kind = 'schwimmer'; return; }
      var m = /^(.+?) (\d{4}) (\d+) (Ja|Nein)$/.exec(s);
      if (m) { out.rows.push({ name: m[1].trim(), jg: m[2], dsv: m[3], aktiv: m[4] === 'Ja' }); return; }
      m = /^(.+?) (\d{4}) (Ja|Nein)$/.exec(s);
      if (m) out.rows.push({ name: m[1].trim(), jg: m[2], dsv: '', aktiv: m[3] === 'Ja' });
    });
    if (!out.kind) out.kind = out.rows.some(function (r) { return r.dsv; }) ? 'schwimmer' : 'trainer';
    return out;
  }
  var IMP = null;
  function importTab() {
    var can = M.anyCan(['mitglieder.import']);
    if (!can) return '<section class="wm-card"><p class="wm-note">Für den Import fehlt dir die Berechtigung.</p></section>';
    return '<section class="wm-card"><div class="wm-bar"><h3>WebClub-Import</h3></div><p class="wm-note">Wähle die Gruppe und die „Gruppenliste“ (PDF) aus WebClub. Du kannst die Schwimmer- und die Trainerliste zusammen auswählen. Du siehst zuerst eine Vorschau (neu, geändert, nicht mehr in der Liste). Es wird nie automatisch gelöscht.</p>' +
      '<div class="m-fgrid"><label class="m-f"><span>Gruppe</span><select id="mi_g">' + GR.map(function (g) { return '<option>' + esc(g) + '</option>'; }).join('') + '</select></label><label class="m-f wide"><span>PDF-Datei(en)</span><input type="file" id="mi_f" accept="application/pdf,.pdf" multiple></label></div><div class="m-btns"><button type="button" class="wm-amber" data-ma="mimpread">Vorschau erstellen</button></div><div id="mi_msg" class="wm-sub" style="margin-top:8px"></div></section>';
  }
  function impRead() {
    var fl = document.getElementById('mi_f').files; var msg = document.getElementById('mi_msg'); var g = document.getElementById('mi_g').value;
    if (!fl.length) { msg.textContent = 'Bitte zuerst eine PDF-Datei auswählen.'; return; }
    if (!window.HubPdf) { msg.textContent = 'Der PDF-Leser fehlt auf dieser Seite.'; return; }
    msg.textContent = 'Wird gelesen … (beim ersten Mal wird der PDF-Leser geladen)';
    Promise.all(Array.prototype.map.call(fl, function (f) { return HubPdf.read(f).then(function (r) { return parseGruppenliste(r.lines); }); })).then(function (res) {
      var sw = [], tr = []; res.forEach(function (x) { (x.kind === 'trainer' ? tr : sw).push.apply(x.kind === 'trainer' ? tr : sw, x.rows); });
      var tn = tr.map(function (x) { return lower(x.name); });
      var ms = members(); var rows = sw.filter(function (x) { return x.aktiv && tn.indexOf(lower(x.name)) < 0; });
      var neu = [], chg = [], same = 0, seen = {};
      rows.forEach(function (x) {
        var m = match(x.name, ms); var dsv = x.dsv && x.dsv !== '0' ? x.dsv : '';
        if (!m) { neu.push({ x: x, dsv: dsv }); return; }
        seen[m.id] = 1; var why = [];
        if (x.jg && String(m.jg || '') !== x.jg) why.push('Jahrgang ' + (m.jg || '–') + ' → ' + x.jg);
        if (dsv && m.dsv !== dsv) why.push('DSV-ID');
        if (gOf(m).indexOf(g) < 0) why.push('Gruppe ' + g + ' neu');
        if (why.length) chg.push({ m: m, x: x, dsv: dsv, why: why }); else same++;
      });
      var gone = ms.filter(function (m) { return isActive(m) && gOf(m).indexOf(g) >= 0 && !seen[m.id]; });
      IMP = { g: g, neu: neu, chg: chg, gone: gone, tr: tr, inactive: sw.filter(function (x) { return !x.aktiv; }).length };
      if (!rows.length && !tr.length) { msg.innerHTML = '<span class="m-over">Keine Personen in der Datei gefunden. Ist das die „Gruppenliste“ aus WebClub?</span>'; return; }
      var list = function (title, arr, fn) { return arr.length ? '<div class="m-sec">' + title + ' (' + arr.length + ')</div><div style="max-height:22vh;overflow:auto">' + arr.map(fn).join('') + '</div>' : ''; };
      M.openDlg('<div class="hub-dhead"><h3>Vorschau: ' + esc(g) + '</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div>' +
        '<p class="wm-note"><b>' + neu.length + '</b> neu · <b>' + chg.length + '</b> geändert · <b>' + same + '</b> unverändert · <b>' + gone.length + '</b> nicht mehr in der Liste' + (IMP.inactive ? ' · ' + IMP.inactive + ' inaktive übersprungen' : '') + '</p>' +
        list('Neu', neu, function (r) { return '<div class="m-chk"><span style="flex:1">' + esc(swapName(r.x.name)) + '</span><span class="wm-sub">Jg. ' + esc(r.x.jg) + '</span></div>'; }) +
        list('Geändert', chg, function (r) { return '<div class="m-chk"><span style="flex:1">' + esc(r.m.name) + '</span><span class="wm-sub">' + esc(r.why.join(', ')) + '</span></div>'; }) +
        list('Nicht mehr in der Liste (nichts wird gelöscht)', gone, function (m) { return '<label class="m-chk"><input type="checkbox" data-gone="' + esc(m.id) + '"><span style="flex:1">' + esc(m.name) + '</span><span class="wm-sub">aus ' + esc(g) + ' nehmen</span></label>'; }) +
        (tr.length ? '<p class="wm-sub">Trainer in der Liste: <b>' + tr.map(function (t) { return esc(swapName(t.name)); }).join(', ') + '</b> (kommen in den Bereich „Trainer“' + (M.anyCan(['trainer.edit']) ? '' : ', dafür fehlt dir das Recht') + ')</p>' : '') +
        '<div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="mimpsave">Übernehmen</button></div>');
    }, function (e) { msg.innerHTML = '<span class="m-over">' + esc(e.message || String(e)) + '</span>'; });
  }
  function impSave() {
    if (!IMP) return; var ops = []; var g = IMP.g;
    IMP.neu.forEach(function (r) { ops.push({ op: 'set', coll: 'wgMitglieder', item: { id: M.uid(), name: swapName(r.x.name), title: swapName(r.x.name), jg: Number(r.x.jg), dsv: r.dsv, gruppen: [g], rollen: ['Schwimmer'] } }); });
    IMP.chg.forEach(function (r) {
      var f = {}; if (r.x.jg && String(r.m.jg || '') !== r.x.jg) f.jg = Number(r.x.jg); if (r.dsv && r.m.dsv !== r.dsv) f.dsv = r.dsv;
      if (gOf(r.m).indexOf(g) < 0) f.gruppen = gOf(r.m).concat([g]);
      ops.push({ op: 'patch', coll: 'wgMitglieder', id: r.m.id, fields: f });
    });
    var boxes = document.querySelectorAll('input[data-gone]:checked');
    Array.prototype.forEach.call(boxes, function (b) { var m = M.find('wgMitglieder', b.getAttribute('data-gone')); if (m) ops.push({ op: 'patch', coll: 'wgMitglieder', id: m.id, fields: { gruppen: gOf(m).filter(function (x) { return x !== g; }) } }); });
    if (M.anyCan(['trainer.edit'])) {
      var ex = trainers();
      IMP.tr.forEach(function (t) {
        if (!t.aktiv) return; var nm = swapName(t.name); var f0 = ex.filter(function (e) { return lower(e.name) === lower(nm); })[0];
        if (f0) { if ((f0.gruppen || []).indexOf(g) < 0) ops.push({ op: 'patch', coll: 'trainer', id: f0.id, fields: { gruppen: (f0.gruppen || []).concat([g]) } }); }
        else ops.push({ op: 'set', coll: 'trainer', item: { id: 't-' + slug(nm), name: nm, title: nm, owner: nm, gruppen: [g] } });
      });
    }
    M.closeDlg(); if (ops.length) M.ops(ops); M.toast(ops.length ? 'Import übernommen (' + ops.length + ' Änderungen).' : 'Nichts zu ändern.'); IMP = null;
  }

  function applyHash() {
    var h = decodeURIComponent(String(location.hash || '').replace(/^#/, '')); if (!h) return;
    if (h === 'gruppen') { M.S.tab = 'gruppen'; } else if (h === 'import') { M.S.tab = 'import'; } else if (h === 'alle') { M.S.tab = 'alle'; M.S.filter = {}; } else if (/^g=/.test(h)) { M.S.tab = 'alle'; M.S.filter = { g: h.slice(2) }; } else return;
    if (M.render) M.render(true);
  }
  window.addEventListener('hashchange', applyHash);
  setTimeout(applyHash, 900); setTimeout(applyHash, 2500);

  M.register('mitglieder', {
    title: 'Mitglieder', icon: '👥', colls: ['wgMitglieder', 'trainer'],
    tabs: [listTab, { id: 'gruppen', label: 'Gruppen', view: ['mitglieder.view'], render: function () { return gruppenTab(); } }, { id: 'import', label: 'WebClub-Import', view: ['mitglieder.import'], render: function () { return importTab(); } }],
    actions: {
      mgf: function (it, el) { var f = flt(); var k = el.getAttribute('data-k'), v = el.getAttribute('data-v'); if (v) f[k] = v; else delete f[k]; M.render(true); },
      mgall: function () { var f = flt(); f.alle = !f.alle; M.render(true); },
      mggo: function (it, el) { M.S.tab = 'alle'; M.S.filter = { g: el.getAttribute('data-v') }; M.render(true); },
      mimpread: function () { impRead(); },
      mimpsave: function () { impSave(); }
    }
  });
})();
