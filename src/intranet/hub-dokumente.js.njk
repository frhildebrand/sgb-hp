/* Dokumente: Sammlung von Vereinsunterlagen als Links oder Dateien im Drive. */
(function () {
  'use strict';
  var M = window.HubMod; if (!M) return; var esc = M.esc;
  var KAT = ['Verein', 'Mitgliedschaft', 'Wettkampf', 'Training', 'Finanzen', 'Veranstaltungen', 'Sonstiges'];
  function flt() { return M.S.filter || (M.S.filter = {}); }
  var tab = {
    id: 'dok', label: 'Dokumente', coll: 'dokumente', view: ['dokumente.view'], edit: ['dokumente.edit'], add: ['dokumente.edit'], del: ['dokumente.edit'], addLabel: 'Dokument eintragen', search: ['titel', 'notiz', 'kat'],
    fields: [{ k: 'titel', t: 'text', label: 'Titel', req: true }, { k: 'kat', t: 'sel', label: 'Bereich', opts: KAT }, { k: 'url', t: 'text', label: 'Link', ph: 'https://…', hint: 'Adresse der Datei, zum Beispiel von der Homepage oder aus dem Drive.' }, { k: 'notiz', t: 'area', label: 'Beschreibung', rows: 2 }],
    newItem: function () { return { kat: flt().k || 'Verein' }; },
    beforeSave: function (it) { it.title = it.titel; if (it.url && !/^https:\/\//i.test(it.url)) throw new Error('Der Link muss mit https:// beginnen.'); },
    filter: function (d, f) { f = f || {}; return !f.k || d.kat === f.k; },
    sortBy: function (a, b) { return String(a.kat || '').localeCompare(String(b.kat || ''), 'de') || String(a.titel || '').localeCompare(String(b.titel || ''), 'de'); },
    summary: function () {
      var f = flt(); var up = M.anyCan(['dokumente.edit']) ? '<div class="m-btns" style="margin-bottom:8px"><button type="button" class="wm-amber" data-ma="dokup">📤 Datei hochladen</button><input type="file" id="dok_f" style="display:none"></div>' : '';
      return up + '<div class="m-chips">' + [''].concat(KAT).map(function (k) { return '<button type="button" class="m-chip' + ((f.k || '') === k ? ' on' : '') + '" data-ma="dokk" data-v="' + esc(k) + '">' + esc(k || 'Alle') + '</button>'; }).join('') + '</div>';
    },
    card: function (d) {
      var ok = d.url && /^https:\/\//i.test(d.url);
      return { title: d.titel, badges: M.badge(d.kat || 'Sonstiges', 'gray'), sub: d.notiz ? esc(d.notiz) : '', row: ok ? '<a class="wm-btn" href="' + esc(d.url) + '" target="_blank" rel="noopener" data-noexp="1">Öffnen</a>' : '', body: ok ? '<div><a href="' + esc(d.url) + '" target="_blank" rel="noopener">' + esc(d.url) + '</a></div>' : '<div class="wm-sub">Kein Link hinterlegt.</div>' };
    }
  };
  function upload(file) {
    if (!file) return; if (file.size > 6000000) { M.toast('Die Datei ist zu groß (maximal 6 MB).'); return; }
    var fr = new FileReader(); M.toast('Wird hochgeladen …');
    fr.onload = function () {
      window.HubShell.post({ action: 'fileSave', token: window.HubShell.token(), area: 'dokumente', sub: flt().k || '', name: file.name, data: String(fr.result).split(',')[1] || '' }).then(function (r) {
        if (!r || r.status !== 'success' || !/^https:\/\//.test(r.url || '')) { M.toast((r && r.message) || 'Hochladen fehlgeschlagen.'); return; }
        var t = file.name.replace(/\.[^.]+$/, ''); M.op({ op: 'set', coll: 'dokumente', item: { id: M.uid ? M.uid() : 'dok-' + Date.now(), titel: t, title: t, kat: flt().k || 'Verein', url: r.url, datei: file.name } }); M.toast('Datei im Drive abgelegt und eingetragen.');
      });
    };
    fr.readAsDataURL(file);
  }
  M.register('dokumente', {
    title: 'Dokumente', icon: '📁', colls: ['dokumente'], tabs: [tab],
    onChange: function (ev) { if (ev.target && ev.target.id === 'dok_f') { upload(ev.target.files[0]); ev.target.value = ''; } },
    actions: { dokk: function (it, el) { var f = flt(), v = el.getAttribute('data-v'); if (v) f.k = v; else delete f.k; M.render(true); }, dokup: function () { var i = document.getElementById('dok_f'); if (i) i.click(); } }
  });
})();
