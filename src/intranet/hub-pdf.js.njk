      if (curEv && curLauf && (m = /^Bahn\s+(\d+)\s+(.+?)\s+(\d{4}|Offen)\s+(\S.*?)\s+(\d{1,2}:\d{2},\d{2})\s*$/.exec(tl))) {
        var st = { e: curEv.no, l: curLauf.l, lt: curLauf.lt, t: curLauf.t, b: +m[1], n: m[2].replace(/\s+\((M|W|X)\)\s*$/, '').trim(), s: sexOf(m[2], curEv.name), j: m[3] === 'Offen' ? 'Staffel' : m[3], v: m[4].trim(), m: m[5] === '00:00,00' ? '' : m[5] };
