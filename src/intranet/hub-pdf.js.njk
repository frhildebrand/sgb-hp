      if (e) { out.events.push({ no: +e[1], ab: curAb || 1, name: e[2].replace(/\s+/g, ' ') + ' ' + e[3] + ' ' + ({ weiblich: 'weiblich', männlich: 'männlich', mixed: 'mixed' }[e[4].toLowerCase()]), jg: e[5].trim() }); return; }
