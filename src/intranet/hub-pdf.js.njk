      else if (key === 'ANSPRECHPARTNER') { out.kontakt = f[0]; out.email = f[7] || ''; }
      else if (key === 'PNMELDUNG') { var sw = { n: f[0].replace(/^([^,]+),\s*(.+)$/, '$2 $1'), nn: f[0], dsv: f[1], pn: f[2], s: f[3], j: f[4] }; byPn[f[2]] = sw; out.swimmers.push(sw); }
      else if (key === 'STARTPN') {
