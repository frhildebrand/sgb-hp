    var kj = joined.replace(/\s+/g, ' '); var re = /(?:bis\s+(\d+)|(\d+)\s+bis\s+(\d+)|ab\s+(\d+))\s+Meldungen\s+(\d+)\s+Kampfrichter/gi;
    while ((m = re.exec(kj))) { out.kr.push({ von: m[2] ? +m[2] : (m[4] ? +m[4] : 0), bis: m[1] ? +m[1] : (m[3] ? +m[3] : 9999), n: +m[5] }); }
