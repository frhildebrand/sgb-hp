  function sexLabel(x) { return x === 'M' ? 'männlich' : x === 'W' ? 'weiblich' : x === 'X' ? 'mixed' : ''; }

  // Meldedatei im DSV7-Format (Vereinsmeldeliste)
  function parseDsv7(text) {
