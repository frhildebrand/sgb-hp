    for (i = 0; i < L.length; i++) {
      if (/Meldeschluss/i.test(L[i])) {
        var seg = L[i] + ' ' + (L[i + 1] || ''); var dm = dateDe(seg);
        if (dm) { out.meldeschluss = dm; var um = /(?:um|bis|\d{4})\s+(\d{1,2}[.:]\d{2})\s*Uhr/i.exec(seg.split(/Einlass/i)[0]); if (!um) for (var q = 0; q < L.length && !um; q++) if (/Meldeschluss/i.test(L[q])) um = /(?:um|bis|\d{4})\s+(\d{1,2}[.:]\d{2})\s*Uhr/i.exec(L[q]); out.meldeschlussUhr = um ? clock(um[1]) : ''; break; }
