    var L = lines.map(function (l) { return l.replace(/\s{3,}/g, '   ').trim(); }).filter(Boolean);
    var head = L.slice(0, 14); var m, i;
    out.title = (head[0] || '').replace(/^Ausschreibung\s*(zum|des|der)?\s*/i, '').trim();
    for (i = 1; i < 4; i++) { var h = head[i] || ''; if (/^(der|des|vom|vom)\s+/i.test(h) || /Schwimm|Verein|SG |SV |SC /i.test(h)) { if (!/^(am|im|datum|ort)\b/i.test(h)) { out.veranstalter = h.replace(/^(der|des)\s+/i, ''); break; } } }
    // Datum
    for (i = 0; i < Math.min(L.length, 30); i++) {
      if (/Meldeschluss/i.test(L[i])) continue;
      var d = dateDe(L[i]); if (d && /(Datum|am\s|vom\s|\d{1,2}\.\s*(\/|bis)?)/i.test(L[i])) { out.date = d; var m2 = /(\d{1,2})\.\s*\/\s*(\d{1,2})\.\s*(\w+)\s+(\d{4})/.exec(L[i]); if (m2) out.date2 = dateDe(m2[2] + '. ' + m2[3] + ' ' + m2[4]); break; }
    }
    // Ort / Halle
    for (i = 0; i < Math.min(L.length, 30); i++) {
      if ((m = /^(?:Ort:?|im|in der|in)\s+(.+)$/i.exec(L[i])) && /\d{5}|bad|halle|schwimm/i.test(L[i])) { out.halle = m[1].replace(/^Ort:\s*/i, '').trim(); var c = /\b\d{5}\s+([A-ZÄÖÜ][^,]+)$/.exec(out.halle); out.ort = c ? c[1].trim() : out.halle.split(',')[0].replace(/^(Hallenbad|Freibad|Schwimmhalle|Wiehe-Bad)\s+/i, '').trim(); break; }
    }
