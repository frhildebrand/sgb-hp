      if (s) { curAb = +s[1]; out.abschnitte.push({ no: curAb, tag: dateDe(s[2]), einschwimmen: clock(s[3]), kr: clock(s[4]), beginn: clock(s[5]) }); return; }
      var s2 = /Einlass und Einschwimmen:\s*([\d.:]+)\s*Uhr.*Kampfrichtersitzung:\s*([\d.:]+)\s*Uhr.*Beginn:\s*([\d.:]+)\s*Uhr/i.exec(l);
