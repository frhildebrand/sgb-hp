    else if ((m = /Einzel\w*:?\s*([\d,.]+)\s*(?:EUR|Euro|€)\s+Staffel\w*:?\s*([\d,.]+)\s*(?:EUR|Euro|€)/i.exec(joined))) out.meldegeld = 'Einzelstart ' + m[1] + ' €, Staffelstart ' + m[2] + ' €';
    else if ((m = /Meldegeld[^.]{0,160}(?:EUR|Euro|€)[^.]{0,80}\./i.exec(joined))) out.meldegeld = m[0].replace(/\s+/g, ' ').trim().slice(0, 240);
    for (i = 0; i < L.length; i++) if (/^Meldeanschrift:/i.test(L[i])) { var a = [L[i].replace(/^Meldeanschrift:\s*/i, '')]; for (var k = 1; k <= 2; k++) { var nx = L[i + k] || ''; if (!/^(E-?Mail|Tel|Fax|www|\S+@\S+|\d{5})/i.test(nx)) break; a.push(nx); } out.meldeanschrift = a.join(', ').replace(/\s{2,}/g, ' ').slice(0, 240); break; }
