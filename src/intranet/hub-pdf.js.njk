  function timeMs(t) { var m = /^(\d{2}):(\d{2}),(\d{2})$/.exec(t || ''); return m ? (+m[1]) * 60000 + (+m[2]) * 1000 + (+m[3]) * 10 : null; }
  function diffStr(ms) { var a = Math.abs(ms); var s = Math.floor(a / 1000), h = Math.round((a % 1000) / 10); return (ms < 0 ? '−' : '+') + s + ',' + ('0' + h).slice(-2) + ' s'; }

  /* ---------- Weitere Dateien: Ausschreibung (PDF), Meldedatei (DSV7), Protokoll (PDF), Anwesenheitsliste (PDF) ---------- */
  var MONATE = { januar: 1, februar: 2, märz: 3, maerz: 3, april: 4, mai: 5, juni: 6, juli: 7, august: 8, september: 9, oktober: 10, november: 11, dezember: 12 };
