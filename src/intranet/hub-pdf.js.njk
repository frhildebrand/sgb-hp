      else if (key === 'VERANSTALTUNG') { out.title = f[0]; out.ort = f[1]; out.bahn = f[2] ? f[2] + ' m' : ''; out.zeit = /hand/i.test(f[3] || '') ? 'Handzeit' : (f[3] ? 'Automatik' : ''); }
