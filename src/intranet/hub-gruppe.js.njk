    }
    function isoWeek(d) { var x = new Date(d + 'T12:00:00'); x.setDate(x.getDate() + 4 - (x.getDay() || 7)); var y0 = new Date(x.getFullYear(), 0, 1); return [x.getFullYear(), Math.ceil(((x - y0) / 86400000 + 1) / 7)]; }
    function weekRange(d) { var x = new Date(d + 'T12:00:00'); var wd = (x.getDay() || 7) - 1; var m0 = new Date(x); m0.setDate(x.getDate() - wd); var s0 = new Date(m0); s0.setDate(m0.getDate() + 6); var f = function (z) { return ('0' + z.getDate()).slice(-2) + '.' + ('0' + (z.getMonth() + 1)).slice(-2) + '.'; }; return f(m0) + '–' + f(s0); }
    function gChips(t) { return gsOf(t).map(function (g) { var i = Math.max(0, GRS.indexOf(g)); return '<span class="tt-g tt-g' + (i % 5) + '">' + esc(g) + '</span>'; }).join(''); }
    var DAYS = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
    var cards = '', rows = '', lastW = '';
    list.forEach(function (t) {
      var c = counts(t); var open = !!M.S.open[t.id]; var tr = (t.trainer || []);
      cards += '<article class="m-card" data-id="' + esc(t.id) + '"><div class="m-head" data-ma="toggle"><div class="m-main"><div class="m-title">' + esc(fd(t.date)) + (t.time ? ' · ' + esc(t.time) + ' Uhr' : '') + '</div><div class="wm-sub">' + [esc(gOfT(t)), t.fokus ? esc(t.fokus) : '', tr.length ? 'Trainer: ' + esc(tr.join(', ')) : '', 'Anwesend ' + c.a + (c.e ? ' · entsch. ' + c.e : '') + (c.f ? ' · fehlt ' + c.f : '')].filter(Boolean).join(' · ') + '</div></div><span class="m-chev">' + (open ? '▾' : '▸') + '</span></div>' + (open ? bodyHtml(t) : '') + '</article>';
    });
    // Tabelle (breite Bildschirme): je Woche eine Trennzeile, je Termin eine Zeile
