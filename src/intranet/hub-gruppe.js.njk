    hint: 'Wer trainiert in der Wettkampfgruppe? Im Drucken-Menü der Karte gibt es den Anmeldebogen zum Unterschreiben.',
    newItem: function () { return { status: 'aktiv', eintritt: M.today() }; },
    summary: function (all) { var a = all.filter(isActive).length; return '<p class="wm-note"><b>' + a + '</b> aktiv · ' + all.filter(function (m) { return m.status === 'pausiert'; }).length + ' pausiert · ' + all.filter(function (m) { return m.status === 'ausgetreten'; }).length + ' ausgetreten</p><p><button type="button" class="wm-btn" data-ma="wgblank">🖨️ Leerer Anmeldebogen</button></p>'; },
    card: function (m) {
      return { title: m.name, dim: m.status === 'ausgetreten', badges: m.status && m.status !== 'aktiv' ? M.badge(m.status === 'pausiert' ? 'pausiert' : 'ausgetreten', m.status === 'pausiert' ? 'amber' : 'gray') : '',
        sub: [m.jg ? 'Jg. ' + m.jg + ' (' + age(m) + ')' : '', m.sex === 'w' ? 'weiblich' : m.sex === 'm' ? 'männlich' : m.sex === 'd' ? 'divers' : '', m.eintritt ? 'seit ' + fs(m.eintritt) : ''].filter(Boolean).join(' · '),
        body: [m.dsv ? '<div><b>DSV-ID:</b> ' + esc(m.dsv) + '</div>' : '', m.austritt ? '<div><b>Austritt:</b> ' + fd(m.austritt) + '</div>' : '', m.kontakt ? '<div><b>Kontakt:</b><pre>' + esc(m.kontakt) + '</pre></div>' : '', m.notiz ? '<div><b>Notiz:</b><pre>' + esc(m.notiz) + '</pre></div>' : ''].join('') };
    },
    printItem: function (m) { return { title: 'Anmeldung ' + m.name, body: formularHtml(m) }; },
    printAll: function (all) {
      return { title: 'Mitglieder Wettkampfgruppe', body: '<h1>Wettkampfgruppe: Mitglieder</h1><div class="sub">Stand ' + M.fmtDate(M.today()) + '</div><table><tr><th>Name</th><th>Jg.</th><th></th><th>Eintritt</th><th>Status</th><th>DSV-ID</th><th>Kontakt</th></tr>' + all.filter(function (m) { return m.status !== 'ausgetreten'; }).map(function (m) { return '<tr><td>' + esc(m.name) + '</td><td>' + esc(m.jg || '') + '</td><td>' + esc(m.sex || '') + '</td><td class="nowrap">' + fs(m.eintritt) + '</td><td>' + esc(m.status || 'aktiv') + '</td><td>' + esc(m.dsv || '') + '</td><td><pre>' + esc(m.kontakt || '') + '</pre></td></tr>'; }).join('') + '</table>' };
    }
  };

  /* ---------- Trainingstage ---------- */
  var TFIELDS = [
    { k: 'date', t: 'date', label: 'Datum', req: true },
    { k: 'time', t: 'time', label: 'Uhrzeit' },
    { k: 'dauer', t: 'num', label: 'Dauer (Min.)' },
    { k: 'trainer', t: 'tags', label: 'Trainer' },
    { k: 'ort', t: 'text', label: 'Ort' },
    { k: 'fokus', t: 'text', label: 'Schwerpunkt', ph: 'z. B. Wenden, Ausdauer' },
    { k: 'inhalt', t: 'area', label: 'Einheit / Inhalt', rows: 5 },
    { k: 'notiz', t: 'area', label: 'Notiz', rows: 3 },
    { k: 'beob', t: 'area', label: 'Beobachtungen', rows: 3 }
  ];
  function tageTab() {
    var ymv = curMonth(); var all = sessions();
    var list = all.filter(function (x) { return ym(x.date) === ymv; });
    var can = canTage();
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Trainingstage</h3><span class="m-actions">' +
      '<button type="button" class="wm-btn" data-ma="wgprintm">🖨️ Anwesenheitsliste</button>' + (can ? '<button type="button" class="wm-btn" data-ma="wgimport">📄 Import (PDF)</button><button type="button" class="wm-amber" data-ma="wgtnew">+ Trainingstag</button>' : '') + '</span></div>' +
      '<div class="m-chips" style="align-items:center"><button type="button" class="m-chip" data-ma="wgmon" data-d="-1">‹</button><b>' + esc(M.monthLabel(ymv)) + '</b><button type="button" class="m-chip" data-ma="wgmon" data-d="1">›</button><span class="wm-sub">' + list.length + ' Termine</span></div>';
