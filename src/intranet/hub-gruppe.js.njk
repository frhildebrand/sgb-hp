  /* ---------- Mitglieder ---------- */

  /* ---------- Trainingstage ---------- */
  // Fahrer eines Trainingstermins -> Fahrten (je Fahrer und Tag einmal), damit sie in der Fahrten-Abrechnung erscheinen
  function syncFahrten(t) {
