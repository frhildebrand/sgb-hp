    var ad = allday.length ? '<div class="wg-cal-g wg-cal-ad">ohne Zeit</div>' + days.map(function (d) { return '<div class="wg-cal-ad">' + allday.filter(function (x) { return x.date === d; }).map(function (x) { return '<span class="wg-ev1 wg-e' + (Math.max(0, GRS.indexOf(gsOf(x)[0])) % 5) + (isHid(x, hid) ? ' off' : '') + '" data-id="' + esc(x.id) + '" data-ma="wgev" role="button">' + esc(gsOf(x).join(' + ')) + '</span>'; }).join('') + '</div>'; }).join('') : '';
    var gut = '<div class="wg-cal-g" style="height:' + H + 'px">';
    for (var h = minH; h <= maxH; h++) gut += '<span style="top:' + Math.round((h - minH) * 60 * PPM) + 'px">' + ('0' + h).slice(-2) + ':00</span>';
