    list.forEach(function (t) {
      var c = counts(t); var open = !!M.S.open[t.id]; var tr = (t.trainer || []);
      out += '<article class="m-card" data-id="' + esc(t.id) + '"><div class="m-head" data-ma="toggle"><div class="m-main"><div class="m-title">' + esc(fd(t.date)) + (t.time ? ' · ' + esc(t.time) + ' Uhr' : '') + '</div><div class="wm-sub">' + [t.fokus ? esc(t.fokus) : '', tr.length ? 'Trainer: ' + esc(tr.join(', ')) : '', 'Anwesend ' + c.a + (c.e ? ' · entsch. ' + c.e : '') + (c.f ? ' · fehlt ' + c.f : '')].filter(Boolean).join(' · ') + '</div></div><span class="m-chev">' + (open ? '▾' : '▸') + '</span></div>';
      if (open) {
        var ro = rosterFor(t);
        out += '<div class="m-body">' + (t.inhalt ? '<div><b>Einheit:</b><pre>' + esc(t.inhalt) + '</pre></div>' : '') + (t.beob ? '<div><b>Beobachtungen:</b><pre>' + esc(t.beob) + '</pre></div>' : '') + (t.notiz ? '<div><b>Notiz:</b><pre>' + esc(t.notiz) + '</pre></div>' : '') +
          '<div class="m-sec">Anwesenheit' + (can ? ' – zum Ändern antippen' : '') + '</div><div class="wg-grid">' + (ro.length ? ro.map(function (m) { var cd = (t.anw || {})[m.id] || ''; return '<button type="button" class="wg-p c-' + (cd || 'o') + '" data-ma="wgtap" data-m="' + esc(m.id) + '"' + (can ? '' : ' disabled') + '><i>' + CODE_TXT[cd] + '</i><span>' + esc(m.name) + '</span></button>'; }).join('') : '<p class="wm-note">Noch keine Mitglieder angelegt.</p>') + '</div>' +
          '<p class="wm-sub">✓ anwesend · E entschuldigt · ✗ fehlt · · offen</p>' +
          '<div class="m-btns">' + (can ? '<button type="button" class="wm-btn" data-ma="wgall">Alle anwesend</button><button type="button" class="wm-btn" data-ma="wgtedit">✏️ Bearbeiten</button><button type="button" class="wm-btn m-danger" data-ma="wgtdel">🗑️ Löschen</button>' : '') + '<button type="button" class="wm-btn" data-ma="wgprintd">🖨️ Liste</button></div></div>';
      }
      out += '</article>';
    });
    return out + '</section>';
  }
  function printSheet(days, title) {
    var ms = members().filter(function (m) { return days.some(function (d) { return inGroup(m, d.date) || (d.anw && d.anw[m.id]); }); });
    var head = '<tr><th>Name</th>' + days.map(function (d) { return '<th class="nowrap">' + esc(M.fmtDate(d.date, true)) + '<br>' + esc(d.time || '') + '</th>'; }).join('') + '</tr>';
    var trainers = {}; days.forEach(function (d) { (d.trainer || []).forEach(function (n) { trainers[n] = 1; }); });
    var body = ms.map(function (m) { return '<tr><td>' + esc(m.name) + '</td>' + days.map(function (d) { var cd = (d.anw || {})[m.id]; return '<td style="text-align:center;min-width:34px">' + (cd ? CODE_TXT[cd] : '') + '</td>'; }).join('') + '</tr>'; }).join('');
    var tr = '<tr><td><i>Trainer</i></td>' + days.map(function (d) { return '<td style="font-size:10px">' + esc((d.trainer || []).join(', ')) + '</td>'; }).join('') + '</tr>';
    M.print(title, '<h1>' + esc(title) + '</h1><div class="sub">✓ anwesend · E entschuldigt · ✗ fehlt</div><table>' + head + tr + body + '</table>');
  }

  /* ---------- Statistik ---------- */
  function statistikTab() {
    var per = M.S.sub.sp || 'y'; var t = M.today();
    var from = per === '3m' ? M.addDays(t, -92) : per === 'y' ? t.slice(0, 4) + '-01-01' : '0000-00-00';
    var days = sessions().filter(function (d) { return d.date >= from && d.date <= t; });
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Anwesenheit</h3>' + M.seg([['3m', '3 Monate'], ['y', 'Dieses Jahr'], ['all', 'Alles']], per, 'wgper') + '</div><p class="wm-note">' + days.length + ' Trainingstage im Zeitraum. Prozent = anwesend im Verhältnis zu allen Terminen seit Eintritt.</p>';
    var rows = members().map(function (m) {
      var a = 0, e = 0, f = 0, n = 0;
      days.forEach(function (d) { if (!inGroup(m, d.date)) return; n++; var c = (d.anw || {})[m.id]; if (c === 'a') a++; else if (c === 'e') e++; else if (c === 'f') f++; });
      return { m: m, a: a, e: e, f: f, n: n, p: n ? Math.round(a * 100 / n) : null };
    }).filter(function (r) { return r.n > 0; }).sort(function (x, y) { return (y.p || 0) - (x.p || 0); });
    if (!rows.length) return out + '<p class="wm-note">Noch keine Daten.</p></section>';
    out += '<table class="m-table"><tr><th>Name</th><th>✓</th><th>E</th><th>✗</th><th>Termine</th><th style="width:34%">Anteil</th></tr>' + rows.map(function (r) { return '<tr><td>' + esc(r.m.name) + '</td><td>' + r.a + '</td><td>' + r.e + '</td><td>' + r.f + '</td><td>' + r.n + '</td><td>' + M.prog(r.a, r.n, false) + ' <b>' + r.p + ' %</b></td></tr>'; }).join('') + '</table></section>';
    return out;
  }

  /* ---------- Einheiten / Beobachtung (Standardlisten) ---------- */
  var einheitenTab = {
    id: 'einheiten', label: 'Einheiten', coll: 'trainingEinheiten', view: ['training.view'], edit: ['training.edit'], print: ['training.print'], printItem: true, addLabel: 'Neue Einheit', search: ['title', 'text', 'schwerpunkt'],
    hint: 'Sammlung bewährter Trainingseinheiten zum Wiederverwenden.',
    fields: [{ k: 'title', t: 'text', label: 'Name', req: true }, { k: 'schwerpunkt', t: 'text', label: 'Schwerpunkt' }, { k: 'dauer', t: 'num', label: 'Dauer (Min.)' }, { k: 'text', t: 'area', label: 'Ablauf', rows: 8 }],
    card: function (it) { return { title: it.title || it.name || 'Einheit', sub: [it.schwerpunkt ? esc(it.schwerpunkt) : '', it.dauer ? it.dauer + ' Min.' : ''].filter(Boolean).join(' · '), body: it.text || it.inhalt ? '<pre>' + esc(it.text || it.inhalt) + '</pre>' : '' }; },
    printItem: function (it) { return { title: it.title || 'Einheit', body: '<h1>' + esc(it.title || 'Einheit') + '</h1><div class="sub">' + esc([it.schwerpunkt, it.dauer ? it.dauer + ' Min.' : ''].filter(Boolean).join(' · ')) + '</div><pre>' + esc(it.text || it.inhalt || '') + '</pre>' }; }
  };
  var beobTab = {
    id: 'beob', label: 'Beobachtung', coll: 'trainingBeob', view: ['training.beobachtung'], edit: ['training.beobachtung'], addLabel: 'Neue Beobachtung', search: ['title', 'wer', 'text'], sortBy: { k: 'date', dir: -1 },
    hint: 'Notizen zu einzelnen Schwimmern: was fällt auf, woran arbeiten wir.',
    fields: [{ k: 'wer', t: 'text', label: 'Wer', req: true, list: 'mPeople' }, { k: 'date', t: 'date', label: 'Datum' }, { k: 'text', t: 'area', label: 'Beobachtung', rows: 6 }],
    newItem: function () { return { date: M.today() }; },
    beforeSave: function (it) { it.title = it.wer; it.by = it.by || M.userName(); },
    card: function (it) { return { title: it.wer || it.title || 'Beobachtung', sub: fd(it.date) + (it.by ? ' · ' + esc(it.by) : ''), body: it.text ? '<pre>' + esc(it.text) + '</pre>' : '' }; }
  };

  /* ---------- Wettkämpfe ---------- */
  function wkTab() {
    var all = M.items('wettkaempfe').sort(function (a, b) { return a.date < b.date ? 1 : -1; });
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Wettkämpfe</h3><a class="wm-amber" href="/intranet/wettkaempfe/" style="text-decoration:none">Zu den Wettkämpfen →</a></div>';
    if (M.S.denied && false) return out;
    if (!all.length) return out + '<p class="wm-note">Noch keine Wettkämpfe angelegt (oder keine Berechtigung).</p></section>';
    all.slice(0, 15).forEach(function (w) { out += '<div class="m-chk"><b style="min-width:5.5em">' + fs(w.date) + '</b><span style="flex:1">' + esc(w.title) + '</span><span class="wm-sub">' + (w.starts || []).length + ' Starts</span></div>'; });
    return out + '</section>';
  }

  /* ---------- Jahresrückblick ---------- */
  function bestzeiten(w) {
    var n = 0; (w.starts || []).forEach(function (s) { var r = (w.res || {})[s.e + '-' + s.l + '-' + s.b]; if (!r || !r.t || !s.m || !P) return; var a = P.timeMs(r.t), m = P.timeMs(s.m); if (a !== null && m !== null && a < m) n++; });
    return n;
  }
  function rueckblickData(year) {
    var y = String(year); var d = {};
    var days = M.items('trainingTage').filter(function (x) { return String(x.date).slice(0, 4) === y; });
    var a = 0, tot = 0; days.forEach(function (x) { var c = counts(x); a += c.a; tot += c.a + c.e + c.f; });
    d.tage = days.length; d.pct = tot ? Math.round(a * 100 / tot) : null;
    var ms = members(); d.zug = ms.filter(function (m) { return String(m.eintritt || '').slice(0, 4) === y; }); d.abg = ms.filter(function (m) { return String(m.austritt || '').slice(0, 4) === y; }); d.aktiv = ms.filter(isActive).length;
    d.wks = M.items('wettkaempfe').filter(function (w) { return String(w.date || '').slice(0, 4) === y; }).sort(function (a, b) { return a.date < b.date ? -1 : 1; });
    d.starts = 0; d.best = 0; d.sw = {}; d.wks.forEach(function (w) { d.starts += (w.starts || []).length; d.best += bestzeiten(w); (w.starts || []).forEach(function (s) { d.sw[s.n] = 1; }); });
    d.abz = M.items('abzeichen').filter(function (x) { return String(x.date || '').slice(0, 4) === y; });
    var top = ms.map(function (m) { var n = 0, p = 0; days.forEach(function (x) { if (!inGroup(m, x.date)) return; n++; if ((x.anw || {})[m.id] === 'a') p++; }); return { n: m.name, p: p, t: n }; }).filter(function (r) { return r.t >= 5; }).sort(function (x, y2) { return y2.p / y2.t - x.p / x.t; }).slice(0, 5);
    d.top = top;
    return d;
  }
  function rueckblickTab() {
    var y = M.S.sub.ry || String(new Date().getFullYear()); var d = rueckblickData(y);
    var years = []; for (var i = 0; i < 5; i++) years.push([String(new Date().getFullYear() - i), String(new Date().getFullYear() - i)]);
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Jahresrückblick ' + esc(y) + '</h3><span class="m-actions">' + M.seg(years, y, 'wgyear') + '<button type="button" class="wm-btn" data-ma="wgprintr">🖨️ Drucken</button></span></div>' +
      '<div class="m-stats">' + M.stat(d.tage, 'Trainingstage') + M.stat(d.pct === null ? '–' : d.pct + ' %', 'Ø Anwesenheit', 'ok') + M.stat(d.wks.length, 'Wettkämpfe') + M.stat(d.best, 'Bestzeiten', 'info') + '</div>' +
      '<p>' + d.aktiv + ' aktive Mitglieder heute · ' + d.zug.length + ' Eintritte' + (d.zug.length ? ' (' + d.zug.map(function (m) { return esc(m.name); }).join(', ') + ')' : '') + ' · ' + d.abg.length + ' Austritte' + (d.abg.length ? ' (' + d.abg.map(function (m) { return esc(m.name); }).join(', ') + ')' : '') + '</p>' +
      '<p>' + Object.keys(d.sw).length + ' Schwimmer waren bei Wettkämpfen am Start (' + d.starts + ' Starts).</p>';
    if (d.wks.length) out += '<div class="m-sec">Wettkämpfe</div>' + d.wks.map(function (w) { return '<div class="m-chk"><b style="min-width:5.5em">' + fs(w.date) + '</b><span style="flex:1">' + esc(w.title) + '</span><span class="wm-sub">' + (w.starts || []).length + ' Starts</span></div>'; }).join('');
    if (d.abz.length) out += '<div class="m-sec">Abzeichen</div><p>' + d.abz.length + ' Abzeichen abgelegt.</p>';
    if (d.top.length) out += '<div class="m-sec">Fleißigste (mind. 5 Termine)</div>' + d.top.map(function (r) { return '<div class="m-chk"><span style="flex:1">' + esc(r.n) + '</span><b>' + r.p + '/' + r.t + '</b></div>'; }).join('');
    return out + '</section>';
  }
  function printRueck() {
    var y = M.S.sub.ry || String(new Date().getFullYear()); var d = rueckblickData(y);
    M.print('Jahresrückblick ' + y, '<h1>Wettkampfgruppe: Jahresrückblick ' + esc(y) + '</h1><div class="sub">SG Barnstorf · Schwimmen</div><table><tr><th>Trainingstage</th><td>' + d.tage + '</td></tr><tr><th>Ø Anwesenheit</th><td>' + (d.pct === null ? '–' : d.pct + ' %') + '</td></tr><tr><th>Aktive Mitglieder</th><td>' + d.aktiv + '</td></tr><tr><th>Eintritte / Austritte</th><td>' + d.zug.length + ' / ' + d.abg.length + '</td></tr><tr><th>Wettkämpfe</th><td>' + d.wks.length + '</td></tr><tr><th>Starts / Schwimmer</th><td>' + d.starts + ' / ' + Object.keys(d.sw).length + '</td></tr><tr><th>Bestzeiten</th><td>' + d.best + '</td></tr><tr><th>Abzeichen</th><td>' + d.abz.length + '</td></tr></table>' +
      (d.wks.length ? '<h2>Wettkämpfe</h2><table><tr><th>Datum</th><th>Wettkampf</th><th>Ort</th><th>Starts</th></tr>' + d.wks.map(function (w) { return '<tr><td>' + fs(w.date) + '</td><td>' + esc(w.title) + '</td><td>' + esc(w.ort || '') + '</td><td>' + (w.starts || []).length + '</td></tr>'; }).join('') + '</table>' : ''));
  }

  /* ---------- Import Anwesenheitsliste (PDF aus WebClub) ---------- */
  var imp = null;
  function matchMember(name, ms) {
    var n = lower(name); var rev = n.indexOf(',') > 0 ? lower(n.split(',').slice(1).join(' ') + ' ' + n.split(',')[0]) : n;
    return ms.filter(function (m) { var mn = lower(m.name); return mn === n || mn === rev; })[0] || null;
  }
  function importDialog() {
    M.openDlg('<div class="hub-dhead"><h3>Anwesenheitsliste importieren</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div><p class="wm-note">PDF „Anwesenheitsliste“ aus WebClub. Trainer und Schwimmer werden getrennt erkannt. Bereits vorhandene Trainingstage werden ergänzt.</p><div class="m-fgrid"><label class="m-f wide"><span>PDF-Datei</span><input type="file" id="wgfile" accept="application/pdf,.pdf"></label></div><div id="wgmsg" class="wm-note"></div><div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="wgread">Auslesen</button></div>');
  }
  function doRead() {
    var f = document.getElementById('wgfile').files[0]; var msg = document.getElementById('wgmsg');
    if (!f) { msg.textContent = 'Bitte zuerst eine PDF-Datei auswählen.'; return; }
    msg.textContent = 'Wird gelesen … (beim ersten Mal wird der PDF-Leser geladen)';
    HubPdf.read(f).then(function (r) { imp = P.parseAnwesenheit(r.pages); imp.file = f.name; preview(); }, function (e) { msg.innerHTML = '<span class="m-over">' + esc(e.message || String(e)) + '</span>'; });
  }
  function preview() {
    var p = imp; var ms = members();
    var trainers = p.people.filter(function (x) { return x.trainer; }); var tn = trainers.map(function (x) { return lower(x.name); });
    var sw = p.people.filter(function (x) { return !x.trainer && tn.indexOf(lower(x.name)) < 0; });
    imp.sw = sw; imp.trainers = trainers;
    var unknown = sw.filter(function (x) { return !matchMember(x.name, ms); });
    imp.unknown = unknown;
    M.openDlg('<div class="hub-dhead"><h3>Das wurde gefunden</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div>' + (p.warnings.length ? '<div class="hub-err">' + p.warnings.map(esc).join('<br>') + '</div>' : '') +
      '<p class="wm-note"><b>' + p.sessions.length + '</b> ' + (p.sessions.length === 1 ? 'Termin' : 'Termine') + ' (' + fs(p.sessions[0] && p.sessions[0].date) + ' – ' + fs(p.sessions.length && p.sessions[p.sessions.length - 1].date) + ') · Trainer: <b>' + esc(trainers.map(function (x) { return x.name; }).join(', ') || '–') + '</b> · <b>' + sw.length + '</b> Schwimmer</p>' +
      (unknown.length ? '<div class="m-sec">Noch nicht in der Mitgliederliste</div><div style="max-height:26vh;overflow:auto">' + unknown.map(function (x, i) { return '<label class="m-f m-fchk" style="padding:4px 0"><input type="checkbox" data-wgnew="' + i + '" checked><span>' + esc(x.name) + ' anlegen</span></label>'; }).join('') + '</div>' : '<p class="wm-note">Alle Schwimmer sind bereits Mitglieder.</p>') +
      '<div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="wgsave"' + (p.sessions.length ? '' : ' disabled') + '>Übernehmen</button></div>');
  }
  function doImport() {
    var p = imp; var list = []; var ms = members(); var byName = {};
    ms.forEach(function (m) { byName[lower(m.name)] = m; });
    (p.unknown || []).forEach(function (x, i) {
      var cb = document.querySelector('[data-wgnew="' + i + '"]'); if (cb && !cb.checked) return;
      var first = (p.sessions[0] || {}).date || M.today();
      var m = { id: M.uid(), name: x.name, status: 'aktiv', eintritt: first };
      list.push({ op: 'set', coll: 'wgMitglieder', item: m }); byName[lower(x.name)] = m;
    });
    var existing = {}; M.items('trainingTage').forEach(function (t) { existing[t.date + '|' + (t.time || '')] = t; });
    var trainerNames = (p.trainers || []).map(function (x) { return x.name; });
    p.sessions.forEach(function (s, i) {
      var anw = {};
      (p.sw || []).forEach(function (x) { var m = matchMember(x.name, ms) || byName[lower(x.name)]; var c = x.st[i]; if (m && c) anw[m.id] = c; });
      var trAtt = (p.trainers || []).filter(function (x) { return x.st[i] === 'a'; }).map(function (x) { return x.name; });
      var tr = trAtt.length ? trAtt : trainerNames.slice(0, 1);
      var ex = existing[s.date + '|' + (s.time || '')];
      if (ex) { var fields = { anw: anw }; if (!(ex.trainer || []).length && tr.length) fields.trainer = tr; list.push({ op: 'patch', coll: 'trainingTage', id: ex.id, merge: true, fields: fields }); }
      else list.push({ op: 'set', coll: 'trainingTage', item: { id: 'tt-' + s.date.replace(/-/g, '') + '-' + String(s.time || '0000').replace(':', ''), date: s.date, time: s.time || '', trainer: tr, anw: anw, ort: '' } });
    });
    M.closeDlg(); M.ops(list); M.toast(p.sessions.length + (p.sessions.length === 1 ? ' Termin' : ' Termine') + ' übernommen.');
    if (p.sessions[0]) M.S.sub.gm = ym(p.sessions[0].date);
  }

  /* ---------- Modul ---------- */
  function mk(id, label, view, render, extra) { return Object.assign({ id: id, label: label, view: view, render: render }, extra || {}); }
  M.register('training', {
    title: 'Wettkampfgruppe', icon: '🦈', colls: ['wgMitglieder', 'trainingTage', 'trainingEinheiten', 'trainingBeob', 'wettkaempfe', 'abzeichen'],
    tabs: [
      mk('uebersicht', 'Übersicht', ['training.view', 'training.tage.view', 'training.mitglieder.view'], function () { return uebersicht(); }),
      memberTab,
      mk('tage', 'Trainingstage', ['training.tage.view'], function () { return tageTab(); }, { coll: 'trainingTage' }),
      mk('statistik', 'Statistik', ['training.tage.view'], function () { return statistikTab(); }),
      einheitenTab, beobTab,
      mk('wk', 'Wettkämpfe', ['training.view', 'training.tage.view'], function () { return wkTab(); }),
      mk('rueckblick', 'Jahresrückblick', ['training.rueckblick'], function () { return rueckblickTab(); })
    ],
    actions: {
      wgtab: function (it, el) { M.S.tab = el.getAttribute('data-v'); M.lsSet('modtab_training', M.S.tab); M.render(true); },
      wgblank: function () { M.print('Anmeldebogen', formularHtml(null)); },
      wgmon: function (it, el) { M.S.sub.gm = monthShift(curMonth(), +el.getAttribute('data-d')); M.render(true); },
      wgtnew: function () { M.openForm({ title: 'Neuer Trainingstag', fields: TFIELDS, item: { date: M.today(), dauer: 90, trainer: M.userName() ? [M.userName()] : [] }, onSave: function (v) { var t = Object.assign({ id: M.uid(), anw: {} }, v); M.S.sub.gm = ym(v.date); M.S.open[t.id] = true; M.op({ op: 'set', coll: 'trainingTage', item: t }); } }); },
      wgtedit: function (it, el, ev, c) { var t = M.find('trainingTage', c.id); if (!t) return; M.openForm({ title: 'Trainingstag bearbeiten', fields: TFIELDS, item: t, onSave: function (v) { M.op({ op: 'patch', coll: 'trainingTage', id: t.id, fields: v }); } }); },
      wgtdel: function (it, el, ev, c) { var t = M.find('trainingTage', c.id); if (!t) return; M.confirm('Trainingstag vom ' + fd(t.date) + ' samt Anwesenheit löschen?', 'Löschen', function () { M.op({ op: 'del', coll: 'trainingTage', id: t.id }); }); },
      wgtap: function (it, el, ev, c) {
        if (!canTage()) return; var t = M.find('trainingTage', c.id); if (!t) return; var mid = el.getAttribute('data-m');
        var cur = (t.anw || {})[mid] || ''; var nx = CODES[(CODES.indexOf(cur) + 1) % CODES.length]; var f = {}; f[mid] = nx || null;
        M.op({ op: 'patch', coll: 'trainingTage', id: t.id, merge: true, fields: { anw: f } });
      },
      wgall: function (it, el, ev, c) { var t = M.find('trainingTage', c.id); if (!t || !canTage()) return; var f = {}; rosterFor(t).forEach(function (m) { if (!(t.anw || {})[m.id]) f[m.id] = 'a'; }); M.op({ op: 'patch', coll: 'trainingTage', id: t.id, merge: true, fields: { anw: f } }); },
      wgprintd: function (it, el, ev, c) { var t = M.find('trainingTage', c.id); if (t) printSheet([t], 'Anwesenheit ' + M.fmtDate(t.date)); },
      wgprintm: function () { var days = sessions().filter(function (x) { return ym(x.date) === curMonth(); }).reverse(); if (!days.length) { M.toast('In diesem Monat gibt es keinen Trainingstag.'); return; } printSheet(days, 'Anwesenheit ' + M.monthLabel(curMonth())); },
      wgimport: function () { importDialog(); },
      wgread: function () { doRead(); },
      wgsave: function () { doImport(); },
      wgper: function (it, el) { M.S.sub.sp = el.getAttribute('data-v'); M.render(true); },
      wgyear: function (it, el) { M.S.sub.ry = el.getAttribute('data-v'); M.render(true); },
      wgprintr: function () { printRueck(); }
    }
  });
  var st = document.createElement('style'); st.textContent = '#hubRoot .wg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin:8px 0}#hubRoot .wg-p{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:12px;border:1px solid var(--line);background:#fff;color:inherit;font:700 14px -apple-system,system-ui,sans-serif;text-align:left;cursor:pointer;min-height:44px}#hubRoot .wg-p i{flex:0 0 auto;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-style:normal;font-weight:900;background:rgba(148,163,184,.25);color:var(--soft)}#hubRoot .wg-p span{overflow-wrap:anywhere;line-height:1.15}#hubRoot .wg-p.c-a i{background:var(--ok);color:#fff}#hubRoot .wg-p.c-e i{background:var(--warn);color:#fff}#hubRoot .wg-p.c-f i{background:var(--bad);color:#fff}#hubRoot .wg-p[disabled]{cursor:default}.dark #hubRoot .wg-p{background:#131d30;border-color:#1f2a3d}';
  document.head.appendChild(st);
})();
