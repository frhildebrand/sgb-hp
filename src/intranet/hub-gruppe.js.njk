      var cl = [], cur = null; es.forEach(function (v) { if (!cur || v.s >= cur.end) { cur = { end: v.e, lanes: [], items: [] }; cl.push(cur); } var ln = 0; while (cur.lanes[ln] !== undefined && cur.lanes[ln] > v.s) ln++; cur.lanes[ln] = v.e; v.lane = ln; cur.end = Math.max(cur.end, v.e); cur.items.push(v); });
      var blocks = cl.map(function (c) { var n = c.lanes.length; return c.items.map(function (v) {
        var x = v.x, tr = x.trainer || [], top = Math.round((v.s - minH * 60) * PPM), ht = Math.max(24, Math.round((v.e - v.s) * PPM) - 2), gi = Math.max(0, GRS.indexOf(gsOf(x)[0])) % 5;
        return '<div class="wg-ev wg-e' + gi + (ht < 46 ? ' sm' : '') + (isHid(x, hid) ? ' off' : '') + '" data-id="' + esc(x.id) + '" data-ma="wgev" role="button" style="top:' + top + 'px;height:' + ht + 'px;left:calc(' + (v.lane * 100 / n) + '% + 2px);width:calc(' + (100 / n) + '% - 4px)" title="' + esc(gsOf(x).join(' + ') + ' · ' + hhmm(v.s) + '–' + hhmm(v.e) + (x.ort ? ' · ' + x.ort : '') + (tr.length ? ' · ' + tr.join(', ') : '')) + '"><b>' + hhmm(v.s) + '–' + hhmm(v.e) + '</b><span>' + esc(gsOf(x).join(' + ')) + '</span>' + (tr.length ? '<i>' + esc(tr.map(function (n) { return String(n).split(' ')[0]; }).join(', ')) + '</i>' : '') + (x.ort ? '<i>' + esc(x.ort) + '</i>' : '') + '</div>'; }).join(''); }).join('');
      return '<div class="wg-cal-c' + (d === t ? ' today' : '') + '" style="height:' + H + 'px;background-size:100% ' + Math.round(60 * PPM) + 'px">' + blocks + '</div>';
    }).join('');
    return out + '<div class="wg-cal-w"><div class="wg-cal"><div class="wg-cal-r">' + head + '</div>' + (ad ? '<div class="wg-cal-r">' + ad + '</div>' : '') + '<div class="wg-cal-r">' + gut + cols + '</div></div></div>' + hidLine(nHid, showH) + '</section>';
  }
  // Fahrten der Wettkampfgruppe je Monat (aus den Trainingstagen)
  function fahrtenCard() {
    var y = M.S.sub.fy || String(new Date().getFullYear()), per = {}, any = false, tot = 0, mt = new Array(12).fill(0);
    sessions().filter(function (d) { return isWK(d) && String(d.date).slice(0, 4) === y && (d.fahrer || []).length; }).forEach(function (d) { var mo = Number(d.date.slice(5, 7)) - 1; (d.fahrer || []).forEach(function (n) { (per[n] = per[n] || new Array(12).fill(0))[mo]++; any = true; tot++; mt[mo]++; }); });
    var years = []; for (var i = 0; i < 4; i++) years.push([String(new Date().getFullYear() - i), String(new Date().getFullYear() - i)]);
    var MO = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'], MON = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
    var out = '<section class="wm-card"><div class="wm-bar"><h3>🚗 Fahrten · Wettkampfgruppe ' + esc(y) + '</h3>' + M.seg(years, y, 'wgfyear') + '</div>';
    if (!any) return out + '<p class="wm-note" style="margin:0">Noch keine Fahrten eingetragen. Fahrer werden beim Trainingstag angegeben.</p></section>';
    var names = Object.keys(per).sort(function (a, b) { return a.localeCompare(b, 'de'); });
    var mx = Math.max.apply(null, names.map(function (n) { return Math.max.apply(null, per[n]); }));
    out += '<p class="wm-sub" style="margin:0 0 8px"><b>' + tot + '</b> Fahrten · <b>' + names.length + '</b> Fahrer</p><div class="wg-fh"><span></span><div class="wg-fm">' + MO.map(function (m) { return '<i>' + m + '</i>'; }).join('') + '</div><span></span></div>';
    return out + names.map(function (n) { var r = per[n], sum = r.reduce(function (a, b) { return a + b; }, 0); return '<div class="wg-fr"><span class="wg-fn">' + esc(n) + '</span><div class="wg-fm">' + r.map(function (v, k) { return '<i class="' + (v ? 'on' : '') + '" style="' + (v ? 'opacity:' + (0.45 + 0.55 * v / mx).toFixed(2) : '') + '" title="' + MON[k] + ': ' + v + '">' + (v || '') + '</i>'; }).join('') + '</div><b class="wg-fs">' + sum + '</b></div>'; }).join('') + '</section>';
  }
  // Eine Seite je Gruppe: Warnung, nächste 7 Tage, Training, Mitglieder (wie in der Mitgliederliste), Anwesenheit, Fahrten
  // Kacheln einklappbar (Zustand bleibt im Browser gemerkt)
  function colState() { try { return JSON.parse(localStorage.getItem('wgcol') || '{}') || {}; } catch (e) { return {}; } }
