  }
  function monthShift(m, n) { var p = m.split('-'); var d = new Date(+p[0], +p[1] - 1 + n, 1); return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2); }
  function curMonth() { var s = M.S.sub; if (!s.gm) s.gm = ym(M.today()); return s.gm; }

  /* ---------- Übersicht ---------- */
  function gTag(g) { var i = Math.max(0, GRS.indexOf(g)); return '<span class="tt-g tt-g' + (i % 5) + '">' + esc(g) + '</span>'; }
  // Warnung: so viele Termine in Folge ohne Rückmeldung (weder anwesend noch entschuldigt) -> in WebClub aus der Gruppe nehmen
  function warnLimit() { var c = M.find('trainingCfg', 'main'), n = c && Number(c.warnN); return n >= 1 && n <= 20 ? Math.round(n) : 3; }
  function warnings(set) {
