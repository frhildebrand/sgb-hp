/* Wettkampfgruppe: Mitglieder, Trainingstage mit Anwesenheit, Statistik, Einheiten, Beobachtungen, Wettkämpfe, Jahresrückblick. */
(function () {
  'use strict';
  var M = window.HubMod; if (!M) return;
  var P = window.WKParse; var esc = M.esc;
  var CODES = ['', 'a', 'e', 'f'];
  var CODE_TXT = { '': '·', a: '✓', e: 'E', f: '✗' };
  var CODE_LABEL = { '': 'offen', a: 'anwesend', e: 'entschuldigt', f: 'fehlt' };
  function lower(s) { return String(s || '').toLowerCase().trim(); }
  function fd(iso) { return iso ? M.fmtDate(iso) : ''; }
  function fs(iso) { return iso ? M.fmtDate(iso, true) : ''; }
  function ym(iso) { return String(iso || '').slice(0, 7); }
