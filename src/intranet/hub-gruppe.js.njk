    var lw = function (x) { return String(x || '').toLowerCase(); }; var have = {}; M.items('fahrten').forEach(function (f) { have[lw(f.owner) + '|' + f.datum] = 1; });
    var fahrt = (M.find('saetze', 'main') || {}).fahrt; fahrt = fahrt === undefined || fahrt === '' ? 5 : M.num(fahrt); var ops = [];
    t.fahrer.forEach(function (n) { var k = lw(n) + '|' + t.date; if (have[k]) return; have[k] = 1; ops.push({ op: 'set', coll: 'fahrten', item: { id: M.uid(), owner: n, datum: t.date, notiz: 'Wettkampftraining' + (t.ort ? ', ' + t.ort : ''), status: 'offen', betrag: fahrt } }); });
    if (ops.length) { M.ops(ops); M.toast(ops.length + (ops.length === 1 ? ' Fahrt' : ' Fahrten') + ' für die Abrechnung angelegt.'); }
  }
  function fahrerOpts() {
    var o = []; ((M.find('saetze', 'main') || {}).fahrer || []).forEach(function (n) { n = String(n || '').trim(); if (n && o.indexOf(n) < 0) o.push(n); });
    if (!o.length) (M.D.people || []).forEach(function (n) { if (n && o.indexOf(n) < 0) o.push(n); });
    return o;
  }
  var TFIELDS = [
