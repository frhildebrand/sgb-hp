      var c = counts(t); var tr = (t.trainer || []); var open = !!M.S.open[t.id]; var tot = c.a + c.e + c.f; var pastDay = t.date <= M.today();
      var anw = tot || pastDay ? '<span class="tt-bar' + (tot && c.a / tot < 0.6 ? ' tt-warn' : '') + '"><i style="width:' + (tot ? Math.round(c.a / tot * 100) : 0) + '%"></i></span>' + c.a + (tot ? ' von ' + tot : '') : '<span class="wm-sub">offen</span>';
