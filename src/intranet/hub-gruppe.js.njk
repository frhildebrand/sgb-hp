      rows += '<tr class="tt-row' + (open ? ' tt-open' : '') + '" data-id="' + esc(t.id) + '" data-ma="toggle"><td class="tt-d">' + DAYS[d.getDay()] + ', ' + esc(fd(t.date).replace(/^\S+,?\s*/, '').slice(0, 6)) + '<small>' + (t.time ? esc(t.time) + ' Uhr' : '–') + '</small></td><td>' + gChips(t) + '</td><td>' + (esc(tr.join(', ')) || '<span class="wm-sub">–</span>') + '</td><td>' + (esc(t.ort || '') || '<span class="wm-sub">–</span>') + '</td><td>' + (t.dauer ? esc(String(t.dauer)) + ' Min.' : '–') + '</td><td>' + anw + '</td>' +
        '<td class="tt-opt"><button type="button" class="tt-ic" data-ma="toggle" title="Anwesenheit ansehen">' + (open ? '▾' : '👁') + '</button>' + (can ? '<button type="button" class="tt-ic" data-ma="wgtedit" title="Bearbeiten">✏️</button>' : '') + '<button type="button" class="tt-ic" data-ma="wgprintd" title="Liste drucken">🖨️</button>' + (M.anyCan(['training.tage.edit', 'training.tage.loeschen']) ? '<button type="button" class="tt-ic" data-ma="wgtdel" title="Löschen">🗑️</button>' : '') + '</td></tr>' +
