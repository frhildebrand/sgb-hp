    return tr;      // wer keine Gruppe hat, sieht auch keine
  }
  function gSet() { var g = M.S.sub.gg; if (g === '*') return null; if (g && g !== 'mine') return [g]; var m = myGroups(); return m.length ? [m[0]] : []; }       // null = alle Gruppen; [] = keine Gruppe
  function inSet(t, set) { return !set || gsOf(t).some(function (x) { return set.indexOf(x) >= 0; }); }
  function allGroups() { var o = GRS.slice(); M.items('wgMitglieder').forEach(function (m) { (m.gruppen || []).forEach(function (g) { if (o.indexOf(g) < 0) o.push(g); }); }); M.items('trainingTage').forEach(function (t) { gsOf(t).forEach(function (g) { if (o.indexOf(g) < 0) o.push(g); }); }); return o; }
  function defGroup() { var g = M.S.sub.gg; return g && g !== '*' ? g : myGroups()[0] || 'Wettkampfgruppe'; }
  function gChipsBar() {
