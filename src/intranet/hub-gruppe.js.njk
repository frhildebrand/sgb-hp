    if (!w.length) return '<section class="wm-card wg-warn ok"><div class="wg-wh"><span class="wg-wi">✓</span><div class="wg-wt"><h3>Keine Warnungen</h3><p>Niemand hat ' + N + ' Termine in Folge ohne Rückmeldung gefehlt.</p></div>' + cfg + '</div></section>';
    return '<section class="wm-card wg-warn"><div class="wg-wh"><span class="wg-wi">!</span><div class="wg-wt"><h3>' + w.length + (w.length === 1 ? ' Person' : ' Personen') + ' ohne Rückmeldung gefehlt</h3><p>Mindestens ' + N + ' Termine in Folge weder anwesend noch entschuldigt. Bitte in WebClub aus der Gruppe nehmen und hier mit „Erledigt“ ausblenden.</p></div>' + cfg + '</div>' +
      '<div class="pl-wrap"><table class="pl-t" style="min-width:520px"><tr><th>Name</th><th>Gruppen</th><th>Termine ohne Rückmeldung</th>' + (ed ? '<th></th>' : '') + '</tr>' +
      w.map(function (x) { return '<tr data-id="' + esc(x.m.id) + '"><td><b>' + esc(x.m.name) + '</b></td><td>' + x.groups.map(gTag).join('') + '</td><td><span class="wg-wn">' + x.n + '×</span> ' + x.dates.map(function (d) { return '<span class="wg-wd">' + esc(M.fmtDate(d, true)) + '</span>'; }).join('') + '</td>' + (ed ? '<td style="text-align:right"><button type="button" class="wg-btn" data-ma="wgack" data-id="' + esc(x.m.id) + '" data-d="' + esc(x.dates[x.dates.length - 1]) + '">Erledigt</button></td>' : '') + '</tr>'; }).join('') + '</table></div></section>';
  }
  function tmin(tm) { var m = /^(\d{1,2}):(\d{2})/.exec(tm || ''); return m ? Number(m[1]) * 60 + Number(m[2]) : null; }
  function hhmm(n) { n = Math.round(n); return ('0' + Math.floor(n / 60) % 24).slice(-2) + ':' + ('0' + n % 60).slice(-2); }
  // Ausgeblendete Termine (nur für mich, im Profil): einzelner Termin ('i:ID') oder wöchentlich ('w:Gruppen|Wochentag|Uhrzeit')
  function hidList() { var p = myProf(); return p && Array.isArray(p.wkHide) ? p.wkHide : []; }
  function hidKeys(x) { var dw = new Date(x.date + 'T12:00:00').getDay(); return { one: 'i:' + x.id, wk: 'w:' + gsOf(x).join('+') + '|' + dw + '|' + (x.time || '') }; }
  function isHid(x, l) { var k = hidKeys(x); return l.indexOf(k.one) >= 0 || l.indexOf(k.wk) >= 0; }
  function saveHid(l) {
    var p = myProf(); if (p) M.op({ op: 'patch', coll: 'profile', id: p.id, fields: { wkHide: l } });
    else if (M.userName()) M.op({ op: 'set', coll: 'profile', item: { id: pidOf(M.userName()), owner: M.userName(), wkHide: l } });
  }
  function hidLine(n, on) { return n ? '<p class="wm-sub" style="margin:8px 0 0">' + n + (n === 1 ? ' Termin' : ' Termine') + ' ausgeblendet · <button type="button" class="wg-lnk" data-ma="wgwh">' + (on ? 'wieder verbergen' : 'anzeigen') + '</button></p>' : ''; }
  function weekCard() {
    var t = M.today(), days = []; for (var i = 0; i < 7; i++) days.push(M.addDays(t, i));
    var hid = hidList(), showH = !!M.S.sub.wh, all7 = sessions().filter(function (x) { return x.date >= t && x.date <= days[6]; }), nHid = all7.filter(function (x) { return isHid(x, hid); }).length;
    var l = all7.filter(function (x) { return showH || !isHid(x, hid); });
    var DAYS = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'], PPM = 1.1;
    var out = '<section class="wm-card"><div class="wm-bar"><h3>📅 Nächste 7 Tage</h3></div>';
    if (!l.length) { var nx = sessions().filter(function (x) { return x.date > days[6] && !isHid(x, hid); }).sort(function (a, b) { return a.date < b.date ? -1 : 1; })[0]; return out + '<p class="wm-note" style="margin:0">Kein Training in den nächsten 7 Tagen.' + (nx ? ' Als Nächstes: ' + esc(fd(nx.date)) + (nx.time ? ' · ' + esc(nx.time) + ' Uhr' : '') + '.' : '') + '</p>' + hidLine(nHid, showH) + '</section>'; }
    var dd = defaultDauer(), ev = l.filter(function (x) { return tmin(x.time) !== null; }).map(function (x) { var st = tmin(x.time), du = Number(x.dauer) || dd; return { x: x, s: st, e: st + du }; });
    var allday = l.filter(function (x) { return tmin(x.time) === null; });
    var minH = 17, maxH = 20; if (ev.length) { minH = Math.floor(Math.min.apply(null, ev.map(function (v) { return v.s; })) / 60); maxH = Math.ceil(Math.max.apply(null, ev.map(function (v) { return v.e; })) / 60); if (maxH - minH < 4) maxH = minH + 4; }
    PPM = Math.max(0.62, Math.min(PPM, 400 / ((maxH - minH) * 60)));
    var H = Math.round((maxH - minH) * 60 * PPM);
