      line('Name, Vorname', m.name) + line('Geburtsdatum / Jahrgang', m.jg) + line('Anschrift', '') + line('Telefon', '') + line('E-Mail', '') + line('Eltern / Erziehungsberechtigte', '') + line('DSV-ID (falls vorhanden)', m.dsv) + line('Eintritt zum', m.eintritt ? M.fmtDate(m.eintritt) : '') + '</table>' +
