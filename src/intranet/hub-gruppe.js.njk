  }
  // „fehlt“ zählt mit: an einem vergangenen Termin mit Eintragungen gilt jeder aus der Gruppe ohne „anwesend/entschuldigt“ als fehlend
  function counts(t) {
    var c = { a: 0, e: 0, f: 0 }; var an = t.anw || {}; Object.keys(an).forEach(function (k) { if (c[an[k]] !== undefined && an[k] !== 'f') c[an[k]]++; });
    if (t.date <= M.today() && Object.keys(an).length) rosterFor(t).forEach(function (m) { if (an[m.id] !== 'a' && an[m.id] !== 'e') c.f++; });
    else Object.keys(an).forEach(function (k) { if (an[k] === 'f') c.f++; });
