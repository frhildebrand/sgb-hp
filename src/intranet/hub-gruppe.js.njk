    return '<div class="m-chips" style="margin:4px 0 8px">' + order.map(function (g) { return [g, g]; }).concat([['*', 'Alle Gruppen']]).map(function (p) { var on = set ? set[0] === p[0] : p[0] === '*'; return '<button type="button" class="m-chip' + (on ? ' on' : '') + '" data-ma="wggf" data-v="' + esc(p[0]) + '">' + esc(p[1]) + '</button>'; }).join('') + '</div>';
  }
  var firstSeenCache = { n: -1, map: {} };
  // Ohne Eintrittsdatum gilt: dabei ab dem ersten Termin, an dem jemand eine Anwesenheit für die Person eingetragen hat (neue Mitglieder zählen also nicht rückwirkend)
  function firstSeen() {
    var tage = M.items('trainingTage'); if (firstSeenCache.n === tage.length && firstSeenCache.k === M.S.loaded) return firstSeenCache.map;
    var map = {}; tage.forEach(function (d) { Object.keys(d.anw || {}).forEach(function (id) { if (!map[id] || d.date < map[id]) map[id] = d.date; }); });
    firstSeenCache = { n: tage.length, k: M.S.loaded, map: map }; return map;
  }
  function inGroup(m, date) { if (m.status === 'ausgetreten' && !m.austritt) return false; var e = m.eintritt || firstSeen()[m.id]; if (e && date < e) return false; if (m.austritt && date > m.austritt) return false; return true; }
  function sessions() { return M.items('trainingTage').slice().sort(function (a, b) { return (a.date + (a.time || '')) < (b.date + (b.time || '')) ? 1 : -1; }); }
  // Wer in dieser Gruppe Trainer ist, zählt dort nur als Trainer – außer er wurde bei diesem Termin als Schwimmer markiert (t.schw)
  // Das Mitschwimmen als Trainer gibt es nur in der Wettkampfgruppe und Gruppe 1
  function trainerSwimmers(t) { var ok = mayMix(t); return !ok ? [] : members(gsOf(t)).filter(function (m) { return isTrOf(m, gsOf(t)) && inGroup(m, t.date); }); }
  function rosterFor(t) {
