/* Wettkampfgruppe: Übersicht (mit Statistik und Jahresrückblick), Training (Trainingstage mit Anwesenheit) und Mitglieder. */
(function () {
  'use strict';
  var M = window.HubMod; if (!M) return;
  var P = window.WKParse; var esc = M.esc;
  var CODES = ['', 'a', 'e', 'f'];
  var CODE_TXT = { '': '·', a: '✓', e: 'E', f: '✗' };
  var CODE_LABEL = { '': 'offen', a: 'anwesend', e: 'entschuldigt', f: 'fehlt' };
  function lower(s) { return String(s || '').toLowerCase().trim(); }
  function fd(iso) { return iso ? M.fmtDate(iso) : ''; }
  function fs(iso) { return iso ? M.fmtDate(iso, true) : ''; }
  function ym(iso) { return String(iso || '').slice(0, 7); }
  function canTage() { return M.can('training.tage.edit'); }
  function members() { return M.items('wgMitglieder').sort(function (a, b) { return String(a.name || '').localeCompare(String(b.name || ''), 'de'); }); }
  var firstSeenCache = { n: -1, map: {} };
  // Ohne Eintrittsdatum gilt: dabei ab dem ersten Termin, an dem jemand eine Anwesenheit für die Person eingetragen hat (neue Mitglieder zählen also nicht rückwirkend)
  function firstSeen() {
    var tage = M.items('trainingTage'); if (firstSeenCache.n === tage.length && firstSeenCache.k === M.S.loaded) return firstSeenCache.map;
    var map = {}; tage.forEach(function (d) { Object.keys(d.anw || {}).forEach(function (id) { if (!map[id] || d.date < map[id]) map[id] = d.date; }); });
    firstSeenCache = { n: tage.length, k: M.S.loaded, map: map }; return map;
  }
  function inGroup(m, date) { if (m.status === 'ausgetreten' && !m.austritt) return false; var e = m.eintritt || firstSeen()[m.id]; if (e && date < e) return false; if (m.austritt && date > m.austritt) return false; return true; }
  function isActive(m) { return m.status !== 'ausgetreten' && m.status !== 'pausiert' && (!m.austritt || m.austritt >= M.today()); }
  function age(m) { return m.jg ? new Date().getFullYear() - Number(m.jg) : ''; }
  function sessions() { return M.items('trainingTage').sort(function (a, b) { return (a.date + (a.time || '')) < (b.date + (b.time || '')) ? 1 : -1; }); }
  function rosterFor(t) {
    var ms = members(); var seen = {};
    var r = ms.filter(function (m) { return inGroup(m, t.date) || (t.anw && t.anw[m.id]); });
    r.forEach(function (m) { seen[m.id] = 1; });
    return r;
  }
  function counts(t) { var c = { a: 0, e: 0, f: 0 }; var an = t.anw || {}; Object.keys(an).forEach(function (k) { if (c[an[k]] !== undefined) c[an[k]]++; }); return c; }
  function monthShift(m, n) { var p = m.split('-'); var d = new Date(+p[0], +p[1] - 1 + n, 1); return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2); }
  function curMonth() { var s = M.S.sub; if (!s.gm) s.gm = ym(M.today()); return s.gm; }

  /* ---------- Übersicht ---------- */
  function uebersicht() {
    var ms = members(); var act = ms.filter(isActive);
    var tage = sessions(); var t = M.today();
    var last8 = tage.filter(function (x) { return x.date <= t; }).slice(0, 8);
    var a = 0, tot = 0; last8.forEach(function (x) { var c = counts(x); a += c.a; tot += c.a + c.e + c.f; });
    var pct = tot ? Math.round(a * 100 / tot) + ' %' : '–';
    var nextT = tage.filter(function (x) { return x.date >= t; }).slice(-1)[0];
    var wks = M.items('wettkaempfe').filter(function (w) { return (w.date || '') >= t; }).sort(function (a, b) { return a.date < b.date ? -1 : 1; });
    var out = '<div class="m-stats">' + M.stat(act.length, 'Mitglieder', '', 'data-ma="wgtab" data-v="mitglieder"') + M.stat(tage.length, 'Trainingstage', '', 'data-ma="wgtab" data-v="tage"') + M.stat(pct, 'Anwesenheit (letzte 8)', pct === '–' ? '' : 'ok') + M.stat(wks.length ? M.daysTo(wks[0].date) : '–', wks.length ? 'Tage bis ' + wks[0].title.slice(0, 22) : 'Kein Wettkampf geplant', wks.length && M.daysTo(wks[0].date) <= 7 ? 'warn' : 'info', 'data-ma="wgtab" data-v="wk"') + '</div>';
    out += '<section class="wm-card"><div class="m-sec" style="margin-top:0">Zuletzt</div>';
    if (!tage.length) out += '<p class="wm-note">Noch keine Trainingstage. Lege einen an oder importiere die Anwesenheitsliste aus WebClub.</p>';
    tage.filter(function (x) { return x.date <= t; }).slice(0, 4).forEach(function (x) { var c = counts(x); out += '<div class="m-chk"><b>' + fd(x.date) + '</b><span class="wm-sub" style="flex:1"> ' + esc(x.time || '') + (x.fokus ? ' · ' + esc(x.fokus) : '') + '</span><span class="wm-sub">✓ ' + c.a + ' · E ' + c.e + ' · ✗ ' + c.f + '</span></div>'; });
    if (nextT && nextT.date > t) out += '<div class="m-sec">Als Nächstes</div><div class="m-chk"><b>' + fd(nextT.date) + '</b><span class="wm-sub"> ' + esc(nextT.time || '') + '</span></div>';
    out += '</section>';
    if (M.anyCan(['training.tage.view'])) out += statistikTab();
    if (M.can('training.rueckblick')) out += rueckblickCard();
    return out;
  }

  /* ---------- Mitglieder ---------- */
  var MFIELDS = [
    { k: 'name', t: 'text', label: 'Name', req: true, ph: 'Vorname Nachname' },
    { k: 'jg', t: 'num', label: 'Jahrgang' },
    { k: 'sex', t: 'sel', label: 'Geschlecht', opts: [['', '–'], ['w', 'weiblich'], ['m', 'männlich'], ['d', 'divers']] },
    { k: 'dsv', t: 'text', label: 'DSV-ID' },
    { k: 'notiz', t: 'area', label: 'Notiz', rows: 3 }
  ];
  var memberTab = {
    id: 'mitglieder', label: 'Mitglieder', coll: 'wgMitglieder', view: ['training.mitglieder.view'], edit: ['training.mitglieder.edit'], add: ['training.mitglieder.edit', 'training.mitglieder.anlegen'], del: ['training.mitglieder.edit', 'training.mitglieder.loeschen'], print: ['training.print'], addLabel: 'Neues Mitglied', search: ['name', 'kontakt'], fields: MFIELDS,
    hint: 'Wer trainiert in der Wettkampfgruppe? Am einfachsten über „Gruppenliste (PDF)“ aus WebClub einlesen.',
    newItem: function () { return {}; },
    summary: function (all) { return '<p class="wm-note"><b>' + all.length + '</b> ' + (all.length === 1 ? 'Mitglied' : 'Mitglieder') + '</p><p class="m-actions"><button type="button" class="wm-btn" data-ma="wgglist">📄 Gruppenliste (PDF)</button></p>'; },
    card: function (m) {
      return { title: m.name,
        sub: [m.jg ? 'Jg. ' + m.jg + ' (' + age(m) + ')' : '', m.sex === 'w' ? 'weiblich' : m.sex === 'm' ? 'männlich' : m.sex === 'd' ? 'divers' : ''].filter(Boolean).join(' · '),
        body: [m.dsv && m.dsv !== '0' ? '<div><b>DSV-ID:</b> ' + esc(m.dsv) + '</div>' : '', m.notiz ? '<div><b>Notiz:</b><pre>' + esc(m.notiz) + '</pre></div>' : ''].join('') };
    },
    printAll: function (all) {
      return { title: 'Mitglieder Wettkampfgruppe', body: '<h1>Wettkampfgruppe: Mitglieder</h1><div class="sub">Stand ' + M.fmtDate(M.today()) + '</div><table><tr><th>Name</th><th>Jg.</th><th></th><th>DSV-ID</th></tr>' + all.map(function (m) { return '<tr><td>' + esc(m.name) + '</td><td>' + esc(m.jg || '') + '</td><td>' + esc(m.sex || '') + '</td><td>' + esc(m.dsv && m.dsv !== '0' ? m.dsv : '') + '</td></tr>'; }).join('') + '</table>' };
    }
  };

  /* ---------- Trainingstage ---------- */
  function fahrerOpts() {
    var o = []; var add = function (n) { n = String(n || '').replace(/^Trainer\s+/i, '').trim(); if (n && o.indexOf(n) < 0) o.push(n); };
    ((M.find('saetze', 'main') || {}).fahrer || []).forEach(add);
    (M.D.trainingTage || []).forEach(function (t) { (t.fahrer || []).forEach(add); (t.trainer || []).forEach(add); });
    (M.D.people || []).forEach(add);
    return o;
  }
  var TFIELDS = [
    { k: 'date', t: 'date', label: 'Datum', req: true },
    { k: 'time', t: 'time', label: 'Uhrzeit' },
    { k: 'dauer', t: 'num', label: 'Dauer (Min.)' },
    { k: 'trainer', t: 'tags', label: 'Trainer' },
    { k: 'fahrer', t: 'pick', label: 'Fahrer (Wettkampftraining)', extra: 'Weitere Fahrer (z. B. Eltern), mit Komma trennen', opts: fahrerOpts, hint: 'Wer gefahren ist. Die Fahrt landet bei „Trainingstage einfügen“ in der Abrechnung des Fahrers.' },
    { k: 'ort', t: 'text', label: 'Ort' },
    { k: 'fokus', t: 'text', label: 'Schwerpunkt', ph: 'z. B. Wenden, Ausdauer' },
    { k: 'inhalt', t: 'area', label: 'Einheit / Inhalt', rows: 5 },
    { k: 'notiz', t: 'area', label: 'Notiz', rows: 3 },
    { k: 'beob', t: 'area', label: 'Beobachtungen', rows: 3 }
  ];
  function tageTab() {
    var ymv = curMonth(); var all = sessions();
    var list = all.filter(function (x) { return ym(x.date) === ymv; });
    var can = canTage();
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Training</h3><span class="m-actions">' +
      '<button type="button" class="wm-btn" data-ma="wgprintm">🖨️ Anwesenheitsliste</button>' + (M.anyCan(['training.tage.edit', 'training.tage.anlegen']) ? '<button type="button" class="wm-btn" data-ma="wgimport">📄 Import (PDF)</button><button type="button" class="wm-amber" data-ma="wgtnew">+ Trainingstag</button>' : '') + '</span></div>' +
      '<div class="m-chips" style="align-items:center"><button type="button" class="m-chip" data-ma="wgmon" data-d="-1">‹</button><b>' + esc(M.monthLabel(ymv)) + '</b><button type="button" class="m-chip" data-ma="wgmon" data-d="1">›</button><span class="wm-sub">' + list.length + ' Termine</span></div>';
    if (!list.length) out += '<p class="wm-note">In diesem Monat gibt es keinen Trainingstag.</p>';
    list.forEach(function (t) {
      var c = counts(t); var open = !!M.S.open[t.id]; var tr = (t.trainer || []);
      out += '<article class="m-card" data-id="' + esc(t.id) + '"><div class="m-head" data-ma="toggle"><div class="m-main"><div class="m-title">' + esc(fd(t.date)) + (t.time ? ' · ' + esc(t.time) + ' Uhr' : '') + '</div><div class="wm-sub">' + [t.fokus ? esc(t.fokus) : '', tr.length ? 'Trainer: ' + esc(tr.join(', ')) : '', 'Anwesend ' + c.a + (c.e ? ' · entsch. ' + c.e : '') + (c.f ? ' · fehlt ' + c.f : '')].filter(Boolean).join(' · ') + '</div></div><span class="m-chev">' + (open ? '▾' : '▸') + '</span></div>';
      if (open) {
        var ro = rosterFor(t);
        out += '<div class="m-body">' + (t.inhalt ? '<div><b>Einheit:</b><pre>' + esc(t.inhalt) + '</pre></div>' : '') + (t.beob ? '<div><b>Beobachtungen:</b><pre>' + esc(t.beob) + '</pre></div>' : '') + (t.notiz ? '<div><b>Notiz:</b><pre>' + esc(t.notiz) + '</pre></div>' : '') +
          '<div class="m-sec">Anwesenheit' + (can ? ' – zum Ändern antippen' : '') + '</div><div class="wg-grid">' + (ro.length ? ro.map(function (m) { var cd = (t.anw || {})[m.id] || (t.date < M.today() || t.date === M.today() ? 'f' : ''); return '<button type="button" class="wg-p c-' + (cd || 'o') + '" data-ma="wgtap" data-m="' + esc(m.id) + '"' + (can ? '' : ' disabled') + '><i>' + CODE_TXT[cd] + '</i><span>' + esc(m.name) + '</span></button>'; }).join('') : '<p class="wm-note">Noch keine Mitglieder angelegt.</p>') + '</div>' +
          '<p class="wm-sub">✓ anwesend · E entschuldigt · ✗ fehlt · · offen</p>' +
          '<div class="m-btns">' + (can ? '<button type="button" class="wm-btn" data-ma="wgall">Alle anwesend</button><button type="button" class="wm-btn" data-ma="wgtedit">✏️ Bearbeiten</button>' : '') + (M.anyCan(['training.tage.edit', 'training.tage.loeschen']) ? '<button type="button" class="wm-btn m-danger" data-ma="wgtdel">🗑️ Löschen</button>' : '') + '<button type="button" class="wm-btn" data-ma="wgprintd">🖨️ Liste</button></div></div>';
      }
      out += '</article>';
    });
    return out + '</section>';
  }
  function printSheet(days, title) {
    var ms = members().filter(function (m) { return days.some(function (d) { return inGroup(m, d.date) || (d.anw && d.anw[m.id]); }); });
    var head = '<tr><th>Name</th>' + days.map(function (d) { return '<th class="nowrap">' + esc(M.fmtDate(d.date, true)) + '<br>' + esc(d.time || '') + '</th>'; }).join('') + '</tr>';
    var trainers = {}; days.forEach(function (d) { (d.trainer || []).forEach(function (n) { trainers[n] = 1; }); });
    var body = ms.map(function (m) { return '<tr><td>' + esc(m.name) + '</td>' + days.map(function (d) { var cd = (d.anw || {})[m.id]; return '<td style="text-align:center;min-width:34px">' + (cd ? CODE_TXT[cd] : '') + '</td>'; }).join('') + '</tr>'; }).join('');
    var tr = '<tr><td><i>Trainer</i></td>' + days.map(function (d) { return '<td style="font-size:10px">' + esc((d.trainer || []).join(', ')) + '</td>'; }).join('') + '</tr>';
    M.print(title, '<h1>' + esc(title) + '</h1><div class="sub">✓ anwesend · E entschuldigt · ✗ fehlt</div><table>' + head + tr + body + '</table>');
  }

  /* ---------- Statistik ---------- */
  function statistikTab() {
    var per = M.S.sub.sp || 'y'; var t = M.today();
    var from = per === '3m' ? M.addDays(t, -92) : per === 'y' ? t.slice(0, 4) + '-01-01' : '0000-00-00';
    var days = sessions().filter(function (d) { return d.date >= from && d.date <= t; });
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Anwesenheit</h3>' + M.seg([['3m', '3 Monate'], ['y', 'Dieses Jahr'], ['all', 'Alles']], per, 'wgper') + '</div><p class="wm-note">' + days.length + ' Trainingstage im Zeitraum. Prozent = anwesend im Verhältnis zu allen Terminen seit Eintritt.</p>';
    var rows = members().map(function (m) {
      var a = 0, e = 0, f = 0, n = 0;
      days.forEach(function (d) { if (!inGroup(m, d.date)) return; n++; var c = (d.anw || {})[m.id]; if (c === 'a') a++; else if (c === 'e') e++; else if (c === 'f') f++; });
      return { m: m, a: a, e: e, f: f, n: n, p: n ? Math.round(a * 100 / n) : null };
    }).filter(function (r) { return r.n > 0; }).sort(function (x, y) { return (y.p || 0) - (x.p || 0); });
    if (!rows.length) return out + '<p class="wm-note">Noch keine Daten.</p></section>';
    out += '<table class="m-table"><tr><th>Name</th><th>✓</th><th>E</th><th>✗</th><th>Termine</th><th style="width:34%">Anteil</th></tr>' + rows.map(function (r) { return '<tr><td>' + esc(r.m.name) + '</td><td>' + r.a + '</td><td>' + r.e + '</td><td>' + r.f + '</td><td>' + r.n + '</td><td>' + M.prog(r.a, r.n, false) + ' <b>' + r.p + ' %</b></td></tr>'; }).join('') + '</table></section>';
    return out;
  }

  /* ---------- Jahresrückblick ---------- */
  function bestzeiten(w) {
    var n = 0; (w.starts || []).forEach(function (s) { var r = (w.res || {})[s.e + '-' + s.l + '-' + s.b]; if (!r || !r.t || !s.m || !P) return; var a = P.timeMs(r.t), m = P.timeMs(s.m); if (a !== null && m !== null && a < m) n++; });
    return n;
  }
  function rueckblickData(year) {
    var y = String(year); var d = {};
    var days = M.items('trainingTage').filter(function (x) { return String(x.date).slice(0, 4) === y; });
    var a = 0, tot = 0; days.forEach(function (x) { var c = counts(x); a += c.a; tot += c.a + c.e + c.f; });
    d.tage = days.length; d.pct = tot ? Math.round(a * 100 / tot) : null;
    var ms = members(); d.zug = ms.filter(function (m) { return String(m.eintritt || '').slice(0, 4) === y; }); d.abg = ms.filter(function (m) { return String(m.austritt || '').slice(0, 4) === y; }); d.aktiv = ms.filter(isActive).length;
    d.wks = M.items('wettkaempfe').filter(function (w) { return String(w.date || '').slice(0, 4) === y; }).sort(function (a, b) { return a.date < b.date ? -1 : 1; });
    d.starts = 0; d.best = 0; d.sw = {}; d.wks.forEach(function (w) { d.starts += (w.starts || []).length; d.best += bestzeiten(w); (w.starts || []).forEach(function (s) { d.sw[s.n] = 1; }); });
    d.abz = M.items('abzeichen').filter(function (x) { return String(x.date || '').slice(0, 4) === y; });
    var top = ms.map(function (m) { var n = 0, p = 0; days.forEach(function (x) { if (!inGroup(m, x.date)) return; n++; if ((x.anw || {})[m.id] === 'a') p++; }); return { n: m.name, p: p, t: n }; }).filter(function (r) { return r.t >= 5; }).sort(function (x, y2) { return y2.p / y2.t - x.p / x.t; }).slice(0, 5);
    d.top = top;
    return d;
  }
  function rueckblickCard() {
    var y = M.S.sub.ry || String(new Date().getFullYear()); var d = rueckblickData(y);
    var years = []; for (var i = 0; i < 4; i++) years.push([String(new Date().getFullYear() - i), String(new Date().getFullYear() - i)]);
    return '<section class="wm-card"><div class="wm-bar"><h3>Jahresrückblick ' + esc(y) + '</h3><span class="m-actions">' + M.seg(years, y, 'wgyear') + '<button type="button" class="wm-btn" data-ma="wgprintr">🖨️ Drucken</button></span></div>' +
      '<div class="m-stats">' + M.stat(d.tage, 'Trainingstage') + M.stat(d.pct === null ? '–' : d.pct + ' %', 'Ø Anwesenheit', 'ok') + M.stat(d.wks.length, 'Wettkämpfe') + M.stat(d.best, 'Bestzeiten', 'info') + '</div>' +
      '<p class="wm-sub">' + Object.keys(d.sw).length + ' Schwimmer waren bei Wettkämpfen am Start (' + d.starts + ' Starts)' + (d.abz.length ? ' · ' + d.abz.length + ' Abzeichen' : '') + '.</p></section>';
  }
  function printRueck() {
    var y = M.S.sub.ry || String(new Date().getFullYear()); var d = rueckblickData(y);
    M.print('Jahresrückblick ' + y, '<h1>Wettkampfgruppe: Jahresrückblick ' + esc(y) + '</h1><div class="sub">SG Barnstorf · Schwimmen</div><table><tr><th>Trainingstage</th><td>' + d.tage + '</td></tr><tr><th>Ø Anwesenheit</th><td>' + (d.pct === null ? '–' : d.pct + ' %') + '</td></tr><tr><th>Aktive Mitglieder</th><td>' + d.aktiv + '</td></tr><tr><th>Wettkämpfe</th><td>' + d.wks.length + '</td></tr><tr><th>Starts / Schwimmer</th><td>' + d.starts + ' / ' + Object.keys(d.sw).length + '</td></tr><tr><th>Bestzeiten</th><td>' + d.best + '</td></tr><tr><th>Abzeichen</th><td>' + d.abz.length + '</td></tr></table>' +
      (d.wks.length ? '<h2>Wettkämpfe</h2><table><tr><th>Datum</th><th>Wettkampf</th><th>Ort</th><th>Starts</th></tr>' + d.wks.map(function (w) { return '<tr><td>' + fs(w.date) + '</td><td>' + esc(w.title) + '</td><td>' + esc(w.ort || '') + '</td><td>' + (w.starts || []).length + '</td></tr>'; }).join('') + '</table>' : ''));
  }

  /* ---------- Import Anwesenheitsliste (PDF aus WebClub) ---------- */
  // Eine Datei füllt Trainingstage, Anwesenheit UND die Trainerstunden: Trainer (mit „Trainer“ vor dem Namen) werden den Tagen zugeordnet,
  // aus denen die Abrechnung später die Stunden holt. Trainer sind keine Mitglieder; wer als Trainer in der Liste steht, wird aus der Mitgliederliste entfernt.
  var imp = null;
  function matchMember(name, ms) {
    var n = lower(name); var rev = n.indexOf(',') > 0 ? lower(n.split(',').slice(1).join(' ') + ' ' + n.split(',')[0]) : n;
    return ms.filter(function (m) { var mn = lower(m.name); return mn === n || mn === rev; })[0] || null;
  }
  function defaultDauer() { var s = M.find('saetze', 'main'); return s && s.dauer ? M.num(s.dauer) : 60; }
  function importDialog() {
    M.openDlg('<div class="hub-dhead"><h3>Anwesenheitsliste importieren</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div><p class="wm-note">PDF „Anwesenheitsliste“ aus WebClub. Trainer und Schwimmer werden getrennt erkannt. Die Trainer bekommen die Stunden automatisch in ihre Abrechnung. Vorhandene Trainingstage werden ergänzt.</p><div class="m-fgrid"><label class="m-f wide"><span>PDF-Datei</span><input type="file" id="wgfile" accept="application/pdf,.pdf"></label><label class="m-f"><span>Dauer eines Trainings (Minuten)</span><input type="number" id="wgdauer" inputmode="numeric" value="' + defaultDauer() + '"></label></div><p class="wm-sub">In der Liste steht nur die Startzeit. Mit der Dauer werden Ende und Stundenzahl berechnet.</p><p id="wgmsg" class="wm-note"></p><div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="wgread">Einlesen</button></div>');
  }
  function doRead() {
    var f = document.getElementById('wgfile').files[0]; var msg = document.getElementById('wgmsg');
    var dm = M.num(document.getElementById('wgdauer').value) || 60;
    if (!f) { msg.textContent = 'Bitte zuerst eine PDF-Datei auswählen.'; return; }
    msg.textContent = 'Wird gelesen … (beim ersten Mal wird der PDF-Leser geladen)';
    HubPdf.read(f).then(function (r) { imp = P.parseAnwesenheit(r.pages); imp.file = f.name; imp.dauer = dm; preview(); }, function (e) { msg.innerHTML = '<span class="m-over">' + esc(e.message || String(e)) + '</span>'; });
  }
  function preview() {
    var p = imp; var ms = members();
    var trainers = p.people.filter(function (x) { return x.trainer; }); var tn = trainers.map(function (x) { return lower(x.name); });
    var sw = p.people.filter(function (x) { return !x.trainer && tn.indexOf(lower(x.name)) < 0; });
    imp.sw = sw; imp.trainers = trainers;
    var unknown = sw.filter(function (x) { return !matchMember(x.name, ms); });
    imp.unknown = unknown;
    var drop = ms.filter(function (m) { return tn.indexOf(lower(m.name)) >= 0; }); imp.drop = drop;
    var hours = {}; trainers.forEach(function (x) { hours[x.name] = p.sessions.filter(function (s, i) { return x.st[i] === 'a'; }).length; });
    M.openDlg('<div class="hub-dhead"><h3>Das wurde gefunden</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div>' + (p.warnings.length ? '<div class="hub-err">' + p.warnings.map(esc).join('<br>') + '</div>' : '') +
      '<p class="wm-note"><b>' + p.sessions.length + '</b> ' + (p.sessions.length === 1 ? 'Termin' : 'Termine') + ' (' + fs(p.sessions[0] && p.sessions[0].date) + ' – ' + fs(p.sessions.length && p.sessions[p.sessions.length - 1].date) + ') · <b>' + sw.length + '</b> Schwimmer</p>' +
      '<p class="wm-note">Trainer: ' + (trainers.length ? trainers.map(function (x) { return '<b>' + esc(x.name) + '</b> (' + hours[x.name] + (hours[x.name] === 1 ? ' Termin' : ' Termine') + ' anwesend, je ' + imp.dauer + ' Min.)'; }).join(', ') : '<b>keiner erkannt</b>') + '</p>' +
      (drop.length ? '<p class="wm-note">Aus der Mitgliederliste entfernt (sind Trainer): <b>' + drop.map(function (m) { return esc(m.name); }).join(', ') + '</b></p>' : '') +
      (unknown.length ? '<div class="m-sec">Noch nicht in der Mitgliederliste</div><div style="max-height:26vh;overflow:auto">' + unknown.map(function (x, i) { return '<label class="m-f m-fchk" style="padding:4px 0"><input type="checkbox" data-wgnew="' + i + '" checked><span>' + esc(x.name) + ' anlegen</span></label>'; }).join('') + '</div>' : '<p class="wm-note">Alle Schwimmer sind bereits Mitglieder.</p>') +
      '<div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="wgsave"' + (p.sessions.length ? '' : ' disabled') + '>Übernehmen</button></div>');
  }
  function doImport() {
    var p = imp; var list = []; var ms = members(); var byName = {};
    ms.forEach(function (m) { byName[lower(m.name)] = m; });
    (p.drop || []).forEach(function (m) { list.push({ op: 'del', coll: 'wgMitglieder', id: m.id }); });
    (p.unknown || []).forEach(function (x, i) {
      var cb = document.querySelector('[data-wgnew="' + i + '"]'); if (cb && !cb.checked) return;
      var m = { id: M.uid(), name: x.name };
      list.push({ op: 'set', coll: 'wgMitglieder', item: m }); byName[lower(x.name)] = m;
    });
    var existing = {}; M.items('trainingTage').forEach(function (t) { existing[t.date + '|' + (t.time || '')] = t; });
    p.sessions.forEach(function (s, i) {
      var anw = {};
      (p.sw || []).forEach(function (x) { var m = matchMember(x.name, ms) || byName[lower(x.name)]; var c = x.st[i]; if (m && c) anw[m.id] = c; });
      var tr = (p.trainers || []).filter(function (x) { return x.st[i] === 'a'; }).map(function (x) { return x.name; });
      var ex = existing[s.date + '|' + (s.time || '')];
      if (ex) { var fields = { anw: anw }; if (tr.length) fields.trainer = tr; if (!ex.dauer) fields.dauer = p.dauer; list.push({ op: 'patch', coll: 'trainingTage', id: ex.id, merge: true, fields: fields }); }
      else list.push({ op: 'set', coll: 'trainingTage', item: { id: 'tt-' + s.date.replace(/-/g, '') + '-' + String(s.time || '0000').replace(':', ''), date: s.date, time: s.time || '', dauer: p.dauer, trainer: tr, anw: anw, ort: '' } });
    });
    M.closeDlg(); M.ops(list); M.toast(p.sessions.length + (p.sessions.length === 1 ? ' Termin' : ' Termine') + ' übernommen. Die Trainerstunden stehen jetzt in der Abrechnung bereit.');
    if (p.sessions[0]) M.S.sub.gm = ym(p.sessions[0].date);
  }

  /* ---------- Import Gruppenliste (PDF aus WebClub): Mitglieder ---------- */
  // Zwei Listen möglich: „Schwimmer in der Gruppe“ (Name, Jg., DSV-ID, Aktiv) und „Trainer in der Gruppe“ (Name, Jg., Aktiv).
  function parseGruppenliste(lines) {
    var out = { kind: '', rows: [] };
    lines.forEach(function (ln) {
      var s = String(ln).replace(/\s+/g, ' ').trim();
      if (/^Trainer in der Gruppe/i.test(s)) { out.kind = 'trainer'; return; }
      if (/^Schwimmer in der Gruppe/i.test(s)) { out.kind = 'schwimmer'; return; }
      var m = /^(.+?) (\d{4}) (\d+) (Ja|Nein)$/.exec(s);
      if (m) { out.rows.push({ name: m[1].trim(), jg: m[2], dsv: m[3], aktiv: m[4] === 'Ja' }); return; }
      m = /^(.+?) (\d{4}) (Ja|Nein)$/.exec(s);
      if (m) out.rows.push({ name: m[1].trim(), jg: m[2], dsv: '', aktiv: m[3] === 'Ja' });
    });
    if (!out.kind) out.kind = out.rows.some(function (r) { return r.dsv; }) ? 'schwimmer' : 'trainer';
    return out;
  }
  var gl = null;
  function glistDialog() {
    M.openDlg('<div class="hub-dhead"><h3>Gruppenliste importieren</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div><p class="wm-note">PDF „Gruppenliste“ aus WebClub (Schwimmer, und wenn du willst auch die Liste der Trainer). Du kannst beide Dateien zusammen auswählen. Trainer werden nicht als Mitglieder angelegt. Übernommen werden nur Name, Jahrgang und DSV-ID.</p><div class="m-fgrid"><label class="m-f wide"><span>PDF-Datei(en)</span><input type="file" id="glfile" accept="application/pdf,.pdf" multiple></label></div><p id="glmsg" class="wm-note"></p><div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="wgglread">Einlesen</button></div>');
  }
  function glistRead() {
    var fl = document.getElementById('glfile').files; var msg = document.getElementById('glmsg');
    if (!fl.length) { msg.textContent = 'Bitte zuerst eine oder zwei PDF-Dateien auswählen.'; return; }
    msg.textContent = 'Wird gelesen … (beim ersten Mal wird der PDF-Leser geladen)';
    Promise.all(Array.prototype.map.call(fl, function (f) { return HubPdf.read(f).then(function (r) { return parseGruppenliste(r.lines); }); })).then(function (res) {
      var sw = [], tr = []; res.forEach(function (g) { (g.kind === 'trainer' ? tr : sw).push.apply(g.kind === 'trainer' ? tr : sw, g.rows); });
      var tn = tr.map(function (x) { return lower(x.name); });
      var ms = members(); var rows = sw.filter(function (x) { return x.aktiv && tn.indexOf(lower(x.name)) < 0; });
      var drop = ms.filter(function (m) { return tn.indexOf(lower(m.name)) >= 0; });
      gl = { rows: rows, drop: drop, tr: tr, skipped: sw.filter(function (x) { return !x.aktiv; }).length, same: sw.filter(function (x) { return x.aktiv && tn.indexOf(lower(x.name)) >= 0; }).map(function (x) { return x.name; }) };
      var neu = rows.filter(function (x) { return !matchMember(x.name, ms); }); var upd = rows.length - neu.length;
      if (!rows.length && !drop.length) { msg.innerHTML = '<span class="m-over">Keine Schwimmer in der Datei gefunden. Ist das die „Gruppenliste“ aus WebClub?</span>'; return; }
      M.openDlg('<div class="hub-dhead"><h3>Das wurde gefunden</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div><p class="wm-note"><b>' + neu.length + '</b> neue Mitglieder, <b>' + upd + '</b> schon vorhanden (Jahrgang und DSV-ID werden aktualisiert)' + (gl.skipped ? ', ' + gl.skipped + ' inaktive übersprungen' : '') + '.</p>' +
        (tr.length ? '<p class="wm-note">Trainer in der Liste: <b>' + tr.map(function (x) { return esc(x.name); }).join(', ') + '</b>' + (gl.same.length ? ' (werden nicht als Schwimmer angelegt)' : '') + '</p>' : (sw.length ? '<p class="wm-sub">Tipp: Wähle auch die Trainerliste mit aus, dann werden Trainer nicht als Schwimmer angelegt.</p>' : '')) +
        (drop.length ? '<p class="wm-note">Aus der Mitgliederliste entfernt (Trainer): <b>' + drop.map(function (m) { return esc(m.name); }).join(', ') + '</b></p>' : '') +
        (neu.length ? '<div style="max-height:26vh;overflow:auto">' + neu.map(function (x) { return '<div class="m-chk"><span style="flex:1">' + esc(x.name) + '</span><span class="wm-sub">Jg. ' + esc(x.jg) + '</span></div>'; }).join('') + '</div>' : '') +
        '<div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="wgglsave">Übernehmen</button></div>');
    }, function (e) { msg.innerHTML = '<span class="m-over">' + esc(e.message || String(e)) + '</span>'; });
  }
  function glistSave() {
    var ms = members(); var list = [];
    gl.drop.forEach(function (m) { list.push({ op: 'del', coll: 'wgMitglieder', id: m.id }); });
    gl.rows.forEach(function (x) {
      var m = matchMember(x.name, ms); var dsv = x.dsv && x.dsv !== '0' ? x.dsv : '';
      if (m) { var f = {}; if (x.jg && String(m.jg) !== x.jg) f.jg = Number(x.jg); if (dsv && m.dsv !== dsv) f.dsv = dsv; if (Object.keys(f).length) list.push({ op: 'patch', coll: 'wgMitglieder', id: m.id, fields: f }); }
      else list.push({ op: 'set', coll: 'wgMitglieder', item: { id: M.uid(), name: x.name, jg: Number(x.jg), dsv: dsv } });
    });
    M.closeDlg(); M.ops(list); M.toast('Mitglieder übernommen.');
  }

  /* ---------- Modul ---------- */
  function mk(id, label, view, render, extra) { return Object.assign({ id: id, label: label, view: view, render: render }, extra || {}); }
  M.register('training', {
    title: 'Wettkampfgruppe', icon: '🦈', colls: ['wgMitglieder', 'trainingTage', 'saetze', 'wettkaempfe', 'abzeichen'],
    tabs: [
      mk('uebersicht', 'Übersicht', ['training.view', 'training.tage.view', 'training.mitglieder.view'], function () { return uebersicht(); }),
      mk('tage', 'Training', ['training.tage.view'], function () { return tageTab(); }, { coll: 'trainingTage' }),
      memberTab
    ],
    actions: {
      wgtab: function (it, el) { M.S.tab = el.getAttribute('data-v'); M.lsSet('modtab_training', M.S.tab); M.render(true); },
      wgmon: function (it, el) { M.S.sub.gm = monthShift(curMonth(), +el.getAttribute('data-d')); M.render(true); },
      wgtnew: function () { M.openForm({ title: 'Neuer Trainingstag', fields: TFIELDS, item: { date: M.today(), dauer: 60, trainer: M.userName() ? [M.userName()] : [] }, onSave: function (v) { var t = Object.assign({ id: M.uid(), anw: {} }, v); M.S.sub.gm = ym(v.date); M.S.open[t.id] = true; M.op({ op: 'set', coll: 'trainingTage', item: t }); } }); },
      wgtedit: function (it, el, ev, c) { var t = M.find('trainingTage', c.id); if (!t) return; M.openForm({ title: 'Trainingstag bearbeiten', fields: TFIELDS, item: t, onSave: function (v) { M.op({ op: 'patch', coll: 'trainingTage', id: t.id, fields: v }); } }); },
      wgtdel: function (it, el, ev, c) { var t = M.find('trainingTage', c.id); if (!t) return; M.confirm('Trainingstag vom ' + fd(t.date) + ' samt Anwesenheit löschen?', 'Löschen', function () { M.op({ op: 'del', coll: 'trainingTage', id: t.id }); }); },
      wgtap: function (it, el, ev, c) {
        if (!canTage()) return; var t = M.find('trainingTage', c.id); if (!t) return; var mid = el.getAttribute('data-m');
        var past = t.date <= M.today(); var cyc = past ? ['f', 'a', 'e'] : CODES; var cur = (t.anw || {})[mid] || (past ? 'f' : ''); var nx = cyc[(cyc.indexOf(cur) + 1) % cyc.length]; var f = {}; f[mid] = (nx === 'f' && past) ? null : (nx || null);
        M.op({ op: 'patch', coll: 'trainingTage', id: t.id, merge: true, fields: { anw: f } });
      },
      wgall: function (it, el, ev, c) { var t = M.find('trainingTage', c.id); if (!t || !canTage()) return; var f = {}; rosterFor(t).forEach(function (m) { if (!(t.anw || {})[m.id]) f[m.id] = 'a'; }); M.op({ op: 'patch', coll: 'trainingTage', id: t.id, merge: true, fields: { anw: f } }); },
      wgprintd: function (it, el, ev, c) { var t = M.find('trainingTage', c.id); if (t) printSheet([t], 'Anwesenheit ' + M.fmtDate(t.date)); },
      wgprintm: function () { var days = sessions().filter(function (x) { return ym(x.date) === curMonth(); }).reverse(); if (!days.length) { M.toast('In diesem Monat gibt es keinen Trainingstag.'); return; } printSheet(days, 'Anwesenheit ' + M.monthLabel(curMonth())); },
      wgimport: function () { importDialog(); },
      wgread: function () { doRead(); },
      wgsave: function () { doImport(); },
      wgglist: function () { glistDialog(); },
      wgglread: function () { glistRead(); },
      wgglsave: function () { glistSave(); },
      wgper: function (it, el) { M.S.sub.sp = el.getAttribute('data-v'); M.render(true); },
      wgyear: function (it, el) { M.S.sub.ry = el.getAttribute('data-v'); M.render(true); },
      wgprintr: function () { printRueck(); }
    }
  });
  var st = document.createElement('style'); st.textContent = '#hubRoot .wg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin:8px 0}#hubRoot .wg-p{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:12px;border:1px solid var(--line);background:#fff;color:inherit;font:700 14px -apple-system,system-ui,sans-serif;text-align:left;cursor:pointer;min-height:44px}#hubRoot .wg-p i{flex:0 0 auto;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-style:normal;font-weight:900;background:rgba(148,163,184,.25);color:var(--soft)}#hubRoot .wg-p span{overflow-wrap:anywhere;line-height:1.15}#hubRoot .wg-p.c-a i{background:var(--ok);color:#fff}#hubRoot .wg-p.c-e i{background:var(--warn);color:#fff}#hubRoot .wg-p.c-f i{background:var(--bad);color:#fff}#hubRoot .wg-p[disabled]{cursor:default}.dark #hubRoot .wg-p{background:#131d30;border-color:#1f2a3d}';
  document.head.appendChild(st);
})();
