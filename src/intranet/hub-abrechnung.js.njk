      '<table><tr><th>Datum</th><th>Zeit</th><th>Anz. Std.</th><th>Gruppe</th><th>Ort</th></tr>' + rows + '<tr><td colspan="2"><b>Summe Stunden</b></td><td style="text-align:right"><b>' + String(c.std).replace('.', ',') + '</b></td><td colspan="2">á ' + euro(a.satz) + ' = <b>' + euro(c.hours) + '</b></td></tr></table>' +
      '<table><tr><td>Fahrtkosten: ' + esc(String(num(a.km)).replace('.', ',')) + ' km á ' + euro(a.kmSatz === undefined || a.kmSatz === '' ? rates().km : a.kmSatz) + '</td><td style="text-align:right">' + euro(c.km) + '</td></tr><tr><td>Telefon</td><td style="text-align:right">' + euro(a.telefon) + '</td></tr><tr><td>Porto</td><td style="text-align:right">' + euro(a.porto) + '</td></tr><tr><td>Kopien</td><td style="text-align:right">' + euro(a.kopien) + '</td></tr><tr><td>Sonstiges' + (a.sonstText ? ' (' + esc(a.sonstText) + ')' : '') + '</td><td style="text-align:right">' + euro(a.sonst) + '</td></tr><tr><td class="big"><b>Gesamtbetrag</b></td><td class="big" style="text-align:right"><b>' + euro(c.total) + '</b></td></tr></table>' +
      '<p>Bankverbindung: IBAN <b>' + esc(a.iban || '________________________') + '</b> &nbsp; BIC <b>' + esc(a.bic || '____________') + '</b></p>' +
      '<p style="margin-top:46px">Ort, Datum: ____________________ &nbsp;&nbsp;&nbsp; Unterschrift: ______________________________</p><p style="margin-top:34px">Sachlich richtig' + (kw ? ' (' + esc(kw) + ', Kassenwartin)' : ' (Kassenwartin)') + ': ______________________________</p>');
  }
  function alleTab() {
