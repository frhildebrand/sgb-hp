/* Trainerabrechnung, Fahrtenformular und Profil. Jede Person sieht nur ihre eigenen Einträge; mit Recht „alle“ auch die anderen. */
(function () {
  'use strict';
  var M = window.HubMod; if (!M) return;
  var esc = M.esc; var num = M.num; var euro = M.euro;
  function fd(iso) { return iso ? M.fmtDate(iso) : ''; }
  function fs(iso) { return iso ? M.fmtDate(iso, true) : ''; }
  function lower(s) { return String(s || '').toLowerCase(); }
