    if (!window.HubPdf) { msg.textContent = 'Der PDF-Leser fehlt auf dieser Seite.'; return; }
    msg.textContent = 'Wird gelesen … (beim ersten Mal wird der PDF-Leser geladen)';
    HubPdf.read(f).then(function (r) {
      var p = WKParse.parseAnwesenheit(r.pages); var isWK = /wettkampf/i.test(p.title || ''); var dm = isWK ? rates().dauer : (num(document.getElementById('abdauer') && document.getElementById('abdauer').value) || 60); var gname = isWK ? 'Wettkampfgruppe' : (String(p.title || '').replace(/^Anwesenheitsliste\s*/i, '').trim() || 'Gruppe'); var mineP = p.people.filter(function (x) { return x.trainer && nameMatches(x.name); });
      if (!mineP.length) { msg.innerHTML = '<span class="m-over">Du stehst in dieser Liste nicht als Trainer (gesucht: „' + esc(me()) + '“). Trainer sind dort mit „Trainer“ vor dem Namen markiert.</span>'; return; }
      var rows = []; var have = {}; (a.zeilen || []).forEach(function (z) { have[rowKey(z)] = 1; });
      var inRange = 0;
      p.sessions.forEach(function (s, i) {
        if (!mineP.some(function (x) { return x.st[i] === 'a'; })) return;
        if (s.date < (a.von || '0000') || s.date > (a.bis || '9999')) return;
        inRange++;
        var z = { d: s.date, zeit: zeitOf(s.time || '', dm), std: isWK ? stdFor() : Math.round(dm / 60 * 100) / 100, gruppe: gname, ort: '' };
        if (!have[rowKey(z)]) rows.push(z);
      });
      if (!rows.length) { msg.innerHTML = '<span class="m-over">' + (inRange ? 'Alle ' + inRange + ' Termine im Zeitraum sind schon in der Abrechnung.' : 'Im Zeitraum ' + fs(a.von) + ' – ' + fs(a.bis) + ' gibt es keinen Termin, bei dem du als Trainer anwesend bist. Passe „Von“ und „Bis“ an.') + '</span>'; return; }
      M.closeDlg(); patchAb(a, { zeilen: (a.zeilen || []).concat(rows) }, true); M.toast(rows.length + (rows.length === 1 ? ' Zeile' : ' Zeilen') + ' übernommen.');
    }, function (e) { msg.innerHTML = '<span class="m-over">' + esc(e.message || String(e)) + '</span>'; });
  }

