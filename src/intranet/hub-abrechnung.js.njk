    var out = '<section class="wm-card"><div class="wm-bar"><button type="button" class="wm-btn" data-ma="abback">← Zurück</button><span class="m-actions"><button type="button" class="wm-btn" data-ma="abprint">🖨️ Drucken</button>' +
