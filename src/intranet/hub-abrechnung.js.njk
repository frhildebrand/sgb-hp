      },
      abdel: function () { var a = curAb(); if (!a) return; M.confirm('Abrechnung „' + (a.title || '') + '“ löschen?', 'Löschen', function () { sub().ae = ''; M.op({ op: 'del', coll: 'abrechnungen', id: a.id }); }); },
      saetzeedit: function () { saetzeEdit(); }
    }
  });

  /* ================= Fahrtenformular ================= */
  function fownList() { return M.items('fahrten').filter(function (f) { return lower(f.owner) === lower(me()); }).sort(function (a, b) { return (b.datum || '') < (a.datum || '') ? -1 : 1; }); }
  function fRow(f, showOwner) {
    return '<article class="m-card" data-id="' + esc(f.id) + '"><div class="m-head"><div class="m-main"><div class="m-title">' + esc(f.ziel || 'Fahrt') + statusBadge(f.status || 'offen') + '</div><div class="wm-sub">' + [fs(f.datum), showOwner ? esc(f.owner || '') : '', (f.mitfahrer || []).length ? 'Mit: ' + esc(f.mitfahrer.join(', ')) : ''].filter(Boolean).join(' · ') + '</div></div><b style="white-space:nowrap">' + euro(f.betrag) + '</b></div>' +
      (!showOwner && (f.status || 'offen') === 'offen' ? '<div class="m-body" style="padding-top:8px"><div class="m-btns" style="margin-top:0"><button type="button" class="wm-btn" data-ma="fedit">✏️</button><button type="button" class="wm-btn m-danger" data-ma="fdel">🗑️</button></div></div>' : '') + '</article>';
  }
  function fFields() { return [{ k: 'datum', t: 'date', label: 'Datum', req: true }, { k: 'ziel', t: 'text', label: 'Ziel / Anlass', req: true, ph: 'z. B. Schwimmfest Bruchhausen-Vilsen' }, { k: 'mitfahrer', t: 'tags', label: 'Mitgefahrene Kinder', hint: 'Namen mit Komma trennen.' }, { k: 'betrag', t: 'num', label: 'Pauschale (€)' }]; }
  function fForm(item, isNew) {
    M.openForm({ title: isNew ? 'Fahrt eintragen' : 'Fahrt ändern', fields: fFields(), item: item, onSave: function (v) {
      v.betrag = v.betrag === '' ? rates().fahrt : num(v.betrag);
      if (isNew) M.op({ op: 'set', coll: 'fahrten', item: Object.assign({ id: M.uid(), status: 'offen' }, v) }); else M.op({ op: 'patch', coll: 'fahrten', id: item.id, fields: v });
    } });
  }
  function fPrint(list, name, iban, bic) {
    var sum = 0; list.forEach(function (f) { sum += num(f.betrag); });
    var kw = rates().kassenwartin;
    M.print('Fahrtenformular ' + name, '<h1>Fahrtenformular Wettkampfgruppe</h1><div class="sub">SG Barnstorf · Fahrten zu Wettkämpfen · Pauschale pro Fahrt</div><table><tr><th style="width:24%">Name</th><td>' + esc(name) + '</td></tr><tr><th>IBAN / BIC</th><td>' + esc(iban || '') + (bic ? ' / ' + esc(bic) : '') + (iban ? '' : '______________________________') + '</td></tr></table>' +
      '<table><tr><th>Datum</th><th>Ziel / Anlass</th><th>Mitgefahrene Kinder</th><th>Pauschale</th></tr>' + list.slice().sort(function (a, b) { return a.datum < b.datum ? -1 : 1; }).map(function (f) { return '<tr><td class="nowrap">' + esc(M.fmtDate(f.datum, true)) + '</td><td>' + esc(f.ziel || '') + '</td><td>' + esc((f.mitfahrer || []).join(', ')) + '</td><td style="text-align:right">' + euro(f.betrag) + '</td></tr>'; }).join('') + '<tr><td colspan="3"><b>Summe (' + list.length + ' Fahrten)</b></td><td style="text-align:right" class="big"><b>' + euro(sum) + '</b></td></tr></table>' +
      '<p style="margin-top:46px">Ort, Datum: ____________________ &nbsp;&nbsp;&nbsp; Unterschrift Fahrer/in: ______________________________</p><p style="margin-top:34px">Sachlich richtig' + (kw ? ' (' + esc(kw) + ', Kassenwartin)' : ' (Kassenwartin)') + ': ______________________________</p>');
  }
  function fMeine() {
    if (!personal()) return needPersonal();
    var list = fownList(); var open = list.filter(function (f) { return (f.status || 'offen') === 'offen'; }); var sum = 0; open.forEach(function (f) { sum += num(f.betrag); });
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Meine Fahrten</h3><span class="m-actions"><button type="button" class="wm-btn" data-ma="fprint"' + (open.length ? '' : ' disabled') + '>🖨️ Formular drucken</button><button type="button" class="wm-amber" data-ma="fnew">+ Fahrt</button></span></div>' +
      '<p class="wm-note">Pro Fahrt zu einem Wettkampf gibt es ' + euro(rates().fahrt) + '. Offen: <b>' + open.length + (open.length === 1 ? ' Fahrt' : ' Fahrten') + ' = ' + euro(sum) + '</b>. Zum Abrechnen das Formular drucken, unterschreiben und abgeben.</p>';
    if (!list.length) out += '<p class="wm-note">Noch keine Fahrt eingetragen.</p>';
    return out + list.map(function (f) { return fRow(f, false); }).join('') + '</section>';
  }
  function fAlle() {
    var all = M.items('fahrten'); var by = {};
    all.forEach(function (f) { (by[f.owner] = by[f.owner] || []).push(f); });
    var out = '<section class="wm-card"><div class="wm-bar"><h3>Alle Fahrten</h3></div>';
    var names = Object.keys(by).sort();
    if (!names.length) out += '<p class="wm-note">Noch keine Fahrten.</p>';
    names.forEach(function (n) {
      var l = by[n]; var op = l.filter(function (f) { return (f.status || 'offen') === 'offen'; }); var sum = 0; op.forEach(function (f) { sum += num(f.betrag); });
      out += '<article class="m-card" data-own="' + esc(n) + '"><div class="m-head" data-ma="ftoggle"><div class="m-main"><div class="m-title">' + esc(n) + '</div><div class="wm-sub">' + op.length + ' offen (' + euro(sum) + ') · ' + (l.length - op.length) + ' abgerechnet</div></div><span class="m-chev">' + (M.S.open['f' + n] ? '▾' : '▸') + '</span></div>' +
        (M.S.open['f' + n] ? '<div class="m-body">' + l.sort(function (a, b) { return a.datum < b.datum ? 1 : -1; }).map(function (f) { return '<div class="m-chk"><span style="flex:1">' + fs(f.datum) + ' · ' + esc(f.ziel || '') + '</span><b>' + euro(f.betrag) + '</b> ' + statusBadge(f.status || 'offen') + '</div>'; }).join('') + '<div class="m-btns"><button type="button" class="wm-btn" data-ma="fprintall"' + (op.length ? '' : ' disabled') + '>🖨️ Offene drucken</button><button type="button" class="wm-amber" data-ma="fpaid"' + (op.length ? '' : ' disabled') + '>Als abgerechnet markieren</button></div></div>' : '') + '</article>';
    });
    return out + '</section>';
  }
  M.register('fahrten', {
    title: 'Fahrtenformular', icon: '🚗', colls: ['fahrten', 'saetze', 'profile'],
    tabs: [{ id: 'meine', label: 'Meine Fahrten', view: ['fahrten.eigene'], render: fMeine }, { id: 'alle', label: 'Alle (Kasse)', view: ['fahrten.alle'], render: fAlle }],
    actions: {
      fnew: function () { fForm({ datum: M.today(), betrag: rates().fahrt, mitfahrer: [] }, true); },
      fedit: function (it, el, ev, c) { var f = M.find('fahrten', c.id); if (f) fForm(f, false); },
      fdel: function (it, el, ev, c) { M.confirm('Fahrt löschen?', 'Löschen', function () { M.op({ op: 'del', coll: 'fahrten', id: c.id }); }); },
      fprint: function () { var p = profile(); fPrint(fownList().filter(function (f) { return (f.status || 'offen') === 'offen'; }), me(), p.iban, p.bic); },
      ftoggle: function (it, el, ev, c) { var n = el.closest('[data-own]').getAttribute('data-own'); M.S.open['f' + n] = !M.S.open['f' + n]; M.render(true); },
      fprintall: function (it, el) { var n = el.closest('[data-own]').getAttribute('data-own'); fPrint(M.items('fahrten').filter(function (f) { return f.owner === n && (f.status || 'offen') === 'offen'; }), n, '', ''); },
      fpaid: function (it, el) { var n = el.closest('[data-own]').getAttribute('data-own'); var l = M.items('fahrten').filter(function (f) { return f.owner === n && (f.status || 'offen') === 'offen'; }); M.confirm(l.length + ' Fahrten von ' + n + ' als abgerechnet markieren?', 'Markieren', function () { M.ops(l.map(function (f) { return { op: 'patch', coll: 'fahrten', id: f.id, fields: { status: 'abgerechnet', paidAt: M.today() } }; })); }); }
    }
  });

  /* ================= Profil ================= */
  var PF = [['tel', 'Telefon', 'tel'], ['mail', 'E-Mail', 'email'], ['lizArt', 'Lizenz (Art)', 'text'], ['lizNr', 'Lizenz-Nr.', 'text'], ['lizBis', 'Lizenz gültig bis', 'text'], ['edvNr', 'ÜL-EDV-Nr.', 'text'], ['iban', 'IBAN', 'text'], ['bic', 'BIC', 'text']];
  M.register('profil', {
    title: 'Mein Profil', icon: '👤', colls: ['profile'], custom: true,
    render: function () {
      var m = M.SH.S.me;
      if (!m) return '<section class="wm-card"><p class="wm-note">Bitte melde dich an.</p><button type="button" class="wm-amber" data-sh="login">Anmelden</button></section>';
      if (!m.user) return '<section class="wm-card"><h3>Kein persönliches Konto</h3><p class="wm-note">Du bist mit einem Rollen-Passwort („' + esc((m.role && m.role.name) || '') + '“) angemeldet. Ein Profil, Abrechnungen und Fahrten gibt es nur mit persönlichem Konto. Bitte frage in der Verwaltung nach einem Benutzernamen.</p></section>';
      var p = profile();
      var out = '<section class="wm-card"><div style="display:flex;gap:14px;align-items:center">' + M.avatar(m.user, 'gold') + '<div><h3 style="margin:0">' + esc(m.user) + '</h3><div class="wm-sub">' + esc((m.role && m.role.name) || '') + '</div></div></div></section>';
      out += '<section class="wm-card"><div class="m-sec" style="margin-top:0">Kontakt</div><div class="m-fgrid">' + PF.slice(0, 2).map(function (f) { return pfield(f, p); }).join('') + '</div>' +
        '<div class="m-sec">Lizenz und Abrechnung</div><div class="m-fgrid">' + PF.slice(2, 6).map(function (f) { return pfield(f, p); }).join('') + '</div>' +
        '<div class="m-sec">Bankverbindung (optional)</div><div class="m-fgrid">' + PF.slice(6).map(function (f) { return pfield(f, p); }).join('') + '</div><p class="wm-sub">Nur du siehst diese Angaben. Sie füllen deine Abrechnungen automatisch aus.</p>' +
        '<div class="ha-actions"><button type="button" class="hub-btn hub-gold" data-ma="pfsave">Speichern</button></div></section>';
      return out;
    },
    actions: {
      pfsave: function () {
        var v = {}; PF.forEach(function (f) { var e = document.querySelector('[data-pf="' + f[0] + '"]'); v[f[0]] = e ? e.value.trim() : ''; });
        M.op({ op: 'set', coll: 'profile', item: Object.assign({ id: pid(me()) }, v) }); M.toast('Profil gespeichert.');
      }
    }
  });
  function pfield(f, p) { return '<label class="m-f"><span>' + f[1] + '</span><input type="' + f[2] + '" data-pf="' + f[0] + '" value="' + esc(p[f[0]] || '') + '" autocomplete="off"></label>'; }
  var st = document.createElement('style'); st.textContent = '#hubRoot .ab-row{padding:10px 0;border-bottom:1px solid rgba(148,163,184,.25)}#hubRoot .ab-total{display:flex;justify-content:space-between;align-items:center;margin-top:12px;padding:14px;border-radius:14px;background:var(--navy);color:#fff;font-size:15px}#hubRoot .ab-total b{font:900 24px ui-rounded,system-ui,sans-serif;color:var(--gold)}';
  document.head.appendChild(st);
})();
