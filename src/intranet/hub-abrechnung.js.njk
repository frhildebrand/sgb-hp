      (ro && !readOnly ? '<p class="wm-note">Eingereichte Abrechnungen sind gesperrt. Mit „Zurück zum Entwurf“ kannst du sie wieder ändern.</p>' : '') + '</section>';
    out += '<section class="wm-card"><div class="m-sec" style="margin-top:0">Angaben</div><div class="m-fgrid">' + inp('Zeitraum / Bezeichnung', 'title', a.title, 'text', dis) + inp('Name', 'name', a.name, 'text', dis) + inp('Von', 'von', a.von, 'date', dis) + inp('Bis', 'bis', a.bis, 'date', dis) + inp('ÜL-EDV-Nr.', 'edv', a.edv, 'text', dis) + inp('Lizenz', 'lizArt', a.lizArt, 'text', dis) + inp('Lizenz-Nr.', 'lizNr', a.lizNr, 'text', dis) + inp('Gültig bis', 'lizBis', a.lizBis, 'text', dis) + '</div></section>';
    out += '<section class="wm-card"><div class="wm-bar"><h3>Stunden</h3>' + (ro ? '' : '<span class="m-actions"><button type="button" class="wm-btn" data-ma="abtage">⬇️ Aus Trainingstagen</button><button type="button" class="wm-amber" data-ma="abzadd">+ Zeile</button></span>') + '</div>';
    if (!(a.zeilen || []).length) out += '<p class="wm-note">Noch keine Stunden. Mit „Aus Trainingstagen“ werden deine Trainingstage im Zeitraum übernommen.</p>';
    (a.zeilen || []).forEach(function (z, i) {
      out += '<div class="ab-row" data-i="' + i + '"><div class="m-fgrid"><label class="m-f"><span>Datum</span><input type="date" data-abz="d" value="' + esc(z.d || '') + '"' + dis + '></label><label class="m-f"><span>Zeit</span><input type="text" data-abz="zeit" value="' + esc(z.zeit || '') + '" placeholder="18:00–19:30"' + dis + '></label><label class="m-f"><span>Std.</span><input type="number" inputmode="decimal" step="any" data-abz="std" value="' + esc(z.std === undefined ? '' : z.std) + '"' + dis + '></label><label class="m-f"><span>Gruppe</span><input type="text" data-abz="gruppe" value="' + esc(z.gruppe || '') + '"' + dis + '></label><label class="m-f"><span>Ort</span><input type="text" data-abz="ort" value="' + esc(z.ort || '') + '"' + dis + '></label></div>' + (ro ? '' : '<button type="button" class="wm-btn m-danger" data-ma="abzdel" style="margin-top:6px">Zeile löschen</button>') + '</div>';
    });
    out += '<p class="wm-note"><b>' + c.std + ' Std.</b> × ' + euro(a.satz) + ' = <b>' + euro(c.hours) + '</b></p><div class="m-fgrid">' + inp('Satz pro Stunde (€)', 'satz', a.satz, 'number', dis) + '</div><p class="wm-sub">Standard laut Sätzen: ' + euro(satzFor(a.lizArt)) + (a.lizArt ? ' (Lizenz: ' + esc(a.lizArt) + ')' : '') + '. Du kannst den Satz hier für diese Abrechnung ändern.</p></section>';
