  function satzFor(lizArt) {
    var r = rates(); var l = lower(lizArt);
    if (l) for (var i = 0; i < r.liz.length; i++) if (r.liz[i].art && l.indexOf(lower(r.liz[i].art)) >= 0) return num(r.liz[i].satz);
    return r.std;
  }
  function needPersonal() {
    return '<section class="wm-card"><h2 class="m-h2">Persönliches Konto nötig</h2><p class="wm-note">Dieser Bereich gehört zu einer Person. Bitte melde dich mit deinem eigenen Benutzernamen an (nicht mit einem Rollen-Passwort).</p><button type="button" class="wm-amber" data-sh="login">Anmelden</button></section>';
  }
  function deniedNote(c) { return M.D && M.D.denied && M.D.denied[c]; }
  function statusBadge(s) { return s === 'bezahlt' || s === 'abgerechnet' ? M.badge(s, 'green') : s === 'eingereicht' ? M.badge(s, 'blue') : M.badge(s || 'entwurf', 'amber'); }

  /* ================= Trainerabrechnung ================= */
  function calc(a) {
    var std = 0; (a.zeilen || []).forEach(function (z) { std += num(z.std); });
    var hours = std * num(a.satz); var km = num(a.km) * (a.kmSatz === undefined || a.kmSatz === '' ? rates().km : num(a.kmSatz));
