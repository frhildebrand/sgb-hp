    var out = '<section class="wm-card"><div class="wm-bar"><h3>Sätze</h3><button type="button" class="wm-amber" data-ma="saetzeedit">✏️ Bearbeiten</button></div><p class="wm-note">Diese Werte werden bei jeder neuen Abrechnung und Fahrt vorgeschlagen. Jeder kann sie in seiner eigenen Abrechnung ändern.</p>' +
      '<div class="m-chk"><span style="flex:1">Standard-Stundensatz</span><b>' + euro(r.std) + '</b></div><div class="m-chk"><span style="flex:1">Kilometer</span><b>' + euro(r.km) + ' / km</b></div><div class="m-chk"><span style="flex:1">Fahrer-Pauschale (Wettkampfgruppe)</span><b>' + euro(r.fahrt) + '</b></div><div class="m-chk"><span style="flex:1">Kassenwartin (für den Ausdruck)</span><b>' + esc(r.kassenwartin || '–') + '</b></div>';
