    var a = { id: M.uid(), title: title, status: 'entwurf', von: first, bis: M.today(), name: me(), edv: p.edvNr || '', lizArt: p.lizArt || '', lizNr: p.lizNr || '', lizBis: p.lizBis || '', iban: p.iban || '', bic: p.bic || '', satz: satzFor(p.lizArt), kmSatz: rates().km, km: 0, zeilen: [], summe: 0 };
