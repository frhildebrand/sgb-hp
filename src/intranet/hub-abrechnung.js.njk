        M.openDlg('<div class="hub-dhead"><h3>Unterschrift</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div><p class="wm-note">Zeichne deine Unterschrift mit dem Finger oder Stift in das Feld.</p><canvas id="sigcv" width="560" height="200" style="width:100%;max-width:560px;height:auto;aspect-ratio:560/200;background:#fff;border:2px dashed #94a3b8;border-radius:12px;touch-action:none;display:block"></canvas><div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="sigclear">Löschen</button><button type="button" class="hub-btn hub-gold" data-ma="sigsave">Speichern</button></div>');
        var cv = document.getElementById('sigcv'); if (!cv) return; var cx = cv.getContext('2d'); cx.lineWidth = 3.2; cx.lineCap = 'round'; cx.lineJoin = 'round'; cx.strokeStyle = '#0b1b3a'; var down = false, last = null;
        function pt(e) { var r = cv.getBoundingClientRect(); return { x: (e.clientX - r.left) * cv.width / r.width, y: (e.clientY - r.top) * cv.height / r.height }; }
        cv.addEventListener('pointerdown', function (e) { down = true; last = pt(e); cv.setPointerCapture && cv.setPointerCapture(e.pointerId); cx.beginPath(); cx.arc(last.x, last.y, 1.6, 0, 6.3); cx.fillStyle = '#0b1b3a'; cx.fill(); cv.__ink = true; e.preventDefault(); });
        cv.addEventListener('pointermove', function (e) { if (!down) return; var q = pt(e); cx.beginPath(); cx.moveTo(last.x, last.y); cx.lineTo(q.x, q.y); cx.stroke(); last = q; e.preventDefault(); });
        var up = function () { down = false; }; cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up); cv.addEventListener('pointerleave', up);
      },
      sigclear: function () { var cv = document.getElementById('sigcv'); if (cv) { cv.getContext('2d').clearRect(0, 0, cv.width, cv.height); cv.__ink = false; } },
      sigsave: function () {
        var cv = document.getElementById('sigcv'); if (!cv || !cv.__ink) { M.toast('Bitte zuerst unterschreiben.'); return; }
        // auf die beschriebene Fläche zuschneiden
        var d = cv.getContext('2d').getImageData(0, 0, cv.width, cv.height).data, x0 = cv.width, y0 = cv.height, x1 = 0, y1 = 0;
        for (var y = 0; y < cv.height; y++) for (var x = 0; x < cv.width; x++) if (d[(y * cv.width + x) * 4 + 3] > 20) { if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
        x0 = Math.max(0, x0 - 6); y0 = Math.max(0, y0 - 6); x1 = Math.min(cv.width, x1 + 6); y1 = Math.min(cv.height, y1 + 6);
        var o = document.createElement('canvas'); o.width = x1 - x0; o.height = y1 - y0; o.getContext('2d').drawImage(cv, x0, y0, o.width, o.height, 0, 0, o.width, o.height);
        var url = o.toDataURL('image/png'); if (url.length > 26000) { var o2 = document.createElement('canvas'); o2.width = Math.round(o.width / 2); o2.height = Math.round(o.height / 2); o2.getContext('2d').drawImage(o, 0, 0, o2.width, o2.height); url = o2.toDataURL('image/png'); }
        M.closeDlg(); M.op({ op: 'set', coll: 'profile', item: Object.assign({}, profile(), { id: pid(me()), sig: url }) }); M.toast('Unterschrift gespeichert.');
      },
      pfsigup: function () {
        var inp = document.createElement('input'); inp.type = 'file'; inp.accept = 'image/*'; inp.style.display = 'none'; document.body.appendChild(inp);
        inp.addEventListener('change', function () {
          var f = inp.files && inp.files[0]; document.body.removeChild(inp); if (!f) return;
          var im = new Image(); var u = URL.createObjectURL(f);
          im.onerror = function () { URL.revokeObjectURL(u); M.toast('Das Bild konnte nicht gelesen werden. Nimm ein PNG oder JPG.'); };
          im.onload = function () {
            URL.revokeObjectURL(u);
            var sc = Math.min(1, 700 / im.width, 260 / im.height); var w = Math.max(1, Math.round(im.width * sc)), h = Math.max(1, Math.round(im.height * sc));
            var cv = document.createElement('canvas'); cv.width = w; cv.height = h; var cx = cv.getContext('2d'); cx.drawImage(im, 0, 0, w, h);
            var id = cx.getImageData(0, 0, w, h), d = id.data, x0 = w, y0 = h, x1 = 0, y1 = 0;
            for (var y = 0; y < h; y++) for (var x = 0; x < w; x++) {
              var i = (y * w + x) * 4; var m = Math.min(d[i], d[i + 1], d[i + 2]);
              if (d[i + 3] === 255) { if (m >= 235) d[i + 3] = 0; else if (m > 170) d[i + 3] = Math.round((235 - m) / 65 * 255); }
              if (d[i + 3] > 20) { if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
            }
            if (x1 <= x0 || y1 <= y0) { M.toast('Im Bild ist keine Unterschrift zu erkennen (nur weiß?).'); return; }
            cx.putImageData(id, 0, 0); x0 = Math.max(0, x0 - 4); y0 = Math.max(0, y0 - 4); x1 = Math.min(w, x1 + 4); y1 = Math.min(h, y1 + 4);
            var o = document.createElement('canvas'); o.width = x1 - x0; o.height = y1 - y0; o.getContext('2d').drawImage(cv, x0, y0, o.width, o.height, 0, 0, o.width, o.height);
            var url = o.toDataURL('image/png'); var k = 1;
            while (url.length > 30000 && k > 0.2) { k *= 0.8; var o2 = document.createElement('canvas'); o2.width = Math.max(60, Math.round(o.width * k)); o2.height = Math.max(20, Math.round(o.height * k)); o2.getContext('2d').drawImage(o, 0, 0, o2.width, o2.height); url = o2.toDataURL('image/png'); }
            if (url.length > 30000) { M.toast('Das Bild ist zu detailreich. Bitte eine einfachere Unterschrift hochladen.'); return; }
            M.op({ op: 'set', coll: 'profile', item: Object.assign({}, profile(), { id: pid(me()), sig: url }) }); M.toast('Unterschrift gespeichert.');
          };
          im.src = u;
        });
        inp.click();
      },
      pfsigdel: function () { M.confirm('Unterschrift löschen?', 'Löschen', function () { M.op({ op: 'set', coll: 'profile', item: Object.assign({}, profile(), { id: pid(me()), sig: '' }) }); }); },
      pfedit: function () {
        var p = profile(); var item = {}; PF.forEach(function (f) { item[f[0]] = p[f[0]] || ''; });
        var fields = PF.map(function (f) { return { k: f[0], t: f[2] === 'date' ? 'date' : 'text', label: f[1] }; });
        M.openForm({ title: 'Profil bearbeiten', fields: fields, item: item, onSave: function (vv) { M.op({ op: 'set', coll: 'profile', item: Object.assign({}, p, { id: pid(me()) }, vv) }); M.toast('Profil gespeichert.'); } });
      },
      pfimport: function () {
        M.openDlg('<div class="hub-dhead"><h3>Aus WebClub-Datei</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div><p class="wm-note">In WebClub deine Stammdaten als CSV exportieren („stammdaten.csv“) und hier auswählen. Es wird nur deine eigene Zeile gelesen. Übernommen werden Telefon, E-Mail, Lizenzen, Nachweise und Bankverbindung. Die Datei selbst wird nicht gespeichert.</p><div class="m-fgrid"><label class="m-f wide"><span>CSV-Datei</span><input type="file" id="pffile" accept=".csv,text/csv,text/plain"></label></div><p id="pfmsg" class="wm-note"></p><div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="pfread">Einlesen</button></div>');
      },
      pfread: function () {
        var f = document.getElementById('pffile') && document.getElementById('pffile').files[0]; var msg = document.getElementById('pfmsg');
        if (!f) { msg.textContent = 'Bitte zuerst eine Datei auswählen.'; return; }
        HubPdf.text(f).then(function (txt) {
          var rows = parseCsv(txt); if (rows.length < 2) { msg.innerHTML = '<span class="m-over">Die Datei enthält keine Daten.</span>'; return; }
          var head = rows[0].map(function (h) { return lower(h).replace(/\s+/g, ''); });
          var col = function (r, names) { for (var i = 0; i < names.length; i++) { var j = head.indexOf(names[i]); if (j >= 0 && (r[j] || '').trim()) return r[j].trim(); } return ''; };
          var mine = rows.slice(1).filter(function (r) { return r.length > 3; }).filter(function (r) { return nameMatches(col(r, ['vorname']) + ' ' + col(r, ['name'])); });
          if (!mine.length) { msg.innerHTML = '<span class="m-over">Keine Zeile für „' + esc(me()) + '“ gefunden. (Gelesen: ' + (rows.length - 1) + ' Zeile(n).)</span>'; return; }
          if (mine.length > 1) { msg.innerHTML = '<span class="m-over">Der Name kommt mehrfach vor. Bitte exportiere nur deine eigenen Stammdaten.</span>'; return; }
          var r = mine[0];
          var v = { tel: col(r, ['mobil', 'telefon1']), mail: col(r, ['mail1']), lizNr: col(r, ['trainerlizenznr']), lizBis: dIso(col(r, ['trainerlizenzgueltig', 'trainerlizenzgültig'])), ersteHilfeBis: dIso(col(r, ['erstehilfebis'])), rettungBis: dIso(col(r, ['rettungsnachweisbis'])), fuehrungszeugnis: dIso(col(r, ['führungszeugnisvom', 'fuehrungszeugnisvom'])), kariNr: col(r, ['karilizenznr']), kariBis: dIso(col(r, ['wettkampfrichterbis'])), kontoinhaber: col(r, ['kontoinhaber']), iban: col(r, ['iban']), bic: col(r, ['bic']) };
          var set = {}; Object.keys(v).forEach(function (k) { if (v[k]) set[k] = v[k]; });
          var names = PF.filter(function (f) { return set[f[0]]; }).map(function (f) { return f[1]; });
          M.closeDlg(); M.op({ op: 'set', coll: 'profile', item: Object.assign({}, profile(), { id: pid(me()) }, set) }); M.toast('Übernommen: ' + names.join(', ') + '.');
        }, function (e) { msg.innerHTML = '<span class="m-over">' + esc(e.message || String(e)) + '</span>'; });
      }
    }
  });
  // CSV mit Semikolon (WebClub), Anführungszeichen erlaubt
  function parseCsv(txt) {
    var rows = [], row = [], cur = '', q = false; txt = String(txt).replace(/^﻿/, '');
    for (var i = 0; i < txt.length; i++) {
      var c = txt[i];
      if (q) { if (c === '"') { if (txt[i + 1] === '"') { cur += '"'; i++; } else q = false; } else cur += c; }
      else if (c === '"') q = true;
      else if (c === ';') { row.push(cur); cur = ''; }
      else if (c === '\n' || c === '\r') { if (c === '\r' && txt[i + 1] === '\n') i++; row.push(cur); cur = ''; if (row.some(function (x) { return x !== ''; })) rows.push(row); row = []; }
      else cur += c;
    }
    row.push(cur); if (row.some(function (x) { return x !== ''; })) rows.push(row);
    return rows;
  }
  window.HubProfil = { expiring: function (p) { var o = []; EXPIRES.forEach(function (x) { var iso = p && p[x[0]]; if (isoOk(iso)) { var d = M.daysTo(iso); if (d <= 60) o.push({ label: x[1], iso: iso, days: d }); } }); return o; } };
  var st = document.createElement('style'); st.textContent = '#hubRoot .ab-row{padding:10px 0;border-bottom:1px solid rgba(148,163,184,.25)}#hubRoot .ab-total{display:flex;justify-content:space-between;align-items:center;margin-top:12px;padding:14px;border-radius:14px;background:var(--navy);color:#fff;font-size:15px}#hubRoot .ab-total b{font:900 24px ui-rounded,system-ui,sans-serif;color:var(--gold)}';
  document.head.appendChild(st);
})();
