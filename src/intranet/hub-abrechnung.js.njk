      },
      pfimport: function () {
        M.openDlg('<div class="hub-dhead"><h3>Aus WebClub-Datei</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div><p class="wm-note">In WebClub deine Stammdaten als CSV exportieren („stammdaten.csv“) und hier auswählen. Es wird nur deine eigene Zeile gelesen. Übernommen werden Telefon, E-Mail, Lizenzen, Nachweise und Bankverbindung. Die Datei selbst wird nicht gespeichert.</p><div class="m-fgrid"><label class="m-f wide"><span>CSV-Datei</span><input type="file" id="pffile" accept=".csv,text/csv,text/plain"></label></div><p id="pfmsg" class="wm-note"></p><div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="pfread">Einlesen</button></div>');
      },
      pfread: function () {
        var f = document.getElementById('pffile') && document.getElementById('pffile').files[0]; var msg = document.getElementById('pfmsg');
        if (!f) { msg.textContent = 'Bitte zuerst eine Datei auswählen.'; return; }
        HubPdf.text(f).then(function (txt) {
          var rows = parseCsv(txt); if (rows.length < 2) { msg.innerHTML = '<span class="m-over">Die Datei enthält keine Daten.</span>'; return; }
          var head = rows[0].map(function (h) { return lower(h).replace(/\s+/g, ''); });
          var col = function (r, names) { for (var i = 0; i < names.length; i++) { var j = head.indexOf(names[i]); if (j >= 0 && (r[j] || '').trim()) return r[j].trim(); } return ''; };
          var mine = rows.slice(1).filter(function (r) { return r.length > 3; }).filter(function (r) { return nameMatches(col(r, ['vorname']) + ' ' + col(r, ['name'])); });
          if (!mine.length) { msg.innerHTML = '<span class="m-over">Keine Zeile für „' + esc(me()) + '“ gefunden. (Gelesen: ' + (rows.length - 1) + ' Zeile(n).)</span>'; return; }
          if (mine.length > 1) { msg.innerHTML = '<span class="m-over">Der Name kommt mehrfach vor. Bitte exportiere nur deine eigenen Stammdaten.</span>'; return; }
          var r = mine[0];
          var v = { tel: col(r, ['mobil', 'telefon1']), mail: col(r, ['mail1']), lizNr: col(r, ['trainerlizenznr']), lizBis: dIso(col(r, ['trainerlizenzgueltig', 'trainerlizenzgültig'])), ersteHilfeBis: dIso(col(r, ['erstehilfebis'])), rettungBis: dIso(col(r, ['rettungsnachweisbis'])), fuehrungszeugnis: dIso(col(r, ['führungszeugnisvom', 'fuehrungszeugnisvom'])), kariNr: col(r, ['karilizenznr']), kariBis: dIso(col(r, ['wettkampfrichterbis'])), kontoinhaber: col(r, ['kontoinhaber']), iban: col(r, ['iban']), bic: col(r, ['bic']) };
          var set = {}; Object.keys(v).forEach(function (k) { if (v[k]) set[k] = v[k]; });
          var names = PF.filter(function (f) { return set[f[0]]; }).map(function (f) { return f[1]; });
          M.closeDlg(); M.op({ op: 'set', coll: 'profile', item: Object.assign({}, profile(), { id: pid(me()) }, set) }); M.toast('Übernommen: ' + names.join(', ') + '.');
        }, function (e) { msg.innerHTML = '<span class="m-over">' + esc(e.message || String(e)) + '</span>'; });
      }
    }
  });
  // CSV mit Semikolon (WebClub), Anführungszeichen erlaubt
  function parseCsv(txt) {
    var rows = [], row = [], cur = '', q = false; txt = String(txt).replace(/^﻿/, '');
    for (var i = 0; i < txt.length; i++) {
      var c = txt[i];
      if (q) { if (c === '"') { if (txt[i + 1] === '"') { cur += '"'; i++; } else q = false; } else cur += c; }
      else if (c === '"') q = true;
      else if (c === ';') { row.push(cur); cur = ''; }
      else if (c === '\n' || c === '\r') { if (c === '\r' && txt[i + 1] === '\n') i++; row.push(cur); cur = ''; if (row.some(function (x) { return x !== ''; })) rows.push(row); row = []; }
      else cur += c;
    }
    row.push(cur); if (row.some(function (x) { return x !== ''; })) rows.push(row);
    return rows;
  }
  window.HubProfil = { expiring: function (p) { var o = []; EXPIRES.forEach(function (x) { var iso = p && p[x[0]]; if (isoOk(iso)) { var d = M.daysTo(iso); if (d <= 60) o.push({ label: x[1], iso: iso, days: d }); } }); return o; } };
  var st = document.createElement('style'); st.textContent = '#hubRoot .ab-row{padding:10px 0;border-bottom:1px solid rgba(148,163,184,.25)}#hubRoot .ab-total{display:flex;justify-content:space-between;align-items:center;margin-top:12px;padding:14px;border-radius:14px;background:var(--navy);color:#fff;font-size:15px}#hubRoot .ab-total b{font:900 24px ui-rounded,system-ui,sans-serif;color:var(--gold)}';
  document.head.appendChild(st);
})();
