/* Trainer: Lizenz, Erste Hilfe, Rettung, Kampfrichter und Gruppenzuordnung. */
(function () {
  'use strict';
  var M = window.HubMod; if (!M) return;
  var esc = M.esc;
  var GR = ['Wettkampfgruppe', 'Gruppe 1', 'Gruppe 2', 'Gruppe 3', 'Gruppe 4', 'Masters'];
  function fd(i) { return i ? M.fmtDate(i) : ''; }
  // Ampel: rot = abgelaufen, gelb = läuft in 90 Tagen ab, grün = gültig, grau = nichts eingetragen
  function amp(iso) { if (!iso) return ['gray', '–']; var d = M.daysTo(iso); if (d === null) return ['gray', '–']; return d < 0 ? ['red', 'abgelaufen ' + fd(iso)] : d <= 90 ? ['amber', 'bis ' + fd(iso)] : ['green', 'bis ' + fd(iso)]; }
  function worst(t) { var rank = { gray: 0, green: 1, amber: 2, red: 3 }; var w = 'green'; ['lizBis', 'ehBis', 'rettungBis'].forEach(function (k) { var c = amp(t[k])[0]; if (c !== 'gray' && rank[c] > rank[w]) w = c; }); return w; }
  var FIELDS = [
    { k: 'name', t: 'text', label: 'Name', req: true },
    { k: 'gruppen', t: 'pick', label: 'Gruppen', opts: GR },
    { k: 'lizArt', t: 'text', label: 'Lizenz (Art)', ph: 'z. B. Trainer C Breitensport' },
    { k: 'lizNr', t: 'text', label: 'Lizenznummer' },
    { k: 'lizDosb', t: 'text', label: 'Lizenznummer DOSB' },
    { k: 'aktiv', t: 'sel', label: 'Aktiver Trainer', opts: [['', 'Ja'], ['nein', 'Nein']] },
    { k: 'seit', t: 'date', label: 'Trainer seit' },
    { k: 'lizBis', t: 'date', label: 'Lizenz gültig bis' },
    { k: 'ehBis', t: 'date', label: 'Erste Hilfe gültig bis' },
    { k: 'rettungBis', t: 'date', label: 'Rettungsnachweis gültig bis' },
    { k: 'kariBis', t: 'date', label: 'Kampfrichter gültig bis' },
    { k: 'fz', t: 'date', label: 'Führungszeugnis vom' },
    { k: 'ehrenkodex', t: 'date', label: 'Ehrenkodex vom' },
    { k: 'notiz', t: 'area', label: 'Notiz', rows: 3 }
  ];
  function flt() { return M.S.filter || (M.S.filter = {}); }
  var tab = {
    id: 'trainer', label: 'Trainer', coll: 'trainer', view: ['trainer.view', 'trainer.eigene'], edit: ['trainer.edit', 'trainer.eigene'], add: ['trainer.edit', 'trainer.eigene'], del: ['trainer.edit'], addLabel: 'Trainer anlegen', search: ['name', 'lizArt'], fields: FIELDS, sortBy: { k: 'name', dir: 1 },
    newItem: function () { return { name: M.anyCan(['trainer.edit']) ? '' : M.userName(), gruppen: [] }; },
    beforeSave: function (it) { it.title = it.name; },
    filter: function (t, f) { f = f || {}; return !f.g || (t.gruppen || []).indexOf(f.g) >= 0; },
    summary: function (all) {
      var n = { green: 0, amber: 0, red: 0 }; all.forEach(function (t) { var w = worst(t); if (n[w] !== undefined) n[w]++; }); var f = flt();
      return '<div class="m-stats">' + M.stat(all.length, 'Trainer', '') + M.stat(n.green, 'Alles gültig', 'ok') + M.stat(n.amber, 'Läuft bald ab', n.amber ? 'warn' : '') + M.stat(n.red, 'Abgelaufen', n.red ? 'bad' : '') + '</div>' +
        '<div class="m-chips" style="margin:2px 0 8px">' + [''].concat(GR).map(function (g) { return '<button type="button" class="m-chip' + ((f.g || '') === g ? ' on' : '') + '" data-ma="tgf" data-v="' + esc(g) + '">' + esc(g || 'Alle Gruppen') + '</button>'; }).join('') + '</div>';
    },
    card: function (t) {
      var row = function (lab, iso, extra) { var a = amp(iso); return '<div class="m-chk"><span style="flex:1">' + lab + (extra ? ' <span class="wm-sub">' + esc(extra) + '</span>' : '') + '</span>' + M.badge(a[1], a[0]) + '</div>'; };
      return { title: t.name, badges: M.badge({ green: 'ok', amber: 'bald ablaufend', red: 'abgelaufen', gray: '' }[worst(t)] || '', worst(t) === 'gray' ? 'gray' : worst(t)),
        sub: (t.gruppen || []).join(', ') || 'keine Gruppe', body: row('Trainerlizenz', t.lizBis, [t.lizArt, t.lizNr, t.lizDosb ? 'DOSB ' + t.lizDosb : ''].filter(Boolean).join(' · ')) + row('Erste Hilfe', t.ehBis) + row('Rettungsnachweis', t.rettungBis) + (t.kariBis ? row('Kampfrichter', t.kariBis) : '') + [['fz', 'Führungszeugnis'], ['ehrenkodex', 'Ehrenkodex'], ['seit', 'Trainer seit']].map(function (r) { return t[r[0]] ? '<div class="m-chk"><span style="flex:1">' + r[1] + '</span><b>' + fd(t[r[0]]) + '</b></div>' : ''; }).join('') + (t.notiz ? '<pre>' + esc(t.notiz) + '</pre>' : '') };
    }
  };
  M.register('trainer', { title: 'Trainer', icon: '🎓', colls: ['trainer'], tabs: [tab], actions: { tgf: function (it, el) { var f = flt(); var v = el.getAttribute('data-v'); if (v) f.g = v; else delete f.g; M.render(true); } } });
})();
