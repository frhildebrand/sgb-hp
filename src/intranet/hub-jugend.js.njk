    ops.push({ op: 'set', coll: 'kasseCfg', item: Object.assign({}, c, { id: 'main', anfang: d.anfang, seit: c.seit || d.seit, ort: c.ort || d.ort || '', holder: c.holder || d.holder || '', kats: c.kats && c.kats.length ? c.kats : DEF_KATS, ortLog: c.ortLog || [] }) });
