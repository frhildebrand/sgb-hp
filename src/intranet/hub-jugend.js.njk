  function bFields() { return [{ k: 'typ', t: 'sel', label: 'Art', opts: [['ein', 'Einnahme'], ['aus', 'Ausgabe']] }, { k: 'betrag', t: 'num', label: 'Betrag (€)', req: true }, { k: 'datum', t: 'date', label: 'Datum', req: true }, { k: 'kat', t: 'sel', label: 'Kategorie', opts: kats() }, { k: 'text', t: 'text', label: 'Wofür?', req: true }, { k: 'beleg', t: 'text', label: 'Beleg-Nr. / Notiz', ph: 'z. B. 2026-07' }]; }
  function bookForm(item, isNew) {
