    var sm = /s="(\d+)"/.exec(m[1]); var st = sm ? ' s="' + sm[1] + '"' : ''; var out;
    if (val === null || val === undefined || val === '') out = '<c r="' + ref + '"' + st + '/>';
    else if (formula) out = '<c r="' + ref + '"' + st + '><f>' + formula + '</f><v>' + val + '</v></c>';
    else if (typeof val === 'number') out = '<c r="' + ref + '"' + st + '><v>' + val + '</v></c>';
    else out = '<c r="' + ref + '"' + st + ' t="inlineStr"><is><t xml:space="preserve">' + xe(val) + '</t></is></c>';
    return xml.replace(re, function () { return out; });
  }
  function jszip(cb) {
    if (window.JSZip) return cb(); var sc = document.createElement('script'); sc.src = 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js'; sc.onload = cb; sc.onerror = function () { M.toast('Die Excel-Bibliothek konnte nicht geladen werden. Bitte Internetverbindung prüfen.'); }; document.head.appendChild(sc);
  }
  function r2(v) { return Math.round(v * 100) / 100; }
  function bookData() {
    var y = M.S.sub.by || String(new Date().getFullYear()); var c = cfg(); var start = (c ? M.num(c.anfang) : 0);
    buchungen().forEach(function (b) { if (b.status === 'bestaetigt' && String(b.datum).slice(0, 4) < y) start += signed(b); });
    var list = buchungen().filter(function (b) { return b.status === 'bestaetigt' && String(b.datum).slice(0, 4) === y; }).sort(function (a, b) { return String(a.datum) < String(b.datum) ? -1 : String(a.datum) > String(b.datum) ? 1 : 0; });
    var s = start; var rows = list.map(function (b) { var v = signed(b); s += v; return { d: b.datum, v: r2(v), t: b.text || '', beleg: b.beleg || '', st: r2(s) }; });
    return { y: y, start: r2(start), rows: rows };
  }
  function bookXlsx(page) {
    var D = bookData(); var per = JK_ROWS - 1; var pages = Math.max(1, Math.ceil(D.rows.length / per));
    if (page === undefined && pages > 1) {
      M.openDlg('<div class="hub-dhead"><h3>Kassenbuch ' + esc(D.y) + ' als Excel</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose" aria-label="Schließen">✕</button></div><p class="wm-note">Eine Seite der Vorlage fasst ' + per + ' Buchungen, im Jahr ' + esc(D.y) + ' sind es ' + D.rows.length + '. Jede Seite beginnt mit dem Übertrag der vorigen. Bitte die Seiten nacheinander erstellen.</p><div class="m-btns" style="flex-direction:column;align-items:stretch">' + Array.apply(null, Array(pages)).map(function (x, i) { var a = D.rows[i * per], z = D.rows[Math.min(D.rows.length, (i + 1) * per) - 1]; return '<button type="button" class="wm-btn" data-ma="kxpage" data-p="' + i + '">📊 Seite ' + (i + 1) + ' von ' + pages + ' · ' + esc(fd(a.d)) + ' bis ' + esc(fd(z.d)) + '</button>'; }).join('') + '</div>');
      return;
    }
    page = page || 0; var chunk = D.rows.slice(page * per, (page + 1) * per); var begin = page === 0 ? D.start : D.rows[page * per - 1].st;
    var df = function (i) { return /^\d{4}-\d{2}-\d{2}$/.test(String(i)) ? String(i).split('-').reverse().join('.') : String(i || ''); };
    jszip(function () {
      JSZip.loadAsync(XLSX_JK, { base64: true }).then(function (zip) {
        return zip.file('xl/worksheets/sheet1.xml').async('string').then(function (x) {
          x = xcell(x, 'E3', 'Stand: ' + df(M.today()));
          x = xcell(x, 'A6', page === 0 ? '01.01.' + D.y : df(D.rows[page * per - 1].d)); x = xcell(x, 'C6', page === 0 ? 'STAND' : 'Übertrag'); x = xcell(x, 'E6', begin);
          chunk.forEach(function (b, i) { var r = 7 + i; x = xcell(x, 'A' + r, df(b.d)); x = xcell(x, 'B' + r, b.v); x = xcell(x, 'C' + r, b.t); x = xcell(x, 'D' + r, b.beleg); x = xcell(x, 'E' + r, b.st); });
