  function stkSum(box) { var t = 0; Array.prototype.forEach.call(box.querySelectorAll('input[data-stk]'), function (i) { var n = Math.max(0, Math.floor(+i.value || 0)); var v = +i.getAttribute('data-stk'); t += Math.round(n * v * 100) / 100; var o = box.querySelector('[data-stkv="' + i.getAttribute('data-stk') + '"]'); if (o) o.textContent = M.euro(Math.round(n * v * 100) / 100); }); return Math.round(t * 100) / 100; }
  var kimp = null;
  function kimportOpen() {
