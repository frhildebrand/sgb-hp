    document.getElementById('kifile').addEventListener('change', function () {
      var f = this.files[0]; if (!f) return; var r = new FileReader();
      r.onload = function () { try { var d = JSON.parse(r.result); if (!d.buchungen || !d.buchungen.length) throw new Error('keine Buchungen'); kimp = d; var sum = d.anfang; d.buchungen.forEach(function (b) { sum += (b.typ === 'aus' ? -1 : 1) * b.betrag; }); document.getElementById('kimsg').innerHTML = '<b>' + d.buchungen.length + '</b> Buchungen, Anfangsbestand ' + M.euro(d.anfang) + ' (' + fd(d.seit) + '), Endstand <b>' + M.euro(sum) + '</b>' + (d.sturz ? ', ein Kassensturz mit Stückelung' : '') + '. Alle Buchungen werden als bestätigt eingetragen.'; document.getElementById('kibtn').disabled = false; } catch (e) { document.getElementById('kimsg').innerHTML = '<span class="m-over">Die Datei konnte nicht gelesen werden.</span>'; } };
      r.readAsText(f);
