    var rows = STK.map(function (v) { return '<div class="m-chk"><span style="flex:1"><b>' + stkLabel(v).replace(' Schein', '') + '</b>' + (v >= 5 ? ' <span class="wm-sub">Schein</span>' : '') + '</span><input type="number" inputmode="numeric" min="0" step="1" data-stk="' + v + '" value="' + (lk[v] || '') + '" style="width:5.5em;text-align:right" aria-label="Anzahl ' + stkLabel(v) + '"><span class="wm-sub" style="width:6.5em;text-align:right" data-stkv="' + v + '"></span></div>'; }).join('');
    M.openDlg('<div class="hub-dhead"><h3>Kassensturz</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose" aria-label="Schließen">✕</button></div><div id="stkBox"><label class="m-f"><span>Datum</span><input type="date" id="stkdat" value="' + M.today() + '"></label>' +
      '<p class="wm-note">Anzahl der Scheine und Münzen eintragen. Die Summe wird automatisch berechnet. Soll laut Kassenbuch (bestätigt): <b>' + M.euro(soll) + '</b></p>' + rows +
      '<div class="m-chk"><b style="flex:1">Summe</b><b id="stkTotal">0,00 €</b></div><p class="wm-note" id="stkDiff"></p><label class="m-f"><span>Notiz</span><input type="text" id="stknotiz"></label></div>' +
      '<div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="ksturzsave">Speichern</button></div>');
    var box = document.getElementById('stkBox'); stkUpd();
  }
  function stkUpd() { var box = document.getElementById('stkBox'); if (!box) return; var t = stkSum(box); var soll = stand(true); var d = Math.round((t - soll) * 100) / 100; document.getElementById('stkTotal').textContent = M.euro(t); document.getElementById('stkDiff').innerHTML = Math.abs(d) < 0.005 ? '<span class="m-ok">Stimmt mit dem Kassenbuch überein.</span>' : 'Differenz zum Soll: <b class="m-over">' + M.euro(d) + '</b>'; }
  document.addEventListener('input', function (e) { if (e.target && e.target.getAttribute && e.target.getAttribute('data-stk') !== null) stkUpd(); });
  function sturzSave() {
    var box = document.getElementById('stkBox'); if (!box) return; var stk = {}; Array.prototype.forEach.call(box.querySelectorAll('input[data-stk]'), function (i) { var n = Math.max(0, Math.floor(+i.value || 0)); if (n) stk[i.getAttribute('data-stk')] = n; });
    var soll = stand(true); var g = stkSum(box); var diff = Math.round((g - soll) * 100) / 100; var dat = document.getElementById('stkdat').value || M.today(); var nz = document.getElementById('stknotiz').value;
    M.closeDlg(); M.op({ op: 'set', coll: 'kasseSturz', item: { id: M.uid(), datum: dat, gezaehlt: g, soll: soll, diff: diff, stk: stk, notiz: nz, von: M.userName() } });
    M.toast(Math.abs(diff) < 0.005 ? 'Kasse stimmt.' : 'Differenz: ' + M.euro(diff));
  }
  function stkText(stk) { var o = []; STK.forEach(function (v) { if (stk && stk[v]) o.push(stk[v] + '× ' + String(v).replace('.', ',') + ' €'); }); return o.join(' · '); }
  function printBook() {
    var y = M.S.sub.by || String(new Date().getFullYear()); var c = cfg();
    var start = (c ? M.num(c.anfang) : 0);
    buchungen().forEach(function (b) { if (b.status === 'bestaetigt' && String(b.datum).slice(0, 4) < y) start += signed(b); });
    var s = start; var df = function (i) { return /^\d{4}-\d{2}-\d{2}$/.test(String(i)) ? String(i).split('-').reverse().join('.') : String(i || ''); };
    var list = buchungen().filter(function (b) { return b.status === 'bestaetigt' && String(b.datum).slice(0, 4) === y; }).sort(function (a, b) { return String(a.datum) < String(b.datum) ? -1 : String(a.datum) > String(b.datum) ? 1 : 0; });
    var rows = list.map(function (b) {
      var aus = b.typ === 'aus'; s += signed(b);
      return '<tr><td class="nowrap">' + esc(df(b.datum)) + '</td><td>' + esc(b.text || '') + '</td><td class="r ' + (aus ? 'neg' : 'pos') + '">' + (aus ? '– ' : '') + M.euro(b.betrag) + '</td><td class="c">' + esc(b.beleg || '') + '</td><td class="r">' + M.euro(s) + '</td></tr>';
    }).join('');
    var sturz = (M.items('kasseSturz') || []).filter(function (x) { return String(x.datum || '').slice(0, 4) === y; }).sort(function (a, b) { return String(b.datum) < String(a.datum) ? -1 : 1; })[0];
    var sturzHtml = '';
    if (sturz) { sturzHtml = '<div class="stk"><h3>Kassensturz am ' + esc(df(sturz.datum)) + '</h3><table class="kb"><thead><tr><th>Wert</th><th class="r">Anzahl</th><th class="r">Summe</th></tr></thead><tbody>' + STK.slice().sort(function (a, b) { return b - a; }).filter(function (v) { return sturz.stk && sturz.stk[v]; }).map(function (v) { return '<tr><td>' + M.euro(v) + '</td><td class="r">' + sturz.stk[v] + '</td><td class="r">' + M.euro(v * sturz.stk[v]) + '</td></tr>'; }).join('') + '<tr class="sum"><td colspan="2"><b>Summe gezählt</b></td><td class="r"><b>' + M.euro(sturz.gezaehlt) + '</b></td></tr></tbody></table>' + (sturz.notiz ? '<p>' + esc(sturz.notiz) + '</p>' : '') + '</div>'; }
    M.print('Kassenbuch Jugendkasse ' + y, '<table class="kb"><thead><tr><th style="width:14%">Datum</th><th>Verwendungszweck</th><th class="r">Wert</th><th class="c" style="width:12%">Rechnung</th><th class="r">Neuer Wert</th></tr></thead><tbody><tr><td class="nowrap">01.01.' + esc(y) + '</td><td>STAND</td><td></td><td></td><td class="r"><b>' + M.euro(start) + '</b></td></tr>' + rows + '</tbody></table>' + sturzHtml, { t2: 'Kassenbuch Jugendkasse ' + y, t3: 'nur bestätigte Buchungen · Stand ' + df(M.today()), css: '@page{size:A4;margin:12mm}.kb{border-collapse:collapse;width:100%}.kb th,.kb td{border:1px solid #cbd5e1;padding:4px 7px;font-size:12px}.kb th{background:#f1f5f9;text-align:left}.kb thead{display:table-header-group}.kb tr{page-break-inside:avoid}.kb .r{text-align:right;white-space:nowrap}.kb .c{text-align:center}.kb td.pos{background:#d1fae5;color:#065f46}.kb td.neg{background:#fee2e2;color:#991b1b}.kb tr.sum td{border-top:2px solid #333}.stk{margin-top:22px;page-break-inside:avoid}.stk h3{margin:0 0 6px;font-size:14px}.stk .kb{width:60%}' });
  }

  M.register('jugend', {
    title: 'Jugend', icon: '🏊', colls: ['abzeichen', 'abzListe', 'kasseBuchungen', 'kasseAuslagen', 'kasseCfg', 'kasseSturz', 'kasseBudgets', 'kasseAbschluss'],
    tabs: [abzTab, { id: 'kasse', label: '💶 Jugendkasse', view: ['jugend.kasse.view'], render: function () { return kasseTab(); } }],
    actions: {
      abzliste: function () { M.openForm({ title: 'Abzeichen-Liste', fields: [{ k: 'list', t: 'lines', label: 'Abzeichen (eins pro Zeile)', rows: 6 }], item: { list: abzList() }, onSave: function (v) { if (!v.list.length) { M.toast('Mindestens ein Abzeichen.'); return false; } M.op({ op: 'set', coll: 'abzListe', item: { id: 'main', list: v.list } }); } }); },
      kview: function (it, el) { M.S.sub.kv = el.getAttribute('data-v'); M.render(true); },
      kmon: function (it, el) { M.S.sub.km = shift(kmon(), +el.getAttribute('data-d')); M.render(true); },
      ksetup: function () { var c = cfg() || {}; M.openForm({ title: 'Kasse einrichten', fields: [{ k: 'anfang', t: 'num', label: 'Anfangsbestand (€)' }, { k: 'ort', t: 'text', label: 'Wo ist die Kasse?' }, { k: 'holder', t: 'text', label: 'Wer verwahrt sie?', list: 'mPeople' }, { k: 'seit', t: 'date', label: 'Seit' }, { k: 'kats', t: 'lines', label: 'Kategorien (eine pro Zeile)', rows: 6 }], item: { anfang: c.anfang || 0, ort: c.ort, holder: c.holder, seit: c.seit || M.today(), kats: c.kats && c.kats.length ? c.kats : DEF_KATS }, onSave: function (v) { M.op({ op: 'set', coll: 'kasseCfg', item: Object.assign({}, c, v, { id: 'main', anfang: M.num(v.anfang), ortLog: c.ortLog || [] }) }); } }); },
      kort: function () { var c = cfg(); if (!c) return; M.openForm({ title: 'Kasse übergeben / verlegt', fields: [{ k: 'ort', t: 'text', label: 'Neuer Ort', req: true }, { k: 'holder', t: 'text', label: 'Neue Verwahrung (Name)', req: true, list: 'mPeople' }, { k: 'seit', t: 'date', label: 'Seit' }], item: { ort: c.ort, holder: c.holder, seit: M.today() }, onSave: function (v) { var log = (c.ortLog || []).concat([{ ort: c.ort, holder: c.holder, seit: c.seit, bis: v.seit, by: M.userName() }]).slice(-20); M.op({ op: 'patch', coll: 'kasseCfg', id: 'main', fields: { ort: v.ort, holder: v.holder, seit: v.seit, ortLog: log } }); } }); },
      kbnew: function (it, el) { bookForm({ typ: el.getAttribute('data-typ') || 'ein', datum: M.today(), kat: kats()[0] }, true); },
      kbedit: function (it, el, ev, c) { var b = M.find('kasseBuchungen', c.id); if (b) bookForm(b, false); },
      kbdel: function (it, el, ev, c) { var b = M.find('kasseBuchungen', c.id); if (b) M.confirm('Buchung „' + (b.text || '') + '“ löschen?', 'Löschen', function () { M.op({ op: 'del', coll: 'kasseBuchungen', id: b.id }); }); },
      kbconf: function (it, el, ev, c) { M.op({ op: 'patch', coll: 'kasseBuchungen', id: c.id, fields: { status: el.getAttribute('data-s') } }); },
      kansend: function () { ansend(); },
      kaset: function (it, el, ev, c) {
        var a = M.find('kasseAuslagen', c.id); if (!a) return; var s = el.getAttribute('data-s'); var list = [{ op: 'patch', coll: 'kasseAuslagen', id: a.id, fields: { status: s } }];
        if (s === 'erstattet') {
          if (!canBook()) { M.toast('Zum Buchen fehlt das Recht.'); return; }
          list.push({ op: 'set', coll: 'kasseBuchungen', item: { id: M.uid(), typ: 'aus', betrag: M.num(a.betrag), datum: M.today(), kat: kats()[kats().length - 1], text: 'Erstattung: ' + (a.text || '') + (a.von ? ' (' + a.von + ')' : ''), beleg: a.beleg || '', status: 'bestaetigt', ref: a.id } });
        }
        M.ops(list);
      },
      kadel: function (it, el, ev, c) { M.confirm('Antrag löschen?', 'Löschen', function () { M.op({ op: 'del', coll: 'kasseAuslagen', id: c.id }); }); },
      ksturz: function () { sturzForm(); },
      ksturzsave: function () { sturzSave(); },
      kimport: function () { kimportOpen(); },
      kimportsave: function () { kimportSave(); },
      kabclose: function (it, el) { var mm = el.closest('[data-mm]').getAttribute('data-mm'); var s = stand(true, lastDay(mm)); M.confirm(M.monthLabel(mm) + ' abschließen? Saldo am Monatsende: ' + M.euro(s), 'Abschließen', function () { M.op({ op: 'set', coll: 'kasseAbschluss', item: { id: mm, saldo: s, by: M.userName(), at: M.today() } }); }); },
      kabopen: function (it, el) { var mm = el.closest('[data-mm]').getAttribute('data-mm'); M.confirm(M.monthLabel(mm) + ' wieder öffnen?', 'Öffnen', function () { M.op({ op: 'del', coll: 'kasseAbschluss', id: mm }); }); },
      kprint: function () { printBook(); }
    }
  });
})();
