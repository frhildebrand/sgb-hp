        });
      }).then(function (blob) {
        M.closeDlg(); var url = URL.createObjectURL(blob); var l = document.createElement('a'); l.href = url; l.download = 'Jugendkasse_' + D.y + (D.rows.length > per ? '_Seite' + (page + 1) : '') + '.xlsx'; document.body.appendChild(l); l.click(); setTimeout(function () { document.body.removeChild(l); URL.revokeObjectURL(url); }, 4000); M.toast('Excel-Datei erstellt.');
      }).catch(function (e) { M.toast('Excel konnte nicht erstellt werden.'); try { console.error(e); } catch (x) { } });
    });
  }

