  <main class="max-w-7xl mx-auto px-4 pt-6 space-y-6">
<!-- aushang.njk -->
<div id="viewAushang" class="space-y-6">

  <!-- Hinweis für Gast-Nutzer -->
  <div id="guestLockNotice" class="bg-amber-500/10 dark:bg-amber-950/40 border border-amber-500/30 rounded-2xl p-6 backdrop-blur-md shadow-sm flex items-start gap-4">
    <div class="text-3xl">🔒</div>
    <div class="space-y-1">
      <h3 class="font-bold text-base text-amber-700 dark:text-amber-400">Eingeschränkte Ansicht</h3>
      <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
        Du bist aktuell als <span class="font-black text-amber-600 dark:text-amber-300 px-1.5 py-0.5 bg-amber-500/20 rounded-md">GAST</span> angemeldet. Du kannst dich hier in die Listen eintragen. Für weitere Bereiche tippe oben rechts auf deinen Status und melde dich an.
      </p>
    </div>
  </div>

  <!-- Countdown (Datum stellt der Admin ein) -->
  <div id="aushangCountdown" class="hidden flex items-center gap-4 bg-amber-500/10 dark:bg-amber-950/40 border border-amber-500/30 rounded-2xl p-5 shadow-sm"></div>

  <!-- Infotext (Orga-Team ändert ihn, Standardtext vorhanden) -->
  <div id="aushangInfo" class="hidden flex items-start gap-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm"></div>

  <!-- Ankündigungen -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 border-l-4 border-l-amber-400 rounded-2xl px-5 py-4 shadow-sm">
    <div class="flex items-center gap-3 mb-1">
      <span class="text-2xl">📌</span>
      <h2 class="font-extrabold text-lg text-slate-800 dark:text-slate-100">Ankündigungen</h2>
    </div>
    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
      Hier trägst du dich für unseren Weihnachtsmarktstand ein: bei „Unterstützung vor Ort“ in ein Zeitfenster und beim Waffelteig auf einen freien Platz. Deinen Eintrag kannst du mit dem ✕ wieder entfernen. <span id="aushangPrintHint" class="hidden">Jede Liste lässt sich als DIN-A4-Blatt ausdrucken.</span>
    </p>
    <div id="aushangPrintAll" class="mt-3 hidden"><button type="button" onclick="printAushang('beide')" class="px-3 py-1.5 rounded-lg text-[11px] font-bold border bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200">🖨️ Beide Tage drucken</button></div>
  </div>

  <!-- Meine Schichten -->
  <div id="aushangMine" class="hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm"></div>

  <!-- Samstag & Sonntag -->
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
      <div class="flex justify-between items-center border-b border-slate-100 dark:border-slate-800 pb-3">
        <h3 class="font-black text-base text-amber-600 dark:text-amber-400 flex items-center gap-2"><span>📅</span> <span id="aushangTitleSamstag">Samstag</span></h3>
        <span class="text-xs font-semibold px-2.5 py-1 bg-amber-100 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 rounded-lg">Tag 1</span>
      </div>
      <div id="aushangListSamstag" class="space-y-4"></div>
      <div id="aushangScanSamstag" class="hidden space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">📄 Zusätzlicher Aushang</h4>
        <button type="button" onclick="openAushang('samstag')" class="block w-full text-left cursor-pointer" aria-label="Aushang Samstag vergrößern">
          <div class="relative w-full rounded-xl overflow-hidden bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700">
            <img id="aushangImgSamstag" alt="Aushang Samstag" class="hidden w-full max-h-96 object-contain bg-white">
          </div>
        </button>
        <p id="aushangHintSamstag" class="text-center text-[11px] font-medium text-slate-500 dark:text-slate-400">🔍 Tippen zum Vergrößern</p>
      </div>
    </div>
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
      <div class="flex justify-between items-center border-b border-slate-100 dark:border-slate-800 pb-3">
        <h3 class="font-black text-base text-sky-600 dark:text-sky-400 flex items-center gap-2"><span>📅</span> <span id="aushangTitleSonntag">Sonntag</span></h3>
        <span class="text-xs font-semibold px-2.5 py-1 bg-sky-100 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 rounded-lg">Tag 2</span>
      </div>
      <div id="aushangListSonntag" class="space-y-4"></div>
      <div id="aushangScanSonntag" class="hidden space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">📄 Zusätzlicher Aushang</h4>
        <button type="button" onclick="openAushang('sonntag')" class="block w-full text-left cursor-pointer" aria-label="Aushang Sonntag vergrößern">
          <div class="relative w-full rounded-xl overflow-hidden bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700">
            <img id="aushangImgSonntag" alt="Aushang Sonntag" class="hidden w-full max-h-96 object-contain bg-white">
          </div>
        </button>
        <p id="aushangHintSonntag" class="text-center text-[11px] font-medium text-slate-500 dark:text-slate-400">🔍 Tippen zum Vergrößern</p>
      </div>
    </div>
  </div>
</div>

<!-- login.njk -->
<div id="viewLogin" class="max-w-4xl mx-auto space-y-4 hidden">

  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-sm flex items-center gap-3">
    <span class="text-2xl">🔐</span>
    <div>
      <h2 class="font-black text-base text-slate-800 dark:text-slate-100">Anmelden</h2>
      <p class="text-[11px] text-slate-500 dark:text-slate-400">Mit dem Passwort einer Rolle oder persönlich mit Benutzername. Die Anmeldung bleibt auf diesem Gerät gespeichert.</p>
    </div>
  </div>

  <!-- Wer ist angemeldet -->
  <div id="loginStatus" class="hidden bg-emerald-500/10 border border-emerald-500/30 rounded-xl p-3 flex items-center justify-between gap-3">
    <span id="loginStatusText" class="text-xs font-bold text-emerald-700 dark:text-emerald-300"></span>
    <button type="button" onclick="logout()" class="px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold rounded-lg">Abmelden</button>
  </div>

  <!-- Fehlermeldung -->
  <div id="loginErrorMessage" class="hidden bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 p-3 rounded-xl text-xs font-bold flex items-center gap-3">
    <span>⚠️</span>
    <span id="loginErrorText">Falsche Anmeldedaten.</span>
  </div>

  <!-- Rollen (werden aus der Rollenverwaltung aufgebaut) -->
  <div id="loginRoleCards" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>

  <!-- Persönlich anmelden -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 shadow-sm space-y-3">
    <h3 class="font-bold text-sm text-slate-800 dark:text-slate-100 flex items-center gap-2"><span>👤</span> Persönlich anmelden</h3>
    <div class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-2">
      <input type="text" id="loginUserName" placeholder="Benutzername" autocomplete="username" class="w-full px-3 py-2 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-500" />
      <input type="password" id="loginUserPw" placeholder="Passwort" autocomplete="current-password" class="w-full px-3 py-2 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-500" />
      <button type="button" onclick="tryUserLogin()" class="px-5 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 text-sm font-bold rounded-lg transition-colors">Anmelden</button>
    </div>
  </div>

</div>

<!-- inventar.njk -->
<div id="viewInventar" class="hidden space-y-6">
<!-- Header / Navigations-Button & Admin Edit Toggle -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-md gap-4">
<div>
<h2 class="font-black text-xl text-amber-600 dark:text-amber-400 flex items-center gap-2">
📋 Inventar & Checkliste
</h2>
<p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Übersicht aller Gegenstände, Status und Packfortschritt</p>
</div>
<div class="flex items-center gap-2 self-end sm:self-center">
<!-- Edit Mode Toggle Button (Nur Admin/Orga) -->
<button id="adminInventarEditBtn" onclick="window.toggleEditMode()" class="hidden px-3.5 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold rounded-xl transition shadow-sm flex items-center gap-1.5">
✏️ Bearbeiten
</button>
<button onclick="switchView('aushang')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl transition border border-slate-300 dark:border-slate-700 flex items-center gap-2">
⬅️ Zurück zu Aushänge
</button>
</div>
</div>
<!-- Suchleiste, Farbige Filter-Pills & Fortschritts-Anzeige -->
<div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-md space-y-4">
<div class="flex flex-col md:flex-row justify-between items-stretch md:items-center gap-4">
<!-- Suchfeld -->
<div class="relative flex-1">
<span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 text-sm">🔍</span>
<input 
type="text" 
placeholder="Suche nach Name, Ort, Kiste..." 
oninput="window.handleInventarSearch(this.value)"
class="w-full pl-10 pr-4 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-amber-500 transition"
/>
</div>
<!-- Live-Fortschritt Text -->
<div class="text-right text-xs font-bold text-amber-600 dark:text-amber-400 whitespace-nowrap self-end md:self-center" id="inventarProgressText">
0% erledigt (0/0)
</div>
</div>
<!-- Dynamischer Container für Status-Filter Buttons (Wird von JS befüllt & aktualisiert) -->
<div id="filterButtonsContainer" class="flex flex-wrap gap-2 pt-2 border-t border-slate-200 dark:border-slate-800/60">
<!-- Wird durch window.updateFilterButtonsUI() gerendert -->
</div>
</div>
<!-- Container für die dynamischen Tabellen -->
<div id="inventarTablesContainer" class="space-y-6">
<div class="p-8 text-center text-slate-500 dark:text-slate-400 text-xs">Lade Inventardaten...</div>
</div>
</div>

<!-- verkauf.njk -->
<div id="viewVerkauf" class="hidden space-y-5 max-w-4xl mx-auto pb-20">

  <!-- Kopf: Titel, Live-Anzeige, Statistik (nur wer sie sehen darf) -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-3 flex-wrap">
      <h2 class="font-black text-xl text-amber-600 dark:text-amber-400">🪙 Kasse</h2>
      <span id="kasseSyncBadge" class="text-xs px-3 py-1 rounded-full font-bold border flex items-center gap-1.5 bg-slate-500/10 text-slate-500 dark:text-slate-300 border-slate-500/30">
        <span class="w-2.5 h-2.5 rounded-full bg-slate-400 animate-pulse"></span> Verbinde...
      </span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button id="kasseEditBtn" type="button" onclick="toggleKasseEdit()" class="hidden px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-xl border border-slate-300 dark:border-slate-700 transition">✏️ Zahlen korrigieren</button>
      <button id="kasseStatistikBtn" type="button" onclick="switchView('statistik')" class="hidden px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-xs rounded-xl shadow transition">📊 Statistik</button>
    </div>
  </div>

  <!-- Werkzeuge (je nach Recht) -->
  <div class="flex flex-wrap items-center gap-2">
    <button id="kasseSturzBtn" type="button" onclick="toggleSturz()" class="hidden px-4 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-xl border border-slate-300 dark:border-slate-700 transition">💰 Kassensturz</button>
    <button id="kasseCloseBtn" type="button" onclick="toggleDayClosed()" class="hidden px-4 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-xl border border-slate-300 dark:border-slate-700 transition">🔒 Tag abschließen</button>
    <button id="kassePracticeBtn" type="button" onclick="togglePractice()" class="hidden px-4 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-xl border border-slate-300 dark:border-slate-700 transition">🎓 Übungsmodus</button>
    <button id="kasseKioskBtn" type="button" onclick="startKiosk()" class="hidden px-4 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-xl border border-slate-300 dark:border-slate-700 transition">📌 Kiosk-Modus</button>
    <button id="kasseReportBtn" type="button" onclick="printTagesbericht()" class="hidden px-4 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-xl border border-slate-300 dark:border-slate-700 transition">📄 Tagesbericht</button>
  </div>
  <div id="kasseKioskHint" class="hidden text-[11px] font-semibold text-slate-500 dark:text-slate-400 text-center">📌 Kiosk-Modus. Zum Beenden den Titel oben 3 Sekunden gedrückt halten.</div>
  <div id="kasseBanner" class="hidden"></div>

  <!-- Tag wählen -->
  <div id="kasseDayTabs" class="grid grid-cols-2 gap-2 bg-slate-200/60 dark:bg-slate-900 p-1.5 rounded-2xl">
    <button id="kasseDayTabSamstag" type="button" onclick="setKasseDay('samstag')" class="py-3 rounded-xl text-sm font-black bg-amber-500 text-slate-950 shadow transition">📅 Samstag</button>
    <button id="kasseDayTabSonntag" type="button" onclick="setKasseDay('sonntag')" class="py-3 rounded-xl text-sm font-bold text-slate-600 dark:text-slate-300 transition">📅 Sonntag</button>
  </div>

  <!-- Produkte: werden aus der Produktliste aufgebaut (Punsch links, Waffeln rechts, weitere danach) -->
  <div id="kasseProducts" class="grid grid-cols-1 md:grid-cols-2 gap-5"></div>

  <!-- Kassensturz -->
  <div id="kasseSturzPanel" class="hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
    <div id="sturzRoot"></div>
  </div>

  <!-- Rückgängig-Leiste: erscheint nach jeder Buchung -->
  <div id="kasseUndoBar" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 pl-4 pr-2 py-2 rounded-2xl bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 shadow-2xl">
    <span id="kasseUndoText" class="text-xs font-bold"></span>
    <button type="button" onclick="undoKasse()" class="px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-black">↩ Rückgängig</button>
  </div>
</div>

<!-- statistik.njk -->
<div id="viewStatistik" class="hidden space-y-6">

