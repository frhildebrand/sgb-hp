</script>

<!-- Hintergrund und Fußzeile der ganzen Seite folgen dem gewählten Design -->
<style>
  html, body { background-color: #f1f5f9 !important; }
  html.dark, html.dark body { background-color: #020617 !important; color: #f8fafc; }
  html.dark .footer { background-color: #0b1120 !important; color: #cbd5e1 !important; }
  html.dark .footer a, html.dark .footer .menu-label { color: #94a3b8 !important; }
  html.dark .footer a:hover { color: #e2e8f0 !important; }
  html.dark .footer .has-text-grey { color: #94a3b8 !important; }
  html.dark .footer hr.has-background-grey-lighter { background-color: #1e293b !important; }
  /* Ueberschriften aller Ansichten: einheitlich gross und gut lesbar */
  main > div[id^="view"] h2 { font-size: 1.75rem; line-height: 2.15rem; }
  @media (min-width: 640px) { main > div[id^="view"] h2 { font-size: 2.1rem; line-height: 2.5rem; } }
  /* Kasse: kleine Rückmeldung beim Buchen */
  @keyframes kassePop { 0% { transform: scale(1); } 40% { transform: scale(1.25); } 100% { transform: scale(1); } }
  .kasse-pop { animation: kassePop .25s ease-out; }

  /* Drucken: nur das DIN-A4-Blatt (Aushang, Aufbauplan, Stromplan) */
  #printSheet { display: none; }
  @media print {
    @page { size: A4; margin: 14mm; }
    body > *:not(#printSheet) { display: none !important; }
    html, body { background: #fff !important; }
    #printSheet { display: block !important; color: #000; background: #fff; font-family: Arial, Helvetica, sans-serif; font-size: 11pt; }
    #printSheet h1 { font-size: 24pt; font-weight: 400; margin: 0; }
    #printSheet h2 { font-size: 16pt; font-weight: 400; margin: 12pt 0 4pt; }
    #printSheet h3 { font-size: 12pt; margin: 10pt 0 2pt; }
    #printSheet .ps-head { display: flex; justify-content: space-between; align-items: flex-start; }
    #printSheet .ps-head img { max-height: 20mm; max-width: 45mm; }
    #printSheet .ps-page { page-break-after: always; page-break-inside: avoid; }
    #printSheet .ps-page:last-child { page-break-after: auto; }
    #printSheet table { width: 100%; border-collapse: collapse; margin-top: 4pt; }
    #printSheet th, #printSheet td { border: 1px solid #000; padding: 5pt 6pt; text-align: left; vertical-align: top; }
    #printSheet th { background: #eee; font-weight: 700; }
    #printSheet .ps-slots td, #printSheet .ps-teig td { padding: 3pt 6pt; box-sizing: border-box; }
    #printSheet table { page-break-inside: avoid; }
    #printSheet .ps-slots .c1 { width: 24%; }
    #printSheet .ps-slots .c3 { width: 20%; }
    #printSheet .ps-teig td { width: 50%; }
    #printSheet .ps-img { page-break-inside: avoid; margin: 6pt 0; }
    #printSheet .ps-img img { max-width: 100%; max-height: 120mm; }
    #printSheet svg { max-width: 100%; height: auto; }
  }


  /* Platzhalter beim Laden */
  .wm-skel { background: linear-gradient(90deg, rgba(148,163,184,.16), rgba(148,163,184,.34), rgba(148,163,184,.16)); background-size: 200% 100%; animation: wmShimmer 1.4s linear infinite; border-radius: 14px; }
  @keyframes wmShimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .wm-skel { animation: none; } }
  /* Handy: Tabellen werden zu Karten (Spaltentitel stehen als data-label an jeder Zelle) */
  @media (max-width: 639px) {
    #viewAushang table, #viewInventar table, #viewEinkaufsliste table, #viewLagerbestand table { display: block; width: 100% !important; table-layout: auto; }
    #viewAushang colgroup, #viewInventar colgroup, #viewEinkaufsliste colgroup, #viewLagerbestand colgroup { display: none; }
    #viewAushang thead, #viewInventar thead, #viewEinkaufsliste thead, #viewLagerbestand thead { display: none; }
    #viewAushang tbody, #viewInventar tbody, #viewEinkaufsliste tbody, #viewLagerbestand tbody { display: block; }
    #viewAushang tr, #viewInventar tr, #viewEinkaufsliste tr, #viewLagerbestand tr { display: block; margin: 8px 0; padding: 8px 12px; border: 1px solid rgba(148,163,184,.35); border-radius: 14px; }
    #viewAushang td, #viewInventar td, #viewEinkaufsliste td, #viewLagerbestand td { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: auto !important; padding: 5px 0 !important; text-align: right !important; border: 0 !important; }
    #viewAushang td[data-label]::before, #viewInventar td[data-label]::before, #viewEinkaufsliste td[data-label]::before, #viewLagerbestand td[data-label]::before { content: attr(data-label); flex: 0 0 auto; font-size: 10px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #64748b; text-align: left; }
  }

  /* ===== Design: Nachtblau, Tannengrün-Kopfzeile, Akzentfarbe je Seite ===== */
  #appBody { position: relative; padding-bottom: 80px !important; background-color: #dbe9f6 !important; background-repeat: repeat, no-repeat !important; background-position: 0 0, 0 0 !important; background-size: 700px 700px, 100% 100% !important; background-image: url(data:image/svg+xml;base64,), linear-gradient(180deg, #b6d0ea 0%, #d9e8f7 38%, #eff6fc 70%, #ffffff 100%) !important; }
  .dark #appBody { background-color: #07101f !important; background-image: url(data:image/svg+xml;base64,), linear-gradient(180deg, #07101f 0%, #0b1b33 55%, #0a1a2e 100%) !important; }
  /* Kopfzeile in dunklem Tannengrün mit Sharks-Logo als Home-Taste */
  #portalHeader { background: linear-gradient(135deg, #052b27, #0a4a40 55%, #07353a) !important; border-bottom: 4px solid #d6a23a !important; box-shadow: 0 8px 20px rgba(0,0,0,.35); }
  #portalHeader #headerTitle { color: #fff !important; font-family: ui-rounded, 'SF Pro Rounded', system-ui, sans-serif; letter-spacing: .2px; }
  #portalHeader button { background: rgba(255,255,255,.14) !important; border: 1px solid rgba(255,255,255,.24) !important; color: #fff !important; }
  #portalHeader button:hover { background: rgba(255,255,255,.22) !important; }
  #portalHeader #themeToggleLabel { color: #fff !important; }
  #portalHeader #homeBtn { width: 50px; height: 50px; border-radius: 15px; padding: 0; }
  #portalHeader #homeBtn img { height: 32px; width: auto; display: block; }
  /* Seitenfarben */
  #viewAushang { --acc: #ef4444; --acc2: #b91c1c; --accs: rgba(239,68,68,.14); }
  #viewLogin { --acc: #f0bd4f; --acc2: #d6a23a; --accs: rgba(240,189,79,.16); }
  #viewStatus { --acc: #94a3b8; --acc2: #64748b; --accs: rgba(148,163,184,.14); }
  #viewProtokoll { --acc: #94a3b8; --acc2: #64748b; --accs: rgba(148,163,184,.14); }
  #viewInventar { --acc: #8b5cf6; --acc2: #6d28d9; --accs: rgba(139,92,246,.15); }
  #viewVerkauf { --acc: #f0bd4f; --acc2: #d6a23a; --accs: rgba(240,189,79,.16); }
  #viewStatistik { --acc: #6366f1; --acc2: #4338ca; --accs: rgba(99,102,241,.15); }
  #viewEinkaufsliste { --acc: #a78bfa; --acc2: #7c3aed; --accs: rgba(167,139,250,.15); }
  #viewVerkabelung { --acc: #f97316; --acc2: #c2410c; --accs: rgba(249,115,22,.15); }
  #viewLagerbestand { --acc: #0ea5e9; --acc2: #0369a1; --accs: rgba(14,165,233,.15); }
  #viewBoxenuebersicht { --acc: #c58a3a; --acc2: #8a5a14; --accs: rgba(197,138,58,.16); }
  #viewRezepte { --acc: #f43f5e; --acc2: #be123c; --accs: rgba(244,63,94,.14); }
  #viewAdminpanel { --acc: #94a3b8; --acc2: #64748b; --accs: rgba(148,163,184,.14); }
  #viewAufbau { --acc: #3b82f6; --acc2: #1d4ed8; --accs: rgba(59,130,246,.15); }
  #viewLeihgaben { --acc: #14b8a6; --acc2: #0f766e; --accs: rgba(20,184,166,.15); }
  #viewHilfe { --acc: #38bdf8; --acc2: #0284c7; --accs: rgba(56,189,248,.15); }

  /* Seitenkopf: ruhige Karte mit Akzentstreifen und Symbolfeld */
  [id^="view"] > div:first-child:not(#aushangInfo):not(#aushangCountdown):not(#guestLockNotice):not(.wm-nohead) { border-radius: 24px !important; border: 1px solid rgba(148,163,184,.30) !important; border-left: 7px solid var(--acc, #94a3b8) !important; background-image: linear-gradient(135deg, var(--accs, rgba(148,163,184,.12)), transparent 60%) !important; box-shadow: 0 10px 28px rgba(15,23,42,.10) !important; }
  .dark [id^="view"] > div:first-child:not(#aushangInfo):not(#aushangCountdown):not(#guestLockNotice):not(.wm-nohead) { background-color: rgba(10,28,50,.92) !important; border-color: rgba(148,163,184,.22) !important; border-left-color: var(--acc, #94a3b8) !important; box-shadow: 0 10px 28px rgba(0,0,0,.35) !important; }
