      </span>
    </div>
    <button type="button" onclick="switchView('verkauf')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl transition border border-slate-300 dark:border-slate-700">🪙 Zur Kasse</button>
  </div>

  <!-- Samstag links, Sonntag rechts -->
