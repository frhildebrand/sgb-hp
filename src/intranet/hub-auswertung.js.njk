    return by;
  }
  function age(o, j) { return +j - o.jg; }
  function defBands(j) { var y = +j; return [['Junior (Jg. ' + (y - 15) + ' und älter)', 0, y - 15], ['Jahrgang ' + (y - 14) + '/' + (y - 13), y - 14, y - 13], ['Jahrgang ' + (y - 12) + '/' + (y - 11), y - 12, y - 11], ['Jahrgang ' + (y - 10) + '/' + (y - 9), y - 10, y - 9], ['Jahrgang ' + (y - 8) + '/' + (y - 7), y - 8, y - 7], ['Jahrgang ' + (y - 6) + ' und jünger', y - 6, 9999]]; }
  function bandList(j) { var b = (cfg().bands || {})[j]; if (Array.isArray(b) && b.length) return b.map(function (x) { return [x.l, +x.von || 0, +x.bis || 9999]; }); return defBands(j); }
  function mastersAb() { var m = +cfg().masters; return m > 0 ? m : 25; }
  function bands(j) { return bandList(j).map(function (b) { return [b[0], function (o) { return o.jg >= b[1] && o.jg <= b[2]; }]; }); }
  function groups(j) {
    var g = [['Gesamt', function () { return true; }], ['Weiblich', function (o) { return o.sex === 'W'; }], ['Männlich', function (o) { return o.sex === 'M'; }], ['Jugend', function (o) { return age(o, j) < mastersAb(); }], ['Masters', function (o) { return age(o, j) >= mastersAb(); }]];
    return g.concat(bands(j));
  }
  function filt(l, j, name) { var f = groups(j).filter(function (g) { return g[0] === name; })[0]; return f ? l.filter(f[1]) : l; }
  function rows(l, n, j) { var sc = starts(j || year()); return l.slice(0, n || l.length).map(function (o, i) { var st = sc[o.name.toLowerCase()] || []; var wks = {}; st.forEach(function (x) { wks[x.wk] = 1; }); return '<tr><td>' + (i + 1) + '</td><td class="nowrap"><b>' + esc(o.name) + '</b></td><td>' + o.jg + '</td><td>' + esc(o.sex) + '</td><td>' + (st.length ? Object.keys(wks).length : '–') + '</td><td>' + (st.length || '–') + '</td><td>' + o.n + '</td><td><b>' + o.ges + '</b></td><td>' + o.avg + '</td></tr>'; }).join(''); }
  var HEAD = '<tr><th>Platz</th><th>Schwimmer</th><th>Jg.</th><th>M/W</th><th>Veranst.</th><th>Starts</th><th>Strecken</th><th>Punkte</th><th>Ø</th></tr>';
  function bahnSel(s) { return '<div class="m-chips">' + [['best', 'Beste Wertung'], ['Lang', 'Langbahn'], ['Kurz', 'Kurzbahn']].map(function (x) { return '<button type="button" class="m-chip' + (s.sb === x[0] ? ' on' : '') + '" data-ma="ausb" data-v="' + x[0] + '">' + x[1] + '</button>'; }).join('') + '</div>'; }
  function yearSel(j) { var ys = years(); if (!ys.length) return ''; return '<div class="m-chips">' + ys.map(function (y) { return '<button type="button" class="m-chip' + (y === j ? ' on' : '') + '" data-ma="ausj" data-v="' + y + '">' + y + '</button>'; }).join('') + '</div>'; }
  function leer() { return '<section class="wm-card"><p class="wm-note">Es gibt noch keine Punkte. Im Reiter „Hochladen“ zuerst die World-Aquatics-Basiszeiten einlesen. Dann rechnet das Intranet die Punkte aus den eingelesenen Wettkampfergebnissen selbst aus. Alternativ kannst du die WebClub-Liste „Punktbeste Leistung nach World Aquatics“ hochladen.</p></section>'; }
  function waInfo() {
