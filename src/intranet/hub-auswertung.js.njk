      '<div class="m-fgrid"><label class="m-f"><span>Saison</span><input type="number" id="au_j" value="' + yy + '" min="2000" max="2100"></label><label class="m-f"><span>Bahn</span><select id="au_b"><option value="Lang">Langbahn (50 m)</option><option value="Kurz">Kurzbahn (25 m)</option></select></label><label class="m-f wide"><span>PDF-Datei</span><input type="file" id="au_f" accept="application/pdf,.pdf"></label></div><div class="m-btns"><button type="button" class="wm-amber" data-ma="ausread">Vorschau erstellen</button></div><div id="au_msg" class="wm-sub" style="margin-top:8px"></div></section>' +
