      '<section class="wm-card"><div class="wm-bar"><h3>Gruppen festlegen</h3><span class="m-actions"><button type="button" class="wm-btn" data-ma="ausbands">✏️ Jahrgangsgruppen</button></span></div><p class="wm-note">Hier legst du fest, welche Jahrgänge zu einer Gruppe zählen und ab welchem Alter jemand zu den Masters gehört (jetzt ab ' + mastersAb() + ' Jahren). Das gilt für alle Schwimmer der Punkteliste.</p></section>' +
      '<section class="wm-card"><div class="wm-bar"><h3>Vorhandene Listen</h3></div>' + (have.length ? have.map(function (x) { return '<div class="m-chk" data-id="' + esc(x.id) + '"><span style="flex:1"><b>' + esc(x.jahr) + ' · ' + (x.bahn === 'Lang' ? 'Langbahn' : 'Kurzbahn') + '</b> <span class="wm-sub">' + (x.rows || []).length + ' Schwimmer · hochgeladen ' + M.fmtDate(x.stand) + '</span></span>' + (M.anyCan(['auswertung.upload']) ? '<button type="button" class="wm-btn m-danger" data-ma="ausdel">🗑️</button>' : '') + '</div>'; }).join('') : '<p class="wm-note">Noch nichts hochgeladen.</p>') + '</section>';
  }
  function read() {
    var f = document.getElementById('au_f').files[0], msg = document.getElementById('au_msg'); if (!f) { msg.textContent = 'Bitte zuerst eine PDF-Datei auswählen.'; return; }
    var j = document.getElementById('au_j').value, b = document.getElementById('au_b').value;
    msg.textContent = 'Wird gelesen … (beim ersten Mal wird der PDF-Leser geladen)';
    HubPdf.read(f).then(function (r) {
      var p = P.parsePunkte(r.pages); if (!p.rows.length) { msg.innerHTML = '<span class="m-over">' + esc(p.warnings.join(' ')) + '</span>'; return; }
      UP = { j: j, b: b, p: p, f: f }; var top = p.rows.slice().sort(function (a, c) { return c.ges - a.ges; })[0]; var have = !!pset(j, b);
      M.openDlg('<div class="hub-dhead"><h3>Das wurde gefunden</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div>' + (p.warnings.length ? '<div class="hub-err">' + p.warnings.slice(0, 6).map(esc).join('<br>') + '</div>' : '') +
        '<p class="wm-note"><b>' + p.rows.length + '</b> Schwimmer · Saison in der Datei: <b>' + esc(p.saison || '?') + '</b> · gewählt: <b>' + esc(j) + ' ' + (b === 'Lang' ? 'Langbahn' : 'Kurzbahn') + '</b><br>Beste Punktzahl: ' + esc(top.name) + ' (' + top.ges + ')</p>' + (p.saison && p.saison !== String(j) ? '<div class="hub-err">Die Datei gehört zur Saison ' + esc(p.saison) + ', gewählt ist ' + esc(j) + '. Bitte prüfen.</div>' : '') + (have ? '<p class="wm-note">Für diese Saison und Bahn gibt es schon eine Liste. Sie wird ersetzt.</p>' : '') +
        '<div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="aussave">Übernehmen</button></div>');
    }, function (e) { msg.innerHTML = '<span class="m-over">' + esc(e.message || String(e)) + '</span>'; });
  }
  function save() {
    if (!UP) return; var u = UP; UP = null; M.closeDlg();
    M.op({ op: 'set', coll: 'saison', item: { id: 'ps-' + u.j + '-' + u.b.toLowerCase(), jahr: String(u.j), bahn: u.b, rows: u.p.rows, stand: M.today(), datei: u.f.name } });
    var s = sub(); s.sj = String(u.j); M.toast('Punkteliste übernommen.');
  }
  var WU = null;
  function waRead() {
    var fl = document.getElementById('wa_f').files, msg = document.getElementById('wa_msg'); if (!fl.length) { msg.textContent = 'Bitte zuerst Datei(en) auswählen.'; return; }
    msg.textContent = 'Wird gelesen … (bei PDFs wird beim ersten Mal der PDF-Leser geladen)';
    var names = [], jobs = Array.prototype.map.call(fl, function (f) {
      names.push(f.name);
      if (/\.pdf$/i.test(f.name) || f.type === 'application/pdf') return HubPdf.read(f).then(function (r) { var o = WAPunkte.out(); WAPunkte.addPdf(o, WAPunkte.parsePdf(r.lines, f.name), f.name); return WAPunkte.finish(o); });
      return HubPdf.text(f).then(function (t) { return WAPunkte.parseCsv(t); });
    });
    Promise.all(jobs).then(function (rs) {
      var m = WAPunkte.merge(rs); WU = { m: m, names: names }; msg.textContent = '';
      var ex = {}; waSets().forEach(function (x) { ex[x.id] = 1; });
      var body = '<div class="hub-dhead"><h3>Das wurde gefunden</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div>';
      if (m.errors.length) body += '<div class="hub-err"><b>Das stimmt nicht, deshalb wird nichts übernommen:</b><br>' + m.errors.slice(0, 12).map(esc).join('<br>') + (m.errors.length > 12 ? '<br>… und ' + (m.errors.length - 12) + ' weitere' : '') + '</div>';
      if (m.warnings.length) body += '<div class="hub-err">' + m.warnings.map(esc).join('<br>') + '</div>';
      if (m.list.length && !m.errors.length) body += m.list.map(function (s, i) {
        var id = 'wa-' + s.course.toLowerCase() + '-' + s.jahr;
        return '<div class="m-chk" style="display:block"><b>' + WAPunkte.CN[s.course] + ' ' + esc(s.jahr) + '</b> <span class="wm-sub">' + s.count + ' Zeiten' + (ex[id] ? ' · ersetzt die vorhandenen' : '') + '</span><div class="m-fgrid" style="margin-top:6px"><label class="m-f"><span>Gültig ab</span><input type="date" id="wa_v' + i + '" value="' + esc(s.von) + '"></label><label class="m-f"><span>Gültig bis</span><input type="date" id="wa_b' + i + '" value="' + esc(s.bis) + '"></label></div></div>';
      }).join('');
      else if (!m.errors.length) body += '<p class="wm-note">Keine Basiszeiten gefunden.</p>';
      body += '<div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">' + (m.errors.length ? 'Schließen' : 'Abbrechen') + '</button>' + (m.errors.length || !m.list.length ? '' : '<button type="button" class="hub-btn hub-gold" data-ma="wasave">Übernehmen</button>') + '</div>';
      M.openDlg(body);
    }, function (e) { msg.innerHTML = '<span class="m-over">' + esc(e.message || String(e)) + '</span>'; });
  }
  function waSave() {
    if (!WU) return; var w = WU, ops = [];
    for (var i = 0; i < w.m.list.length; i++) {
      var s = w.m.list[i], v = document.getElementById('wa_v' + i).value, b = document.getElementById('wa_b' + i).value;
      if (!v || !b || v > b) { M.toast('Bitte bei ' + WAPunkte.CN[s.course] + ' ' + s.jahr + ' das Gültigkeitsdatum prüfen (ab muss vor bis liegen).'); return; }
      ops.push({ op: 'set', coll: 'saison', item: { id: 'wa-' + s.course.toLowerCase() + '-' + s.jahr, kind: 'wa', bahn: s.course === 'SCM' ? 'Kurz' : 'Lang', jahr: s.jahr, von: v, bis: b, t: s.t, stand: M.today(), datei: w.names.join(', ') } });
    }
    WU = null; M.closeDlg(); M.ops(ops); M.toast('Basiszeiten übernommen.');
  }
  function printRang() {
    var j = year(), s = sub(), l = table(j, s.sb);
    var body = '<h1>Jahresauswertung ' + esc(j) + '</h1><div class="sub">' + (s.sb === 'best' ? 'Punktbeste Leistung aus Lang- und Kurzbahn' : s.sb === 'Lang' ? 'Langbahn' : 'Kurzbahn') + '</div>';
    groups(j).forEach(function (g) { var c = filt(l, j, g[0]); if (!c.length) return; body += '<h2 style="break-after:avoid">' + esc(g[0]) + '</h2><table>' + HEAD + rows(c) + '</table>'; });
    M.print('Jahresauswertung ' + j, body);
  }
  function printSheets(list, j) {
    var body = list.map(function (o, i) { return '<div style="' + (i ? 'page-break-before:always' : '') + '">' + sheetHtml(o, j) + '</div>'; }).join('');
    M.print('Jahresauswertung ' + j, body, { t2: 'Jahresauswertung ' + j, t3: '', css: '.ausk td{background:#eef1f6}' });
  }
  M.register('auswertung', {
    onChange: function (ev) { if (ev.target && ev.target.id === 'au_sp') { sub().sp = ev.target.value; M.render(true); } },
    title: 'Jahresauswertung', icon: '🏆', colls: ['saison', 'wgMitglieder', 'wettkaempfe'],
    tabs: [{ id: 'rang', label: 'Rangliste', view: ['auswertung.view'], render: rangliste }, { id: 'einzel', label: 'Einzelblatt', view: ['auswertung.view'], render: einzel }, { id: 'ehr', label: 'Ehrungen', view: ['auswertung.view'], render: ehrungen }, { id: 'up', label: 'Hochladen', view: ['auswertung.upload'], render: hochladen }],
    actions: {
      ausj: function (it, el) { sub().sj = el.getAttribute('data-v'); M.render(true); },
      ausb: function (it, el) { sub().sb = el.getAttribute('data-v'); M.render(true); },
      ausg: function (it, el) { sub().sg = el.getAttribute('data-v'); M.render(true); },
      ausread: read, aussave: save,
      waread: waRead, wasave: waSave,
      wadel: function (it, el, ev, c) { var id = c.id || el.closest('[data-id]').getAttribute('data-id'); M.confirm('Diese Basiszeiten löschen? Die Punkte für Wettkämpfe in diesem Zeitraum entfallen dann.', 'Löschen', function () { M.op({ op: 'del', coll: 'saison', id: id }); }); },
      ausjub: function () {
        var f = document.getElementById('au_jf').files[0]; var j = year(); if (!f) { M.toast('Bitte zuerst eine PDF-Datei auswählen.'); return; }
        HubPdf.read(f).then(function (r) {
          var rows = []; r.lines.forEach(function (l) { var m = /^\s*(\d{1,2})\s+([A-Za-zäöüÄÖÜß-]+)\s+(\S.*?)\s*$/.exec(l); if (m && +m[1] > 0) rows.push({ jahre: +m[1], art: m[2], name: m[3] }); });
          if (!rows.length) { M.toast('Keine Jubilare gefunden. Ist das die Liste „Jubiläum im aktuellen Jahr“?'); return; }
          M.op({ op: 'set', coll: 'saison', item: { id: 'jub-' + j, jahr: String(j), rows: rows, stand: M.today() } }); M.toast(rows.length + ' Jubilare für ' + j + ' übernommen.');
        }, function (e) { M.toast(e.message || 'Datei konnte nicht gelesen werden.'); });
      },
      ausbands: function () {
        var j = year(); var txt = bandList(j).map(function (b) { return b[0] + ' | ' + (b[1] || '') + '-' + (b[2] >= 9999 ? '' : b[2]); }).join('\n');
        M.openForm({ title: 'Jahrgangsgruppen ' + j, fields: [{ k: 'masters', t: 'num', label: 'Masters ab Alter' }, { k: 'txt', t: 'area', rows: 9, label: 'Eine Gruppe pro Zeile', hint: 'Schreibweise: Name | Jahrgang von - bis. Offen lassen heißt „und älter“ bzw. „und jünger“. Beispiel: Jahrgang 2013/2014 | 2013-2014' }], item: { masters: mastersAb(), txt: txt }, onSave: function (v) {
          var out = []; String(v.txt || '').split(/\n/).forEach(function (l) { var m = /^\s*(.+?)\s*\|\s*(\d{0,4})\s*-\s*(\d{0,4})\s*$/.exec(l); if (m) out.push({ l: m[1], von: m[2] ? +m[2] : 0, bis: m[3] ? +m[3] : 9999 }); });
          var c = Object.assign({}, cfg(), { id: 'cfg', masters: +v.masters || 25 }); c.bands = Object.assign({}, c.bands || {}); if (out.length) c.bands[j] = out; else delete c.bands[j];
          M.op({ op: 'set', coll: 'saison', item: c }); M.toast('Gruppen gespeichert.');
        } });
      },
      ausdel: function (it, el, ev, c) { var id = c.id || el.closest('[data-id]').getAttribute('data-id'); M.confirm('Diese Punkteliste löschen?', 'Löschen', function () { M.op({ op: 'del', coll: 'saison', id: id }); }); },
      ausprint: printRang,
      ausone: function () { var j = year(), s = sub(); var o = table(j, 'best').filter(function (x) { return x.name === s.sp; })[0]; if (o) printSheets([o], j); },
      ausallsheets: function () { var j = year(); printSheets(table(j, 'best').slice().sort(function (a, b) { return a.name.localeCompare(b.name, 'de'); }), j); }
    }
  });
})();
