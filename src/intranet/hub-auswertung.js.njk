        HubPdf.read(f).then(function (r) {
          var rows = []; r.lines.forEach(function (l) { var m = /^\s*(\d{1,2})\s+([A-Za-zäöüÄÖÜß-]+)\s+(\S.*?)\s*$/.exec(l); if (m && +m[1] > 0) rows.push({ jahre: +m[1], art: m[2], name: m[3] }); });
          if (!rows.length) { M.toast('Keine Jubilare gefunden. Ist das die Liste „Jubiläum im aktuellen Jahr“?'); return; }
          M.op({ op: 'set', coll: 'saison', item: { id: 'jub-' + j, jahr: String(j), rows: rows, stand: M.today() } }); M.toast(rows.length + ' Jubilare für ' + j + ' übernommen.');
        }, function (e) { M.toast(e.message || 'Datei konnte nicht gelesen werden.'); });
      },
      ausbands: function () {
        var j = year(); var txt = bandList(j).map(function (b) { return b[0] + ' | ' + (b[1] || '') + '-' + (b[2] >= 9999 ? '' : b[2]); }).join('\n');
        M.openForm({ title: 'Jahrgangsgruppen ' + j, fields: [{ k: 'masters', t: 'num', label: 'Masters ab Alter' }, { k: 'txt', t: 'area', rows: 9, label: 'Eine Gruppe pro Zeile', hint: 'Schreibweise: Name | Jahrgang von - bis. Offen lassen heißt „und älter“ bzw. „und jünger“. Beispiel: Jahrgang 2013/2014 | 2013-2014' }], item: { masters: mastersAb(), txt: txt }, onSave: function (v) {
          var out = []; String(v.txt || '').split(/\n/).forEach(function (l) { var m = /^\s*(.+?)\s*\|\s*(\d{0,4})\s*-\s*(\d{0,4})\s*$/.exec(l); if (m) out.push({ l: m[1], von: m[2] ? +m[2] : 0, bis: m[3] ? +m[3] : 9999 }); });
          var c = Object.assign({}, cfg(), { id: 'cfg', masters: +v.masters || 25 }); c.bands = Object.assign({}, c.bands || {}); if (out.length) c.bands[j] = out; else delete c.bands[j];
          M.op({ op: 'set', coll: 'saison', item: c }); M.toast('Gruppen gespeichert.');
        } });
      },
      ausdel: function (it, el, ev, c) { var id = c.id || el.closest('[data-id]').getAttribute('data-id'); M.confirm('Diese Punkteliste löschen?', 'Löschen', function () { M.op({ op: 'del', coll: 'saison', id: id }); }); },
      ausprint: printRang,
      ausone: function () { var j = year(), s = sub(); var o = table(j, 'best').filter(function (x) { return x.name === s.sp; })[0]; if (o) printSheets([o], j); },
      ausallsheets: function () { var j = year(); printSheets(table(j, 'best').slice().sort(function (a, b) { return a.name.localeCompare(b.name, 'de'); }), j); }
    }
  });
})();
