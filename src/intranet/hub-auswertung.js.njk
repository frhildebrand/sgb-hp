        var o = by[n] || (by[n] = { name: x.nm, jg: x.jg, sex: x.sx, p: {}, l: {}, k: {} }); var tg = bn === 'Lang' ? o.l : o.k;
        if (!(tg[x.k] >= x.pt)) tg[x.k] = x.pt; if (!(o.p[x.k] >= x.pt)) o.p[x.k] = x.pt;
      });
    });
    var l = Object.keys(by).map(function (k) { var o = by[k]; o.n = Object.keys(o.p).length; o.ges = 0; Object.keys(o.p).forEach(function (s) { o.ges += o.p[s]; }); o.avg = o.n ? Math.round(o.ges / o.n) : 0; return o; });
