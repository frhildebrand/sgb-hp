  // WebClub-Punkteliste als CSV: Kopfzeile „Schwimmer;Jg;M/W;50S;…;Gesamt“, Titelzeile mit „Saison 2026“
  function parsePunkteCsv(text) {
    var rows = [], warnings = [], saison = '', head = null, cols = [];
    String(text || '').replace(/^\uFEFF/, '').split(/\r?\n/).forEach(function (raw, i) {
      if (!raw.trim()) return; var f = raw.split(';').map(function (x) { return x.trim(); });
      if (!head) {
        var m = /Saison\s+(\d{4})/.exec(raw); if (m) saison = m[1];
        if (/^Schwimmer$/i.test(f[0])) { head = f; f.forEach(function (c, k) { if (k >= 3 && c && !/^Gesamt$/i.test(c)) { if (/^\d+[SRBFL]$/.test(c)) cols.push([k, c]); else warnings.push('Unbekannte Spalte „' + c + '“ wird ignoriert.'); } }); }
        return;
      }
      if (!f[0]) return; var jg = +f[1], sx = (f[2] || '').toUpperCase();
      if (!(jg > 1900 && jg < 2100)) { warnings.push('Zeile ' + (i + 1) + ' (' + f[0] + '): Jahrgang „' + f[1] + '“ ist nicht lesbar.'); }
      if (sx !== 'M' && sx !== 'W') { warnings.push('Zeile ' + (i + 1) + ' (' + f[0] + '): Geschlecht „' + f[2] + '“ ist nicht M oder W.'); }
      var o = { name: f[0], jg: jg || 0, sex: sx, p: {}, ges: 0 };
      cols.forEach(function (c) { var v = +(f[c[0]] || 0); if (v > 0) { o.p[c[1]] = v; o.ges += v; } });
      var gi = head.map(function (c) { return /^Gesamt$/i.test(c); }).indexOf(true);
      if (gi >= 0 && f[gi] !== '' && +f[gi] !== o.ges) warnings.push(f[0] + ': Gesamt ' + f[gi] + ' passt nicht zur Summe der Strecken (' + o.ges + ').');
      rows.push(o);
    });
    if (!head) warnings.push('Die Kopfzeile „Schwimmer;Jg;M/W;…“ wurde nicht gefunden. Ist das die Liste „Punktbeste Leistung nach World Aquatics“?');
    return { rows: rows, warnings: warnings, saison: saison };
  }
