/* Schwarzes Brett: Mitteilungen für den ganzen Verein. Verfassen und pflegen nur mit dem Recht „startseite.brett“. */
(function () {
  'use strict';
  var M = window.HubMod; if (!M) return; var esc = M.esc, HB = window.HubBrett, HR = window.HubRich;
  function can() { return M.anyCan(['startseite.brett']); }
  function canDel() { return M.anyCan(['brett.loeschen']) || can(); }
  function fd(d) { return d ? M.fmtDate(d) : ''; }
  function sortAll(l) { return l.slice().sort(function (a, b) { var oa = typeof a.ord === 'number' ? a.ord : -1, ob = typeof b.ord === 'number' ? b.ord : -1; return (b.wichtig ? 1 : 0) - (a.wichtig ? 1 : 0) || oa - ob || String(b.date || '').localeCompare(String(a.date || '')); }); }
  function live() { return sortAll(M.items('brett').filter(function (b) { return !HB.expired(b); })); }
  function archive() { return sortAll(M.items('brett').filter(function (b) { return HB.expired(b); })); }
  function groups() { var s = {}; M.items('wgMitglieder').forEach(function (m) { (m.gruppen || []).forEach(function (g) { s[g] = 1; }); }); return Object.keys(s).sort(function (a, b) { return a.localeCompare(b, 'de'); }); }
  function acts(b, up, dn) {
    return '<td class="a"><div>' + (up !== null ? '<button type="button" class="hub-bx" data-ma="bbup" data-id="' + esc(b.id) + '" aria-label="Nach oben"' + (up ? '' : ' disabled') + '>▲</button><button type="button" class="hub-bx" data-ma="bbdn" data-id="' + esc(b.id) + '" aria-label="Nach unten"' + (dn ? '' : ' disabled') + '>▼</button>' : '') +
      '<button type="button" class="hub-bx" data-ma="bbedit" data-id="' + esc(b.id) + '" aria-label="Bearbeiten">✏️</button>' + (canDel() ? '<button type="button" class="hub-bx" data-ma="bbdel" data-id="' + esc(b.id) + '" aria-label="Löschen">🗑️</button>' : '') + '</div></td>';
  }
  function row(b, up, dn) {
    var at = HB.audText(b);
    return '<tr' + (b.wichtig ? ' class="imp"' : '') + '><td>' + esc(b.by || '') + '</td><td>' + esc(fd(b.date)) + '</td><td class="m"' + (HR.okBg(b.bg) ? ' style="background:' + HR.okBg(b.bg) + '"' : '') + '><b>' + (b.wichtig ? '📣 ' : '') + esc(b.title) + '</b>' + (HB.isNew(b) ? '<span class="hub-new">NEU</span>' : '') + (at ? '<span class="hub-lock">🔒 ' + esc(at) + '</span>' : '') + HR.show(b) + (b.until ? '<span class="hub-lock">sichtbar bis ' + esc(fd(b.until)) + '</span>' : '') + '</td>' + (can() ? acts(b, up, dn) : '') + '</tr>';
  }
  function render() {
    var l = live(), ar = can() ? archive() : [];
    var out = '<section class="wm-card"><div class="wm-bar"><h3>📌 Schwarzes Brett</h3>' + (can() ? '<button type="button" class="wm-amber" data-ma="bbnew">+ Neue Mitteilung</button>' : '') + '</div>' +
      '<p class="wm-note">Mitteilungen für den ganzen Verein. ' + (can() ? 'Du darfst Einträge verfassen und ändern' + (canDel() ? ' und löschen.' : '.') : 'Verfasst werden sie vom Vorstand und der Orga.') + '</p></section>';
    if (!l.length) out += '<section class="wm-card"><p class="wm-note">Zurzeit gibt es keine Mitteilungen.</p></section>';
    else out += '<section class="wm-card"><div class="hub-bwrap"><table class="hub-bt"><tr><th>Von</th><th>Datum</th><th>Mitteilung</th>' + (can() ? '<th></th>' : '') + '</tr>' + l.map(function (b, i) {
      return row(b, i > 0 && !!l[i - 1].wichtig === !!b.wichtig, i < l.length - 1 && !!l[i + 1].wichtig === !!b.wichtig);
    }).join('') + '</table></div></section>';
    if (ar.length) out += '<section class="wm-card"><details><summary style="cursor:pointer;font-weight:800">🗄️ Archiv · abgelaufen (' + ar.length + ')</summary><p class="wm-note">Nur für Verfasser:innen sichtbar. Mit ✏️ und neuem „Sichtbar bis“-Datum wieder hervorholen.</p><div class="hub-bwrap"><table class="hub-bt"><tr><th>Von</th><th>Datum</th><th>Mitteilung</th><th></th></tr>' + ar.map(function (b) { return row(b, null, null); }).join('') + '</table></div></details></section>';
    return out;
  }
  function form(item, title) {
    var x = item || {}; M.openDlg('<div class="hub-dhead"><h3>' + esc(title) + '</h3><button type="button" class="hub-btn hub-ghost" data-ma="dclose">✕</button></div>' +
      '<div class="m-fgrid"><label class="m-f"><span>Überschrift</span><input type="text" id="bb_t" maxlength="120" value="' + esc(x.title || '') + '"></label><label class="m-f"><span>Datum</span><input type="date" id="bb_d" value="' + esc(x.date || M.today()) + '"></label></div>' +
      '<div style="margin-top:10px"><div style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;opacity:.7;margin-bottom:4px">Mitteilung</div>' + HR.editor(x.html || HR.plain(x.text || ''), x.bg) + '</div>' +
      '<label class="m-chk" style="margin-top:8px"><input type="checkbox" id="bb_w"' + (x.wichtig ? ' checked' : '') + '> 📣 Wichtig (steht automatisch ganz oben)</label>' + HB.picker(x, groups()) +
      '<div class="ha-actions"><button type="button" class="hub-btn hub-ghost" data-ma="dclose">Abbrechen</button><button type="button" class="hub-btn hub-gold" data-ma="bbsave" data-id="' + esc(x.id || '') + '">Speichern</button></div>');
  }
  function openForm(item, title) { form(item, title); HB.loadRoles(function () { var d = document.getElementById('mDlg'), box = d && d.querySelector('.hub-aud'); if (box && !box.querySelector('input[data-bb=r]')) box.outerHTML = HB.picker(Object.assign({}, item || {}, HB.read(d) ), groups()); }); }
  function move(id, dir) {
    var l = live(), ix = l.map(function (b) { return b.id; }).indexOf(id), jx = ix + dir;
    if (ix < 0 || jx < 0 || jx >= l.length || !!l[jx].wichtig !== !!l[ix].wichtig) return;
    var t = l[ix]; l[ix] = l[jx]; l[jx] = t; M.op({ op: 'order', coll: 'brett', ids: l.map(function (b) { return b.id; }) });
  }
  M.register('brett', {
    title: 'Schwarzes Brett', icon: '📌', colls: ['brett', 'wgMitglieder'],
    tabs: [{ id: 'brett', label: 'Mitteilungen', view: ['brett.view', 'startseite.brett'], render: render }],
    actions: {
      bbnew: function () { openForm({}, 'Neue Mitteilung'); },
      bbsave: function (it, el) {
        var t = (document.getElementById('bb_t') || {}).value || ''; t = t.trim(); if (!t) { M.toast('Bitte eine Überschrift eingeben.'); return; }
        var dlg = document.getElementById('mDlg'), rv = HR.val(dlg), pk = HB.read(dlg), old = el.getAttribute('data-id') ? M.find('brett', el.getAttribute('data-id')) : null, d = (document.getElementById('bb_d') || {}).value;
        var n = Object.assign({}, old || {}, { title: t, text: rv.text, html: rv.html, bg: rv.bg, wichtig: !!(document.getElementById('bb_w') || {}).checked, date: /^\d{4}-\d{2}-\d{2}$/.test(d || '') ? d : M.today(), until: pk.until, aud: pk.aud });
        if (!n.id) { n.id = M.uid(); n.ts = Date.now(); } if (!n.by) n.by = M.userName();
        M.closeDlg(); M.op({ op: 'set', coll: 'brett', item: n });
      },
      bbedit: function (it, el, ev, c) { var b = M.find('brett', c.id); if (b) openForm(b, 'Mitteilung bearbeiten'); },
      bbup: function (it, el, ev, c) { move(c.id, -1); },
      bbdn: function (it, el, ev, c) { move(c.id, 1); },
      bbdel: function (it, el, ev, c) { var b = M.find('brett', c.id); if (b) M.confirm('„' + b.title + '“ löschen?', 'Löschen', function () { M.op({ op: 'del', coll: 'brett', id: b.id }); }); }
    }
  });
  setTimeout(HB.markSeen, 4000);            // „Neu“-Markierung bleibt für diesen Besuch sichtbar
})();
