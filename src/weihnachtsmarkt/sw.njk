/* Offline-Start fuer das Weihnachtsmarkt-Portal.
   Seite und Bausteine werden zwischengespeichert. Die Daten kommen weiter vom Google-Script und werden hier nie gespeichert. */
const VERSION = 'wm-shell-12';

self.addEventListener('install', function () {
  self.skipWaiting();
});

self.addEventListener('activate', function (event) {
  event.waitUntil((async function () {
    const keys = await caches.keys();
    await Promise.all(keys.filter(function (k) { return k.indexOf('wm-shell-') === 0 && k !== VERSION; }).map(function (k) { return caches.delete(k); }));
    await self.clients.claim();
  })());
});

async function cacheUrls(urls) {
  const cache = await caches.open(VERSION);
  await Promise.all(urls.slice(0, 150).map(async function (u) {
    try {
      const same = new URL(u).origin === self.location.origin;
      const req = new Request(u, { mode: same ? 'same-origin' : 'no-cors', credentials: 'omit' });
      const res = await fetch(req);
      if (res && (res.ok || res.type === 'opaque')) await cache.put(req, res);
    } catch (e) { /* egal */ }
  }));
}

self.addEventListener('message', function (event) {
  const d = event.data || {};
  if (d.type === 'cache-urls') event.waitUntil(cacheUrls(d.urls || []));
  if (d.type === 'clear') event.waitUntil(caches.keys().then(function (ks) { return Promise.all(ks.filter(function (k) { return k.indexOf('wm-shell-') === 0; }).map(function (k) { return caches.delete(k); })); }));
});

// Erst das Netz (mit kurzer Wartezeit, damit schlechtes WLAN nicht haengt), sonst der Zwischenspeicher
async function networkFirst(req) {
  const cache = await caches.open(VERSION);
  try {
    const res = await Promise.race([
      fetch(req),
      new Promise(function (_, reject) { setTimeout(function () { reject(new Error('timeout')); }, 5000); })
    ]);
    if (res && (res.ok || res.type === 'opaque')) cache.put(req, res.clone());
    return res;
  } catch (err) {
    let hit = await cache.match(req, { ignoreSearch: req.mode === 'navigate' });
    if (!hit && req.mode === 'navigate') hit = await cache.match('/weihnachtsmarkt/', { ignoreSearch: true });
    if (hit) return hit;
    throw err;
  }
}

self.addEventListener('fetch', function (event) {
  const req = event.request;
  if (req.method !== 'GET' || req.headers.has('range')) return;
  const url = new URL(req.url);
  if (url.protocol !== 'https:' && url.protocol !== 'http:') return;
  if (/(^|\.)script\.google(usercontent)?\.com$/.test(url.hostname)) return;   // Daten nie zwischenspeichern
  if (req.mode === 'navigate' && url.pathname.indexOf('/weihnachtsmarkt') !== 0) return;
  event.respondWith(networkFirst(req));
});
