<!-- Design vor dem ersten Zeichnen setzen (Auto = Geräteeinstellung), damit nichts aufblitzt -->
<script>
  (function () {
    try {
      var m = localStorage.getItem('themeMode');
      var dark = m === 'dark' || (m !== 'light' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', dark);
    } catch (e) {}
  })();
</script>
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    darkMode: 'class'
  }
</script>

<!-- Hintergrund und Fußzeile der ganzen Seite folgen dem gewählten Design -->
<style>
  html, body { background-color: #f1f5f9 !important; }
  html.dark, html.dark body { background-color: #020617 !important; color: #f8fafc; }
  html.dark .footer { background-color: #0b1120 !important; color: #cbd5e1 !important; }
  html.dark .footer a, html.dark .footer .menu-label { color: #94a3b8 !important; }
  html.dark .footer a:hover { color: #e2e8f0 !important; }
  html.dark .footer .has-text-grey { color: #94a3b8 !important; }
  html.dark .footer hr.has-background-grey-lighter { background-color: #1e293b !important; }
  /* Kasse: kleine Rückmeldung beim Buchen */
  @keyframes kassePop { 0% { transform: scale(1); } 40% { transform: scale(1.25); } 100% { transform: scale(1); } }
  .kasse-pop { animation: kassePop .25s ease-out; }

  /* Drucken: nur das DIN-A4-Blatt (Aushang, Aufbauplan, Stromplan) */
  #printSheet { display: none; }
  @media print {
    @page { size: A4; margin: 14mm; }
    body > *:not(#printSheet) { display: none !important; }
    html, body { background: #fff !important; }
    #printSheet { display: block !important; color: #000; background: #fff; font-family: Arial, Helvetica, sans-serif; font-size: 11pt; }
    #printSheet h1 { font-size: 24pt; font-weight: 400; margin: 0; }
    #printSheet h2 { font-size: 16pt; font-weight: 400; margin: 18pt 0 6pt; }
    #printSheet h3 { font-size: 12pt; margin: 10pt 0 2pt; }
    #printSheet .ps-head { display: flex; justify-content: space-between; align-items: flex-start; }
    #printSheet .ps-head img { max-height: 32mm; max-width: 55mm; }
    #printSheet .ps-page { page-break-after: always; }
    #printSheet .ps-page:last-child { page-break-after: auto; }
    #printSheet table { width: 100%; border-collapse: collapse; margin-top: 4pt; }
    #printSheet th, #printSheet td { border: 1px solid #000; padding: 5pt 6pt; text-align: left; vertical-align: top; }
    #printSheet th { background: #eee; font-weight: 700; }
    #printSheet .ps-slots td { height: 17mm; }
    #printSheet .ps-slots .c1 { width: 24%; }
    #printSheet .ps-slots .c3 { width: 20%; }
    #printSheet .ps-teig td { width: 50%; height: 8mm; }
    #printSheet .ps-img { page-break-inside: avoid; margin: 6pt 0; }
    #printSheet .ps-img img { max-width: 100%; max-height: 120mm; }
    #printSheet svg { max-width: 100%; height: auto; }
  }
</style>

