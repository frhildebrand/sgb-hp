    {% include "weihnachtsmarkt/views/einkaufsliste.njk" %}
    {% include "weihnachtsmarkt/views/verkabelung.njk" %}
    {% include "weihnachtsmarkt/views/lagerbestand.njk" %}
    {% include "weihnachtsmarkt/views/boxen.njk" %}
    {% include "weihnachtsmarkt/views/rezepte.njk" %}
    {% include "weihnachtsmarkt/views/aufbau.njk" %}
