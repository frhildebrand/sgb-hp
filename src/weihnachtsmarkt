<div class="max-w-4xl mx-auto px-4 py-8">
  <!-- Progress Header -->
  <div class="bg-gradient-to-r from-emerald-900 to-green-950 text-amber-300 border border-amber-500/40 rounded-2xl p-6 text-center shadow-xl mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2">🎄 SG Barnstorf – Weihnachtsmarkt</h1>
    <p class="text-emerald-200/80 text-sm sm:text-base mb-4">Fortschritt eurer Standvorbereitung</p>
    
    <!-- Progress Bar -->
    <div class="w-full bg-emerald-950 rounded-full h-6 border border-emerald-800 overflow-hidden relative shadow-inner">
      <div id="progressBar" class="bg-gradient-to-r from-amber-400 to-amber-300 h-full w-0 transition-all duration-300"></div>
      <div id="progressText" class="absolute inset-0 flex items-center justify-center text-xs font-bold text-slate-900">0% erledigt</div>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="flex flex-col sm:flex-row gap-3 mb-6">
    <input type="text" id="searchInput" placeholder="🔍 Gegenstand oder To-Do suchen..." 
      class="flex-1 bg-slate-900/90 border border-slate-700 text-slate-100 placeholder-slate-400 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-amber-400 transition" />
    <div class="flex gap-2">
      <button onclick="setFilter('all', this)" class="filter-btn active flex-1 sm:flex-none px-4 py-3 rounded-xl border border-amber-400 bg-amber-400 text-slate-950 font-bold text-sm">Alle</button>
      <button onclick="setFilter('open', this)" class="filter-btn flex-1 sm:flex-none px-4 py-3 rounded-xl border border-slate-700 bg-slate-900 text-slate-300 font-medium text-sm">Offen</button>
      <button onclick="setFilter('done', this)" class="filter-btn flex-1 sm:flex-none px-4 py-3 rounded-xl border border-slate-700 bg-slate-900 text-slate-300 font-medium text-sm">Erledigt</button>
    </div>
  </div>

  <!-- Checklist Container -->
  <div id="checklist" class="space-y-6"></div>

  <!-- Reset Button -->
  <div class="text-center mt-10">
    <button onclick="resetAll()" class="text-red-400 hover:text-red-300 border border-red-500/30 hover:border-red-500/60 bg-red-950/20 px-4 py-2 rounded-lg text-xs font-medium transition">
      ⚠️ Alle Häkchen auf diesem Gerät zurücksetzen
    </button>
  </div>
</div>

<style>
  .task-card {
    transition: all 0.2s ease;
  }
  .task-card.completed {
    opacity: 0.5;
  }
  .task-card.completed .task-title {
    text-decoration: line-through;
  }
  .checkbox-custom::after {
    content: '✓';
    font-weight: bold;
    color: #0f1c15;
    display: none;
  }
  .task-card.completed .checkbox-custom {
    background-color: #f59e0b;
    border-color: #f59e0b;
  }
  .task-card.completed .checkbox-custom::after {
    display: block;
  }
</style>

<script>
  const itemsData = [
    // Orga
    { id: 1, cat: "🏛️ Orga & Anträge", title: "Anmeldung Gemeinde", details: "Teilnahmebestätigung vorab sichern" },
    { id: 2, cat: "🏛️ Orga & Anträge", title: "Anzeige Gaststättengewerbe", details: "Erforderliche Anträge einreichen" },
    { id: 3, cat: "🏛️ Orga & Anträge", title: "Hütte Gemeinde", details: "Aufbauort, Tag & Uhrzeit genau abklären" },
    { id: 4, cat: "🏛️ Orga & Anträge", title: "Helfer- & Teiglisten (Reshop)", details: "Unterstützung & Schichten koordinieren" },
    
    // Strom & Technik
    { id: 5, cat: "⚡ Strom, Licht & Aufbau", title: "Einkochautomaten / Punschkocher (2x)", details: "Vorab auf Funktion prüfen" },
    { id: 6, cat: "⚡ Strom, Licht & Aufbau", title: "Waffeleisen (3x)", details: "2x SG + 1x KE" },
    { id: 7, cat: "⚡ Strom, Licht & Aufbau", title: "Wasserkocher", details: "Für Heißwasser / schnelle Reinigung" },
    { id: 8, cat: "⚡ Strom, Licht & Aufbau", title: "Lichterketten (Kurz, Lang, Sterne)", details: "2 Sterne, 4 normale (2 kurz / 2 lang)" },
    { id: 9, cat: "⚡ Strom, Licht & Aufbau", title: "Mehrfachsteckdosen (3er & 5er)", details: "Für hohe Watt-Zahlen geeignet" },
    { id: 10, cat: "⚡ Strom, Licht & Aufbau", title: "Verlängerungskabel (3m & Outdoor)", details: "Laufwege beachten" },
    
    // Werkzeug
    { id: 11, cat: "🛠️ Werkzeug & Befestigung", title: "Werkzeugkiste", details: "Hammer, Schraubendreher, Nagelzange, Seitenschneider, Schere" },
    { id: 12, cat: "🛠️ Werkzeug & Befestigung", title: "Befestigungsmaterial", details: "Kabelbinder, Draht, Heftzwecken, Kreppband, Nägel, Schrauben" },
    { id: 13, cat: "🛠️ Werkzeug & Befestigung", title: "Beleuchtung & Sonstiges", details: "Taschenlampe / Kopflampe, Feuerzeug" },

    // Stand & Deko
    { id: 14, cat: "✨ Stand-Deko & Atmosphäre", title: "SG Barnstorf Banner", details: "Gut sichtbar aufhängen" },
    { id: 15, cat: "✨ Stand-Deko & Atmosphäre", title: "Stehtische mit Tischdecken", details: "Inkl. Servietten & Kerzengläser" },
    { id: 16, cat: "✨ Stand-Deko & Atmosphäre", title: "Kerzen in größeren Gläsern", details: "Windgeschützt (gehen sonst aus) + Teelichter" },
    { id: 17, cat: "✨ Stand-Deko & Atmosphäre", title: "Bodenschutz / Teppich / Malervlies", details: "Gegen kalte Füße im Stand" },
    { id: 18, cat: "✨ Stand-Deko & Atmosphäre", title: "Deko & Zubehör", details: "Keksteller, Rezeptzettel, Weihnachtsmützen" },

    // Zutaten Punsch
    { id: 19, cat: "☕ Zutaten & Zubehör Punsch", title: "Säfte & Tee", details: "Apfelsaft (2,5l), Roter Traubensaft (2,5l), Orangensaft (1l), Wintertee (10 Btl)" },
    { id: 20, cat: "☕ Zutaten & Zubehör Punsch", title: "Gewürze & Zutaten", details: "Glühfix (5 Btl), Zimtstangen (2 Stk)" },
    { id: 21, cat: "☕ Zutaten & Zubehör Punsch", title: "Ausschank & Becher", details: "Thermobecher / Becher, Punschkelle (Spaghettikelle), Suppenkellen" },

    // Zutaten Waffeln
    { id: 22, cat: "🧇 Zutaten & Zubehör Waffeln", title: "Teig & Zutaten", details: "Waffelteig-Spenden, Öl, Puderzucker, Spekulatius" },
    { id: 23, cat: "🧇 Zutaten & Zubehör Waffeln", title: "Waffel-Utensilien", details: "Teigkellen, Holzgabeln, Ölpinsel inkl. Flasche, Sieb für Puderzucker" },

    // Hygiene & Reinigung
    { id: 24, cat: "🧹 Hygiene, Reinigung & Müll", title: "Reinigungsmittel", details: "Spülmittel, Lappen, Geschirrhandtücher, Küchenrolle, Waschlappen" },
    { id: 25, cat: "🧹 Hygiene, Reinigung & Müll", title: "Müllentsorgung", details: "Mülltüten, Steckmülleimer" },
    { id: 26, cat: "🧹 Hygiene, Reinigung & Müll", title: "Sauberkeit & Schutz", details: "Schüssel zum Lappen waschen, Kehrblech & Handfeger, Einmalhandschuhe" },

    // Kasse
    { id: 27, cat: "💶 Kasse, Preise & Finanzen", title: "Kasse & Wechselgeld", details: "Geldtasche / Kasse mit Kleingeld-Reserve" },
    { id: 28, cat: "💶 Kasse, Preise & Finanzen", title: "Preisschilder & Spenden", details: "Preisschilder Waffeln & Punsch (DIN A4), Spendenente" }
  ];

  let completedTasks = JSON.parse(localStorage.getItem('sg_wm_tasks')) || [];
  let currentFilter = 'all';

  function saveState() {
    localStorage.setItem('sg_wm_tasks', JSON.stringify(completedTasks));
    updateProgress();
  }

  function toggleTask(id) {
    if (completedTasks.includes(id)) {
      completedTasks = completedTasks.filter(item => item !== id);
    } else {
      completedTasks.push(id);
    }
    saveState();
    renderChecklist();
  }

  function updateProgress() {
    const total = itemsData.length;
    const count = completedTasks.length;
    const percent = Math.round((count / total) * 100);
    
    document.getElementById('progressBar').style.width = percent + '%';
    document.getElementById('progressText').innerText = `${percent}% erledigt (${count}/${total})`;
  }

  function setFilter(filter, btn) {
    currentFilter = filter;
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.remove('bg-amber-400', 'text-slate-950', 'border-amber-400', 'font-bold');
      b.classList.add('bg-slate-900', 'text-slate-300', 'border-slate-700', 'font-medium');
    });
    btn.classList.remove('bg-slate-900', 'text-slate-300', 'border-slate-700', 'font-medium');
    btn.classList.add('bg-amber-400', 'text-slate-950', 'border-amber-400', 'font-bold');
    renderChecklist();
  }

  function renderChecklist() {
    const searchVal = document.getElementById('searchInput').value.toLowerCase();
    const container = document.getElementById('checklist');
    container.innerHTML = '';

    const categories = [...new Set(itemsData.map(item => item.cat))];

    categories.forEach(cat => {
      const catItems = itemsData.filter(item => {
        const matchesCat = item.cat === cat;
        const matchesSearch = item.title.toLowerCase().includes(searchVal) || item.details.toLowerCase().includes(searchVal);
        const isDone = completedTasks.includes(item.id);
        
        let matchesFilter = true;
        if (currentFilter === 'open') matchesFilter = !isDone;
        if (currentFilter === 'done') matchesFilter = isDone;

        return matchesCat && matchesSearch && matchesFilter;
      });

      if (catItems.length > 0) {
        const catBox = document.createElement('div');
        
        const catTitle = document.createElement('h2');
        catTitle.className = 'text-lg font-bold text-amber-400 mb-3 flex items-center gap-2';
        catTitle.innerText = cat;
        catBox.appendChild(catTitle);

        const taskList = document.createElement('div');
        taskList.className = 'grid grid-cols-1 gap-2.5';

        catItems.forEach(item => {
          const isDone = completedTasks.includes(item.id);
          const card = document.createElement('div');
          card.className = `task-card ${isDone ? 'completed' : ''} bg-slate-900/80 border border-slate-800 hover:border-amber-500/50 rounded-xl p-3.5 flex items-start gap-3 cursor-pointer select-none`;
          card.onclick = () => toggleTask(item.id);

          card.innerHTML = `
            <div class="checkbox-custom w-6 h-6 border-2 border-amber-400 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5"></div>
            <div class="flex-1">
              <div class="task-title font-semibold text-slate-100 text-sm sm:text-base">${item.title}</div>
              <div class="text-xs sm:text-sm text-slate-400 mt-0.5">${item.details}</div>
            </div>
          `;
          taskList.appendChild(card);
        });

        catBox.appendChild(taskList);
        container.appendChild(catBox);
      }
    });
  }

  function resetAll() {
    if (confirm("Möchtest du wirklich alle abgehakten Punkte zurücksetzen?")) {
      completedTasks = [];
      saveState();
      renderChecklist();
    }
  }

  document.getElementById('searchInput').addEventListener('input', renderChecklist);
  document.addEventListener('DOMContentLoaded', () => {
    renderChecklist();
    updateProgress();
  });
</script>
