---
layout: base.njk
heading: Aktuelle News
---

<div class="columns is-multiline">
  {%- for post in collections.news | reverse -%}
    <div class="column is-4-desktop is-12-tablet">
      <div class="card">
        <div class="card-image">
          <a href="{{ post.url }}">
            <figure class="image is-3by2">
              <img
                src="{{ post.data.image | default('/images/news/placeholder.png') }}"
                alt="{{ post.data.heading }}"
              />
            </figure>
          </a>
        </div>
        <div class="card-content">
          <div class="content">
            <p class="title is-5 mb-2">{{ post.data.newsTitle }}</p>
            <p class="subtitle is-7 mb-4">{{ post.data.date | dateFilter }}</p>
            {{ post.data.excerpt }}
          </div>
        </div>
        <footer class="card-footer">
          <a href="{{ post.url }}" class="card-footer-item">
            <span>Mehr lesen</span>
            <span class="icon is-small ml-2">
              <i class="fas fa-arrow-circle-right"></i>
            </span>
          </a>
        </footer>
      </div>
    </div>
  {% else %}
    <p>Keine News gefunden.</p>
  {%- endfor -%}
</div>
