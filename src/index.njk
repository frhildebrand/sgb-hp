---
layout: base.njk
heroSubtitle: "Seit 1972 mit euch im Wasser"
---

<section class="section">
  <h2 class="title is-2">News</h2>
  <div class="columns is-multiline">
    {% for post in collections.news | reverse %}
      {% if loop.index0 < 3 %}
        <div class="column is-4-desktop is-12-tablet is-flex">
          <div
            class="card is-flex is-flex-direction-column"
            style="width: 100%;"
          >
            <div class="card-image">
              <a href="{{ post.url }}">
                <figure class="image is-3by2">
                  <img
                    src="{{ post.data.preview | default('/images/news/placeholder.png') }}"
                    alt="{{ post.data.heading }}"
                    style="object-fit: cover;"
                  />
                </figure>
              </a>
            </div>
            <div class="card-content is-flex-grow-1">
              <div class="content">
                <p class="title is-5 mb-2">{{ post.data.heading }}</p>
                <div
                  class="is-flex is-justify-content-space-between is-align-items-center mb-4"
                >
                  <p class="subtitle is-7 mb-0">
                    {{ post.data.date | dateFilter }}
                  </p>
                  <div class="tags">
                    {% for tag in post.data.tags %}
                      <a
                        href="/tags/{{ tag | slugify }}/"
                        class="tag is-primary is-light is-small"
                        ><span class="icon is-small mr-1"
                          ><i class="fas fa-tag"></i></span
                        >{{ tag }}</a
                      >
                    {% endfor %}
                  </div>
                </div>
                {{ post.data.excerpt }}
              </div>
            </div>
            <footer class="card-footer">
              <a href="{{ post.url }}" class="card-footer-item">
                <span>Mehr lesen</span>
                <span class="icon is-small ml-2">
                  <i class="fas fa-arrow-circle-right"></i>
                </span>
              </a>
            </footer>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="section">
  <h2 class="title is-2">Trainingszeiten</h2>

  <div class="grid is-col-min-10">
    {% for gruppe in training.zeiten %}
      <article class="message is-primary">
        <div class="message-header">
          <p>{{ gruppe.name }}</p>
        </div>
        <div class="message-body">
          <ul>
            {% for termin in gruppe.termine %}
              <li><strong>{{ termin.tag }}:</strong> {{ termin.zeit }}</li>
            {% endfor %}
          </ul>
        </div>
      </article>
    {% endfor %}
  </div>
</section>
