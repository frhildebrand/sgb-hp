---
layout: base.njk
heroSubtitle: "Seit 1972 mit euch im Wasser"
---

<section class="section">
  <h2 class="title is-2">News</h2>
  <div class="columns is-multiline">
    {% for item in collections.news | reverse %}
      {% if loop.index0 < 3 %}
        <div class="column is-4-desktop is-12-tablet is-flex">
          <div
            class="card is-flex is-flex-direction-column"
            style="width: 100%;"
          >
            <div class="card-image">
              <a href="{{ item.url }}">
                <figure class="image is-3by2">
                  <img
                    src="{{ item.data.image | default('/images/news/placeholder.png') }}"
                    alt="{{ item.data.heading }}"
                    style="object-fit: cover;"
                  />
                </figure>
              </a>
            </div>
            <div class="card-content is-flex-grow-1">
              <div class="content">
                <p class="title is-5 mb-2">{{ item.data.newsTitle }}</p>
                <p class="subtitle is-7 mb-4">
                  {{ item.data.date | dateFilter }}
                </p>
                {{ item.data.excerpt }}
              </div>
            </div>
            <footer class="card-footer">
              <a href="{{ item.url }}" class="card-footer-item">
                <span>Mehr lesen</span>
                <span class="icon is-small ml-2">
                  <i class="fas fa-arrow-circle-right"></i>
                </span>
              </a>
            </footer>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="section">
  <h2 class="title is-2">Trainingszeiten</h2>

  <div class="grid is-col-min-10">
    {% for gruppe in training.zeiten %}
      <article class="message is-primary">
        <div class="message-header">
          <p>{{ gruppe.name }}</p>
        </div>
        <div class="message-body">
          <ul>
            {% for termin in gruppe.termine %}
              <li><strong>{{ termin.tag }}:</strong> {{ termin.zeit }}</li>
            {% endfor %}
          </ul>
        </div>
      </article>
    {% endfor %}
  </div>
</section>
