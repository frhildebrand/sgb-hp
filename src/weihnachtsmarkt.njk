<!-- Modal: Strom & Modularer Verkabelungs-Planer (Dynamic Multi-Instance Items) -->
<div id="wiringModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white border border-slate-200 rounded-2xl max-w-6xl w-full max-h-[92vh] flex flex-col shadow-2xl">
    <div class="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between bg-sky-50 rounded-t-2xl">
      <div>
        <h2 class="text-lg font-bold text-sky-900 flex items-center gap-2">⚡ Modularer Strom- & Kabel-Planer (3 Stromeingänge)</h2>
        <p class="text-xs text-sky-700 mt-0.5">Dynamische Anzahl aller Geräte & Kabel gemäß Mengen-Eingabe verteilen!</p>
      </div>
      <button onclick="closeWiringModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">✕</button>
    </div>

    <div class="p-4 sm:p-6 overflow-y-auto space-y-6 text-xs sm:text-sm">
      
      <!-- Unassigned Pool -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="font-bold text-slate-900 text-sm mb-2 flex items-center gap-2">🔌 Nicht zugewiesene Geräte & Kabel (Hier herausziehen):</h3>
        <div id="unassignedPool" ondragover="allowDrop(event)" ondrop="drop(event, 'unassigned')" class="flex flex-wrap gap-2 min-h-[50px] p-2 bg-white rounded-lg border border-dashed border-slate-300"></div>
      </div>

      <!-- Modular 3 Outlets / Sockets Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <!-- Outlet 1 -->
        <div class="bg-sky-50/50 border border-sky-200 rounded-xl p-4 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-2">
              <h4 class="font-bold text-sky-900 text-sm flex items-center gap-1.5">🔌 Steckdose 1</h4>
              <span id="socket1Watts" class="px-2 py-0.5 rounded bg-sky-100 text-sky-900 font-bold font-mono text-xs">0 W / 0,0 A</span>
            </div>
            
            <!-- Cable Attachment Selector & Cable Max Power -->
            <div class="mb-3 space-y-1.5 bg-white p-2.5 rounded-lg border border-sky-100">
              <label class="block text-[11px] font-semibold text-slate-600">Angeschlossenes Kabel / Verteilung:</label>
              <select id="socket1Cable" onchange="updateSocketCable(1, this.value)" class="w-full text-xs border border-sky-200 rounded-lg p-1.5 bg-white font-medium text-sky-950 focus:outline-none">
              </select>
              <div class="flex items-center justify-between text-[11px] pt-1 border-t border-slate-100">
                <span class="text-slate-500">Max. Kapazität Kabel:</span>
                <div class="flex items-center gap-1">
                  <input type="number" id="socket1CableMax" value="3680" step="100" onchange="updateCableMaxWatt(1, this.value)" class="w-16 border rounded px-1 text-right font-mono font-bold text-sky-900" />
                  <span class="text-slate-500 font-bold">W</span>
                </div>
              </div>
            </div>

            <div id="socket1Pool" ondragover="allowDrop(event)" ondrop="drop(event, 'socket1')" class="space-y-2 min-h-[140px] p-2 bg-white rounded-lg border border-dashed border-sky-300"></div>
          </div>
          <div id="socket1Warn" class="mt-3 text-xs hidden font-bold text-red-600">⚠️ Überlastung Steckdose 1 (> 3.680W oder Kabel-Limit)!</div>
        </div>

        <!-- Outlet 2 -->
        <div class="bg-indigo-50/50 border border-indigo-200 rounded-xl p-4 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-2">
              <h4 class="font-bold text-indigo-900 text-sm flex items-center gap-1.5">🔌 Steckdose 2</h4>
              <span id="socket2Watts" class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-900 font-bold font-mono text-xs">0 W / 0,0 A</span>
            </div>
            
            <div class="mb-3 space-y-1.5 bg-white p-2.5 rounded-lg border border-indigo-100">
              <label class="block text-[11px] font-semibold text-slate-600">Angeschlossenes Kabel / Verteilung:</label>
              <select id="socket2Cable" onchange="updateSocketCable(2, this.value)" class="w-full text-xs border border-indigo-200 rounded-lg p-1.5 bg-white font-medium text-indigo-950 focus:outline-none">
              </select>
              <div class="flex items-center justify-between text-[11px] pt-1 border-t border-slate-100">
                <span class="text-slate-500">Max. Kapazität Kabel:</span>
                <div class="flex items-center gap-1">
                  <input type="number" id="socket2CableMax" value="3680" step="100" onchange="updateCableMaxWatt(2, this.value)" class="w-16 border rounded px-1 text-right font-mono font-bold text-indigo-900" />
                  <span class="text-slate-500 font-bold">W</span>
                </div>
              </div>
            </div>

            <div id="socket2Pool" ondragover="allowDrop(event)" ondrop="drop(event, 'socket2')" class="space-y-2 min-h-[140px] p-2 bg-white rounded-lg border border-dashed border-indigo-300"></div>
          </div>
          <div id="socket2Warn" class="mt-3 text-xs hidden font-bold text-red-600">⚠️ Überlastung Steckdose 2 (> 3.680W oder Kabel-Limit)!</div>
        </div>

        <!-- Outlet 3 -->
        <div class="bg-emerald-50/50 border border-emerald-200 rounded-xl p-4 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-2">
              <h4 class="font-bold text-emerald-900 text-sm flex items-center gap-1.5">🔌 Steckdose 3</h4>
              <span id="socket3Watts" class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-900 font-bold font-mono text-xs">0 W / 0,0 A</span>
            </div>
            
            <div class="mb-3 space-y-1.5 bg-white p-2.5 rounded-lg border border-emerald-100">
              <label class="block text-[11px] font-semibold text-slate-600">Angeschlossenes Kabel / Verteilung:</label>
              <select id="socket3Cable" onchange="updateSocketCable(3, this.value)" class="w-full text-xs border border-emerald-200 rounded-lg p-1.5 bg-white font-medium text-emerald-950 focus:outline-none">
              </select>
              <div class="flex items-center justify-between text-[11px] pt-1 border-t border-slate-100">
                <span class="text-slate-500">Max. Kapazität Kabel:</span>
                <div class="flex items-center gap-1">
                  <input type="number" id="socket3CableMax" value="3680" step="100" onchange="updateCableMaxWatt(3, this.value)" class="w-16 border rounded px-1 text-right font-mono font-bold text-emerald-900" />
                  <span class="text-slate-500 font-bold">W</span>
                </div>
              </div>
            </div>

            <div id="socket3Pool" ondragover="allowDrop(event)" ondrop="drop(event, 'socket3')" class="space-y-2 min-h-[140px] p-2 bg-white rounded-lg border border-dashed border-emerald-300"></div>
          </div>
          <div id="socket3Warn" class="mt-3 text-xs hidden font-bold text-red-600">⚠️ Überlastung Steckdose 3 (> 3.680W oder Kabel-Limit)!</div>
        </div>

      </div>

      <div class="bg-amber-50/60 border border-amber-200 rounded-xl p-4 text-slate-700 space-y-1">
        <h4 class="font-bold text-amber-900 mb-1 flex items-center gap-2">⚠️ Tipp für die 3 Anschlüsse</h4>
        <p>• Die Karten im Pool werden automatisch entsprechend der angegebenen Anzahl in der Hauptliste dupliziert.</p>
        <p>• Verteilt die Großverbraucher (Einkochautomaten mit je 1.800W & Waffeleisen mit je 1.200W) am besten auf alle 3 Steckdosen!</p>
      </div>

    </div>

    <div class="p-4 border-t border-slate-100 text-right bg-slate-50 rounded-b-2xl">
      <button onclick="closeWiringModal()" class="px-5 py-2 bg-sky-700 text-white font-bold rounded-xl text-xs sm:text-sm hover:bg-sky-800 transition">Schließen</button>
    </div>
  </div>
