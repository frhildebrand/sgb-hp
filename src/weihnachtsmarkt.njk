layout: base.njk
heading: Weihnachtsmarkt Checkliste
heroSubtitle: Interaktive Vorbereitungsliste für Kinderpunsch & Waffelstand
permalink: /weihnachtsmarkt/index.html
---

<div class="max-w-6xl mx-auto px-2 sm:px-4 py-6">
  <!-- Progress & Sync Header -->
  <div class="bg-gradient-to-r from-emerald-900 via-green-950 to-emerald-900 text-amber-300 border border-amber-500/40 rounded-2xl p-5 shadow-xl mb-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">🎄 SG Barnstorf – Stand-Planung</h1>
        <p class="text-emerald-200/80 text-xs sm:text-sm mt-1">Live synchronisiert über Vereinsspeicher</p>
      </div>
      <div id="syncStatus" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-950/80 border border-emerald-700/60 text-emerald-300 self-start md:self-auto">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Synchronisiert
      </div>
    </div>
    
    <!-- Progress Bar -->
    <div class="w-full bg-emerald-950 rounded-full h-5 border border-emerald-800 overflow-hidden relative shadow-inner">
      <div id="progressBar" class="bg-gradient-to-r from-amber-400 to-amber-300 h-full w-0 transition-all duration-300"></div>
      <div id="progressText" class="absolute inset-0 flex items-center justify-center text-xs font-bold text-slate-950">0% erledigt</div>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="flex flex-col sm:flex-row gap-3 mb-6">
    <input type="text" id="searchInput" placeholder="🔍 Gegenstand, Person oder Box suchen..." 
      class="flex-1 bg-slate-900/90 border border-slate-700 text-slate-100 placeholder-slate-400 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-amber-400 transition" />
    <div class="flex gap-2">
      <button onclick="setFilter('all', this)" class="filter-btn active flex-1 sm:flex-none px-4 py-2.5 rounded-xl border border-amber-400 bg-amber-400 text-slate-950 font-bold text-xs sm:text-sm">Alle</button>
      <button onclick="setFilter('open', this)" class="filter-btn flex-1 sm:flex-none px-4 py-2.5 rounded-xl border border-slate-700 bg-slate-900 text-slate-300 font-medium text-xs sm:text-sm">Offen</button>
      <button onclick="setFilter('done', this)" class="filter-btn flex-1 sm:flex-none px-4 py-2.5 rounded-xl border border-slate-700 bg-slate-900 text-slate-300 font-medium text-xs sm:text-sm">Erledigt</button>
    </div>
  </div>

  <!-- Checklist Container (Tables) -->
  <div id="checklist" class="space-y-8"></div>

  <!-- Reset Button -->
  <div class="text-center mt-10">
    <button onclick="resetAll()" class="text-red-400 hover:text-red-300 border border-red-500/30 hover:border-red-500/60 bg-red-950/20 px-4 py-2 rounded-lg text-xs font-medium transition">
      ⚠️ Alle Eingaben in der Datenbank zurücksetzen
    </button>
  </div>
</div>

<style>
  .table-container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  select option {
    background-color: #0f172a;
    color: #f8fafc;
  }
</style>

<script>
{% raw %}
  // Hier deine kopierte Web-App-URL aus Google Apps Script einfügen:
  const GOOGLE_SCRIPT_URL = https://script.google.com/a/macros/sgbarnstorf.de/s/AKfycbx0J8qYfvLmKXqBsg_Km-QDp4RGk58pQfg9rDzX7kKa5iUFeVZqrCySYfxiSMM1No-W/exec;

  const itemsData = [
    // Orga
    { id: 1, cat: "🏛️ Orga & Anträge", isShop: false, title: "Anmeldung Gemeinde", details: "Teilnahmebestätigung vorab sichern" },
    { id: 2, cat: "🏛️ Orga & Anträge", isShop: false, title: "Anzeige Gaststättengewerbe", details: "Erforderliche Anträge einreichen" },
    { id: 3, cat: "🏛️ Orga & Anträge", isShop: false, title: "Hütte Gemeinde", details: "Aufbauort, Tag & Uhrzeit genau abklären" },
    { id: 4, cat: "🏛️ Orga & Anträge", isShop: false, title: "Helfer- & Teiglisten (Reshop)", details: "Unterstützung & Schichten koordinieren" },
    
    // Strom & Technik
    { id: 5, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Einkochautomaten / Punschkocher (2x)", details: "Vorab auf Funktion prüfen" },
    { id: 6, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Waffeleisen (3x)", details: "2x SG + 1x KE" },
    { id: 7, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Wasserkocher", details: "Für Heißwasser / schnelle Reinigung" },
    { id: 8, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Lichterketten (Kurz, Lang, Sterne)", details: "2 Sterne, 4 normale (2 kurz / 2 lang)" },
    { id: 9, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Mehrfachsteckdosen (3er & 5er)", details: "Für hohe Watt-Zahlen geeignet" },
    { id: 10, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Verlängerungskabel (3m & Outdoor)", details: "Laufwege beachten" },
    
    // Werkzeug
    { id: 11, cat: "🛠️ Werkzeug & Befestigung", isShop: false, title: "Werkzeugkiste", details: "Hammer, Schraubendreher, Nagelzange, Seitenschneider, Schere" },
    { id: 12, cat: "🛠️ Werkzeug & Befestigung", isShop: false, title: "Befestigungsmaterial", details: "Kabelbinder, Draht, Heftzwecken, Kreppband, Nägel, Schrauben" },
    { id: 13, cat: "🛠️ Werkzeug & Befestigung", isShop: false, title: "Beleuchtung & Sonstiges", details: "Taschenlampe / Kopflampe, Feuerzeug" },

    // Stand & Deko
    { id: 14, cat: "✨ Stand-Deko & Atmosphäre", isShop: false, title: "SG Barnstorf Banner", details: "Gut sichtbar aufhängen" },
    { id: 15, cat: "✨ Stand-Deko & Atmosphäre", isShop: false, title: "Stehtische mit Tischdecken", details: "Inkl. Servietten & Kerzengläser" },
    { id: 16, cat: "✨ Stand-Deko & Atmosphäre", isShop: false, title: "Kerzen in größeren Gläsern", details: "Windgeschützt (gehen sonst aus) + Teelichter" },
    { id: 17, cat: "✨ Stand-Deko & Atmosphäre", isShop: false, title: "Bodenschutz / Teppich / Malervlies", details: "Gegen kalte Füße im Stand" },
    { id: 18, cat: "✨ Stand-Deko & Atmosphäre", isShop: false, title: "Deko & Zubehör", details: "Keksteller, Rezeptzettel, Weihnachtsmützen" },

    // Zutaten Punsch (Einkauf)
    { id: 19, cat: "☕ Zutaten & Zubehör Punsch", isShop: true, title: "Säfte & Tee", details: "Apfelsaft (2,5l), Roter Traubensaft (2,5l), Orangensaft (1l), Wintertee (10 Btl)" },
    { id: 20, cat: "☕ Zutaten & Zubehör Punsch", isShop: true, title: "Gewürze & Zutaten", details: "Glühfix (5 Btl), Zimtstangen (2 Stk)" },
    { id: 21, cat: "☕ Zutaten & Zubehör Punsch", isShop: false, title: "Ausschank & Becher", details: "Thermobecher / Becher, Punschkelle (Spaghettikelle), Suppenkellen" },

    // Zutaten Waffeln (Einkauf)
    { id: 22, cat: "🧇 Zutaten & Zubehör Waffeln", isShop: true, title: "Teig & Zutaten", details: "Waffelteig-Spenden, Öl, Puderzucker, Spekulatius" },
    { id: 23, cat: "🧇 Zutaten & Zubehör Waffeln", isShop: false, title: "Waffel-Utensilien", details: "Teigkellen, Holzgabeln, Ölpinsel inkl. Flasche, Sieb für Puderzucker" },

    // Hygiene & Reinigung (Einkauf)
    { id: 24, cat: "🧹 Hygiene, Reinigung & Müll", isShop: true, title: "Reinigungsmittel", details: "Spülmittel, Lappen, Geschirrhandtücher, Küchenrolle, Waschlappen" },
    { id: 25, cat: "🧹 Hygiene, Reinigung & Müll", isShop: true, title: "Müllentsorgung", details: "Mülltüten, Steckmülleimer" },
    { id: 26, cat: "🧹 Hygiene, Reinigung & Müll", isShop: false, title: "Sauberkeit & Schutz", details: "Schüssel zum Lappen waschen, Kehrblech & Handfeger, Einmalhandschuhe" },

    // Kasse
    { id: 27, cat: "💶 Kasse, Preise & Finanzen", isShop: false, title: "Kasse & Wechselgeld", details: "Geldtasche / Kasse mit Kleingeld-Reserve" },
    { id: 28, cat: "💶 Kasse, Preise & Finanzen", isShop: false, title: "Preisschilder & Spenden", details: "Preisschilder Waffeln & Punsch (DIN A4), Spendenente" }
  ];

  let appState = {};
  let currentFilter = 'all';

  function initItemState(id) {
    if (!appState[id]) {
      appState[id] = { status: 'Offen', assignedTo: '', packed: false, boxNum: '' };
    }
  }

  itemsData.forEach(item => initItemState(item.id));

  function setSyncStatus(text, colorClass) {
    const el = document.getElementById('syncStatus');
    if (!el) return;
    el.className = `inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold border ${colorClass}`;
    el.innerHTML = `<span class="w-2 h-2 rounded-full bg-current animate-pulse"></span> ${text}`;
  }

  async function loadCloudData() {
    if (!GOOGLE_SCRIPT_URL || GOOGLE_SCRIPT_URL.includes("HIER_DEINE")) return;
    setSyncStatus("Lade Daten...", "bg-amber-950/80 border-amber-700/60 text-amber-300");
    try {
      const res = await fetch(GOOGLE_SCRIPT_URL);
      if (res.ok) {
        const data = await res.json();
        if (data && Object.keys(data).length > 0) {
          appState = data;
          itemsData.forEach(item => initItemState(item.id));
          setSyncStatus("Synchronisiert", "bg-emerald-950/80 border-emerald-700/60 text-emerald-300");
          renderChecklist();
          updateProgress();
        }
      }
    } catch (e) {
      setSyncStatus("Fehler beim Laden", "bg-red-950/80 border-red-700/60 text-red-300");
    }
  }

  let saveTimeout = null;
  function saveState() {
    updateProgress();
    if (!GOOGLE_SCRIPT_URL || GOOGLE_SCRIPT_URL.includes("HIER_DEINE")) return;
    setSyncStatus("Speichere...", "bg-amber-950/80 border-amber-700/60 text-amber-300");

    clearTimeout(saveTimeout);
    saveTimeout = setTimeout(async () => {
      try {
        await fetch(GOOGLE_SCRIPT_URL, {
          method: "POST",
          body: JSON.stringify(appState)
        });
        setSyncStatus("Synchronisiert", "bg-emerald-950/80 border-emerald-700/60 text-emerald-300");
      } catch (e) {
        setSyncStatus("Speicherfehler", "bg-red-950/80 border-red-700/60 text-red-300");
      }
    }, 600);
  }

  function updateItem(id, field, value) {
    initItemState(id);
    appState[id][field] = value;
    saveState();
    renderChecklist();
  }

  function updateProgress() {
    const total = itemsData.length;
    const count = itemsData.filter(i => {
      const s = appState[i.id] ? appState[i.id].status : 'Offen';
      return s === 'Erledigt' || s === 'Eingekauft';
    }).length;
    const percent = Math.round((count / total) * 100);
    
    const bar = document.getElementById('progressBar');
    const txt = document.getElementById('progressText');
    if (bar) bar.style.width = percent + '%';
    if (txt) txt.innerText = percent + '% erledigt (' + count + '/' + total + ')';
  }

  function setFilter(filter, btn) {
    currentFilter = filter;
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.remove('bg-amber-400', 'text-slate-950', 'border-amber-400', 'font-bold');
      b.classList.add('bg-slate-900', 'text-slate-300', 'border-slate-700', 'font-medium');
    });
    btn.classList.remove('bg-slate-900', 'text-slate-300', 'border-slate-700', 'font-medium');
    btn.classList.add('bg-amber-400', 'text-slate-950', 'border-amber-400', 'font-bold');
    renderChecklist();
  }

  function renderChecklist() {
    const searchVal = (document.getElementById('searchInput')?.value || '').toLowerCase();
    const container = document.getElementById('checklist');
    if (!container) return;
    container.innerHTML = '';

    const categories = [...new Set(itemsData.map(item => item.cat))];

    categories.forEach(cat => {
      const catItems = itemsData.filter(item => {
        initItemState(item.id);
        const state = appState[item.id];
        const matchesCat = item.cat === cat;
        const matchesSearch = item.title.toLowerCase().includes(searchVal) || 
                              item.details.toLowerCase().includes(searchVal) ||
                              (state.assignedTo && state.assignedTo.toLowerCase().includes(searchVal)) ||
                              (state.boxNum && state.boxNum.toLowerCase().includes(searchVal));
        
        const isDone = state.status === 'Erledigt' || state.status === 'Eingekauft';
        let matchesFilter = true;
        if (currentFilter === 'open') matchesFilter = !isDone;
        if (currentFilter === 'done') matchesFilter = isDone;

        return matchesCat && matchesSearch && matchesFilter;
      });

      if (catItems.length > 0) {
        const catWrapper = document.createElement('div');
        catWrapper.className = 'bg-slate-900/90 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-lg';

        const catTitle = document.createElement('h2');
        catTitle.className = 'text-lg font-bold text-amber-400 mb-4 flex items-center gap-2 border-b border-slate-800 pb-2';
        catTitle.innerText = cat;
        catWrapper.appendChild(catTitle);

        const tableContainer = document.createElement('div');
        tableContainer.className = 'table-container';

        const table = document.createElement('table');
        table.className = 'w-full text-left text-xs sm:text-sm text-slate-200 border-collapse min-w-[650px]';

        table.innerHTML = `
          <thead>
            <tr class="border-b border-slate-700/80 text-slate-400 text-xs uppercase tracking-wider">
              <th class="py-2.5 px-2 w-[24%]">Gegenstand / Details</th>
              <th class="py-2.5 px-2 w-[18%]">Status</th>
              <th class="py-2.5 px-2 w-[22%]">Verteilt an</th>
              <th class="py-2.5 px-2 w-[16%] text-center">Eingepackt?</th>
              <th class="py-2.5 px-2 w-[20%]">Box-Nr.</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60"></tbody>
        `;

        const tbody = table.querySelector('tbody');

        catItems.forEach(item => {
          const state = appState[item.id];
          const isDone = state.status === 'Erledigt' || state.status === 'Eingekauft';
          
          const tr = document.createElement('tr');
          tr.className = `hover:bg-slate-800/40 transition ${isDone ? 'opacity-60 bg-emerald-950/10' : ''}`;

          const statusOptions = item.isShop 
            ? ['Offen', 'Vorbereitet', 'Verteilt', 'Eingekauft']
            : ['Offen', 'Vorbereitet', 'Verteilt', 'Erledigt'];

          tr.innerHTML = `
            <td class="py-3 px-2">
              <div class="font-semibold ${isDone ? 'line-through text-slate-400' : 'text-slate-100'}">${item.title}</div>
              <div class="text-xs text-slate-400">${item.details}</div>
            </td>
            <td class="py-3 px-2">
              <select onchange="updateItem(${item.id}, 'status', this.value)" 
                class="bg-slate-950 border border-slate-700 rounded-lg px-2 py-1 text-xs text-slate-100 focus:border-amber-400 focus:outline-none w-full">
                ${statusOptions.map(opt => `<option value="${opt}" ${state.status === opt ? 'selected' : ''}>${opt}</option>`).join('')}
              </select>
            </td>
            <td class="py-3 px-2">
              <input type="text" placeholder="Name eintragen..." value="${state.assignedTo || ''}"
                onchange="updateItem(${item.id}, 'assignedTo', this.value)"
                class="bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1 text-xs text-slate-100 placeholder-slate-500 focus:border-amber-400 focus:outline-none w-full" />
            </td>
            <td class="py-3 px-2 text-center">
              <input type="checkbox" ${state.packed ? 'checked' : ''} 
                onchange="updateItem(${item.id}, 'packed', this.checked)"
                class="w-5 h-5 accent-amber-400 rounded cursor-pointer" />
            </td>
            <td class="py-3 px-2">
              <input type="text" placeholder="z.B. Box 1" value="${state.boxNum || ''}"
                onchange="updateItem(${item.id}, 'boxNum', this.value)"
                class="bg-slate-950 border border-slate-700 rounded-lg px-2 py-1 text-xs text-slate-100 placeholder-slate-500 focus:border-amber-400 focus:outline-none w-full" />
            </td>
          `;
          tbody.appendChild(tr);
        });

        tableContainer.appendChild(table);
        catWrapper.appendChild(tableContainer);
        container.appendChild(catWrapper);
      }
    });
  }

  function resetAll() {
    if (confirm("Möchtest du wirklich alle Eingaben in der Datenbank zurücksetzen?")) {
      appState = {};
      itemsData.forEach(item => initItemState(item.id));
      saveState();
      renderChecklist();
    }
  }

  function initChecklist() {
    const input = document.getElementById('searchInput');
    if (input) input.addEventListener('input', renderChecklist);
    renderChecklist();
    updateProgress();
    loadCloudData();
    // Alle 10 Sekunden automatisch im Hintergrund aktualisieren
    setInterval(loadCloudData, 10000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChecklist);
  } else {
    initChecklist();
  }
{% endraw %}
</script>
