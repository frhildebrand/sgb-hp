---
layout: base.njk
title: SG Barnstorf Weihnachtsmarkt
---

<div class="max-w-6xl mx-auto px-4 py-6 font-sans">
  
  <!-- HEADER & MENU -->
  <header class="flex items-center justify-between gap-3 bg-slate-900/90 text-white p-4 rounded-3xl backdrop-blur-md mb-6 border border-slate-800 shadow-lg relative">
    <div class="flex items-center gap-3">
      <span class="text-2xl">🎄</span>
      <div>
        <h1 class="font-bold text-sm sm:text-base leading-tight">SG Barnstorf – Weihnachtsmarkt</h1>
        <div id="currentViewTitle" class="text-xs text-amber-400 font-medium">📋 Hauptliste & Inventar</div>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <button onclick="toggleRoleModal()" id="roleBadge" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white/10 text-emerald-100 border border-white/20">
        👁️ Rolle: BETRACHTER
      </button>

      <!-- Burger Navigation Menu -->
      <div class="relative">
        <button onclick="toggleNavMenu()" class="p-2.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-white font-bold text-lg leading-none transition">
          ☰
        </button>

        <div id="navDropdown" class="hidden absolute right-0 mt-2 w-60 bg-slate-900 border border-slate-800 text-slate-200 rounded-2xl shadow-2xl p-2 z-50">
          <button onclick="switchView('main')" class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-slate-800 font-semibold text-xs flex items-center gap-2">
            <span>📋</span> Hauptliste & Inventar
          </button>
          <button onclick="switchView('recipes')" class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-slate-800 font-semibold text-xs flex items-center gap-2">
            <span>☕</span> Rezepte & Zutaten
          </button>
          <button onclick="switchView('sales')" class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-slate-800 font-semibold text-xs flex items-center gap-2">
            <span>🏬</span> Standkasse & Verkauf
          </button>
          
          <div class="my-1 border-t border-slate-800"></div>

          <!-- Goldener Admin-Button -->
          <button onclick="switchView('admin')" class="w-full text-left px-3 py-2.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold text-xs flex items-center gap-2">
            <span>👑</span> Admin Control Center
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- VIEW 1: CHECKLIST & MAIN -->
  <section id="viewChecklist" class="space-y-6">
    <div class="bg-white p-4 sm:p-6 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row gap-3 justify-between items-center">
        <div class="w-full sm:w-1/2">
          <input type="text" id="searchInput" placeholder="🔍 Suchen nach Gegenstand oder Helfer..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        </div>
        <div id="syncStatus" class="text-xs text-slate-500 font-medium">⏳ Verbinde...</div>
      </div>

      <div>
        <div class="flex justify-between text-xs font-semibold mb-1.5 text-slate-700">
          <span>Gesamtfortschritt</span>
          <span id="progressText">0% erledigt</span>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200">
          <div id="progressBar" class="bg-emerald-500 h-full w-0 transition-all duration-300"></div>
        </div>
      </div>

      <div class="flex gap-2 overflow-x-auto pb-1 text-xs">
        <button onclick="filterCategory('all')" class="px-3 py-1.5 rounded-xl bg-slate-900 text-white font-medium">Alle</button>
        <button onclick="filterCategory('Offen')" class="px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200">Offen</button>
        <button onclick="filterCategory('Vorbereitet')" class="px-3 py-1.5 rounded-xl bg-amber-100 text-amber-800 hover:bg-amber-200">Vorbereitet</button>
        <button onclick="filterCategory('Verteilt')" class="px-3 py-1.5 rounded-xl bg-sky-100 text-sky-800 hover:bg-sky-200">Verteilt</button>
        <button onclick="filterCategory('Erledigt')" class="px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-800 hover:bg-emerald-200">Erledigt</button>
      </div>
    </div>

    <div id="checklist"></div>
  </section>

  <!-- VIEW 2: RECIPES -->
  <section id="viewRecipes" class="hidden space-y-6">
    <div class="bg-white border border-slate-200/80 rounded-3xl p-6 shadow-sm space-y-4">
      <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">☕ Kinderpunsch-Rechner</h2>
      <p class="text-xs text-slate-500">Stelle die Menge an Litern ein, um die benötigten Zutaten automatisch hochzurechnen.</p>
      
      <div class="flex items-center gap-4 bg-slate-50 p-4 rounded-2xl border border-slate-200">
        <input type="range" id="punschLiters" min="4" max="40" step="4" value="8" oninput="updateRecipeScaling()" class="w-full accent-emerald-600" />
        <span id="punschLitersLabel" class="font-bold text-slate-800 text-sm whitespace-nowrap">8 Liter</span>
      </div>

      <ul id="punschRecipeList" class="space-y-2 text-xs sm:text-sm text-slate-700 list-disc pl-5"></ul>
    </div>
  </section>

  <!-- VIEW 3: SALES / KASSE -->
  <section id="viewSales" class="hidden space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Punsch Kasse -->
      <div class="bg-white border border-slate-200/80 rounded-3xl p-6 shadow-sm space-y-4 text-center">
        <h3 class="font-bold text-slate-900 text-base">☕ Kinderpunsch (2,00 €)</h3>
        <div class="flex items-center justify-center gap-3">
          <button onclick="addSale('punsch', -1)" class="cash-btn w-12 h-12 bg-slate-100 hover:bg-slate-200 font-bold text-xl rounded-2xl border border-slate-300">-1</button>
          <input type="number" id="soldPunsch" value="0" onchange="calculateSalesStats()" class="w-20 text-center font-extrabold text-2xl border border-slate-300 rounded-2xl py-2" />
          <button onclick="addSale('punsch', 1)" class="cash-btn w-12 h-12 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xl rounded-2xl border border-emerald-700 shadow-md">+1</button>
        </div>
      </div>

      <!-- Waffeln Kasse -->
      <div class="bg-white border border-slate-200/80 rounded-3xl p-6 shadow-sm space-y-4 text-center">
        <h3 class="font-bold text-slate-900 text-base">🧇 Waffeln (2,00 €)</h3>
        <div class="flex items-center justify-center gap-3">
          <button onclick="addSale('waffles', -1)" class="cash-btn w-12 h-12 bg-slate-100 hover:bg-slate-200 font-bold text-xl rounded-2xl border border-slate-300">-1</button>
          <input type="number" id="soldWaffles" value="0" onchange="calculateSalesStats()" class="w-20 text-center font-extrabold text-2xl border border-slate-300 rounded-2xl py-2" />
          <button onclick="addSale('waffles', 1)" class="cash-btn w-12 h-12 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xl rounded-2xl border border-emerald-700 shadow-md">+1</button>
        </div>
      </div>

    </div>

    <!-- Live Bilanz -->
    <div class="bg-slate-900 text-white rounded-3xl p-6 shadow-xl space-y-4">
      <h3 class="font-bold text-amber-400 text-sm uppercase tracking-wider">📊 Live Umsatz-Übersicht</h3>
      <div class="grid grid-cols-3 gap-2 text-center">
        <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700">
          <div class="text-xs text-slate-400">Einnahmen</div>
          <div id="statRevenue" class="text-base sm:text-lg font-bold text-emerald-400">0,00 €</div>
        </div>
        <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700">
          <div class="text-xs text-slate-400">Ausgaben</div>
          <div id="statExpenses" class="text-base sm:text-lg font-bold text-red-400">0,00 €</div>
        </div>
        <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700">
          <div class="text-xs text-slate-400">Gewinn</div>
          <div id="statProfit" class="text-base sm:text-lg font-extrabold text-amber-300">0,00 €</div>
        </div>
      </div>
    </div>
  </section>

  <!-- VIEW 4: ADMIN CONTROL CENTER -->
  <section id="viewAdmin" class="hidden space-y-6">
    <div class="bg-slate-900 border border-amber-500/30 text-slate-100 rounded-3xl p-6 shadow-2xl max-w-2xl mx-auto">
      <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-800">
        <div>
          <h2 class="text-lg font-bold text-amber-400 flex items-center gap-2">
            <span>👑</span> Admin Control Center
          </h2>
          <p class="text-xs text-slate-400">Verwalte Passwörter & Einzelberechtigungen aller Rollen.</p>
        </div>
        <button onclick="saveRoleSettings()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2 rounded-xl text-xs transition shadow-lg">
          💾 Alle Speichern
        </button>
      </div>

      <div class="space-y-6 text-xs">
        
        <!-- HELFER ROLLE -->
        <div class="bg-slate-950/70 p-4 rounded-2xl border border-slate-800">
          <div class="flex items-center justify-between mb-3">
            <span class="font-bold text-emerald-400 text-sm flex items-center gap-2">🤝 Helfer Rolle</span>
            <div class="flex items-center gap-2">
              <span class="text-slate-400">PW:</span>
              <input type="text" id="pwd_helfer" class="bg-slate-800 border border-slate-700 rounded-lg px-2.5 py-1 text-white font-mono w-32" />
            </div>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-slate-300 pt-2 border-t border-slate-800/60">
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_helfer_cash" class="accent-emerald-500 rounded" /> 🛒 Kasse bedienen (+1/-1)</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_helfer_packed" class="accent-emerald-500 rounded" /> ✅ Gepackt-Haken setzen</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_helfer_qty" class="accent-emerald-500 rounded" /> 🔢 Benötigte Mengen ändern</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_helfer_stock" class="accent-emerald-500 rounded" /> 📦 "Auf Lager" ändern</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_helfer_box" class="accent-emerald-500 rounded" /> 🏷️ Boxen-Nummer ändern</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_helfer_status" class="accent-emerald-500 rounded" /> 🔄 Status & Namen anpassen</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_helfer_prices" class="accent-emerald-500 rounded" /> 💶 Preise & Kosten sehen/ändern</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_helfer_log" class="accent-emerald-500 rounded" /> 📜 Aktivitäten protokollieren</label>
          </div>
        </div>

        <!-- ORGA ROLLE -->
        <div class="bg-slate-950/70 p-4 rounded-2xl border border-slate-800">
          <div class="flex items-center justify-between mb-3">
            <span class="font-bold text-sky-400 text-sm flex items-center gap-2">📋 Orga-Team Rolle</span>
            <div class="flex items-center gap-2">
              <span class="text-slate-400">PW:</span>
              <input type="text" id="pwd_orga" class="bg-slate-800 border border-slate-700 rounded-lg px-2.5 py-1 text-white font-mono w-32" />
            </div>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-slate-300 pt-2 border-t border-slate-800/60">
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_orga_cash" class="accent-sky-500 rounded" /> 🛒 Kasse bedienen (+1/-1)</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_orga_packed" class="accent-sky-500 rounded" /> ✅ Gepackt-Haken setzen</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_orga_qty" class="accent-sky-500 rounded" /> 🔢 Benötigte Mengen ändern</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_orga_stock" class="accent-sky-500 rounded" /> 📦 "Auf Lager" ändern</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_orga_box" class="accent-sky-500 rounded" /> 🏷️ Boxen-Nummer ändern</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_orga_status" class="accent-sky-500 rounded" /> 🔄 Status & Namen anpassen</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_orga_prices" class="accent-sky-500 rounded" /> 💶 Preise & Kosten sehen/ändern</label>
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="perm_orga_log" class="accent-sky-500 rounded" /> 📜 Aktivitäten protokollieren</label>
          </div>
        </div>

        <!-- ADMIN ROLLE -->
        <div class="bg-slate-950/70 p-4 rounded-2xl border border-slate-800">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-amber-400 text-sm flex items-center gap-2">🔓 Admin Rolle</span>
            <div class="flex items-center gap-2">
              <span class="text-slate-400">PW:</span>
              <input type="text" id="pwd_admin" class="bg-slate-800 border border-slate-700 rounded-lg px-2.5 py-1 text-white font-mono w-32" />
            </div>
          </div>
          <p class="text-slate-500 text-[11px]">Der Admin besitzt automatisch immer alle Berechtigungen.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ROLE SWITCH MODAL -->
  <div id="roleModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-slate-800 text-white rounded-3xl p-6 w-full max-w-sm space-y-4 text-center shadow-2xl">
      <h3 class="font-bold text-base">Rolle auswählen</h3>
      <div class="space-y-2">
        <button onclick="selectRoleWithPassword('betrachter')" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs font-semibold">👁️ Betrachter (Nur Lesen)</button>
        <button onclick="selectRoleWithPassword('helfer')" class="w-full py-2.5 bg-emerald-600/30 hover:bg-emerald-600/40 text-emerald-200 border border-emerald-500/30 rounded-xl text-xs font-semibold">🤝 Helfer</button>
        <button onclick="selectRoleWithPassword('orga')" class="w-full py-2.5 bg-sky-600/30 hover:bg-sky-600/40 text-sky-200 border border-sky-500/30 rounded-xl text-xs font-semibold">📋 Orga-Team</button>
        <button onclick="selectRoleWithPassword('admin')" class="w-full py-2.5 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 rounded-xl text-xs font-bold">👑 Admin</button>
      </div>
      <button onclick="closeRoleModal()" class="text-xs text-slate-400 hover:text-white pt-2">Abbrechen</button>
    </div>
  </div>

</div>

<script src="/assets/weihnachtsmarkt/weihnachtsmarkt-data.js"></script>
<script src="/assets/weihnachtsmarkt/weihnachtsmarkt.js"></script>
