<!-- MODAL 3: STROM & KABEL PLANER (Screenshot 5) -->
<div id="modalPower" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white text-slate-900 rounded-2xl max-w-5xl w-full p-6 space-y-4 max-h-[85vh] overflow-y-auto shadow-2xl border border-slate-200">
    <div class="flex justify-between items-center border-b pb-3">
      <div>
        <h3 class="font-extrabold text-base text-sky-900 flex items-center gap-2">⚡ Modularer Strom- & Kabel-Planer (3 Stromeingänge)</h3>
        <p class="text-xs text-slate-500 font-medium">Wattzahlen für jedes einzelne Gerät direkt anpassen und per Drag & Drop Verteilen!</p>
      </div>
      <button onclick="closeModal('modalPower')" class="text-slate-400 hover:text-slate-700 text-2xl font-bold">✕</button>
    </div>

    <!-- Power Items Pool -->
    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80 space-y-2">
      <div class="font-bold text-xs text-slate-700">🔌 Nicht zugewiesene Geräte & Kabel (Hier herausziehen):</div>
      <div id="powerPool" class="flex flex-wrap gap-2 text-xs"></div>
    </div>

    <!-- 3 Steckdosen/Phasen -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-sky-50/50 border border-sky-200 p-3.5 rounded-xl space-y-2">
        <div class="font-bold text-xs text-sky-900 flex justify-between items-center">
          <span>🔌 Steckdose 1</span>
          <span id="loadPhase1" class="text-sky-700 font-extrabold bg-sky-100 px-2 py-0.5 rounded border border-sky-200">0 W / 0,0 A</span>
        </div>
        <div id="phase1Items" class="min-h-[120px] bg-white border border-dashed border-sky-300 rounded-lg p-2 space-y-1.5"></div>
      </div>
      <div class="bg-sky-50/50 border border-sky-200 p-3.5 rounded-xl space-y-2">
        <div class="font-bold text-xs text-sky-900 flex justify-between items-center">
          <span>🔌 Steckdose 2</span>
          <span id="loadPhase2" class="text-sky-700 font-extrabold bg-sky-100 px-2 py-0.5 rounded border border-sky-200">0 W / 0,0 A</span>
        </div>
        <div id="phase2Items" class="min-h-[120px] bg-white border border-dashed border-sky-300 rounded-lg p-2 space-y-1.5"></div>
      </div>
      <div class="bg-sky-50/50 border border-sky-200 p-3.5 rounded-xl space-y-2">
        <div class="font-bold text-xs text-sky-900 flex justify-between items-center">
          <span>🔌 Steckdose 3</span>
          <span id="loadPhase3" class="text-sky-700 font-extrabold bg-sky-100 px-2 py-0.5 rounded border border-sky-200">0 W / 0,0 A</span>
        </div>
        <div id="phase3Items" class="min-h-[120px] bg-white border border-dashed border-sky-300 rounded-lg p-2 space-y-1.5"></div>
      </div>
    </div>

    <div class="text-right pt-2 border-t">
      <button onclick="closeModal('modalPower')" class="px-5 py-2 bg-[#0284c7] hover:bg-[#0369a1] text-white font-bold rounded-xl text-xs shadow transition">Schließen</button>
    </div>
  </div>
</div>

<!-- MODAL 4: EINKAUFSLISTE & PREISE (Screenshot 6) -->
<div id="modalShopping" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white text-slate-900 rounded-2xl max-w-5xl w-full p-6 space-y-4 max-h-[85vh] overflow-y-auto shadow-2xl border border-slate-200">
    <div class="flex justify-between items-center border-b pb-3">
      <div>
        <h3 class="font-extrabold text-base text-amber-900 flex items-center gap-2">🛒 Interaktive Einkaufsliste & Preise</h3>
        <p class="text-xs text-slate-500 font-medium">Gib Packungsgrößen & Einzelpreise ein. Die Gesamtmenge und Kosten berechnen sich automatisch!</p>
      </div>
      <button onclick="closeModal('modalShopping')" class="text-slate-400 hover:text-slate-700 text-2xl font-bold">✕</button>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="bg-[#fffbeb] text-amber-900 font-extrabold uppercase border-b border-amber-200">
            <th class="p-2.5 text-center w-8">Gekauft</th>
            <th class="p-2.5">Artikel</th>
            <th class="p-2.5">Bedarf</th>
            <th class="p-2.5">Packungsgröße</th>
            <th class="p-2.5 text-center">Anz. Packungen</th>
            <th class="p-2.5">Laden / Geschäft</th>
            <th class="p-2.5 text-right">Preis / Packung</th>
            <th class="p-2.5 text-right">Gesamtpreis</th>
          </tr>
        </thead>
        <tbody id="shoppingTableBody" class="divide-y divide-slate-100 font-medium"></tbody>
      </table>
    </div>

    <div class="flex justify-between items-center pt-3 border-t">
      <div class="font-bold text-xs text-amber-900">Gesamtkosten Einkauf: <span id="shoppingTotalCost" class="text-base font-extrabold text-emerald-600">0,00 €</span></div>
      <button onclick="closeModal('modalShopping')" class="px-5 py-2 bg-[#d97706] hover:bg-[#b45309] text-white font-bold rounded-xl text-xs shadow transition">Schließen</button>
    </div>
  </div>
</div>

<!-- ROLE SELECTION MODAL -->
<div id="roleModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-slate-900 border border-slate-800 text-slate-100 rounded-2xl p-6 w-full max-w-sm text-center space-y-3 shadow-2xl">
    <h3 class="font-bold text-sm">Rolle auswählen</h3>
    <button onclick="selectRoleWithPassword('betrachter')" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs font-semibold transition">👁️ Betrachter (Nur Lesen)</button>
    <button onclick="selectRoleWithPassword('helfer')" class="w-full py-2.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-xl text-xs font-semibold transition">🤝 Helfer</button>
    <button onclick="selectRoleWithPassword('orga')" class="w-full py-2.5 bg-sky-500/10 hover:bg-sky-500/20 text-sky-300 border border-sky-500/30 rounded-xl text-xs font-semibold transition">📋 Orga-Team</button>
    <button onclick="selectRoleWithPassword('admin')" class="w-full py-2.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-xl text-xs font-bold transition">👑 Admin</button>
    <button onclick="closeModal('roleModal')" class="text-xs text-slate-500 hover:text-slate-300 pt-1 block mx-auto">Abbrechen</button>
  </div>
</div>

