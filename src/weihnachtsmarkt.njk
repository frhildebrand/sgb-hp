  </div>

  <!-- Checklist Container (Tables) -->
  <div id="checklist" class="space-y-8"></div>

</div>

<!-- Modal für Boxen-Übersicht -->
<div id="boxModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
