<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-[#111625] text-slate-100 font-sans pb-12">
  <div class="max-w-7xl mx-auto px-4 py-4 space-y-5">
    
    <!-- HEADER BAR (Exakt nach Screenshot 1) -->
    <header class="flex flex-wrap items-center justify-between gap-3 bg-white/95 backdrop-blur-md p-3.5 rounded-2xl shadow-xl border border-slate-200 text-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center font-bold text-xl">🦈</div>
        <div>
          <h1 class="font-extrabold text-sm sm:text-base tracking-tight leading-none text-slate-900">SG Barnstorf</h1>
          <span class="text-[11px] text-slate-500 font-medium">Weihnachtsmarkt Portal</span>
        </div>
      </div>

      <!-- Quick Modal Navigation Buttons -->
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
        <button onclick="openModal('modalShopping')" class="px-3.5 py-1.5 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-900 transition flex items-center gap-1.5 shadow-sm">
          🛒 <span>Einkaufsliste & Preise</span>
        </button>
        <button onclick="openModal('modalPower')" class="px-3.5 py-1.5 rounded-xl bg-sky-100 hover:bg-sky-200 text-sky-900 transition flex items-center gap-1.5 shadow-sm">
          ⚡ <span>Strom & Kabel-Planer</span>
        </button>
        <button onclick="openModal('modalStock')" class="px-3.5 py-1.5 rounded-xl bg-indigo-100 hover:bg-indigo-200 text-indigo-900 transition flex items-center gap-1.5 shadow-sm">
          📊 <span>Lagerbestand</span>
        </button>
        <button onclick="openModal('modalBoxes')" class="px-3.5 py-1.5 rounded-xl bg-emerald-100 hover:bg-emerald-200 text-emerald-900 transition flex items-center gap-1.5 shadow-sm">
          📦 <span>Boxen-Übersicht</span>
        </button>
        <button onclick="window.print()" class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition flex items-center gap-1.5 shadow-sm border border-slate-200">
          🖨️ <span>Liste drucken</span>
        </button>
        <button onclick="toggleRoleModal()" id="roleBadge" class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-emerald-400 font-bold ml-1 shadow-md transition">
          👁️ BETRACHTER
        </button>
      </div>
    </header>

    <!-- ADMIN CONTROL CENTER CARD (Exakt wie in Screenshot 1) -->
    <div class="bg-[#fffbeb] border border-[#fef3c7] rounded-2xl p-5 shadow-lg text-slate-800 space-y-3">
      <div class="flex items-center justify-between border-b border-amber-200/70 pb-3">
        <h2 class="font-extrabold text-sm text-amber-900 flex items-center gap-2">
          ⚙️ Admin Control-Center
        </h2>
        <a href="https://script.google.com" target="_blank" class="text-xs text-amber-800 font-bold underline hover:text-amber-950 flex items-center gap-1">
          🔗 Google Sheet Backend öffnen
        </a>
      </div>

      <div class="flex flex-wrap gap-2 text-xs font-bold">
        <button onclick="addNewItemPrompt()" class="px-3.5 py-2 bg-[#047857] hover:bg-[#065f46] text-white rounded-xl shadow transition">⚙️ Neuer Gegenstand / Kategorie</button>
        <button onclick="transferIngredientsToShopping()" class="px-3.5 py-2 bg-[#d97706] hover:bg-[#b45309] text-white rounded-xl shadow transition">☕ Punsch-Zutaten in Einkaufsliste übernehmen</button>
        <button onclick="downloadBackup()" class="px-3.5 py-2 bg-[#334155] hover:bg-[#1e293b] text-white rounded-xl shadow transition">💾 Backup Herunterladen</button>
        <button onclick="uploadBackup()" class="px-3.5 py-2 bg-[#334155] hover:bg-[#1e293b] text-white rounded-xl shadow transition">📂 Backup Einspielen</button>
        <button onclick="changePasswordPrompt()" class="px-3.5 py-2 bg-[#0284c7] hover:bg-[#0369a1] text-white rounded-xl shadow transition">🔑 Passwort Ändern</button>
        <button onclick="resetSeasonPrompt()" class="px-3.5 py-2 bg-[#e11d48] hover:bg-[#be123c] text-white rounded-xl shadow transition">🔄 Saison-Reset</button>
      </div>
      <p class="text-[11px] text-amber-800/80 font-medium">Verwaltung aller Artikel, Skalierungen und Systemeinstellungen.</p>
    </div>

    <!-- AUSHANG ROSHOP CARD (Exakt wie in Screenshot 1) -->
    <div class="bg-[#fffbeb] border border-[#fef3c7] rounded-2xl p-5 shadow-lg text-slate-800 space-y-3">
      <h2 class="font-extrabold text-sm text-amber-900 flex items-center gap-2">
        📌 Aktueller Aushang bei ROSHOP (Helfer & Teigspenden)
      </h2>
      <p class="text-xs text-slate-600 font-medium">Fotos/Scans der ausgehängten Listen für Samstag und Sonntag:</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-sm text-center space-y-2">
          <div class="font-bold text-xs text-slate-700 flex items-center justify-center gap-1.5">
            📅 Samstag (1. Adventswochenende)
          </div>
          <div id="imgSamstagContainer" class="text-xs text-slate-400 italic py-8 border border-dashed rounded-lg bg-slate-50/50">
            📷 Noch kein Foto für Samstag hochgeladen.
          </div>
          <input type="file" accept="image/*" onchange="uploadRoshopImage('samstag', this)" class="text-xs text-slate-500 mx-auto block pt-1" />
        </div>

        <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-sm text-center space-y-2">
          <div class="font-bold text-xs text-slate-700 flex items-center justify-center gap-1.5">
            📅 Sonntag (1. Adventswochenende)
          </div>
          <div id="imgSonntagContainer" class="text-xs text-slate-400 italic py-8 border border-dashed rounded-lg bg-slate-50/50">
            📷 Noch kein Foto für Sonntag hochgeladen.
          </div>
          <input type="file" accept="image/*" onchange="uploadRoshopImage('sonntag', this)" class="text-xs text-slate-500 mx-auto block pt-1" />
        </div>
      </div>
    </div>

    <!-- STAND REZEPTE CARD (Exakt wie in Screenshot 1) -->
    <div class="bg-white rounded-2xl p-5 shadow-lg text-slate-800 space-y-4 border border-slate-200">
      <div class="flex flex-wrap justify-between items-center gap-2 border-b pb-3">
        <h2 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">📜 Stand-Rezepte</h2>
        <div class="flex items-center gap-2 text-xs">
          <span class="font-bold text-slate-600">Punsch-Mengenrechner: Ziel-Menge (Liter):</span>
          <input type="number" id="punschCalcInput" value="8" min="4" max="80" step="4" onchange="updatePunschRecipe()" class="w-16 bg-slate-100 border border-slate-300 rounded-lg p-1 text-center font-extrabold text-slate-900 focus:ring-2 focus:ring-amber-500" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <div class="bg-[#fffbeb] p-4 rounded-xl border border-amber-200/80 space-y-1.5">
          <div class="font-bold text-amber-900 text-xs">🥯 Belgische Waffeln (Rezept pro Spende)</div>
          <p class="text-slate-700 leading-relaxed font-medium">500g Butter, 300g Zucker, 2 Pck. Vanillezucker, 1 Prise Salz, 10 Eier, 1000g Mehl, 2 Pck. Backpulver, 400ml Milch.</p>
        </div>
        <div class="bg-[#fffbeb] p-4 rounded-xl border border-amber-200/80 space-y-1.5">
          <div class="font-bold text-amber-900 text-xs">☕ Winter-Kinderpunsch ( <span id="recipeLitersLabel" class="font-extrabold">8 Liter</span> )</div>
          <ul id="recipeIngredientsList" class="list-disc pl-4 space-y-1 text-slate-700 font-medium"></ul>
        </div>
      </div>
    </div>

    <!-- HAUPTLISTE / INVENTAR CHECKLISTE -->
    <div class="bg-slate-900/90 backdrop-blur-md p-5 rounded-2xl border border-slate-800 shadow-2xl space-y-4">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
        <input type="text" id="searchInput" placeholder="🔍 Suchen nach Gegenstand, Helfer, Box..." class="w-full sm:w-1/2 bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500" />
        <div id="syncStatus" class="text-xs text-slate-400 font-mono">⏳ Verbinde...</div>
      </div>

      <div>
        <div class="flex justify-between text-xs font-semibold mb-1.5 text-slate-300">
          <span>Gesamtfortschritt Packen & Vorbereiten</span>
          <span id="progressText" class="text-amber-400">0% erledigt</span>
        </div>
        <div class="w-full bg-slate-950 rounded-full h-2.5 overflow-hidden border border-slate-800">
          <div id="progressBar" class="bg-emerald-500 h-full w-0 transition-all duration-300"></div>
        </div>
      </div>

      <div id="checklist" class="space-y-4 pt-2"></div>
    </div>

  </div>
</div>

<!-- MODAL 1: BOXEN ÜBERSICHT (Screenshot 3) -->
<div id="modalBoxes" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white text-slate-900 rounded-2xl max-w-4xl w-full p-6 space-y-4 max-h-[85vh] overflow-y-auto shadow-2xl border border-slate-200">
    <div class="flex justify-between items-center border-b pb-3">
      <div>
        <h3 class="font-extrabold text-base text-slate-900 flex items-center gap-2">📦 Inhaltsübersicht & Packstatus der Boxen (1–12)</h3>
        <p class="text-xs text-slate-500 font-medium">Übersicht aller Gegenstände und Pack-Fortschritt pro Kiste</p>
      </div>
      <button onclick="closeModal('modalBoxes')" class="text-slate-400 hover:text-slate-700 text-2xl font-bold">✕</button>
    </div>
    <div id="boxOverviewGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
    <div class="text-right pt-2 border-t">
      <button onclick="closeModal('modalBoxes')" class="px-5 py-2 bg-[#047857] hover:bg-[#065f46] text-white font-bold rounded-xl text-xs shadow transition">Schließen</button>
    </div>
  </div>
</div>

