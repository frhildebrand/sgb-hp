      <button onclick="closeBoxOverview()" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">✕</button>
    </div>
    <div class="p-4 sm:p-6 overflow-y-auto space-y-6" id="boxModalContent"></div>
    <div class="p-4 border-t border-slate-100 text-right bg-slate-50 rounded-b-2xl">
      <button onclick="closeBoxOverview()" class="px-4 py-2 bg-emerald-700 text-white font-bold rounded-xl text-xs sm:text-sm hover:bg-emerald-800 transition">Schließen</button>
    </div>
  </div>
</div>

