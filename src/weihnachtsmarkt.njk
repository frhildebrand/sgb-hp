layout: base.njk
heading: Weihnachtsmarkt Checkliste
heroSubtitle: Interaktive Vorbereitungsliste für Kinderpunsch & Waffelstand
permalink: /weihnachtsmarkt/index.html
---

<!-- Tailwind CSS Fallback CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-6xl mx-auto px-2 sm:px-4 py-6 font-sans text-slate-800">
  
  <!-- Header -->
  <div class="bg-gradient-to-r from-emerald-50 via-green-100 to-emerald-50 text-slate-900 border border-emerald-200 rounded-2xl p-6 text-center shadow-md mb-6">
    <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-2 text-emerald-900">🎄 SG Barnstorf – Stand-Planung</h1>
    <p class="text-slate-600 text-sm sm:text-base mb-4 max-w-xl mx-auto">Vorbereitungsliste für Kinderpunsch & Waffelstand am 1. Advent</p>
    
    <!-- Progress Bar -->
    <div class="max-w-xl mx-auto bg-slate-200 rounded-full h-6 border border-slate-300 overflow-hidden relative shadow-inner mb-5">
      <div id="progressBar" class="bg-gradient-to-r from-emerald-500 to-green-600 h-full w-0 transition-all duration-300"></div>
      <div id="progressText" class="absolute inset-0 flex items-center justify-center text-xs sm:text-sm font-bold text-slate-900">0% erledigt</div>
    </div>

    <!-- Top Action Button -->
    <div class="flex justify-center">
      <button onclick="openBoxOverview()" class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-emerald-700 text-white hover:bg-emerald-800 transition shadow-sm flex items-center gap-2">
        📦 Boxen-Übersicht anzeigen
      </button>
    </div>
  </div>

  <!-- Helfer- & Teigspenden Aushang Vorschau (ROSHOP) - 2 Seiten Nebeneinander -->
  <div class="bg-amber-50/90 border border-amber-200 rounded-2xl p-4 sm:p-5 shadow-sm mb-6">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-2xl">📌</span>
      <div>
        <h3 class="font-bold text-slate-900 text-sm sm:text-base">Aktueller Aushang bei ROSHOP (Helfer & Teigspenden)</h3>
        <p class="text-xs sm:text-sm text-slate-600">Fotos/Scans der ausgehängten Listen für Samstag und Sonntag:</p>
      </div>
    </div>

    <!-- 2 Spalten Layout für Samstag & Sonntag -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Samstag -->
      <div class="bg-white border border-amber-200 rounded-xl p-3 text-center">
        <span class="font-bold text-xs sm:text-sm text-amber-900 block mb-2">📅 Samstag (1. Adventswochenende)</span>
        <div class="bg-slate-50 border border-slate-100 rounded-lg p-2 flex justify-center items-center overflow-hidden min-h-[250px]">
          <img src="/images/roshop_samstag.jpg" 
               alt="Aushang Samstag" 
               class="max-h-[500px] w-auto object-contain rounded shadow-sm"
               onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'py-12 text-amber-700/70 text-xs italic\'>📷 Noch kein Foto für <b>Samstag</b> hochgeladen.<br>(/images/roshop_samstag.jpg)</div>';" />
        </div>
      </div>

      <!-- Sonntag -->
      <div class="bg-white border border-amber-200 rounded-xl p-3 text-center">
        <span class="font-bold text-xs sm:text-sm text-amber-900 block mb-2">📅 Sonntag (1. Adventswochenende)</span>
        <div class="bg-slate-50 border border-slate-100 rounded-lg p-2 flex justify-center items-center overflow-hidden min-h-[250px]">
          <img src="/images/roshop_sonntag.jpg" 
               alt="Aushang Sonntag" 
               class="max-h-[500px] w-auto object-contain rounded shadow-sm"
               onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'py-12 text-amber-700/70 text-xs italic\'>📷 Noch kein Foto für <b>Sonntag</b> hochgeladen.<br>(/images/roshop_sonntag.jpg)</div>';" />
        </div>
      </div>
    </div>
  </div>

  <!-- Rezepte Sektion -->
  <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm mb-6">
    <h2 class="text-lg font-bold text-emerald-900 mb-4 flex items-center gap-2 border-b border-slate-100 pb-2">
      📜 Stand-Rezepte & Mengenangaben
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Waffelteig Rezept -->
      <div class="bg-emerald-50/50 border border-emerald-100 rounded-xl p-4 text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-bold text-emerald-900 text-sm sm:text-base mb-2">
          <span>🧇</span> Waffelteig (Standard-Portion)
        </div>
        <p class="text-slate-600 mb-3 text-xs italic">Bitte Teig in verschließbaren Eimern/Gefäßen mitbringen!</p>
        <ul class="list-disc list-inside space-y-1 text-slate-700">
          <li><b>500 g</b> Mehl</li>
          <li><b>250 g</b> Butter (weich)</li>
          <li><b>150–200 g</b> Zucker</li>
          <li><b>1 Pck.</b> Vanillezucker</li>
          <li><b>6</b> Eier</li>
          <li><b>500 ml</b> Milch</li>
          <li><b>1 Pck.</b> Backpulver & 1 Prise Salz</li>
        </ul>
      </div>

      <!-- Kinderpunsch Rezept -->
      <div class="bg-red-50/50 border border-red-100 rounded-xl p-4 text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-bold text-red-900 text-sm sm:text-base mb-2">
          <span>☕</span> Kinderpunsch (Pro Kocher-Füllung)
        </div>
        <p class="text-slate-600 mb-3 text-xs italic">Im Einkochautomaten erhitzen – nicht kochen lassen!</p>
        <ul class="list-disc list-inside space-y-1 text-slate-700">
          <li><b>2,5 l</b> Apfelsaft</li>
          <li><b>2,5 l</b> Traubensaft (rot)</li>
          <li><b>1,0 l</b> Orangensaft</li>
          <li><b>10 Beutel</b> Früchtetee / Wintertee (vorab ziehen lassen)</li>
          <li><b>3–4 Beutel</b> Glühfix / Punschgewürz</li>
          <li><b>2–3</b> Zimtstangen & Orangenscheiben</li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Suche & Status-Filter -->
  <div class="space-y-4 mb-8">
    <input type="text" id="searchInput" placeholder="🔍 Gegenstand, Person, Menge oder Box suchen..." 
      class="w-full bg-white border border-slate-300 text-slate-900 placeholder-slate-400 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-emerald-500 transition shadow-sm" />
    
    <!-- Status Filter Buttons -->
    <div class="flex flex-wrap justify-center gap-2" id="filterContainer">
      <button onclick="setFilter('all', this)" class="filter-btn active px-3.5 py-2 rounded-xl border border-emerald-600 bg-emerald-600 text-white font-bold text-xs sm:text-sm shadow-sm">Alle</button>
      <button onclick="setFilter('Offen', this)" class="filter-btn px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-red-600 font-medium text-xs sm:text-sm hover:border-red-400">Offen</button>
      <button onclick="setFilter('Vorbereitet', this)" class="filter-btn px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-amber-600 font-medium text-xs sm:text-sm hover:border-amber-400">Vorbereitet</button>
      <button onclick="setFilter('Verteilt', this)" class="filter-btn px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-sky-600 font-medium text-xs sm:text-sm hover:border-sky-400">Verteilt</button>
      <button onclick="setFilter('Eingekauft', this)" class="filter-btn px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-emerald-600 font-medium text-xs sm:text-sm hover:border-emerald-400">Eingekauft</button>
      <button onclick="setFilter('Erledigt', this)" class="filter-btn px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-emerald-600 font-medium text-xs sm:text-sm hover:border-emerald-400">Erledigt</button>
    </div>
  </div>

  <!-- Checklist Container (Tables) -->
  <div id="checklist" class="space-y-8"></div>

</div>

<!-- Modal für Boxen-Übersicht -->
<div id="boxModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white border border-slate-200 rounded-2xl max-w-3xl w-full max-h-[85vh] flex flex-col shadow-2xl">
    <div class="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between">
      <h2 class="text-lg font-bold text-emerald-900 flex items-center gap-2">📦 Inhaltsübersicht der Boxen (1–12)</h2>
      <button onclick="closeBoxOverview()" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">✕</button>
    </div>
    <div class="p-4 sm:p-6 overflow-y-auto space-y-6" id="boxModalContent"></div>
    <div class="p-4 border-t border-slate-100 text-right bg-slate-50 rounded-b-2xl">
      <button onclick="closeBoxOverview()" class="px-4 py-2 bg-emerald-700 text-white font-bold rounded-xl text-xs sm:text-sm hover:bg-emerald-800 transition">Schließen</button>
    </div>
  </div>
</div>

<style>
  .table-container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  select option {
    background-color: #ffffff;
    color: #0f172a;
  }
  .status-offen { background-color: #fef2f2; color: #991b1b; border-color: #fecaca; }
  .status-vorbereitet { background-color: #fefce8; color: #854d0e; border-color: #fef08a; }
  .status-verteilt { background-color: #f0f9ff; color: #075985; border-color: #bae6fd; }
  .status-erledigt, .status-eingekauft { background-color: #f0fdf4; color: #166534; border-color: #bbf7d0; }
</style>

<script>
{% raw %}
  const itemsData = [
    // Orga
    { id: 1, cat: "🏛️ Orga & Anträge", isShop: false, title: "Anmeldung Gemeinde", details: "Teilnahmebestätigung vorab sichern", defaultQty: "1x" },
    { id: 2, cat: "🏛️ Orga & Anträge", isShop: false, title: "Anzeige Gaststättengewerbe", details: "Erforderliche Anträge einreichen", defaultQty: "1x" },
    { id: 3, cat: "🏛️ Orga & Anträge", isShop: false, title: "Hütte Gemeinde", details: "Aufbauort, Tag & Uhrzeit genau abklären", defaultQty: "1x" },
    { id: 4, cat: "🏛️ Orga & Anträge", isShop: false, title: "Helfer- & Teiglisten (Reshop)", details: "Aushang kontrollieren & abfotografieren", defaultQty: "1x" },
    
    // Strom & Technik
    { id: 5, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Einkochautomaten / Punschkocher", details: "Vorab auf Funktion prüfen", defaultQty: "2x" },
    { id: 6, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Waffeleisen", details: "2x SG + 1x KE", defaultQty: "3x" },
    { id: 7, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Wasserkocher", details: "Für Heißwasser / schnelle Reinigung", defaultQty: "1x" },
    { id: 8, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Lichterketten", details: "2 Sterne, 4 normale (2 kurz / 2 lang)", defaultQty: "6x" },
    { id: 9, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Mehrfachsteckdosen", details: "Für hohe Watt-Zahlen geeignet", defaultQty: "3er & 5er" },
    { id: 10, cat: "⚡ Strom, Licht & Aufbau", isShop: false, title: "Verlängerungskabel", details: "Laufwege beachten (Outdoor)", defaultQty: "3m+" },
    
    // Werkzeug
    { id: 11, cat: "🛠️ Werkzeug & Befestigung", isShop: false, title: "Werkzeugkiste", details: "Hammer, Schraubendreher, Nagelzange, Schere", defaultQty: "1 Kiste" },
    { id: 12, cat: "🛠️ Werkzeug & Befestigung", isShop: false, title: "Befestigungsmaterial", details: "Kabelbinder, Draht, Heftzwecken, Nägel", defaultQty: "Set" },
    { id: 13, cat: "🛠️ Werkzeug & Befestigung", isShop: false, title: "Beleuchtung & Sonstiges", details: "Taschenlampe / Kopflampe, Feuerzeug", defaultQty: "2x" },

    // Stand & Deko
    { id: 14, cat: "✨ Stand-Deko & Atmosphäre", isShop: false, title: "SG Barnstorf Banner", details: "Gut sichtbar aufhängen", defaultQty: "1x" },
    { id: 15, cat: "✨ Stand-Deko & Atmosphäre", isShop: false, title: "Stehtische mit Tischdecken", details: "Inkl. Servietten & Kerzengläser", defaultQty: "2 Stk" },
    { id: 16, cat: "✨ Stand-Deko & Atmosphäre", isShop: false, title: "Kerzen in größeren Gläsern", details: "Windgeschützt + Teelichter", defaultQty: "4 Gläser" },
    { id: 17, cat: "✨ Stand-Deko & Atmosphäre", isShop: false, title: "Bodenschutz / Teppich / Malervlies", details: "Gegen kalte Füße im Stand", defaultQty: "1 Rolle" },
    { id: 18, cat: "✨ Stand-Deko & Atmosphäre", isShop: false, title: "Deko & Zubehör", details: "Keksteller, Rezeptzettel, Weihnachtsmützen", defaultQty: "Set" },

    // Zutaten Punsch (Einkauf)
    { id: 19, cat: "☕ Zutaten & Zubehör Punsch", isShop: true, title: "Säfte & Tee", details: "Apfel-, Trauben-, Orangensaft & Wintertee", defaultQty: "2,5l / 10Btl" },
    { id: 20, cat: "☕ Zutaten & Zubehör Punsch", isShop: true, title: "Gewürze & Zutaten", details: "Glühfix & Zimtstangen", defaultQty: "5 Btl / 2 Stk" },
    { id: 21, cat: "☕ Zutaten & Zubehör Punsch", isShop: false, title: "Ausschank & Becher", details: "Thermobecher, Punschkelle, Suppenkellen", defaultQty: "Ausreich." },

    // Zutaten Waffeln (Einkauf)
    { id: 22, cat: "🧇 Zutaten & Zubehör Waffeln", isShop: true, title: "Teig & Zutaten", details: "Waffelteig-Spenden, Öl, Puderzucker, Spekulatius", defaultQty: "Nach Liste" },
    { id: 23, cat: "🧇 Zutaten & Zubehör Waffeln", isShop: false, title: "Waffel-Utensilien", details: "Teigkellen, Holzgabeln, Ölpinsel, Puderzuckersieb", defaultQty: "Set" },

    // Hygiene & Reinigung (Einkauf)
    { id: 24, cat: "🧹 Hygiene, Reinigung & Müll", isShop: true, title: "Reinigungsmittel", details: "Spülmittel, Lappen, Handtücher, Küchenrolle", defaultQty: "Set" },
    { id: 25, cat: "🧹 Hygiene, Reinigung & Müll", isShop: true, title: "Müllentsorgung", details: "Mülltüten, Steckmülleimer", defaultQty: "1 Rolle" },
    { id: 26, cat: "🧹 Hygiene, Reinigung & Müll", isShop: false, title: "Sauberkeit & Schutz", details: "Spülschüssel, Kehrblech, Einmalhandschuhe", defaultQty: "Set" },

    // Kasse
    { id: 27, cat: "💶 Kasse, Preise & Finanzen", isShop: false, title: "Kasse & Wechselgeld", details: "Geldtasche / Kasse mit Kleingeld-Reserve", defaultQty: "1 Kasse" },
    { id: 28, cat: "💶 Kasse, Preise & Finanzen", isShop: false, title: "Preisschilder & Spenden", details: "Preisschilder Waffeln & Punsch (DIN A4), Spendenente", defaultQty: "Set" }
  ];

  let appState = JSON.parse(localStorage.getItem('sg_wm_state_light_v2')) || {};
  let currentFilter = 'all';

  function initItemState(item) {
    if (!appState[item.id]) {
      appState[item.id] = { status: 'Offen', assignedTo: '', packed: false, boxNum: '', qty: item.defaultQty || '' };
    }
  }

  itemsData.forEach(item => initItemState(item));

  function saveState() {
    localStorage.setItem('sg_wm_state_light_v2', JSON.stringify(appState));
    updateProgress();
  }

  function updateItem(id, field, value) {
    if (!appState[id]) appState[id] = {};
    appState[id][field] = value;
    saveState();
    renderChecklist();
  }

  function updateProgress() {
    const total = itemsData.length;
    const count = itemsData.filter(i => {
      const s = appState[i.id] ? appState[i.id].status : 'Offen';
      return s === 'Erledigt' || s === 'Eingekauft';
    }).length;
    const percent = Math.round((count / total) * 100);
    
    const bar = document.getElementById('progressBar');
    const txt = document.getElementById('progressText');
    if (bar) bar.style.width = percent + '%';
    if (txt) txt.innerText = percent + '% erledigt (' + count + '/' + total + ')';
  }

  function setFilter(filter, btn) {
    currentFilter = filter;
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600', 'font-bold');
      b.classList.add('bg-white', 'text-slate-700', 'border-slate-200', 'font-medium');
    });
    btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200', 'font-medium');
    btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600', 'font-bold');
    renderChecklist();
  }

  function getStatusClass(status) {
    if (status === 'Vorbereitet') return 'status-vorbereitet';
    if (status === 'Verteilt') return 'status-verteilt';
    if (status === 'Erledigt' || status === 'Eingekauft') return 'status-erledigt';
    return 'status-offen';
  }

  function renderChecklist() {
    const searchVal = (document.getElementById('searchInput')?.value || '').toLowerCase();
    const container = document.getElementById('checklist');
    if (!container) return;
    container.innerHTML = '';

    const categories = [...new Set(itemsData.map(item => item.cat))];

    categories.forEach(cat => {
      const catItems = itemsData.filter(item => {
        initItemState(item);
        const state = appState[item.id];
        const matchesCat = item.cat === cat;
        const matchesSearch = item.title.toLowerCase().includes(searchVal) || 
                              item.details.toLowerCase().includes(searchVal) ||
                              (state.assignedTo && state.assignedTo.toLowerCase().includes(searchVal)) ||
                              (state.boxNum && state.boxNum.toString().includes(searchVal));
        
        let matchesFilter = true;
        if (currentFilter !== 'all') {
          matchesFilter = (state.status === currentFilter);
        }

        return matchesCat && matchesSearch && matchesFilter;
      });

      if (catItems.length > 0) {
        const catWrapper = document.createElement('div');
        catWrapper.className = 'bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm';

        const catTitle = document.createElement('h2');
        catTitle.className = 'text-lg font-bold text-emerald-900 mb-4 flex items-center gap-2 border-b border-slate-100 pb-2';
        catTitle.innerText = cat;
        catWrapper.appendChild(catTitle);

        const tableContainer = document.createElement('div');
        tableContainer.className = 'table-container';

        const table = document.createElement('table');
        table.className = 'w-full text-left text-xs sm:text-sm text-slate-800 border-collapse min-w-[700px]';

        table.innerHTML = `
          <thead>
            <tr class="border-b border-slate-200 text-slate-500 text-xs uppercase tracking-wider bg-slate-50">
              <th class="py-2.5 px-3 w-[26%]">Gegenstand / Details</th>
              <th class="py-2.5 px-2 w-[12%]">Menge</th>
              <th class="py-2.5 px-2 w-[18%]">Status</th>
              <th class="py-2.5 px-2 w-[20%]">Verteilt an</th>
              <th class="py-2.5 px-2 w-[12%] text-center">Eingepackt?</th>
              <th class="py-2.5 px-2 w-[12%] text-center">Box-Nr.</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100"></tbody>
        `;

        const tbody = table.querySelector('tbody');

        catItems.forEach(item => {
          const state = appState[item.id];
          const isDone = state.status === 'Erledigt' || state.status === 'Eingekauft';
          
          const tr = document.createElement('tr');
          tr.className = `hover:bg-slate-50 transition ${isDone ? 'opacity-70 bg-emerald-50/40' : ''}`;

          const statusOptions = item.isShop 
            ? ['Offen', 'Vorbereitet', 'Verteilt', 'Eingekauft']
            : ['Offen', 'Vorbereitet', 'Verteilt', 'Erledigt'];

          tr.innerHTML = `
            <td class="py-3 px-3">
              <div class="font-semibold ${isDone ? 'line-through text-slate-400' : 'text-slate-900'}">${item.title}</div>
              <div class="text-xs text-slate-500">${item.details}</div>
            </td>
            <td class="py-3 px-2">
              <input type="text" value="${state.qty || ''}"
                onchange="updateItem(${item.id}, 'qty', this.value)"
                class="bg-white border border-slate-300 rounded-lg px-2 py-1 text-xs text-slate-900 focus:border-emerald-500 focus:outline-none w-20 shadow-sm" />
            </td>
            <td class="py-3 px-2">
              <select onchange="updateItem(${item.id}, 'status', this.value)" 
                class="border rounded-lg px-2 py-1 text-xs font-semibold focus:outline-none w-full shadow-sm ${getStatusClass(state.status)}">
                ${statusOptions.map(opt => `<option value="${opt}" ${state.status === opt ? 'selected' : ''}>${opt}</option>`).join('')}
              </select>
            </td>
            <td class="py-3 px-2">
              <input type="text" placeholder="Name..." value="${state.assignedTo || ''}"
                onchange="updateItem(${item.id}, 'assignedTo', this.value)"
                class="bg-white border border-slate-300 rounded-lg px-2.5 py-1 text-xs text-slate-900 placeholder-slate-400 focus:border-emerald-500 focus:outline-none w-full shadow-sm" />
            </td>
            <td class="py-3 px-2 text-center align-middle">
              <input type="checkbox" ${state.packed ? 'checked' : ''} 
                onchange="updateItem(${item.id}, 'packed', this.checked)"
                class="w-5 h-5 accent-emerald-600 rounded cursor-pointer mx-auto block" />
            </td>
            <td class="py-3 px-2 text-center">
              <input type="number" min="1" max="12" value="${state.boxNum || ''}"
                onchange="updateItem(${item.id}, 'boxNum', this.value)"
                class="bg-white border border-slate-300 rounded-lg px-1.5 py-1 text-xs text-slate-900 text-center focus:border-emerald-500 focus:outline-none w-14 mx-auto shadow-sm" />
            </td>
          `;
          tbody.appendChild(tr);
        });

        tableContainer.appendChild(table);
        catWrapper.appendChild(tableContainer);
        container.appendChild(catWrapper);
      }
    });
  }

  function openBoxOverview() {
    const modal = document.getElementById('boxModal');
    const content = document.getElementById('boxModalContent');
    content.innerHTML = '';

    for (let b = 1; b <= 12; b++) {
      const boxItems = itemsData.filter(item => {
        const state = appState[item.id];
        return state && parseInt(state.boxNum) === b;
      });

      const boxDiv = document.createElement('div');
      boxDiv.className = 'border border-slate-200 rounded-xl p-4 bg-slate-50';

      const boxHeader = document.createElement('h3');
      boxHeader.className = 'font-bold text-emerald-900 text-base mb-2 flex justify-between items-center';
      boxHeader.innerHTML = `<span>📦 Box ${b}</span> <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-semibold">${boxItems.length} Gegenstände</span>`;
      boxDiv.appendChild(boxHeader);

      if (boxItems.length > 0) {
        const ul = document.createElement('ul');
        ul.className = 'divide-y divide-slate-200 text-xs sm:text-sm';
        boxItems.forEach(item => {
          const state = appState[item.id];
          const li = document.createElement('li');
          li.className = 'py-1.5 flex justify-between items-center';
          li.innerHTML = `
            <div>
              <span class="font-medium text-slate-800">${item.title}</span>
              <span class="text-slate-400 text-xs">(${state.qty || '1x'})</span>
            </div>
            <span class="text-xs px-2 py-0.5 rounded border ${getStatusClass(state.status)}">${state.status}</span>
          `;
          ul.appendChild(li);
        });
        boxDiv.appendChild(ul);
      } else {
        const emptyMsg = document.createElement('p');
        emptyMsg.className = 'text-xs text-slate-400 italic';
        emptyMsg.innerText = 'Bisher keine Gegenstände dieser Box zugewiesen.';
        boxDiv.appendChild(emptyMsg);
      }

      content.appendChild(boxDiv);
    }

    modal.classList.remove('hidden');
  }

  function closeBoxOverview() {
    document.getElementById('boxModal').classList.add('hidden');
  }

  function initChecklist() {
    const input = document.getElementById('searchInput');
    if (input) input.addEventListener('input', renderChecklist);
    renderChecklist();
    updateProgress();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChecklist);
  } else {
    initChecklist();
  }
{% endraw %}
</script>
