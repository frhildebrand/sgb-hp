---
layout: base.njk
title: SG Barnstorf Weihnachtsmarkt
---
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    darkMode: 'class',
    theme: {
      extend: {
        colors: {
          brand: {
            50: '#fffbe8',
            500: '#f59e0b',
            600: '#d97706',
            900: '#78350f'
          }
        }
      }
    }
  }
</script>

<div id="appBody" class="min-h-screen bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans transition-colors duration-200 pb-16">
  
  <!-- STICKY HEADER -->
  <header class="sticky top-0 z-30 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 shadow-sm px-4 py-3">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center font-bold text-2xl shadow-inner">🦈</div>
        <div>
          <h1 class="font-extrabold text-base sm:text-lg leading-tight tracking-tight">SG Barnstorf</h1>
          <p class="text-xs text-amber-600 dark:text-amber-400 font-semibold">Weihnachtsmarkt Portal</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button onclick="openModal('roleModal')" id="roleBadge" class="px-3.5 py-1.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 font-bold text-xs hover:bg-amber-500/20 transition shadow-sm">
          👁️ BETRACHTER
        </button>

        <button onclick="toggleDarkMode()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 text-xs font-bold hover:scale-105 transition shadow-sm">
          🌙 / ☀️
        </button>

        <button onclick="toggleBurgerMenu()" class="p-2.5 rounded-xl bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 font-bold text-sm shadow hover:opacity-90 transition">
          ☰
        </button>
      </div>
    </div>
  </header>

  <!-- BURGER DRAWER NAVIGATION -->
  <div id="burgerDrawer" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm hidden flex justify-end transition-opacity">
    <div class="w-80 bg-white dark:bg-slate-900 h-full shadow-2xl p-6 flex flex-col justify-between overflow-y-auto border-l border-slate-200 dark:border-slate-800">
      <div class="space-y-6">
        <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-4">
          <h2 class="font-extrabold text-lg text-slate-900 dark:text-slate-100 flex items-center gap-2">🧭 Hauptnavigation</h2>
          <button onclick="toggleBurgerMenu()" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 font-bold text-2xl">✕</button>
        </div>

        <nav class="space-y-2 font-bold text-sm">
          <button onclick="navTo('inventar')" class="w-full text-left px-4 py-3 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-300 hover:scale-[1.02] transition flex items-center gap-3">📋 Inventar</button>
          <button onclick="navTo('verkauf')" class="w-full text-left px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-300 hover:scale-[1.02] transition flex items-center gap-3">💰 Verkauf</button>
          <button onclick="navTo('einkaufsliste')" class="w-full text-left px-4 py-3 rounded-xl bg-orange-50 dark:bg-orange-950/40 text-orange-900 dark:text-orange-300 hover:scale-[1.02] transition flex items-center gap-3">🛒 Einkaufsliste</button>
          <button onclick="navTo('verkabelung')" class="w-full text-left px-4 py-3 rounded-xl bg-sky-50 dark:bg-sky-950/40 text-sky-900 dark:text-sky-300 hover:scale-[1.02] transition flex items-center gap-3">⚡ Verkabelung</button>
          <button onclick="navTo('lagerbestand')" class="w-full text-left px-4 py-3 rounded-xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-900 dark:text-indigo-300 hover:scale-[1.02] transition flex items-center gap-3">📊 Lagerbestand</button>
          <button onclick="navTo('boxenuebersicht')" class="w-full text-left px-4 py-3 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-900 dark:text-purple-300 hover:scale-[1.02] transition flex items-center gap-3">📦 Boxenübersicht</button>
          <button onclick="navTo('rezepte')" class="w-full text-left px-4 py-3 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-900 dark:text-rose-300 hover:scale-[1.02] transition flex items-center gap-3">☕ Rezepte</button>
          <button onclick="window.print()" class="w-full text-left px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:scale-[1.02] transition flex items-center gap-3">🖨️ Drucken</button>
          <button onclick="navTo('adminpanel')" class="w-full text-left px-4 py-3 rounded-xl bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 hover:scale-[1.02] transition flex items-center gap-3 border border-amber-500/50 shadow-md">👑 Admin-Panel</button>
        </nav>
      </div>

      <div id="syncStatus" class="text-xs text-slate-400 font-mono text-center pt-4 border-t border-slate-200 dark:border-slate-800">
        ⏳ Verbinde mit Cloud Sheet...
      </div>
    </div>
  </div>

  <!-- DASHBOARD HAUPTINHALT -->
  <main class="max-w-7xl mx-auto px-4 pt-6 space-y-6">

    <!-- ROSHOP AUSHANG CARD -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
      <h2 class="font-extrabold text-sm text-slate-900 dark:text-slate-100 flex items-center gap-2">
        📌 Aktueller Aushang bei ROSHOP (Helfer- & Teigspendenlisten)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-slate-50 dark:bg-slate-950 p-4 rounded-xl border border-slate-200 dark:border-slate-800 text-center space-y-3">
          <div class="font-bold text-xs text-slate-700 dark:text-slate-300">📅 Samstag (1. Adventswochenende)</div>
          <div id="imgSamstagContainer" class="text-xs text-slate-400 italic py-6 border border-dashed border-slate-300 dark:border-slate-800 rounded-lg flex items-center justify-center">Kein Foto hochgeladen</div>
          <input type="file" accept="image/*" onchange="uploadRoshopImage('samstag', this)" class="text-xs text-slate-500 mx-auto block cursor-pointer" />
        </div>
        <div class="bg-slate-50 dark:bg-slate-950 p-4 rounded-xl border border-slate-200 dark:border-slate-800 text-center space-y-3">
          <div class="font-bold text-xs text-slate-700 dark:text-slate-300">📅 Sonntag (1. Adventswochenende)</div>
          <div id="imgSonntagContainer" class="text-xs text-slate-400 italic py-6 border border-dashed border-slate-300 dark:border-slate-800 rounded-lg flex items-center justify-center">Kein Foto hochgeladen</div>
          <input type="file" accept="image/*" onchange="uploadRoshopImage('sonntag', this)" class="text-xs text-slate-500 mx-auto block cursor-pointer" />
        </div>
      </div>
    </div>

    <!-- MAIN INVENTAR SECTION -->
    <section id="secInventar" class="space-y-4">
      <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
          <input type="text" id="searchInput" placeholder="🔍 Suchen nach Gegenständen, Helfern, Kisten..." class="w-full sm:w-1/2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-xs text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500" />
          <div class="text-xs font-bold text-amber-600 dark:text-amber-400" id="progressText">0% erledigt</div>
        </div>
        <div class="w-full bg-slate-100 dark:bg-slate-950 rounded-full h-3 overflow-hidden border border-slate-200 dark:border-slate-800">
          <div id="progressBar" class="bg-emerald-500 h-full w-0 transition-all duration-500"></div>
        </div>
      </div>
      <div id="checklist" class="space-y-4"></div>
    </section>

  </main>
</div>

<!-- MODALS CONTAINER -->

<!-- 1. STANDKASSE & VERKAUF MODAL -->
<div id="modalVerkauf" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 rounded-2xl max-w-lg w-full p-6 space-y-6 shadow-2xl border border-slate-200 dark:border-slate-800">
    <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-3">
      <h3 class="font-extrabold text-base text-emerald-600 dark:text-emerald-400 flex items-center gap-2">💰 Standkasse & Verkauf</h3>
      <button onclick="closeModal('modalVerkauf')" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 text-2xl font-bold">✕</button>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/50 p-5 rounded-2xl text-center space-y-3">
        <div class="font-extrabold text-xs text-amber-900 dark:text-amber-300">🥯 Belgische Waffel</div>
        <div id="countWaffeln" class="text-4xl font-black text-slate-900 dark:text-slate-100">0</div>
        <div class="flex justify-center gap-2 pt-2">
          <button onclick="addSale('waffel', -1)" class="w-12 h-12 rounded-xl bg-rose-500 text-white font-bold text-xl shadow hover:scale-105 active:scale-95 transition">-</button>
          <button onclick="addSale('waffel', 1)" class="w-12 h-12 rounded-xl bg-emerald-500 text-white font-bold text-xl shadow hover:scale-105 active:scale-95 transition">+</button>
        </div>
      </div>

      <div class="bg-sky-50 dark:bg-sky-950/40 border border-sky-200 dark:border-sky-800/50 p-5 rounded-2xl text-center space-y-3">
        <div class="font-extrabold text-xs text-sky-900 dark:text-sky-300">☕ Kinderpunsch</div>
        <div id="countPunsch" class="text-4xl font-black text-slate-900 dark:text-slate-100">0</div>
        <div class="flex justify-center gap-2 pt-2">
          <button onclick="addSale('punsch', -1)" class="w-12 h-12 rounded-xl bg-rose-500 text-white font-bold text-xl shadow hover:scale-105 active:scale-95 transition">-</button>
          <button onclick="addSale('punsch', 1)" class="w-12 h-12 rounded-xl bg-emerald-500 text-white font-bold text-xl shadow hover:scale-105 active:scale-95 transition">+</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 2. EINKAUFSLISTE MODAL -->
<div id="modalEinkaufsliste" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 rounded-2xl max-w-4xl w-full p-6 space-y-4 max-h-[85vh] overflow-y-auto shadow-2xl border border-slate-200 dark:border-slate-800">
    <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-3">
      <h3 class="font-extrabold text-base text-orange-600 dark:text-orange-400 flex items-center gap-2">🛒 Einkaufsliste & Preise</h3>
      <button onclick="closeModal('modalEinkaufsliste')" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 text-2xl font-bold">✕</button>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="bg-slate-100 dark:bg-slate-800 font-extrabold border-b border-slate-200 dark:border-slate-700">
            <th class="p-2.5 text-center">Gekauft</th>
            <th class="p-2.5">Artikel</th>
            <th class="p-2.5">Bedarf</th>
            <th class="p-2.5">Packung</th>
            <th class="p-2.5">Laden</th>
            <th class="p-2.5 text-right">Preis (€)</th>
          </tr>
        </thead>
        <tbody id="shoppingTableBody" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
      </table>
    </div>
    <div class="flex justify-between items-center pt-3 border-t border-slate-200 dark:border-slate-800 font-bold text-xs">
      <span>Gesamtkosten:</span>
      <span id="shoppingTotalCost" class="text-base text-emerald-500 font-extrabold">0,00 €</span>
    </div>
  </div>
</div>

<!-- 3. VERKABELUNG MODAL -->
<div id="modalVerkabelung" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 rounded-2xl max-w-4xl w-full p-6 space-y-4 max-h-[85vh] overflow-y-auto shadow-2xl border border-slate-200 dark:border-slate-800">
    <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-3">
      <h3 class="font-extrabold text-base text-sky-600 dark:text-sky-400 flex items-center gap-2">⚡ Strom- & Verkabelungsplaner</h3>
      <button onclick="closeModal('modalVerkabelung')" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 text-2xl font-bold">✕</button>
    </div>
    <div id="powerPool" class="flex flex-wrap gap-2 text-xs bg-slate-50 dark:bg-slate-950 p-3 rounded-xl border border-slate-200 dark:border-slate-800"></div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-bold">
      <div class="bg-sky-50 dark:bg-sky-950/30 p-4 rounded-xl border border-sky-200 dark:border-sky-800 space-y-2">
        <div class="flex justify-between text-sky-900 dark:text-sky-300"><span>🔌 Steckdose 1</span><span id="loadPhase1">0 W</span></div>
        <div id="phase1Items" class="min-h-[120px] bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-dashed border-slate-200 dark:border-slate-800 space-y-1"></div>
      </div>
      <div class="bg-sky-50 dark:bg-sky-950/30 p-4 rounded-xl border border-sky-200 dark:border-sky-800 space-y-2">
        <div class="flex justify-between text-sky-900 dark:text-sky-300"><span>🔌 Steckdose 2</span><span id="loadPhase2">0 W</span></div>
        <div id="phase2Items" class="min-h-[120px] bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-dashed border-slate-200 dark:border-slate-800 space-y-1"></div>
      </div>
      <div class="bg-sky-50 dark:bg-sky-950/30 p-4 rounded-xl border border-sky-200 dark:border-sky-800 space-y-2">
        <div class="flex justify-between text-sky-900 dark:text-sky-300"><span>🔌 Steckdose 3</span><span id="loadPhase3">0 W</span></div>
        <div id="phase3Items" class="min-h-[120px] bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-dashed border-slate-200 dark:border-slate-800 space-y-1"></div>
      </div>
    </div>
  </div>
</div>

<!-- 4. LAGERBESTAND MODAL -->
<div id="modalLagerbestand" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 rounded-2xl max-w-4xl w-full p-6 space-y-4 max-h-[85vh] overflow-y-auto shadow-2xl border border-slate-200 dark:border-slate-800">
    <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-3">
      <h3 class="font-extrabold text-base text-indigo-600 dark:text-indigo-400 flex items-center gap-2">📊 Lagerbestand</h3>
      <button onclick="closeModal('modalLagerbestand')" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 text-2xl font-bold">✕</button>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="bg-slate-100 dark:bg-slate-800 font-extrabold border-b border-slate-200 dark:border-slate-700">
            <th class="p-2.5">Kategorie</th>
            <th class="p-2.5">Gegenstand</th>
            <th class="p-2.5 text-center">Auf Lager</th>
            <th class="p-2.5 text-center">Status</th>
          </tr>
        </thead>
        <tbody id="stockTableBody" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
      </table>
    </div>
  </div>
</div>

<!-- 5. BOXENÜBERSICHT MODAL -->
<div id="modalBoxenuebersicht" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 rounded-2xl max-w-4xl w-full p-6 space-y-4 max-h-[85vh] overflow-y-auto shadow-2xl border border-slate-200 dark:border-slate-800">
    <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-3">
      <h3 class="font-extrabold text-base text-purple-600 dark:text-purple-400 flex items-center gap-2">📦 Boxenübersicht (1–12)</h3>
      <button onclick="closeModal('modalBoxenuebersicht')" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 text-2xl font-bold">✕</button>
    </div>
    <div id="boxOverviewGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
  </div>
</div>

<!-- 6. REZEPTE & PUNSCHRECHNER MODAL -->
<div id="modalRezepte" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 rounded-2xl max-w-2xl w-full p-6 space-y-4 max-h-[85vh] overflow-y-auto shadow-2xl border border-slate-200 dark:border-slate-800">
    <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-3">
      <h3 class="font-extrabold text-base text-rose-600 dark:text-rose-400 flex items-center gap-2">☕ Stand-Rezepte & Punschrechner</h3>
      <button onclick="closeModal('modalRezepte')" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 text-2xl font-bold">✕</button>
    </div>
    <div class="space-y-4 text-xs">
      <div class="bg-amber-50 dark:bg-amber-950/30 p-4 rounded-xl border border-amber-200 dark:border-amber-800/50 space-y-2">
        <div class="font-extrabold text-amber-900 dark:text-amber-300">🥯 Belgische Waffeln (Pro Teigspende)</div>
        <p class="text-slate-700 dark:text-slate-300 leading-relaxed">500g Butter, 300g Zucker, 2 Pck. Vanillezucker, 1 Prise Salz, 10 Eier, 1000g Mehl, 2 Pck. Backpulver, 400ml Milch.</p>
      </div>
      <div class="bg-rose-50 dark:bg-rose-950/30 p-4 rounded-xl border border-rose-200 dark:border-rose-800/50 space-y-3">
        <div class="flex justify-between items-center">
          <span class="font-extrabold text-rose-900 dark:text-rose-300">☕ Kinderpunsch Rechner</span>
          <div class="flex items-center gap-1 font-bold">
            <input type="number" id="punschCalcInput" value="8" min="4" max="80" step="4" onchange="updatePunschRecipe()" class="w-16 p-1.5 border border-slate-200 dark:border-slate-700 rounded-lg text-center bg-white dark:bg-slate-900 font-bold focus:ring-2 focus:ring-rose-500" />
            <span>Liter</span>
          </div>
        </div>
        <ul id="recipeIngredientsList" class="list-disc pl-4 space-y-1 font-medium text-slate-700 dark:text-slate-300"></ul>
      </div>
    </div>
  </div>
</div>

<!-- 7. ADMIN-PANEL MODAL -->
<div id="modalAdminpanel" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 rounded-2xl max-w-3xl w-full p-6 space-y-5 max-h-[85vh] overflow-y-auto shadow-2xl border border-slate-200 dark:border-slate-800">
    <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-3">
      <h3 class="font-extrabold text-base text-amber-500 flex items-center gap-2">👑 Admin Control Center</h3>
      <button onclick="closeModal('modalAdminpanel')" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 text-2xl font-bold">✕</button>
    </div>
    
    <div id="adminPermissionsGrid" class="space-y-4"></div>

    <div class="pt-4 border-t border-slate-200 dark:border-slate-800 flex flex-wrap gap-2 text-xs font-bold">
      <button onclick="addNewItemPrompt()" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl shadow transition">⚙️ Item Hinzufügen</button>
      <button onclick="downloadBackup()" class="px-4 py-2.5 bg-slate-700 hover:bg-slate-600 text-white rounded-xl shadow transition">💾 Backup Download</button>
      <button onclick="resetSeasonPrompt()" class="px-4 py-2.5 bg-rose-600 hover:bg-rose-500 text-white rounded-xl shadow transition">🔄 Saison-Reset</button>
    </div>
  </div>
</div>

<!-- ROLES MODAL -->
<div id="roleModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 rounded-2xl p-6 w-full max-w-xs text-center space-y-3 shadow-2xl border border-slate-200 dark:border-slate-800">
    <h3 class="font-extrabold text-sm border-b border-slate-200 dark:border-slate-800 pb-2">Benutzerrolle wählen</h3>
    <button onclick="selectRoleWithPassword('betrachter')" class="w-full py-2.5 bg-slate-100 dark:bg-slate-800 rounded-xl text-xs font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition">👁️ Betrachter</button>
    <button onclick="selectRoleWithPassword('helfer')" class="w-full py-2.5 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 rounded-xl text-xs font-bold hover:bg-emerald-500/20 transition">🤝 Helfer</button>
    <button onclick="selectRoleWithPassword('orga')" class="w-full py-2.5 bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/30 rounded-xl text-xs font-bold hover:bg-sky-500/20 transition">📋 Orga-Team</button>
