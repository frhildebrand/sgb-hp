          <button onclick="selectRoleWithPassword('helfer')" class="w-full py-2.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-xl font-semibold">🤝 Helfer</button>
          <button onclick="selectRoleWithPassword('orga')" class="w-full py-2.5 bg-sky-500/10 hover:bg-sky-500/20 text-sky-300 border border-sky-500/30 rounded-xl font-semibold">📋 Orga-Team</button>
