---
layout: base.njk
title: SG Barnstorf Weihnachtsmarkt
---

<!-- Direct Tailwind CDN Embed -->
<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-slate-950 text-slate-100 font-sans pb-12">
  <div class="max-w-6xl mx-auto px-4 py-6 space-y-6">
    
    <!-- HEADER & NAVIGATION -->
    <header class="flex items-center justify-between gap-4 bg-slate-900/90 backdrop-blur-md p-4 rounded-2xl border border-slate-800 shadow-2xl relative">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-xl">
          🎄
        </div>
        <div>
          <h1 class="font-bold text-sm sm:text-base text-slate-100 leading-tight">SG Barnstorf – Weihnachtsmarkt</h1>
          <div id="currentViewTitle" class="text-xs text-amber-400 font-semibold flex items-center gap-1.5 mt-0.5">
            <span>📋</span> Hauptliste & Inventar
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <button type="button" onclick="toggleRoleModal()" id="roleBadge" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-emerald-400 border border-emerald-500/30 transition shadow-sm">
          👁️ Rolle: BETRACHTER
        </button>

        <!-- Main Navigation Menu -->
        <div class="relative">
          <button type="button" onclick="toggleNavMenu()" class="p-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-slate-200 transition">
            ☰
          </button>

          <div id="navDropdown" class="hidden absolute right-0 mt-2 w-64 bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-2 z-50 text-xs font-medium">
            <button type="button" onclick="switchView('main')" class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-slate-800 flex items-center gap-2.5 text-slate-200">
              <span>📋</span> Hauptliste & Inventar
            </button>
            <button type="button" onclick="switchView('boxes')" class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-slate-800 flex items-center gap-2.5 text-slate-200">
              <span>📦</span> Lagerbestand & Boxen
            </button>
            <button type="button" onclick="switchView('recipes')" class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-slate-800 flex items-center gap-2.5 text-slate-200">
              <span>☕</span> Rezepte & Zutaten
            </button>
            <button type="button" onclick="switchView('power')" class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-slate-800 flex items-center gap-2.5 text-slate-200">
              <span>⚡</span> Stromverbrauch-Rechner
            </button>
            <button type="button" onclick="switchView('sales')" class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-slate-800 flex items-center gap-2.5 text-slate-200">
              <span>💰</span> Standkasse & Verkauf
            </button>
            
            <div class="my-1.5 border-t border-slate-800"></div>

            <button type="button" onclick="switchView('admin')" class="w-full text-left px-3 py-2.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold flex items-center gap-2.5">
              <span>👑</span> Admin Control Center
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- VIEW 1: HAUPTLISTE & INVENTAR -->
    <section id="viewChecklist" class="space-y-6">
      <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 shadow-xl space-y-4">
        <div class="flex flex-col sm:flex-row gap-3 justify-between items-center">
          <div class="w-full sm:w-1/2">
            <input type="text" id="searchInput" placeholder="🔍 Suchen nach Gegenstand, Helfer, Box..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-xs font-medium text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500/50" />
          </div>
          <div id="syncStatus" class="text-xs text-slate-400 font-mono">⏳ Verbinde...</div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-semibold mb-2 text-slate-300">
            <span>Gesamtfortschritt</span>
            <span id="progressText" class="text-amber-400">0% erledigt</span>
          </div>
          <div class="w-full bg-slate-950 rounded-full h-3 overflow-hidden border border-slate-800">
            <div id="progressBar" class="bg-gradient-to-r from-amber-500 to-emerald-500 h-full w-0 transition-all duration-300"></div>
          </div>
        </div>

        <!-- Filter-Buttons -->
        <div class="flex gap-2 overflow-x-auto pb-1 text-xs font-medium">
          <button type="button" onclick="filterCategory('all')" id="btnFilterAll" class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700">Alle</button>
          <button type="button" onclick="filterCategory('Offen')" id="btnFilterOffen" class="px-3.5 py-1.5 rounded-lg bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/40 font-bold">🔴 Offen</button>
          <button type="button" onclick="filterCategory('Vorbereitet')" id="btnFilterVorbereitet" class="px-3.5 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40">🟡 Vorbereitet</button>
          <button type="button" onclick="filterCategory('Verteilt')" id="btnFilterVerteilt" class="px-3.5 py-1.5 rounded-lg bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 border border-sky-500/40">🔵 Verteilt</button>
          <button type="button" onclick="filterCategory('Erledigt')" id="btnFilterErledigt" class="px-3.5 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40">🟢 Erledigt</button>
        </div>
      </div>

      <!-- Tabellen-Container für Inventar -->
      <div id="checklist" class="space-y-4"></div>
    </section>

    <!-- VIEW 2: LAGERBESTAND & BOXEN -->
    <section id="viewBoxes" class="hidden space-y-6">
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
        <h2 class="text-base font-bold text-slate-100 flex items-center gap-2">📦 Boxenübersicht & Lagerorte</h2>
        <div id="boxOverviewGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>
    </section>

    <!-- VIEW 3: REZEPTE & ZUTATEN -->
    <section id="viewRecipes" class="hidden space-y-6">
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
        <h2 class="text-base font-bold text-slate-100 flex items-center gap-2">☕ Kinderpunsch-Rechner</h2>
        <p class="text-xs text-slate-400">Stelle die gewünschte Menge ein, um die benötigten Zutaten automatisch hochzurechnen.</p>
        
        <div class="flex items-center gap-4 bg-slate-950 p-4 rounded-xl border border-slate-800">
          <input type="range" id="punschLiters" min="4" max="40" step="4" value="8" oninput="updateRecipeScaling()" class="w-full accent-amber-500" />
          <span id="punschLitersLabel" class="font-bold text-amber-400 text-sm whitespace-nowrap">8 Liter</span>
        </div>
        
        <ul id="punschRecipeList" class="space-y-2 text-xs sm:text-sm text-slate-200 list-disc pl-5 font-medium"></ul>
      </div>

      <!-- Ausschriebene Grundrezepte -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-5 space-y-3">
          <h3 class="font-bold text-amber-400 text-sm flex items-center gap-2">☕ Original Kinderpunsch (Grundrezept 8L)</h3>
          <ul class="text-xs text-slate-300 space-y-1.5 list-disc pl-4 font-medium">
            <li><strong>2,0 Liter</strong> Wasser</li>
            <li><strong>10 Beutel</strong> Wintertee</li>
            <li><strong>1,0 Liter</strong> Orangensaft</li>
            <li><strong>2,5 Liter</strong> Apfelsaft</li>
            <li><strong>2,5 Liter</strong> Roter Traubensaft</li>
            <li><strong>2 Stück</strong> Zimtstangen</li>
            <li><strong>5 Beutel</strong> Glühfix</li>
          </ul>
        </div>

        <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-5 space-y-3">
          <h3 class="font-bold text-emerald-400 text-sm flex items-center gap-2">🧇 SG Barnstorf Herzwaffeln (ca. 30 Stk.)</h3>
          <ul class="text-xs text-slate-300 space-y-1.5 list-disc pl-4 font-medium">
            <li><strong>500g</strong> Butter (weich)</li>
            <li><strong>300g</strong> Zucker & 2 Pck. Vanillezucker</li>
            <li><strong>1 Prise</strong> Salz</li>
            <li><strong>10 Stück</strong> Eier</li>
            <li><strong>1.000g</strong> Weizenmehl (Typ 405)</li>
            <li><strong>2 Pck.</strong> Backpulver</li>
            <li><strong>ca. 400ml</strong> Milch</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- VIEW 4: STROMVERBRAUCH-RECHNER -->
    <section id="viewPower" class="hidden space-y-6">
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
        <h2 class="text-base font-bold text-slate-100 flex items-center gap-2">⚡ Stromverbrauch & Last-Rechner</h2>
        <p class="text-xs text-slate-400">Berechne die Gesamtleistung am Stand, um Sicherungsausfälle zu vermeiden (Max. 3680W pro 16A Phase!).</p>

        <div class="space-y-2 text-xs font-medium">
          <div class="flex justify-between items-center bg-slate-950 p-3 rounded-xl border border-slate-800">
            <span class="text-slate-300">🧇 Waffeleisen (ca. 1200W)</span>
            <input type="number" id="pwrWaffel" value="3" onchange="calculatePowerLoad()" class="w-16 bg-slate-900 border border-slate-700 text-amber-400 rounded-lg p-1 text-center font-bold" />
          </div>
          <div class="flex justify-between items-center bg-slate-950 p-3 rounded-xl border border-slate-800">
            <span class="text-slate-300">☕ Einkochautomat (ca. 1800W)</span>
            <input type="number" id="pwrPunsch" value="2" onchange="calculatePowerLoad()" class="w-16 bg-slate-900 border border-slate-700 text-amber-400 rounded-lg p-1 text-center font-bold" />
          </div>
          <div class="flex justify-between items-center bg-slate-950 p-3 rounded-xl border border-slate-800">
            <span class="text-slate-300">🫖 Wasserkocher (ca. 2200W)</span>
            <input type="number" id="pwrWasser" value="1" onchange="calculatePowerLoad()" class="w-16 bg-slate-900 border border-slate-700 text-amber-400 rounded-lg p-1 text-center font-bold" />
          </div>
        </div>

        <div id="powerSummary" class="p-4 bg-amber-500/10 border border-amber-500/30 text-amber-300 rounded-xl font-semibold text-xs text-center">
          Gesamtleistung: <span class="text-amber-400 font-bold" id="totalWatts">9400 Watt</span> (Achtung: Auf verschiedene Phasen aufteilen!)
        </div>
      </div>
    </section>

    <!-- VIEW 5: STANDKASSE & VERKAUF -->
    <section id="viewSales" class="hidden space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4 text-center">
          <h3 class="font-bold text-slate-100 text-base">☕ Kinderpunsch (2,00 €)</h3>
          <div class="flex items-center justify-center gap-3">
            <button type="button" onclick="addSale('punsch', -1)" class="cash-btn w-12 h-12 bg-slate-800 hover:bg-slate-700 font-bold text-xl rounded-xl border border-slate-700 text-slate-200 transition">-1</button>
            <input type="number" id="soldPunsch" value="0" readonly class="w-24 text-center font-extrabold text-2xl border border-slate-800 rounded-xl py-2 bg-slate-950 text-amber-400" />
            <button type="button" onclick="addSale('punsch', 1)" class="cash-btn w-12 h-12 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xl rounded-xl shadow-lg transition">+1</button>
          </div>
        </div>

        <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4 text-center">
          <h3 class="font-bold text-slate-100 text-base">🧇 Waffeln (2,00 €)</h3>
          <div class="flex items-center justify-center gap-3">
            <button type="button" onclick="addSale('waffles', -1)" class="cash-btn w-12 h-12 bg-slate-800 hover:bg-slate-700 font-bold text-xl rounded-xl border border-slate-700 text-slate-200 transition">-1</button>
            <input type="number" id="soldWaffles" value="0" readonly class="w-24 text-center font-extrabold text-2xl border border-slate-800 rounded-xl py-2 bg-slate-950 text-amber-400" />
            <button type="button" onclick="addSale('waffles', 1)" class="cash-btn w-12 h-12 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xl rounded-xl shadow-lg transition">+1</button>
          </div>
        </div>
      </div>

      <!-- Finanzen & Rechner -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
        <h3 class="font-bold text-amber-400 text-xs uppercase tracking-wider">📊 Live Umsatz & Bilanz</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs mb-4">
          <div>
            <label class="text-slate-400 block mb-1">Standgebühren (€)</label>
            <input type="number" id="standFee" value="0.00" onchange="calculateSalesStats()" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2 text-slate-100 font-bold" />
          </div>
          <div>
            <label class="text-slate-400 block mb-1">Sonstige Einnahmen (€)</label>
            <input type="number" id="otherRevenue" value="0.00" onchange="calculateSalesStats()" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2 text-slate-100 font-bold" />
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 text-center">
          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
            <div class="text-[11px] text-slate-400">Einnahmen</div>
            <div id="statRevenue" class="text-base font-bold text-emerald-400">0,00 €</div>
          </div>
          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
            <div class="text-[11px] text-slate-400">Ausgaben</div>
            <div id="statExpenses" class="text-base font-bold text-red-400">0,00 €</div>
          </div>
          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
            <div class="text-[11px] text-slate-400">Gewinn</div>
            <div id="statProfit" class="text-base font-extrabold text-amber-400">0,00 €</div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW 6: ADMIN CONTROL CENTER -->
    <section id="viewAdmin" class="hidden space-y-6">
      <div class="bg-slate-900/90 border border-amber-500/30 rounded-2xl p-6 shadow-2xl space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800">
          <div>
            <h2 class="text-base font-bold text-amber-400 flex items-center gap-2">
              <span>👑</span> Admin Control Center
            </h2>
            <p class="text-xs text-slate-400">Passwörter & feingliedrige Einzelberechtigungen verwalten.</p>
          </div>
          <button type="button" onclick="saveRoleSettings()" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs transition shadow-md">
            💾 Speichern
          </button>
        </div>

        <div class="space-y-4 text-xs">
          <!-- HELFER -->
          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
              <span class="font-bold text-emerald-400">🤝 Helfer Rolle</span>
              <div class="flex items-center gap-2">
                <span class="text-slate-400">PW:</span>
                <input type="text" id="pwd_helfer" class="bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-slate-100 font-mono w-32" />
              </div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-slate-300">
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_helfer_cash" /> 🛒 Kasse</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_helfer_packed" /> ✅ Gepackt</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_helfer_qty" /> 🔢 Menge</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_helfer_stock" /> 📦 Auf Lager</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_helfer_box" /> 🏷️ Box</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_helfer_status" /> 🔄 Status</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_helfer_prices" /> 💶 Preise</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_helfer_log" /> 📜 Log</label>
            </div>
          </div>

          <!-- ORGA -->
          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
              <span class="font-bold text-sky-400">📋 Orga-Team Rolle</span>
              <div class="flex items-center gap-2">
                <span class="text-slate-400">PW:</span>
                <input type="text" id="pwd_orga" class="bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-slate-100 font-mono w-32" />
              </div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-slate-300">
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_orga_cash" /> 🛒 Kasse</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_orga_packed" /> ✅ Gepackt</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_orga_qty" /> 🔢 Menge</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_orga_stock" /> 📦 Auf Lager</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_orga_box" /> 🏷️ Box</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_orga_status" /> 🔄 Status</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_orga_prices" /> 💶 Preise</label>
              <label class="flex items-center gap-2"><input type="checkbox" id="perm_orga_log" /> 📜 Log</label>
            </div>
          </div>

          <!-- ADMIN -->
          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-amber-400">🔓 Admin Rolle</span>
              <div class="flex items-center gap-2">
                <span class="text-slate-400">PW:</span>
                <input type="text" id="pwd_admin" class="bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-slate-100 font-mono w-32" />
              </div>
            </div>
            <p class="text-slate-500 text-[11px]">Der Admin besitzt automatisch immer alle Berechtigungen.</p>
          </div>
        </div>

        <!-- Aktivitäten-Protokoll -->
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
          <h3 class="font-bold text-slate-300 text-xs uppercase tracking-wider">📜 Aktivitäts-Protokoll</h3>
          <ul id="activityLogList" class="text-xs text-slate-400 space-y-1 max-h-40 overflow-y-auto pt-2">
            <li class="italic text-slate-500">Keine Aktivitäten aufgezeichnet.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ROLE MODAL -->
    <div id="roleModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
      <div class="bg-slate-900 border border-slate-800 text-slate-100 rounded-2xl p-6 w-full max-w-sm space-y-4 text-center shadow-2xl">
        <h3 class="font-bold text-sm">Rolle auswählen</h3>
        <div class="space-y-2 text-xs">
          <button type="button" onclick="selectRoleWithPassword('betrachter')" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 rounded-xl font-semibold">👁️ Betrachter (Nur Lesen)</button>
          <button type="button" onclick="selectRoleWithPassword('helfer')" class="w-full py-2.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-xl font-semibold">🤝 Helfer</button>
          <button type="button" onclick="selectRoleWithPassword('orga')" class="w-full py-2.5 bg-sky-500/10 hover:bg-sky-500/20 text-sky-300 border border-sky-500/30 rounded-xl font-semibold">📋 Orga-Team</button>
          <button type="button" onclick="selectRoleWithPassword('admin')" class="w-full py-2.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-xl font-bold">👑 Admin</button>
        </div>
        <button type="button" onclick="closeRoleModal()" class="text-xs text-slate-500 hover:text-slate-300 pt-1">Abbrechen</button>
      </div>
    </div>

  </div>
</div>

<script src="/assets/weihnachtsmarkt/weihnachtsmarkt-data.js"></script>
<script src="/assets/weihnachtsmarkt/weihnachtsmarkt.js"></script>
