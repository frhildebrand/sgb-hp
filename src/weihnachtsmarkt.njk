<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-6xl mx-auto px-2 sm:px-4 py-6 font-sans text-slate-800 print:p-0 print:max-w-none">
  
  <!-- Live Notice Banner -->
  <div id="noticeBanner" class="hidden bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 text-white rounded-2xl p-4 shadow-lg mb-6 flex items-center justify-between gap-3 animate-pulse print:hidden">
    <div class="flex items-center gap-3">
      <span class="text-2xl">📢</span>
      <div>
        <span class="font-extrabold uppercase text-xs tracking-wider opacity-90 block">Wichtige Durchsage</span>
        <p id="noticeBannerText" class="text-sm font-bold sm:text-base"></p>
      </div>
    </div>
    <button onclick="dismissNotice()" class="text-white/80 hover:text-white font-bold p-1 text-sm bg-black/10 rounded-lg px-2">Schließen</button>
  </div>

  <!-- Header -->
  <div class="bg-gradient-to-r from-emerald-900 via-emerald-800 to-teal-900 text-white rounded-3xl p-6 sm:p-8 text-center shadow-xl mb-6 relative overflow-hidden print:hidden">
    <div class="absolute -top-12 -left-12 w-40 h-40 bg-emerald-500/20 rounded-full blur-2xl"></div>
    <div class="absolute -bottom-12 -right-12 w-40 h-40 bg-amber-500/20 rounded-full blur-2xl"></div>

    <div class="flex items-center justify-between gap-2 mb-4 relative z-10">
      <div id="roleBadge" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white/10 backdrop-blur-md border border-white/20 text-emerald-100 flex items-center gap-1.5 shadow-sm">
        👁️ Rolle: Betrachter
      </div>
      
      <div class="flex items-center gap-2">
        <span id="syncStatus" class="hidden sm:inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-1 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 text-emerald-200">
          ⏳ Lädt...
        </span>
        <button id="adminToggleBtn" onclick="toggleRoleModal()" class="px-3 py-1.5 rounded-xl text-xs font-extrabold transition shadow-md flex items-center gap-1.5 bg-amber-400 text-slate-950 hover:bg-amber-300">
          🔑 Rolle / Login
        </button>
      </div>
    </div>

    <h1 class="text-2xl sm:text-4xl font-black tracking-tight mb-2 text-amber-300 drop-shadow-sm">🎄 SG Barnstorf – Stand-Planung</h1>
    <p class="text-emerald-100/90 text-sm sm:text-base mb-6 max-w-xl mx-auto font-medium">Vorbereitungsliste & Stand-Kasse für Kinderpunsch & Waffelstand am 1. Advent</p>
    
    <!-- Progress Bar -->
    <div class="max-w-xl mx-auto bg-black/20 backdrop-blur-md rounded-full h-6 border border-white/10 overflow-hidden relative shadow-inner mb-6">
      <div id="progressBar" class="bg-gradient-to-r from-amber-400 via-amber-300 to-emerald-400 h-full w-0 transition-all duration-500"></div>
      <div id="progressText" class="absolute inset-0 flex items-center justify-center text-xs sm:text-sm font-black text-white drop-shadow">0% erledigt</div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap justify-center gap-2.5 relative z-10">
      <button onclick="openShoppingModal()" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-md flex items-center gap-2">
        🛒 Einkaufsliste & Preise
      </button>
      <button onclick="openWiringModal()" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-sky-500/20 backdrop-blur-md border border-sky-300/30 text-sky-100 hover:bg-sky-500/30 transition shadow-md flex items-center gap-2">
        ⚡ Strom-Planer
      </button>
      <button onclick="openStockModal()" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-indigo-500/20 backdrop-blur-md border border-indigo-300/30 text-indigo-100 hover:bg-indigo-500/30 transition shadow-md flex items-center gap-2">
        📊 Lagerbestand
      </button>
      <button onclick="openBoxOverview()" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-emerald-500/20 backdrop-blur-md border border-emerald-300/30 text-emerald-100 hover:bg-emerald-500/30 transition shadow-md flex items-center gap-2">
        📦 Boxen-Übersicht
      </button>
      <button onclick="window.print()" class="px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-white/10 hover:bg-white/20 text-white transition shadow-md flex items-center gap-2">
        🖨️ Drucken
      </button>
    </div>
  </div>

  <!-- Admin Panel Bar -->
  <div id="adminPanel" class="hidden bg-gradient-to-br from-amber-50 via-orange-50 to-amber-100 border-2 border-amber-300 rounded-3xl p-5 shadow-lg mb-6 print:hidden">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-amber-200/80 pb-3 mb-4">
      <span class="font-extrabold text-amber-950 text-base flex items-center gap-2">⚙️ Admin Control-Center</span>
      <div class="flex flex-wrap gap-2">
        <button onclick="openCreateItemModal()" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-emerald-700 text-white hover:bg-emerald-800 transition shadow-sm">➕ Neuer Gegenstand</button>
        <button onclick="syncIngredientsToShoppingList()" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-amber-700 text-white hover:bg-amber-800 transition">🛒 Punsch-Zutaten synchronisieren</button>
        <button onclick="setGlobalNotice()" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-orange-600 text-white hover:bg-orange-700 transition">📢 Durchsage setzen</button>
        <button onclick="exportDataJSON()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-700 text-white hover:bg-slate-800 transition">💾 Backup</button>
        <button onclick="importDataJSON()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-700 text-white hover:bg-slate-800 transition">📂 Import</button>
        <button onclick="changeAdminPassword()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-sky-700 text-white hover:bg-sky-800 transition">🔑 PW Ändern</button>
        <button onclick="resetSeason()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-red-600 text-white hover:bg-red-700 transition">🔄 Saison-Reset</button>
      </div>
    </div>

    <!-- Activity Log -->
    <div class="bg-white/80 backdrop-blur border border-amber-200/60 rounded-2xl p-3.5 text-xs text-slate-700">
      <div class="flex justify-between items-center mb-2">
        <span class="font-bold text-amber-950 flex items-center gap-1.5">⏱️ Aktivitäten-Logbuch</span>
        <button onclick="clearActivityLog()" class="text-[10px] text-slate-400 hover:text-slate-600 underline">Log leeren</button>
      </div>
      <ul id="activityLogList" class="space-y-1 font-mono text-[11px] text-slate-600 max-h-28 overflow-y-auto">
        <li class="italic text-slate-400">Keine Aktivitäten protokolliert.</li>
      </ul>
    </div>
  </div>

  <!-- ROSHOP Aushang -->
  <div class="bg-amber-50/80 border border-amber-200/80 rounded-3xl p-5 shadow-sm mb-6 print:hidden">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-2xl">📌</span>
      <div>
        <h3 class="font-bold text-slate-900 text-sm sm:text-base">Aktueller Aushang bei ROSHOP (Helfer & Teigspenden)</h3>
        <p class="text-xs text-slate-600">Fotos/Scans der ausgehängten Listen für Samstag und Sonntag:</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-white border border-amber-200/60 rounded-2xl p-3 text-center">
        <span class="font-bold text-xs sm:text-sm text-amber-900 block mb-2">📅 Samstag (1. Adventswochenende)</span>
        <div class="bg-slate-50 border border-slate-100 rounded-xl p-2 flex justify-center items-center overflow-hidden min-h-[200px]">
          <img src="/images/roshop_samstag.jpg" alt="Aushang Samstag" class="max-h-[450px] w-auto object-contain rounded shadow-sm" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'py-12 text-amber-700/70 text-xs italic\'>📷 Noch kein Foto für <b>Samstag</b> hochgeladen.</div>';" />
        </div>
      </div>
      <div class="bg-white border border-amber-200/60 rounded-2xl p-3 text-center">
        <span class="font-bold text-xs sm:text-sm text-amber-900 block mb-2">📅 Sonntag (1. Adventswochenende)</span>
        <div class="bg-slate-50 border border-slate-100 rounded-xl p-2 flex justify-center items-center overflow-hidden min-h-[200px]">
          <img src="/images/roshop_sonntag.jpg" alt="Aushang Sonntag" class="max-h-[450px] w-auto object-contain rounded shadow-sm" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'py-12 text-amber-700/70 text-xs italic\'>📷 Noch kein Foto für <b>Sonntag</b> hochgeladen.</div>';" />
        </div>
      </div>
    </div>
  </div>

  <!-- Rezepte & Punsch-Skalierer -->
  <div class="bg-white border border-slate-200/80 rounded-3xl p-5 shadow-sm mb-6 print:break-inside-avoid">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3 mb-4">
      <h2 class="text-lg font-bold text-emerald-950 flex items-center gap-2">📜 Stand-Rezepte</h2>
      <div class="flex items-center gap-2 text-xs bg-emerald-50/60 px-3 py-1.5 rounded-xl border border-emerald-200">
        <span class="font-bold text-emerald-900">☕ Punsch-Rechner:</span>
        <label class="flex items-center gap-1.5 font-semibold text-slate-700">
          Ziel-Menge:
          <input type="number" id="punschLiters" value="8" min="1" max="200" step="1" onchange="updateRecipeScaling()" class="w-16 border border-slate-300 rounded-lg text-center py-0.5 text-xs font-bold bg-white focus:outline-none focus:border-emerald-500" /> Liter
        </label>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-emerald-50/40 border border-emerald-100 rounded-2xl p-4 text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-bold text-emerald-900 text-sm sm:text-base mb-2"><span>🧇</span> Belgische Waffeln (Spenden-Rezept)</div>
        <p class="text-slate-500 mb-2 text-xs italic">Bitte eine ausreichend große Schüssel benutzen (2l reichen nicht)!</p>
        <ul class="list-disc list-inside space-y-1 text-slate-700 mb-3 font-medium">
          <li><b>5</b> Eier</li>
          <li><b>300 g</b> Zucker</li>
          <li><b>2 Pck.</b> Vanillezucker</li>
          <li><b>2 Prisen</b> Salz</li>
          <li><b>400 g</b> Butter (weich)</li>
          <li><b>500 g</b> Mehl</li>
          <li><b>½ Pck.</b> Backpulver</li>
          <li><b>200 ml</b> Milch</li>
        </ul>
        <div class="border-t border-emerald-200/60 pt-2 text-slate-600 space-y-1 text-[11px]">
          <p><b>Zubereitung:</b> Eier, Zucker, Vanillezucker, Salz schaumig schlagen. Weiche Butter einrühren. Mehl + Backpulver mit Milch abwechselnd unterrühren.</p>
        </div>
      </div>

      <div class="bg-red-50/40 border border-red-100 rounded-2xl p-4 text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-bold text-red-900 text-sm sm:text-base mb-2"><span>☕</span> Winter-Kinderpunsch (<span id="punschLitersLabel">8 Liter</span>)</div>
        <p class="text-slate-500 mb-2 text-xs italic">Im Einkochautomaten erhitzen – nicht kochen lassen!</p>
        <ul id="punschRecipeList" class="list-disc list-inside space-y-1 text-slate-700 mb-3 font-medium"></ul>
        <div class="border-t border-red-200/60 pt-2 text-slate-600 space-y-1 text-[11px]">
          <p><b>Zubereitung:</b> Tee kochen, ziehen lassen, Beutel entfernen. Säfte & Glühfix zugeben und langsam erhitzen.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Verkaufsstatistik & Stand-Kasse -->
  <div class="bg-white border border-slate-200/80 rounded-3xl p-5 shadow-sm mb-6 print:hidden">
    <h2 class="text-lg font-bold text-slate-900 mb-3 flex items-center gap-2 border-b border-slate-100 pb-2">📈 Verkaufsstatistik & Stand-Kasse</h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-xs sm:text-sm mb-4">
      <div class="bg-slate-50 border border-slate-200/60 p-3 rounded-2xl">
        <label class="block font-bold text-slate-700 mb-1">Tassen Punsch:</label>
        <div class="flex items-center gap-1.5">
          <input type="number" id="soldPunsch" value="0" min="0" onchange="calculateSalesStats()" class="role-helfer-field w-16 border border-slate-300 rounded-lg p-1.5 text-center font-bold text-slate-900 focus:outline-none" />
          <span class="text-slate-400">x</span>
          <input type="number" step="0.50" id="pricePunsch" value="2.50" onchange="calculateSalesStats()" class="role-orga-field w-16 border border-slate-300 rounded-lg p-1.5 text-right font-bold text-slate-900 focus:outline-none" /> €
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200/60 p-3 rounded-2xl">
        <label class="block font-bold text-slate-700 mb-1">Verkaufte Waffeln:</label>
        <div class="flex items-center gap-1.5">
          <input type="number" id="soldWaffles" value="0" min="0" onchange="calculateSalesStats()" class="role-helfer-field w-16 border border-slate-300 rounded-lg p-1.5 text-center font-bold text-slate-900 focus:outline-none" />
          <span class="text-slate-400">x</span>
          <input type="number" step="0.50" id="priceWaffles" value="2.00" onchange="calculateSalesStats()" class="role-orga-field w-16 border border-slate-300 rounded-lg p-1.5 text-right font-bold text-slate-900 focus:outline-none" /> €
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200/60 p-3 rounded-2xl">
        <label class="block font-bold text-slate-700 mb-1">Standgebühr (Fixkosten):</label>
        <div class="flex items-center gap-1">
          <input type="number" step="1.00" id="standFee" value="0.00" min="0" onchange="calculateSalesStats()" class="role-orga-field w-20 border border-slate-300 rounded-lg p-1.5 text-right font-bold text-slate-900 focus:outline-none" /> €
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200/60 p-3 rounded-2xl">
        <label class="block font-bold text-slate-700 mb-1">Sonstiges / Spenden:</label>
        <div class="flex items-center gap-1">
          <input type="number" step="1.00" id="otherRevenue" value="0.00" onchange="calculateSalesStats()" class="role-helfer-field w-20 border border-slate-300 rounded-lg p-1.5 text-right font-bold text-slate-900 focus:outline-none" /> €
        </div>
      </div>
    </div>

    <!-- Live Kassen-Ergebnis -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center border-t border-slate-100 pt-3">
      <div class="bg-blue-50/80 border border-blue-200/60 p-3 rounded-2xl">
        <span class="block text-xs font-bold text-blue-800 uppercase tracking-wider">Einnahmen (Brutto)</span>
        <span id="statRevenue" class="text-lg font-black text-blue-950">0,00 €</span>
      </div>
      <div class="bg-amber-50/80 border border-amber-200/60 p-3 rounded-2xl">
        <span class="block text-xs font-bold text-amber-800 uppercase tracking-wider">Gesamtkosten (Einkauf + Gebühr)</span>
        <span id="statExpenses" class="text-lg font-black text-amber-950">0,00 €</span>
      </div>
      <div class="bg-emerald-50/80 border border-emerald-200/60 p-3 rounded-2xl">
        <span class="block text-xs font-bold text-emerald-800 uppercase tracking-wider">Reingewinn (SG Jugend)</span>
        <span id="statProfit" class="text-lg font-black text-emerald-950">0,00 €</span>
      </div>
    </div>
  </div>

  <!-- Suche & Status-Filter -->
  <div class="space-y-4 mb-8 print:hidden">
    <input type="text" id="searchInput" placeholder="🔍 Gegenstand, Person, Menge oder Box suchen..." 
      class="w-full bg-white border border-slate-300 text-slate-900 placeholder-slate-400 rounded-2xl px-4 py-3.5 text-sm focus:outline-none focus:border-emerald-500 transition shadow-sm" />
    
    <div class="flex flex-wrap justify-center gap-2" id="filterContainer">
      <button onclick="setFilter('all', this)" class="filter-btn active px-4 py-2 rounded-xl border border-emerald-600 bg-emerald-600 text-white font-bold text-xs sm:text-sm shadow-sm">Alle</button>
      <button onclick="setFilter('Offen', this)" class="filter-btn px-4 py-2 rounded-xl border border-slate-200 bg-white text-red-600 font-medium text-xs sm:text-sm hover:border-red-400">Offen</button>
      <button onclick="setFilter('Vorbereitet', this)" class="filter-btn px-4 py-2 rounded-xl border border-slate-200 bg-white text-amber-600 font-medium text-xs sm:text-sm hover:border-amber-400">Vorbereitet</button>
      <button onclick="setFilter('Verteilt', this)" class="filter-btn px-4 py-2 rounded-xl border border-slate-200 bg-white text-sky-600 font-medium text-xs sm:text-sm hover:border-sky-400">Verteilt</button>
      <button onclick="setFilter('Eingekauft', this)" class="filter-btn px-4 py-2 rounded-xl border border-slate-200 bg-white text-emerald-600 font-medium text-xs sm:text-sm hover:border-emerald-400">Eingekauft</button>
      <button onclick="setFilter('Erledigt', this)" class="filter-btn px-4 py-2 rounded-xl border border-slate-200 bg-white text-emerald-600 font-medium text-xs sm:text-sm hover:border-emerald-400">Erledigt</button>
    </div>
  </div>

  <!-- Checklist Container -->
  <div id="checklist" class="space-y-8"></div>

</div>

<!-- Modal: Rollen-Wechsel -->
<div id="roleModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 print:hidden">
  <div class="bg-white border border-slate-200 rounded-3xl max-w-sm w-full p-6 shadow-2xl">
    <h3 class="text-lg font-bold text-slate-900 mb-2">🔑 Rollen-Wechsel</h3>
    <p class="text-xs text-slate-500 mb-4">Wähle deine Zugriffsrolle für die Bearbeitung aus:</p>

    <div class="space-y-2 mb-6">
      <button onclick="selectRole('betrachter')" class="w-full text-left p-3 rounded-2xl border border-slate-200 hover:border-emerald-500 transition">
        <span class="font-bold text-slate-900 text-sm block">👁️ Betrachter</span>
        <span class="text-[11px] text-slate-500">Nur Lesen (Smartphone-Sicher)</span>
      </button>

      <button onclick="selectRole('helfer')" class="w-full text-left p-3 rounded-2xl border border-slate-200 hover:border-emerald-500 transition">
        <span class="font-bold text-slate-900 text-sm block">🤝 Helfer</span>
        <span class="text-[11px] text-slate-500">Kann Gepackt-Haken & Kasse bedienen</span>
      </button>

      <button onclick="selectRole('orga')" class="w-full text-left p-3 rounded-2xl border border-slate-200 hover:border-emerald-500 transition">
        <span class="font-bold text-slate-900 text-sm block">📋 Orga-Team</span>
        <span class="text-[11px] text-slate-500">Status, Mengen & Namen anpassen</span>
      </button>

      <button onclick="promptAdminLogin()" class="w-full text-left p-3 rounded-2xl border border-amber-300 bg-amber-50 hover:border-amber-500 transition">
        <span class="font-bold text-amber-950 text-sm block">🔒 Admin</span>
        <span class="text-[11px] text-amber-800">Vollzugriff, Artikel-Löschen, Reset</span>
      </button>
    </div>

    <button onclick="closeRoleModal()" class="w-full py-2.5 bg-slate-100 text-slate-600 font-bold rounded-xl hover:bg-slate-200 text-xs">Schließen</button>
  </div>
</div>

<!-- Modal: Admin Item -->
<div id="itemModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 print:hidden">
  <div class="bg-white border border-slate-200 rounded-3xl max-w-md w-full p-6 shadow-2xl">
    <h3 id="itemModalTitle" class="text-lg font-bold text-slate-900 mb-4">Gegenstand bearbeiten</h3>
    <div class="space-y-4 text-xs sm:text-sm">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Name des Gegenstands:</label>
        <input type="text" id="modalItemTitle" class="w-full border border-slate-300 rounded-xl p-2.5 focus:border-emerald-500 focus:outline-none" />
      </div>
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Kategorie:</label>
        <select id="modalItemCat" onchange="handleCatSelectChange(this)" class="w-full border border-slate-300 rounded-xl p-2.5 bg-white focus:border-emerald-500 focus:outline-none"></select>
        <input type="text" id="modalCustomCat" placeholder="Neue Kategorie eingeben..." class="w-full border border-slate-300 rounded-xl p-2.5 mt-2 hidden focus:border-emerald-500 focus:outline-none" />
      </div>
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Zusatzdetails / Hinweistext:</label>
        <input type="text" id="modalItemDetails" placeholder="z. B. Verpackungs-Tipp..." class="w-full border border-slate-300 rounded-xl p-2.5 focus:border-emerald-500 focus:outline-none" />
      </div>
    </div>
    <div class="flex justify-end gap-2 mt-6">
      <button onclick="closeItemModal()" class="px-4 py-2 bg-slate-100 text-slate-600 font-bold rounded-xl hover:bg-slate-200 text-xs">Abbrechen</button>
      <button onclick="saveItemFromModal()" class="px-4 py-2 bg-emerald-700 text-white font-bold rounded-xl hover:bg-emerald-800 text-xs">Speichern</button>
    </div>
  </div>
</div>

<!-- Modal: Einkaufsliste -->
<div id="shoppingModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 print:hidden">
  <div class="bg-white border border-slate-200 rounded-3xl max-w-5xl w-full max-h-[90vh] flex flex-col shadow-2xl">
    <div class="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between bg-amber-50 rounded-t-3xl">
      <div>
        <h2 class="text-lg font-bold text-amber-900 flex items-center gap-2">🛒 Interaktive Einkaufsliste & Preise</h2>
        <p class="text-xs text-amber-800/80 mt-0.5">Packungsgrößen & Einzelpreise eingeben. Gesamtmenge und Kosten berechnen sich automatisch!</p>
      </div>
      <button onclick="closeShoppingModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">✕</button>
    </div>
    <div class="p-4 sm:p-6 overflow-y-auto space-y-4">
      <div class="table-container">
