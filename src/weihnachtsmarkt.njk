              <label class="flex items-center gap-2 cursor-pointer bg-slate-900/50 p-2 rounded-lg border border-slate-800"><input type="checkbox" id="perm_orga_shopping_check" class="accent-amber-500 rounded" /> ☑️ Einkaufseinträge abhaken</label>
              <label class="flex items-center gap-2 cursor-pointer bg-slate-900/50 p-2 rounded-lg border border-slate-800"><input type="checkbox" id="perm_orga_shopping_add" class="accent-amber-500 rounded" /> 🛒 Einkaufsartikel hinzufügen</label>

              <div class="font-semibold text-slate-400 col-span-full mt-2">💰 Kasse & Finanzen</div>
              <label class="flex items-center gap-2 cursor-pointer bg-slate-900/50 p-2 rounded-lg border border-slate-800"><input type="checkbox" id="perm_orga_cash_buttons" class="accent-amber-500 rounded" /> 🛒 Kasse Schnelltasten (+1/-1)</label>
              <label class="flex items-center gap-2 cursor-pointer bg-slate-900/50 p-2 rounded-lg border border-slate-800"><input type="checkbox" id="perm_orga_override_sales" class="accent-amber-500 rounded" /> 🔢 Gesamtzahlen Kasse abändern</label>
              <label class="flex items-center gap-2 cursor-pointer bg-slate-900/50 p-2 rounded-lg border border-slate-800"><input type="checkbox" id="perm_orga_view_finances" class="accent-amber-500 rounded" /> 💶 Umsatz & Gewinn einsehen</label>
            </div>
          </div>

        </div>
      </div>
