        class="button is-primary block"
        href="/downloads/{{ baderegeln.filename }}"
        target="_blank"
        rel="noopener"
      >
        <span class="icon">
          <i class="fas fa-download"></i>
        </span>
        <span> {{ baderegeln.title }} herunterladen </span>
      </a>
    {% endif %}
